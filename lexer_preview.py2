"""Py2Cpp 拟定语法高亮预览。

打开本文件，确认语言模式为 Py2Cpp；GPU 高亮自动在后台启动。
查看推理结果时执行（关闭预览不影响编辑器高亮）：
Py2Cpp Lexer: Open GPU Highlight Preview

用于人工检查 lexer 着色；新语法仍处于设计阶段，不作为当前编译器的运行测试。
语法依据：docs/syntax-migration.md。
解析器与自举方案：docs/parser-self-hosting.md。
"""

from py2cpp import *
from py2cpp.core.exceptions import Exception


# 01. enum / Flag / 继承 / type enum / type union
enum ModeEnum:
    Slow = 0
    Fast = ...
    Debug = ...


enum AccessFlag(int64, flag=True):
    Read = 1
    Write = ...
    Execute = ...


class Animal:
    virtual def sound(self) -> str:
        return "animal"


class Dog(Animal):
    override final def sound(self) -> str:
        return "woof"


class Cat(Animal):
    override def sound(self) -> str:
        return "meow"


type enum KindTypeEnum(base=Animal):
    Other = -1


class PreviewError(Exception):
    pass


type union ErrorTypeUnion(base=Exception):
    variant Unknown:
        pass


# 02. union / variant / 泛型载荷
union MessageUnion:
    variant Move:
        x: int
        y: int

    variant Text:
        value: str

    variant Quit:
        pass


union BoxUnion[Value]:
    variant Some:
        value: Value

    variant Empty:
        pass


# 03. protocol / mixin / final / const / static / property
protocol SizedType:
    abstract def size(self) -> int:
        ...

    static abstract def zero() -> int:
        ...


mixin LabelMixin:
    def label(self) -> str:
        return "lexer preview"


final class Counter(LabelMixin):
    const limit: int = 64
    final seed: int
    _x: int = 0

    def __init__(self, seed: int):
        self.seed = seed

    property x:
        def __get__(self) -> int:
            return self._x

        def __set__(self, value: int):
            self._x = value

        def __post_set__(self, value: int):
            print(f"x 已更新为 {value}")

    static property title:
        def __get__() -> str:
            return "Py2Cpp Lexer"

    static def clamp(value: int) -> int:
        return max(0, min(value, 64))


# 仅含 getter 的属性：单行、多行和静态简写。
class ReadOnlyPreview:
    property def x(self): return 1

    property def description(self) -> str:
        return "只有 getter 的只读属性"

    static property def version() -> str:
        return "0.1.0"


# 04. record / frozen / ordered / optional
# record 固定生成 __init__、__eq__ 与 __repr__；手写 __str__ 和 __post_init__ 合法。
@serializable
ordered record User:
    id: int
    name: str = "anonymous"
    optional label: str = ""

    def __post_init__(self) -> None:
        self.label = self.label or self.name

    def __str__(self) -> str:
        return f"User({self.id}, {self.name})"


# frozen 冻结完整实例布局；因此这里的字段都在构造时确定。
frozen ordered record Point:
    x: int
    y: int


# ref 和 final 可以与 record 组合；ordered 仅适用于 record。
ref record SharedHandle:
    value: int


final record BuildStamp:
    revision: str


# 05. ref class / T? / ?. / ?[] / ! / ?? / ??=
ref class Node:
    x: int = 0
    label: str = "节点 😀"
    memo: str? = None
    next: Node? = None

    def notify(self, text: str):
        print(text)


def nullablePreview(node: Node?, values: list[int]?) -> int:
    count: int? = None
    count ??= 0
    stillNullable: int? = count!  # ! 只抑制诊断，不把 int? 解包成 int。
    mixed: list[int?]? = [None, 0, 42]

    value: int = node?.x ?? 0
    first: int = values?[0] ?? -1
    label: str = node?.next?.label ?? "没有下一个节点"

    # node 使用引用模型；为空时跳过 RHS、调用实参及实际写入。
    node?.x = value
    node?.x += 1
    node?.memo ??= "已访问"
    node?.notify(f"当前值：{value}")

    if node is not None:
        print(node!.label)  # 后缀 !；普通不等比较仍写 !=。
    if first != 0 and not (value < 0):
        print(label)
    return (stillNullable ?? 0) + first + value


# 05. => 创建 lambda；-> 在类型位置表示 Callable。
type Formatter = (int, float) -> str
type Transform[T, U] = (T) -> U
type MaybeText = (int) -> str?          # 返回值可空。
type MaybeFormatter = ((int) -> str)?  # Callable 本身可空。
type FormatterFactory = () -> (int) -> str


def apply(fn: (int, float) -> str, a: int, b: float) -> str:
    return fn(a, b)


def lambdaPreview():
    one: () -> int = () => 1
    twice: (int) -> int = x => 2 * x
    add: (int, int) -> int = (a, b) => a + b
    formatter: Formatter = (a, b) => f"{a}:{b:.2f}"
    choose: (int) -> str = x => "正数" if x > 0 else "非正数"
    transforms: list[(int) -> int] = [x => x + 1, x => x * x]

    optional: ((int) -> str)? = None
    optional ??= x => str(x)
    render: (int) -> str = optional ?? (x => f"默认值 {x}")

    print(one(), twice(3), add(2, 5), choose(-1))
    print(apply(formatter, 7, 2.5), render(42))


# 06. inline for / inline if / inline match
class CompileTimePreview:
    def total(self) -> int:
        result: int = 0
        # 保持 inlineRange 的宿主要求，放在类方法内。
        inline for i in range(3):
            inline if i == 0:
                result += 10
            elif i == 1:
                result += 20
            else:
                result += i
        return result

    def dimensionCode(self) -> int:
        inline match 3:
            case 0 | 1:
                return 1
            case n if n >= 3:
                return n
            case _:
                return 0


# 07. 类型捕获：type U 声明捕获，裸 U 引用已有类型。
type ElementOf[T] = U if T is list[type U] else T
type ValueOf[T] = V if T is dict[str, type V] else Never
type InnerOf[T] = U if T is list[list[type U]] else T
type EntryOf[T] = (K, V) if T is dict[type K, type V] else Never

type PreviewElement = ElementOf[list[int]]      # int
type PreviewFallback = ElementOf[str]          # str
type PreviewNullable = ElementOf[list[Node?]]  # Node?，保留可空注解。


def typeCapturePreview[T](value: T) -> int:
    # type U 显式捕获；两个 case 的 U 分别绑定，彼此不泄漏。
    type match T:
        case list[type U] if U is int:
            return 1
        case list[type U]:
            return 2
        case dict[type K, type V] if K is V:
            return 3
        case type Whole:
            return 0


def typeCode[T](value: T) -> int:
    type match T:
        case list[int]:
            return 1
        case str:
            return 2
        case int | float:
            return 3
        case int?:
            return 4
        case (int, float) -> str:
            return 5
        case _:
            return 0


# 普通 match 继续匹配值。
def modeName(mode: ModeEnum) -> str:
    match mode:
        case ModeEnum.Fast | ModeEnum.Debug:
            return "fast"
        case _:
            return "slow"


# 08. match 表达式：case 的结果是表达式，逗号分隔，允许尾逗号。
def matchCode(x: int) -> int:
    return x match { case 0: 1, case y if y > 0: 2, case _: 3 }


def matchDescription(x: int) -> str:
    return x match {
        case 0: "zero",
        case y if y > 0: f"positive: {y}",
        case _: "negative",
    }


def matchOptional(x: int) -> int?:
    return x match { case 0: None, case _: x }


def matchExpressionPreview(x: int, mode: ModeEnum):
    # match 位于 lambda 体内，只在调用 classify 时求值。
    classify: (int) -> str = value => value match {
        case 0: "zero",
        case y if y > 0: "positive",
        case _: "negative",
    }
    # 枚举 OR、嵌套 match 和嵌套字典的逗号/冒号。
    label: str = mode match {
        case ModeEnum.Fast | ModeEnum.Debug: "fast",
        case _: x match { case 0: "idle", case _: "slow" },
    }
    data: dict[str, int] = x match {
        case 0: {"code": 1, "value": 0},
        case y if y > 0: {"code": 2, "value": y},
        case _: {"code": 3, "value": x},
    }
    result: int = matchOptional(x) ?? 42
    print(classify(x), label, data, result)


# 09. ref / lazy 参数：前缀写法，保持每次调用内部的求值规则。
def increment(value: ref int):
    value += 1


def lazyPreview(value: lazy int = None) -> int:
    return value + value


def f(x: lazy int, y: ref str):
    y += str(x + x)


def nameRef(name: ref str) -> ref str:
    return name


def localMemo(value: lazy ref int = 10) -> int:
    slot: ref int = value  # 引用当前调用内部的 memo，不重绑定调用者变量。
    slot += 1
    return value


# 10. lazy property / lazy def：跨读取或跨调用缓存结果。
class CachedPreview:
    source: str = "hello"

    lazy property summary:
        def __get__(self) -> str:
            return self.source + "!"

    lazy property def size(self) -> int:
        return len(self.source)

    lazy property def answer(self): return 42

    static lazy property def title() -> str:
        return "Py2Cpp Lexer"

    lazy def scaledSize(self, factor: int) -> int:
        return len(self.source) * factor

    static lazy def square(value: int) -> int:
        return value * value


lazy def fibonacci(n: int) -> int:
    if n < 2:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)


@LazyCache(128)
lazy def formatCached(value: int, prefix: str = "value=") -> str:
    return prefix + str(value)


def cachePreview():
    report: CachedPreview = new()
    print(report.summary, report.summary)
    report.source = "updated"
    del report.summary  # 不读取 getter；下次访问重算。
    print(report.summary, report.scaledSize(2))
    report.scaledSize.clearCache()
    print(fibonacci(12), formatCached(42))
    fibonacci.clearCache()


# 10b. lazy class：拟定的惰性单例语法，只允许无参获取实例。
lazy class Settings:
    theme: str = "default"
    accessCount: int = 0

    def __init__(self) -> None:
        print("首次获取 Settings，执行一次初始化")
        self.theme = "light"


def singletonPreview():
    first = Settings()  # 首次调用创建并初始化单例。
    second = Settings()  # 返回同一个对象，不再执行 __init__。
    print(first is second)  # True：同一对象身份。

    first.theme = "dark"
    first.accessCount += 1
    print(second.theme)  # "dark"：两个引用共享字段状态。
    print(second.accessCount)

    same: Settings = new()  # 由目标类型推导，也获取同一个单例。
    print(same is first)  # True。

    # Settings(1)                 # 错误：单例获取不接受位置参数。
    # Settings(theme="dark")      # 错误：单例获取不接受关键字参数。


# 11. 普通表达式、字符串与数值字面量
def literalsPreview():
    hexValue: int = 0x2A
    bits: int = 0b1010
    ratio: float = 1.25e2
    path: str = r"C:\Py2Cpp\lexer_preview.py2"
    text: str = "中文、emoji 😀、转义：\n\t\"quoted\""
    squares: list[int] = [x * x for x in range(5) if x % 2 == 0]
    labels: dict[str, int] = {"alpha": 1, "beta": 2}
    message: MessageUnion = new.Move(10, 20)
    print(f"hex={hexValue}, bits={bits}, ratio={ratio:.2f}")
    print(path, text, squares, labels)


# 12. call / from / as：在调用现场定义回调，正文使用普通缩进块。
def runCallback(callback: () -> None) -> None:
    callback()


def callFromPreview():
    s: list[int] = [-120, 3, -8, 0, 42]

    # 多行回调：f 仅在本次调用表达式和自身正文中可见。
    call f(x: int) -> int from s.sort(key=f):
        value: int = abs(x)
        if value > 100:
            return 100
        return value
    print(s)

    # 单行回调：有值签名仍显式 return。
    call descending(x: int) -> int from s.sort(key=descending): return -x

    # as 接收 sorted 的列表结果；-> int 约束 key 回调。
    call key(x: int) -> int from sorted(s, key=key) as result:
        return abs(x)
    print(result)

    # 多参数、显式签名，与已有 Callable 类型的 apply 配合。
    call formatPair(a: int, b: float) -> str from apply(formatPair, 7, 2.5) as text:
        label: str = f"{a}:{b:.2f}"
        return label
    print(text)

    # 零参数、无值回调；正文在 runCallback 调用 notify 时执行。
    call notify() -> None from runCallback(notify):
        print("回调开始")
        print(text)

    # pass 用于无值回调，避免与 -> int 的返回要求冲突。
    call noop() -> None from runCallback(noop): pass
