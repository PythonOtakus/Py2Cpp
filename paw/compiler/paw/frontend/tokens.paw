"""Token 种类与结构 — parity with ``compiler/py/frontend/tokens.py``.

Paw 侧枚举名 ``TokenKindEnum``（编码规范）；宿主 Py 为 ``TokenKind``。
"""
from paw import *
from .source import SourceSpan, makeSpan

enum TokenKindEnum:
  End = 0
  Newline = ...
  Indent = ...
  Dedent = ...
  Name = ...
  Number = ...
  String = ...
  Op = ...
  Comment = ...
  KwEnum = ...
  KwUnion = ...
  Colon = ...
  Comma = ...
  Dot = ...
  Lpar = ...
  Rpar = ...
  Lsqb = ...
  Rsqb = ...
  Lbrace = ...
  Rbrace = ...
  Eq = ...
  Arrow = ...
  Rarrow = ...
  At = ...
  Question = ...
  Bang = ...
  Ellipsis = ...

@copyable
class Token:
  kind: TokenKindEnum = TokenKindEnum.End
  span: SourceSpan = new()
  text: str = ""

def makeNameToken(fileValue: int, start: int, end: int, text: str) -> Token:
  return new(
    kind=TokenKindEnum.Name,
    span=makeSpan(fileValue, start, end),
    text=text,
  )
