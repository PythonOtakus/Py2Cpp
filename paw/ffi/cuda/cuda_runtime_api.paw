native def pyiCudaGraphGetRootNodes(graph: Pointer[PyiCUgraphSt], pRootNodes: Pointer[Pointer[PyiCUgraphNodeSt]], pNumRootNodes: Pointer[uint64]) -> PyiCudaErrorT:
  """
  Returns a graph's root nodes

