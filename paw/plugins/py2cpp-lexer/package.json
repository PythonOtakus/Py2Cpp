{
  "name": "py2cpp-lexer",
  "displayName": "Paw Lexer",
  "description": "gpu-lexer 后台 GPU 主高亮、Paw 编辑器语义着色与独立代码预览",
  "version": "0.3.0",
  "publisher": "PythonOtakus",
  "author": "PythonOtakus",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0", "node": ">=18" },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": ["onLanguage:paw"],
  "main": "./out/extension.js",
  "private": true,
  "extensionKind": ["ui"],
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "scripts": {
    "package": "python package.py",
    "test": "node --test tests/*.test.js",
    "vscode:prepublish": "node -e \"process.exit(0)\""
  },
  "contributes": {
    "languages": [{
      "id": "paw",
      "aliases": ["Paw", "paw"],
      "extensions": [".paw"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "paw",
      "scopeName": "source.paw",
      "path": "./syntaxes/paw.tmLanguage.json"
    }],
    "commands": [
      { "command": "py2cpp-lexer.openPanel", "title": "Paw Lexer: Open GPU Highlight Preview" },
      { "command": "py2cpp-lexer.enableForCurrentFile", "title": "Paw Lexer: Enable GPU Highlighting for Current File" },
      { "command": "py2cpp-lexer.restoreLanguage", "title": "Paw Lexer: Restore Previous Language Mode" },
      { "command": "py2cpp-lexer.refresh", "title": "Paw Lexer: Refresh Highlighting" },
      { "command": "py2cpp-lexer.restartGpu", "title": "Paw Lexer: Restart GPU Session" }
    ],
    "configurationDefaults": { "[paw]": { "editor.semanticHighlighting.enabled": true } },
    "semanticTokenScopes": [{
      "language": "paw",
      "scopes": {
        "comment": ["comment.line.number-sign.paw"],
        "string": ["string.quoted.double.paw"],
        "number": ["constant.numeric.paw"],
        "keyword": ["keyword.control.paw"],
        "type": ["entity.name.type.paw"],
        "function": ["entity.name.function.paw"],
        "variable.readonly": ["constant.other.paw"],
        "operator": ["keyword.operator.paw"]
      }
    }],
    "configuration": {
      "title": "Paw Lexer",
      "properties": {
        "py2cpp-lexer.enabled": {
          "type": "boolean", "default": true,
          "description": "打开 Paw（*.paw）文件时自动启用后台 GPU 主高亮；关闭预览不影响高亮。初始化、不可用或禁用时保留基础高亮。"
        },
        "py2cpp-lexer.nodePath": {
          "type": "string", "default": "", "scope": "machine",
          "description": "可选普通 Node.js 18+ 可执行文件路径。Windows x64 默认使用随包运行时，其他平台使用 PATH 中的 node。不能使用编辑器的 Electron 可执行文件。"
        },
        "py2cpp-lexer.debounceMs": {
          "type": "number", "default": 250, "minimum": 50, "maximum": 3000,
          "description": "编辑后重新高亮的等待时间（毫秒）。"
        },
        "py2cpp-lexer.maxDocumentCharacters": {
          "type": "number", "default": 200000, "minimum": 1000, "maximum": 1000000,
          "description": "允许送入 GPU 的文件大小上限（UTF-16 单元）；超限时使用基础高亮。"
        },
        "py2cpp-lexer.requestTimeoutMs": {
          "type": "number", "default": 15000, "minimum": 1000, "maximum": 60000,
          "description": "单次 GPU 高亮请求超时（毫秒）；初始化另有 30 秒上限。"
        }
      }
    }
  }
}
