"""Paw B 批竖切：record / frozen / optional 字段（lowering → @dataclass）。"""
from paw import *
from paw.test.unittest import TestCaseMixin, TestSuite, TextTestRunner

record Point:
  x: int = 0
  y: int = 0

frozen record Size:
  w: int = 1
  h: int = 1

record Slot:
  optional name: str = ""
  value: int = 0

class PawRecordTests(TestCaseMixin):
  _testTag = 1

  override def test(self):
    p: Point = new(1, 2)
    self.assertTrue(p.x == 1)
    self.assertTrue(p.y == 2)
    s: Size = new(3, 4)
    self.assertTrue(s.w == 3)
    slot: Slot = new(value=9)
    self.assertTrue(slot.value == 9)

def main():
  suite: TestSuite = new()
  for Class in TestCaseMixin.iterSubclasses(sortConst="_testTag"):
    suite.addTest(Class())
  return TextTestRunner().run(suite)
