                  i += 1
            elseCppFE = _emitStmtSeq("\n".join(elseLinesFE), "void", st, depth + 1)
            if elseCppFE == "" and len(elseLinesFE) > 0:
              elseCppFE = "  /* for-else omitted */\n"
