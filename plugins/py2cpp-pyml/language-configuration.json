{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*@(?:def|inline|if|elif|else|for)\\b",
      "end": "^\\s*@(?:elif|else)\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:-\\s+)?(?:@[\\w]+|[=$]?[\\w$\"'].*):\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:@elif\\b|@else\\b)"
  }
}
