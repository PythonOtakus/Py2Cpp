# clangd：``#include "paw/..."`` 的根为 out/runtime（与 compile.py 一致）
CompileFlags:
  Add:
    - -std=c++14
    - -I
    - out/runtime
    - -I
    - templates
    - -D_WIN32

# out/*.inl 常不在 DB 中单独列出时的回退；templates/*.inl 走 compile_commands 条目
If:
  PathMatch: out/.*\.inl$
CompileFlags:
  CompilationDatabase: None
  Add:
    - -std=c++14
    - -I
    - out/runtime
    - -I
    - templates
    - -D_WIN32
    - -x
    - c++
    - -fsyntax-only
