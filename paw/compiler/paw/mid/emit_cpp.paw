          out = out + " = "
          out = out + startCpp
          out = out + "; "
          out = out + varF
          out = out + cmpOp
          out = out + limCpp
          out = out + "; "
          out = out + varF
          out = out + stepStmt
          out = out + ") {\n"
          out = out + forCpp
          out = out + "  }\n"
          if hasElseFE:
            out = out + "  if (!" + flagFE + ") {\n"
            out = out + elseCppFE
            out = out + "  }\n"
          continue
    # ``async for x in agen:`` → ``__aiter__`` / ``__anext__``（勿 ``s[:10]=="async for "`` soft-skip）
    wantAsyncFor: bool = False
    if s.find("async for ") == 0:
      if len(s) > 0 and s[len(s) - 1] == ":":
        if s.find(" in ") > 0:
          wantAsyncFor = True
    if wantAsyncFor:
      headAF: str = s[10 : len(s) - 1].strip()
