"""``Optional[Value]``：``Value | None`` 的 ADT（``Some`` / ``None_``）。"""
from ..builtins import *
from paw import native_name, property, variant

union Optional[Value]:
  variant None_:
    pass

  variant Some:
    value: Value

  property def value(self) -> Value:
    match self:
      case None:
        raise ValueError("Optional has no value")
      case v:
        return v
