          if iterCppAF != "":
            forCppAF: str = _emitStmtSeq("\n".join(forLinesAF), "void", st, depth + 1)
            elseCppAF: str = ""
            hasElseAF: bool = False
            if i < len(lines) and lines[i].strip() == "else:" and _lineIndent(lines[i]) == ind:
