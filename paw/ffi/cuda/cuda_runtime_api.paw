@native_name("cudaOccupancyMaxActiveClusters")
native def pyiCudaOccupancyMaxActiveClusters(numClusters: Pointer[int], func: uintptr, launchConfig: Pointer[PyiCudaLaunchConfigSt]) -> PyiCudaErrorT:
  """
  Given the kernel function ( func) and launch configuration ( config), return the maximum number of clusters that could co-exist on the target device in *numClusters.

