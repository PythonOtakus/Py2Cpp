          _localRemember(st, nameAW)
        else:
          out = out + "  (void)(py2cpp_thin_task_run(__aw_cm.__aenter__()));\n"
        out = out + bodyAW
        out = out + "  (void)(py2cpp_thin_task_run(__aw_cm.__aexit__()));\n"
        out = out + "  }\n"
        continue
      out = out + _softSkipLine(s)
      continue
    # ``for x in xs:`` / ``for x in reversed(xs):`` / ``for i in prange(...)``
    if len(s) >= 4 and s[:4] == "for " and s[len(s) - 1] == ":" and " in " in s:
      headFI: str = s[4 : len(s) - 1].strip()
      inFI: int = headFI.find(" in ")
      if inFI > 0:
        varFI: str = headFI[:inFI].strip()
        iterFI: str = headFI[inFI + 4 :].strip()
        i += 1
        forLinesI: list[str] = []
        if i < len(lines):
          forIndI: int = _lineIndent(lines[i])
          if forIndI > ind:
            while i < len(lines) and _lineIndent(lines[i]) >= forIndI:
              forLinesI.append(lines[i])
              i += 1
        # ``for i in prange(...)`` → 原生 for（OpenMP 可选；薄路径先串行）
        if _isIdent(varFI) and len(iterFI) >= 7 and iterFI[:7] == "prange(" and iterFI[len(iterFI) - 1] == ")":
          prArgs: str = iterFI[7 : len(iterFI) - 1].strip()
          prParts: list[str] = _splitParams(prArgs)
          # 过滤关键字实参 schedule=/th=/…
          posPr: list[str] = []
          piPr: int = 0
          while piPr < len(prParts):
            rawPr: str = prParts[piPr].strip()
            if _bareKwEqPos(rawPr) > 0:
              piPr += 1
              continue
            posPr.append(rawPr)
            piPr += 1
          startPr: str = "0"
          stopPr: str = ""
          stepPr: str = "1"
          stepSrcPr: str = "1"
          if len(posPr) >= 3:
            a0p: str = _emitSimpleTerm(posPr[0], st)
            a1p: str = _emitSimpleTerm(posPr[1], st)
            stepSrcPr = posPr[2]
            a2p: str = _emitSimpleTerm(stepSrcPr, st)
            if a0p != "" and a1p != "" and a2p != "":
              startPr = a0p
              stopPr = a1p
              stepPr = a2p
          elif len(posPr) == 2:
            a0b: str = _emitSimpleTerm(posPr[0], st)
            a1b: str = _emitSimpleTerm(posPr[1], st)
            if a0b != "" and a1b != "":
              startPr = a0b
              stopPr = a1b
          elif len(posPr) == 1:
            stopPr = _emitSimpleTerm(posPr[0], st)
          if stopPr != "":
            forCppPr: str = _emitStmtSeq("\n".join(forLinesI), "void", st, depth + 1)
            cmpPr: str = " < "
            stepStmtPr: str = " += " + stepPr
            if _rangeStepIsNeg(stepSrcPr, stepPr):
              cmpPr = " > "
            # 有 reduction 累加时挂 omp（简单 ``+=``）；否则普通 for
            redPr: str = ""
            fjPr: int = 0
            while fjPr < len(forLinesI):
              lnPr: str = forLinesI[fjPr].strip()
              if "+=" in lnPr:
                plusPr: int = lnPr.find("+=")
                if plusPr > 0:
                  nmRed: str = lnPr[:plusPr].strip()
                  if _isIdent(nmRed):
                    if redPr == "":
                      redPr = nmRed
                    elif redPr.find(nmRed) < 0:
                      redPr = redPr + ", " + nmRed
              fjPr += 1
            if redPr != "":
              out = out + "  #pragma omp parallel for reduction(+:" + redPr + ")\n"
            else:
              out = out + "  #pragma omp parallel for\n"
            out = out + "  for (PyInt " + varFI + " = " + startPr + "; " + varFI + cmpPr + stopPr + "; " + varFI + stepStmtPr + ") {\n"
            out = out + forCppPr
            out = out + "  }\n"
            continue
        # ``iterFields`` / ``iterMethods`` / mixin 反射：薄 emit 暂 soft-skip
        if "iterFields" in iterFI or "iterMethods" in iterFI:
          out = out + _softSkipLine(s)
          continue
        # ``for e in pos & vel:`` → ``pos.__and__(vel)`` 迭代
        andPosFI: int = iterFI.find(" & ")
        if andPosFI > 0 and "(" not in iterFI and _isIdent(varFI):
          leftAnd: str = iterFI[:andPosFI].strip()
          rightAnd: str = iterFI[andPosFI + 3 :].strip()
          if (_isIdent(leftAnd) or _isAttrOrIdent(leftAnd)) and (
            _isIdent(rightAnd) or _isAttrOrIdent(rightAnd)
          ):
            leftCppA: str = _rewriteSelf(leftAnd)
            rightCppA: str = _rewriteSelf(rightAnd)
            forCppAnd: str = _emitStmtSeq("\n".join(forLinesI), "void", st, depth + 1)
            out = out + "  {\n"
            out = out + "  auto __itc = (" + leftCppA + ").__and__(" + rightCppA + ");\n"
            out = out + "  auto& __it = (__itc).__iter__();\n"
            out = out + "  for (;;) {\n"
            out = out + "  auto __ir = __it.__next__();\n"
            out = out + "  if (__ir.done__get()) break;\n"
            out = out + "  auto " + varFI + " = __ir.value__get();\n"
            out = out + forCppAnd
            out = out + "  }\n"
            out = out + "  }\n"
            continue
        # ``for m in ModeEnum``：按成员表展开
        if _isEnumTypeName(st, iterFI) and _isIdent(varFI):
          csvE: str = _enumTypeMembersCsv(st, iterFI)
          cntE: int = _enumTypeCount(st, iterFI)
          forCppE: str = _emitStmtSeq("\n".join(forLinesI), "void", st, depth + 1)
          if csvE != "" and cntE > 0:
            out = out + "  {\n"
            out = out + "  static const Py" + iterFI + " __en_vals[] = {"
            partsE: list[str] = csvE.split(",")
            pe: int = 0
            while pe < len(partsE):
              if pe > 0:
                out = out + ", "
              out = out + "Py" + iterFI + "::" + partsE[pe].strip()
              pe += 1
            out = out + "};\n"
            out = out + "  for (PyInt __fi = 0; __fi < " + str(cntE) + "; __fi += 1) {\n"
            out = out + "  auto " + varFI + " = __en_vals[__fi];\n"
            out = out + forCppE
            out = out + "  }\n"
            out = out + "  }\n"
            continue
          out = out + _softSkipLine(s)
          continue
        revInner: str = ""
        if len(iterFI) >= 10 and iterFI[:9] == "reversed(" and iterFI[len(iterFI) - 1] == ")":
          revInner = iterFI[9 : len(iterFI) - 1].strip()
        if _isIdent(varFI) and revInner != "" and (_isIdent(revInner) or _isAttrOrIdent(revInner)):
          iterCppR: str = _rewriteSelf(revInner)
          forCppR: str = _emitStmtSeq("\n".join(forLinesI), "void", st, depth + 1)
          out = out + "  for (PyInt __fi = (" + iterCppR + ").__len__() - 1; __fi >= 0; __fi -= 1) {\n"
          out = out + "  auto " + varFI + " = (" + iterCppR + ").__getitem__(__fi);\n"
          out = out + forCppR
          out = out + "  }\n"
          continue
        commaEn: int = varFI.find(",")
        if commaEn > 0:
          v0En: str = varFI[:commaEn].strip()
          v1En: str = varFI[commaEn + 1 :].strip()
          if _isIdent(v0En) and _isIdent(v1En):
            if len(iterFI) >= 10 and iterFI[:10] == "enumerate(" and iterFI[len(iterFI) - 1] == ")":
              enIn: str = iterFI[10 : len(iterFI) - 1].strip()
              enPs: list[str] = _splitParams(enIn)
              if len(enPs) >= 1:
                seqN: str = enPs[0].strip()
                startN: str = "0"
                if len(enPs) >= 2:
                  stN: str = _emitSimpleTerm(enPs[1].strip(), st)
                  if stN != "":
                    startN = stN
                if _isIdent(seqN) or _isAttrOrIdent(seqN):
                  seqCppN: str = _rewriteSelf(seqN)
                  forCppEn: str = _emitStmtSeq("\n".join(forLinesI), "void", st, depth + 1)
                  out = out + "  for (PyInt __fi = 0; __fi < (" + seqCppN + ").__len__(); __fi += 1) {\n"
                  out = out + "  PyInt " + v0En + " = " + startN + " + __fi;\n"
                  out = out + "  auto " + v1En + " = (" + seqCppN + ").__getitem__(__fi);\n"
                  out = out + forCppEn
                  out = out + "  }\n"
                  continue
        # ``for ent in dirPath.iterDir():`` / ``for hit in dirPath.glob('…'):``
        if _isIdent(varFI) and "(" in iterFI and iterFI[len(iterFI) - 1] == ")":
          iterCallCpp: str = _emitSimpleTerm(iterFI, st)
          if iterCallCpp != "":
            forCppCall: str = _emitStmtSeq("\n".join(forLinesI), "void", st, depth + 1)
            out = out + "  {\n"
            out = out + "  auto __itc = " + iterCallCpp + ";\n"
            out = out + "  auto& __it = (__itc).__iter__();\n"
            out = out + "  for (;;) {\n"
            out = out + "  auto __ir = __it.__next__();\n"
            out = out + "  if (__ir.done__get()) break;\n"
            out = out + "  auto " + varFI + " = __ir.value__get();\n"
            out = out + forCppCall
            out = out + "  }\n"
            out = out + "  }\n"
            continue
        if _isIdent(varFI) and (_isIdent(iterFI) or _isAttrOrIdent(iterFI)):
          iterCpp: str = _rewriteSelf(iterFI)
          iterTyFi: str = ""
          if _isIdent(iterFI):
            iterTyFi = _localCppTypeOf(st, iterFI)
          elif _isAttrOrIdent(iterFI):
            # ``self.g`` / ``this->g`` / ``holder.g``：从接收者类字段表取 GeneratorType
            iterFI2: str = iterFI.replace("->", ".")
            lastDotFi: int = iterFI2.rfind(".")
            if lastDotFi > 0:
              recvFi: str = iterFI2[:lastDotFi].strip()
              fldFi: str = iterFI2[lastDotFi + 1 :].strip()
              if _isIdent(fldFi):
                recvTyFi: str = ""
                if recvFi == "self" or recvFi == "this":
                  # 方法体内：扫已登记类字段名
                  ciF: int = 0
                  while ciF < len(st.classFieldNameCsv):
                    nmsF: list[str] = st.classFieldNameCsv[ciF].split(",")
                    njF: int = 0
                    while njF < len(nmsF):
                      if nmsF[njF].strip() == fldFi:
                        tysF: list[str] = st.classFieldTypeCsv[ciF].split("|")
                        if njF < len(tysF):
                          iterTyFi = _cppType(tysF[njF].strip(), st)
                        break
                      njF += 1
                    if iterTyFi != "":
                      break
                    ciF += 1
                else:
                  if _isIdent(recvFi):
                    recvTyFi = _localCppTypeOf(st, recvFi)
                  if recvTyFi != "":
                    srcFi: str = _classFieldSrcType(st, recvTyFi, fldFi)
                    if srcFi != "":
                      iterTyFi = _cppType(srcFi, st)
          forCppI: str = _emitStmtSeq("\n".join(forLinesI), "void", st, depth + 1)
          # IO / Set / FrozenSet / Dict / xsplit generator：无 ``__getitem__(i)``，走迭代器协议
          useIterProto: bool = False
          if iterTyFi.find("PyStringIO") >= 0 or iterTyFi.find("PyTextIO") >= 0:
            useIterProto = True
          if iterTyFi.find("PySet") >= 0 or iterTyFi.find("PyFrozenSet") >= 0:
            useIterProto = True
          if iterTyFi.find("PyDict") >= 0 or iterTyFi.find("PyCounter") >= 0:
            useIterProto = True
          if iterTyFi.find("FrozenDict") >= 0:
            useIterProto = True
          if iterTyFi.find("generator") >= 0 or iterTyFi.find("Generator") >= 0:
            useIterProto = True
          if iterTyFi.find("Coroutine") >= 0 or iterTyFi.find("AsyncGenerator") >= 0:
            useIterProto = True
          if iterTyFi.find("xsplit") >= 0 or iterTyFi.find("Iterator") >= 0:
            useIterProto = True
          # 属性迭代且类型未知：优先迭代器协议（避免 PyGenerator 误走 __getitem__）
          if iterTyFi == "" and (iterFI.find(".") >= 0 or iterFI.find("->") >= 0):
            useIterProto = True
          # ``g = genThree(); for x in g``：auto 无类型时勿走 __len__/__getitem__
          if iterTyFi == "" and _isIdent(iterFI):
            useIterProto = True
          if useIterProto:
            out = out + "  {\n"
            # TextIO 等 ``@uncopyable``：``auto&&`` 绑 ``__iter__`` 返回，勿拷贝
            if iterTyFi.find("PyTextIO") >= 0 or iterTyFi.find("PyStringIO") >= 0:
              out = out + "  auto&& __it = (" + iterCpp + ").__iter__();\n"
            else:
              out = out + "  auto __it = (" + iterCpp + ").__iter__();\n"
            out = out + "  for (;;) {\n"
            out = out + "  auto __ir = __it.__next__();\n"
            out = out + "  if (__ir.done__get()) break;\n"
            out = out + "  auto " + varFI + " = __ir.value__get();\n"
            out = out + forCppI
            out = out + "  }\n"
            out = out + "  }\n"
            continue
          # ``PyStackArray`` 带 Offset：相对下标 + offset
          idxFi: str = "__fi"
          if _isStackArrayTy(iterTyFi):
            lbOff: int = iterTyFi.find("<")
            rbOff: int = iterTyFi.rfind(">")
            if lbOff > 0 and rbOff > lbOff:
              partsOff: list[str] = _splitParams(iterTyFi[lbOff + 1 : rbOff])
              if len(partsOff) >= 3:
                offRawFi: str = partsOff[2].strip()
                if _isIntLit(offRawFi) and offRawFi != "0":
                  idxFi = "((" + offRawFi + ") + (__fi))"
          out = out + "  for (PyInt __fi = 0; __fi < (" + iterCpp + ").__len__(); __fi += 1) {\n"
          out = out + "  auto " + varFI + " = (" + iterCpp + ").__getitem__(" + idxFi + ");\n"
          out = out + forCppI
          out = out + "  }\n"
          continue
        # 其它 for-in：吞掉循环体，避免体语句落到外层
        out = out + _softSkipLine(s)
        continue
    if len(s) >= 6 and s[:6] == "while " and s[len(s) - 1] == ":":
      wcond: str = s[6 : len(s) - 1].strip()
      wCpp: str = ""
      if wcond == "True":
        wCpp = "true"
      elif "len(" in wcond:
        lt: int = wcond.find("<")
        if lt > 0:
          leftW: str = wcond[:lt].strip()
          rightW: str = wcond[lt + 1 :].strip()
          if len(rightW) >= 4 and rightW[:4] == "len(" and rightW[len(rightW) - 1] == ")":
            innerL: str = rightW[4 : len(rightW) - 1].strip()
            limT: str = _emitSimpleTerm(innerL, st)
            if limT != "" and (_isIdent(leftW) or _isAttrOrIdent(leftW)):
              wCpp = "(" + _rewriteSelf(leftW) + " < (" + limT + ").__len__())"
      if wCpp == "":
        wCpp = _emitBoolCond(wcond, st)
      i += 1
      loopLines: list[str] = []
      if i < len(lines):
        loopInd: int = _lineIndent(lines[i])
        if loopInd > ind:
          while i < len(lines) and _lineIndent(lines[i]) >= loopInd:
            loopLines.append(lines[i])
            i += 1
      if wCpp == "":
        out = out + "  /* skip: while */\n"
        continue
      loopCpp: str = _emitStmtSeq("\n".join(loopLines), "void", st, depth + 1)
      if loopCpp == "" and len(loopLines) > 0:
        loopCpp = "  /* while body omitted */\n"
      elseCppWE: str = ""
      hasElseWE: bool = False
      if i < len(lines) and lines[i].strip() == "else:" and _lineIndent(lines[i]) == ind:
        hasElseWE = True
        i += 1
        elseLinesWE: list[str] = []
        if i < len(lines):
          elseIndWE: int = _lineIndent(lines[i])
          if elseIndWE > ind:
            while i < len(lines) and _lineIndent(lines[i]) >= elseIndWE:
              elseLinesWE.append(lines[i])
              i += 1
        elseCppWE = _emitStmtSeq("\n".join(elseLinesWE), "void", st, depth + 1)
        if elseCppWE == "" and len(elseLinesWE) > 0:
          elseCppWE = "  /* while-else omitted */\n"
      flagWE: str = "__we" + str(depth)
      if hasElseWE:
        out = out + "  bool " + flagWE + " = false;\n"
        loopCpp = _rewriteBreaksWithFlag(loopCpp, flagWE)
      out = out + "  while ("
      out = out + wCpp
      out = out + ") {\n"
      out = out + loopCpp
      out = out + "  }\n"
      if hasElseWE:
        out = out + "  if (!" + flagWE + ") {\n"
        out = out + elseCppWE
        out = out + "  }\n"
      continue
    # ``del dq[1]`` → ``__delitem__``
    if len(s) >= 4 and s[:4] == "del ":
      delT: str = s[4:].strip()
      lbD: int = delT.find("[")
      rbD: int = delT.rfind("]")
      if lbD > 0 and rbD == len(delT) - 1:
        baseD: str = delT[:lbD].strip()
        idxD: str = delT[lbD + 1 : rbD].strip()
        if _isIdent(baseD) or _isAttrOrIdent(baseD):
          baseDCpp: str = _rewriteSelf(baseD)
          if ":" in idxD:
            slD: str = _emitSliceArg(idxD, st)
            if slD != "":
              out = out + "  (void)(" + baseDCpp + ".__delitem__(" + slD + "));\n"
              i += 1
              continue
          idxCppD: str = _emitSimpleTerm(idxD, st)
          if idxCppD != "":
            out = out + "  (void)(" + baseDCpp + ".__delitem__(" + idxCppD + "));\n"
            i += 1
            continue
    # typed local / augassign / append
    # ``fn: FunctionBundle = mod.functions[i]`` (bare index only; ``tokens[i].text`` via assign).
    if "[" in s and "]" in s and ":" in s and "=" in s:
      colon2: int = s.find(":")
      eq2: int = s.find("=")
      if colon2 > 0 and eq2 > colon2:
        nm: str = s[:colon2].strip()
        tyS: str = s[colon2 + 1 : eq2].strip()
        rhsS: str = s[eq2 + 1 :].strip()
        lb: int = rhsS.find("[")
        rb: int = rhsS.rfind("]")
        if (
          _isIdent(nm)
          and lb > 0
          and rb > lb
          and rb == len(rhsS) - 1
        ):
          base: str = rhsS[:lb].strip()
          idx: str = rhsS[lb + 1 : rb].strip()
          # 仅裸 ``recv[i]`` / ``a.b[i]``；勿吞 ``b"…".partition(…)[0]`` 等调用链。
          bareGi: bool = False
          if _isIdent(base):
            bareGi = True
          if _isAttrOrIdent(base):
            bareGi = True
          if "(" in base:
            bareGi = False
          if ":" not in idx and bareGi:
            idxCpp: str = _emitSimpleTerm(idx, st)
            if idxCpp != "":
              isRefI: bool = _typeSrcHasRefPrefix(tyS)
              if s.find(": ref ") >= 0:
                isRefI = True
              if len(tyS) >= 3 and tyS[:3] == "ref":
                isRefI = True
              tyI: str = _cppType(tyS, st)
              if isRefI:
                if len(tyI) == 0 or tyI[len(tyI) - 1 : len(tyI)] != "&":
                  tyI = tyI + "&"
              gotI: str = _rewriteSelf(base) + ".__getitem__(" + idxCpp + ")"
              if tyI == "PyStr":
                gotI = _wrapGetitemAsPyStr(gotI)
              # ``@refcount`` 类（如 ``WeakValueDict[str, Node]`` 元素）→ ``PyRefCount<PyNode>``
              tyI = _refcountStorageTy(tyI, st)
              _localRememberTy(st, nm, tyI)
              out = out + "  " + tyI + " " + nm + " = " + gotI + ";\n"
              i += 1
              continue
    # Coalesce multi-line triple-quoted assigns: ``source: str = \"\"\"…\"\"\".stripLines()``
    eqT0: int = s.find("=")
    if eqT0 > 0:
      rhsT0: str = s[eqT0 + 1 :]
      needTq: bool = False
      if "\"\"\"" in rhsT0:
        needTq = True
      if "'''" in rhsT0:
        needTq = True
      if needTq and not _tripleQuotesClosed(s):
        iSaveT: int = i
        tJoined: str = s
        closedT: bool = False
        while i + 1 < len(lines):
          i += 1
          tJoined = tJoined + "\n" + lines[i]
          if _tripleQuotesClosed(tJoined):
            closedT = True
            break
        if closedT:
          alT: str = _emitAssignLine(tJoined.strip(), st)
          if alT != "":
            out = out + alT
            i += 1
            continue
        i = iSaveT
    # Coalesce multi-line list/bracket assigns: ``ops: list[str] = [\n  ...\n]``
    # Quote-aware (ops lit ``\"?[\"`` must not shift bracket depth).
    eqB0: int = s.find("=")
    if eqB0 > 0 and "[" in s[eqB0 :]:
      iSaveB: int = i
      brJoined: str = s
      depthB: int = _bracketDepthDelta(brJoined, eqB0)
      if depthB > 0:
        while depthB > 0 and i + 1 < len(lines):
          i += 1
          nxtB: str = lines[i].strip()
          brJoined = brJoined + " " + nxtB
          depthB = depthB + _bracketDepthDelta(nxtB, 0)
        if depthB == 0:
          alB: str = _emitAssignLine(brJoined, st)
          if alB != "":
            out = out + alB
            i += 1
            continue
        # Failed: restore so soft-skip / other handlers see original lines.
        i = iSaveB
    # Coalesce multi-line ``x: T = new(\n  ...\n)`` / ``x = new(...)``.
    eqP0: int = s.find("=")
    if eqP0 > 0 and "new(" in s[eqP0 :]:
      iSaveP: int = i
      pJoined: str = s
      depthP: int = _parenDepthDelta(pJoined, eqP0)
      if depthP > 0:
        while depthP > 0 and i + 1 < len(lines):
          i += 1
          nxtP: str = lines[i].strip()
          pJoined = pJoined + " " + nxtP
          depthP = depthP + _parenDepthDelta(nxtP, 0)
        if depthP == 0:
          alP: str = _emitAssignLine(pJoined, st)
          if alP != "":
            out = out + alP
            i += 1
            continue
        i = iSaveP
    # Coalesce multi-line typed/bare call-assign: ``x: T = f(\n  ...\n)`` / ``x = f(...)``.
    # （``new(`` 已在上支处理；此处覆盖 ``_parseTypePrimary(`` 等普通调用。）
    if eqP0 > 0 and "(" in s[eqP0 :] and "new(" not in s[eqP0 :]:
      iSaveCallA: int = i
      caJoined: str = s
      depthCA: int = _parenDepthDelta(caJoined, eqP0)
      if depthCA > 0:
        while depthCA > 0 and i + 1 < len(lines):
          i += 1
          caJoined = caJoined + "\n" + lines[i]
          depthCA = _parenDepthDelta(caJoined, eqP0)
        if depthCA == 0:
          alCA: str = _emitAssignLine(caJoined.strip(), st)
          if alCA != "":
            out = out + alCA
            i += 1
            continue
        i = iSaveCallA
    # 发现展开后的 C++ 行（``suite.addTest(makeRefCount<PyX>());``）
    if "makeRefCount<" in s:
      out = out + "  " + s.strip() + "\n"
      i += 1
      continue
    # ``print(...)``
    if len(s) >= 6 and s[:6] == "print(" and s[len(s) - 1] == ")":
      pr: str = _emitPrintStmt(s[6 : len(s) - 1], st)
      if pr != "":
        out = out + pr
        i += 1
        continue
    # 记录 ``.assign(kw=…)`` → 字段赋值
    if ".assign(" in s:
      asgCpp: str = _emitAssignKwargsStmt(s, st)
      if asgCpp != "":
        out = out + asgCpp
      else:
        out = out + _softSkipLine(s)
      i += 1
      continue
    if "stopwatch(" in s:
      out = out + _softSkipLine(s)
      i += 1
      if len(s) > 0 and s[len(s) - 1] == ":" and i < len(lines):
        bodyIndSw: int = _lineIndent(lines[i])
        if bodyIndSw > ind:
          while i < len(lines) and _lineIndent(lines[i]) >= bodyIndSw:
            i += 1
      continue
    al: str = _emitAssignLine(s, st)
    if al != "":
      out = out + al
      i += 1
      continue
    # bare method / call — coalesce multi-line ``self.f(\n  a,\n  b\n)`` / triple quotes
    if "(" in s:
      # 注解赋值 ``x: T =`` 才跳过；字面量内的 ``:``/``=``（如 ``expand("a: = b")``）勿挡调用。
      annEqB: int = _findOutsideQuotes(s, "=")
      annColB: int = _findOutsideQuotes(s, ":")
      skipBareCall: bool = annColB > 0 and annEqB > annColB
      if not skipBareCall:
        callJoined: str = s
        depthC: int = _parenDepthDelta(callJoined, 0)
        iSaveCall: int = i
        while depthC > 0 and i + 1 < len(lines):
          i += 1
          # Keep newline so ``\"\"\"…\"\"\"`` content / stripLines stay faithful.
          callJoined = callJoined + "\n" + lines[i]
          depthC = _parenDepthDelta(callJoined, 0)
        cj: str = callJoined.strip()
        if depthC == 0 and len(cj) > 0 and cj[len(cj) - 1] == ")":
          if len(cj) >= 6 and cj[:6] == "print(":
            pr2: str = _emitPrintStmt(cj[6 : len(cj) - 1], st)
            if pr2 != "":
              out = out + pr2
              i += 1
              continue
          braceCall: str = _emitBraceArgCallStmt(cj, st)
          if braceCall != "":
            out = out + braceCall
            i += 1
            continue
          utf8wCall: str = _emitFromUtf8WriterCallStmt(cj, st)
          if utf8wCall != "":
            out = out + utf8wCall
            i += 1
            continue
          callS: str = _emitSimpleTerm(cj, st)
          if callS != "":
            out = out + "  (void)(" + callS + ");\n"
            i += 1
            continue
        i = iSaveCall
    # Soft-skip unknown stmt so later lines still emit (thin vertical).
    # 复合语句（``for``/``if``/``while``/``match`` 等以 ``:`` 结尾）须吞掉子句体，
    # 否则残留 ``m``/``field`` 等未声明标识符（C2065）。
    # 失败的 ``name: T = …``：仍声明空对象，避免后续断言 C2065
    colonSk: int = _findOutsideQuotes(s, ":")
    eqSk: int = _findOutsideQuotes(s, "=")
    if colonSk > 0 and eqSk > colonSk:
      nmSk: str = s[:colonSk].strip()
      midSk: str = s[colonSk + 1 : eqSk].strip()
      if _isIdent(nmSk) and midSk != "" and " " not in nmSk:
        tySk: str = _cppType(midSk, st)
        if tySk != "":
          wasSk: bool = _localKnown(st, nmSk)
          _localRememberTy(st, nmSk, tySk)
          if wasSk == False:
            out = out + "  " + tySk + " " + _escapeCppIdent(nmSk) + "{};\n"
    # 压扁失败的 ``for k in`` 残留（``forkinkeys``）勿落 C++
    if s.find("forkin") >= 0 or s.find("forx") >= 0:
      out = out + _softSkipLine(s)
      i += 1
      continue
    out = out + _softSkipLine(s)
    i += 1
    if len(s) > 0 and s[len(s) - 1] == ":" and i < len(lines):
      bodyIndS: int = _lineIndent(lines[i])
      if bodyIndS > ind:
        while i < len(lines) and _lineIndent(lines[i]) >= bodyIndS:
          i += 1
    continue
  return out

def _dedentBodySource(bodySource: str) -> str:
  """整段 ``.strip()`` 会打乱首行相对缩进（``try``/``except`` 错位）；按最小公共缩进剥齐。"""
  raw: str = bodySource.replace("\r\n", "\n")
  linesB: list[str] = raw.split("\n")
  minInd: int = 999999
  liB: int = 0
  while liB < len(linesB):
    lnB: str = linesB[liB]
    if lnB.strip() != "":
      indB: int = _lineIndent(lnB)
      if indB < minInd:
        minInd = indB
    liB += 1
  if minInd <= 0 or minInd >= 999999:
    return raw
  return _dedentBlockLines(linesB, minInd)

def _emitBody(
  bodySource: str, ret: str, st: EnumEmitState, paramsSource: str,
  selfTy: str
) -> str:
  # 每个函数体重置局部声明跟踪（``auto`` vs 纯赋值）。
  while len(st.localNames) > 0:
    st.localNames.pop()
  while len(st.localCppTypes) > 0:
    st.localCppTypes.pop()
  while len(st.opaqueStubNames) > 0:
    st.opaqueStubNames.pop()
  st.flowSerSkip = False
  _clearUntypedParams(st)
  preDesc: str = ""
  if paramsSource != "":
    _rememberParamsFromSource(st, paramsSource, selfTy)
    _rememberUntypedParams(st, paramsSource)
    if "@" in paramsSource:
      preDesc = _emitParamDescPreamble(paramsSource)
  b: str = _dedentBodySource(bodySource)
  if b == "" or b == "pass" or b == "...":
    if ret == "void":
      return preDesc
    if ret == "bool":
      return preDesc + "  return false;\n"
    return preDesc + "  return " + ret + "{};\n"
  if len(b) >= 6 and b[:6] == "return":
    emitted: str = _emitReturnExpr(b[6:], ret, st)
    if emitted != "":
      return preDesc + emitted
  if "=" in b and b.find(":") < 0:
    alOne: str = _emitAssignLine(b, st)
    if alOne != "":
      return preDesc + alOne
  # Prefer indent-aware multi-stmt (makeSpan / check / formatDiagnostic).
  seq: str = _emitStmtSeq(b, ret, st)
  if seq != "":
    # 生成器：``__ys`` 缓冲 + ``makeGenerator`` / ``makeAsyncGenerator`` 装箱
    if _isGeneratorRetCpp(ret):
      yTyG: str = _generatorYieldTy(ret)
      sTyG: str = _generatorSendTy(ret)
      rTyG: str = _generatorReturnTy(ret)
      # 去掉误追加的 ``return PyGenerator{}``
      seqG: str = seq
      if seqG.find("return " + ret + "{}") >= 0:
        seqG = seqG.replace("  return " + ret + "{};\n", "")
      # send 型：``received = yield`` 急切 while 会死循环 → 专用 echo 生成器
      if sTyG != "PyNone" and sTyG != "":
        if seqG.find("received") >= 0:
          return (
            preDesc
            + "  return makeGenerator<"
            + yTyG
            + ", "
            + sTyG
            + ", "
            + rTyG
            + ">(py2cpp_echo_int_generator{});\n"
          )
      preG: str = (
        "  PyList<"
        + yTyG
        + ", 0> __ys{};\n"
        + "  "
        + rTyG
        + " __ret{};\n"
      )
      postG: str = ""
      if _isAsyncGeneratorRetCpp(ret):
        postG = (
          "  return makeAsyncGenerator<"
          + yTyG
          + ", "
          + sTyG
          + ">(py2cpp_list_async_generator<"
          + yTyG
          + ", "
          + sTyG
          + ">(__ys));\n"
        )
      else:
        postG = (
          "  return makeGenerator<"
          + yTyG
          + ", "
          + sTyG
          + ", "
          + rTyG
          + ">(py2cpp_list_generator<"
          + yTyG
          + ", "
          + rTyG
          + ">(__ys, __ret));\n"
        )
      return preDesc + preG + seqG + postG
    # soft-skip match 等可能无 ``return`` → MSVC C4716（勿重复追加）
    hasRet: bool = False
    if seq.find("return ") >= 0:
      hasRet = True
    if ret != "void" and hasRet == False:
      if ret == "bool":
        return preDesc + seq + "  return false;\n"
      return preDesc + seq + "  return " + ret + "{};\n"
    return preDesc + seq
  # Legacy: ``if <attr>: return … / return …`` without relying on indent.
  if len(b) >= 3 and b[:3] == "if ":
    colon: int = b.find(":")
    if colon > 3:
      cond: str = b[3:colon].strip()
      restBody: str = b[colon + 1 :].strip()
      condCpp: str = _emitSimpleTerm(cond, st)
      firstRet: int = restBody.find("return")
      if condCpp != "" and firstRet >= 0:
        afterFirst: str = restBody[firstRet + 6 :]
        second: int = _findElseReturn(afterFirst)
        if second >= 0:
          thenExpr2: str = afterFirst[:second].strip()
          elseExpr: str = afterFirst[second + 6 :].strip()
          thenCpp2: str = _emitReturnExpr(thenExpr2, ret, st)
          elseCpp: str = _emitReturnExpr(elseExpr, ret, st)
          if thenCpp2 != "" and elseCpp != "":
            # Split brace/newline lits — thin plus-expr once mishandled ``") {\n"``.
            return (
              "  if ("
              + condCpp
              + ") "
              + "{"
              + "\n  "
              + thenCpp2
              + "  }\n  "
              + elseCpp
            )
        else:
          thenCpp: str = _emitReturnExpr(afterFirst.strip(), ret, st)
          if thenCpp != "":
            headIf: str = "  if (" + condCpp + ") " + "{" + "\n  " + thenCpp + "  }\n"
            if ret == "void":
              return headIf
            if ret == "bool":
              return headIf + "  return false;\n"
            return headIf + "  return " + ret + "{};\n"
  if ret == "void":
    return "  // body omitted\n"
  if ret == "bool":
    return "  // body omitted\n  return false;\n"
  return "  // body omitted\n  return " + ret + "{};\n"

def _appendIncludeStem(seen: list[str], out: str, rel: str) -> str:
  if rel == "":
    return out
  found: bool = False
  k2: int = 0
  while k2 < len(seen):
    if seen[k2] == rel:
      found = True
      break
    k2 += 1
  if found:
    return out
  seen.append(rel)
  return out + "#include \"" + rel + ".h\"\n"

def _emitRelativeIncludes(mod: SyntaxModule, modulePath: str) -> str:
  out: str = ""
  seen: list[str] = []
  _ = modulePath
  # 同时扫 imports 表与 Import items（防表空 / ``not in`` 对 list 不可靠）
  i: int = 0
  while i < len(mod.imports):
    srcI: str = mod.imports[i]
    rel: str = _importRelPath(srcI)
    if rel != "":
      out = _appendIncludeStem(seen, out, rel)
    else:
      absRels: list[str] = _absImportIncludes(srcI, modulePath)
      ai: int = 0
      while ai < len(absRels):
        out = _appendIncludeStem(seen, out, absRels[ai])
        ai += 1
    i += 1
  j: int = 0
  while j < len(mod.items):
    it: ModuleItem = mod.items[j]
    if it.kind == ItemKindEnum.Import:
      srcJ: str = it.opaqueSource
      rel2: str = _importRelPath(srcJ)
      if rel2 != "":
        out = _appendIncludeStem(seen, out, rel2)
      else:
        absRels2: list[str] = _absImportIncludes(srcJ, modulePath)
        aj: int = 0
        while aj < len(absRels2):
          out = _appendIncludeStem(seen, out, absRels2[aj])
          aj += 1
    j += 1
  return out

def emitFunctionDecl(fn: FunctionBundle, st: EnumEmitState) -> str:
  ret: str = _emitFnRetCpp(fn, st)
  params: str = _cppParams(fn.paramsSource, True, "", st)
  tpl: str = _fnTemplatePrefix(fn.paramsSource)
  return tpl + ret + " " + fn.name + "(" + params + ");\n"

def _countCppParams(params: str) -> int:
  if params.strip() == "":
    return 0
  return len(_splitParams(params))

def _firstCppParamTypeName(params: str) -> list[str]:
  """``PyAsyncTcpSocket& listener`` → ``[PyAsyncTcpSocket, listener, ref]``；``PyInt n`` → ``[..., val]``。"""
  out2: list[str] = []
  parts: list[str] = _splitParams(params)
  if len(parts) >= 1:
    p0: str = parts[0].strip()
    amp: int = p0.rfind("&")
    if amp >= 0:
      tyR: str = p0[:amp].strip()
      nmR: str = p0[amp + 1 :].strip()
      if tyR != "" and nmR != "" and _isIdent(nmR):
        out2.append(tyR)
        out2.append(nmR)
        out2.append("ref")
    else:
      # ``PyInt n`` 按值
      spV: int = p0.rfind(" ")
      if spV > 0:
        tyV: str = p0[:spV].strip()
        nmV: str = p0[spV + 1 :].strip()
        if tyV != "" and nmV != "" and _isIdent(nmV):
          out2.append(tyV)
          out2.append(nmV)
          out2.append("val")
  return out2

def _emitAsyncThunkFunction(
  fn: FunctionBundle, ret: str, params: str, tpl: str, st: EnumEmitState, qualName: str
) -> str:
  """async 非 gen → static body + 懒协程包装；不适用返回空串。``qualName`` 如 ``foo`` 或 ``stem::foo``。"""
  if fn.isAsync == False:
    return ""
  if _isCoroutineRetCpp(ret) == False:
    return ""
  if _isAsyncGeneratorRetCpp(ret):
    return ""
  rtBody: str = _coroutineReturnTy(ret)
  nP: int = _countCppParams(params)
  tn: list[str] = []
  canThunk: bool = False
  if nP == 0:
    canThunk = True
  if nP == 1:
    tn = _firstCppParamTypeName(params)
    if len(tn) == 3:
      canThunk = True
  if canThunk == False:
    return ""
  helper: str = fn.name + "__thin_body"
  # 按值单参 helper 改为 T&，对齐 makeThunkCoroutine1Val 的 fn(A0&)
  hp: str = params
  useRefThunk: bool = True
  if nP == 1:
    if len(tn) == 3:
      kindT: str = tn[2]
      if kindT == "val":
        hp = tn[0] + "& " + tn[1]
        useRefThunk = False
  outT: str = tpl
  outT = outT + "static " + rtBody + " " + helper + "(" + hp + ") "
  outT = outT + "{"
  outT = outT + "\n"
  outT = outT + _emitBody(fn.bodySource, rtBody, st, fn.paramsSource, "")
  outT = outT + "}"
  outT = outT + "\n"
  outT = outT + ret + " " + qualName + "(" + params + ") "
  outT = outT + "{"
  outT = outT + "\n"
  if nP == 0:
    outT = outT + "  return makeThunkCoroutine0<" + rtBody + ">(&" + helper + ");\n"
  else:
    if useRefThunk:
      outT = (
        outT
        + "  return makeThunkCoroutine1Ref<"
        + rtBody
        + ", "
        + tn[0]
        + ">(&"
        + helper
        + ", "
        + tn[1]
        + ");\n"
      )
    else:
      outT = (
        outT
        + "  return makeThunkCoroutine1Val<"
        + rtBody
        + ", "
        + tn[0]
        + ">(&"
        + helper
        + ", "
        + tn[1]
        + ");\n"
      )
  outT = outT + "}"
  outT = outT + "\n"
  return outT

def emitFunctionDef(fn: FunctionBundle, st: EnumEmitState) -> str:
  ret: str = _emitFnRetCpp(fn, st)
  params: str = _cppParams(fn.paramsSource, False, "", st)
  # Avoid single lit ``") {\n"`` (thin plus-expr historically soft-skipped it).
  tpl: str = _fnTemplatePrefix(fn.paramsSource)
  thunk: str = _emitAsyncThunkFunction(fn, ret, params, tpl, st, fn.name)
  if thunk != "":
    return thunk
  out: str = tpl
  out = out + ret + " " + fn.name + "(" + params + ") "
  out = out + "{"
  out = out + "\n"
  out = out + _emitBody(fn.bodySource, ret, st, fn.paramsSource, "")
  out = out + "}"
  out = out + "\n"
  return out


def _paramCppTypeLookup(paramsSource: str, name: str, st: EnumEmitState) -> str:
  """从 ``self, lo: int, hi: int`` 查形参 C++ 类型。"""
  if name == "" or paramsSource == "":
    return ""
  partsP: list[str] = _splitParams(paramsSource)
  piP: int = 0
  while piP < len(partsP):
    pP: str = partsP[piP].strip()
    if pP == "" or pP == "self":
      piP += 1
      continue
    colonP: int = pP.find(":")
    if colonP < 0:
      piP += 1
      continue
    nmP: str = pP[:colonP].strip()
    if nmP != name:
      piP += 1
      continue
    restP: str = pP[colonP + 1 :].strip()
    eqP: int = restP.find("=")
    tySrcP: str = restP
    if eqP >= 0:
      tySrcP = restP[:eqP].strip()
    if tySrcP != "":
      return _cppType(_stripFieldTypeDecorators(tySrcP), st)
    piP += 1
  return ""

def _appendInitAnnSelfFields(
  cls: ClassBundle, instTys: list[str], instNms: list[str], instDefs: list[str],
  st: EnumEmitState
) -> str:
  """``__init__`` 内 ``self.x: T = …`` / ``self.x = …`` → 字段；扫描 ``__value__``。"""
  out: str = ""
  seen: list[str] = []
  fi0: int = 0
  while fi0 < len(cls.constFields):
    seen.append(cls.constFields[fi0].name)
    fi0 += 1
  si0: int = 0
  while si0 < len(instNms):
    seen.append(instNms[si0])
    si0 += 1
  needValue: bool = False
  # ``property value:`` 体内 ``self.__value__`` 已映射 ``value__value``，勿再造裸 ``__value__``
  propsForVal: list[str] = _classPropertyNames(cls)
  mi0: int = 0
  while mi0 < len(cls.methods):
    fn0: FunctionBundle = cls.methods[mi0]
    bodyAll: str = fn0.bodySource
    if "__value__" in bodyAll:
      isPropAcc: bool = False
      if fn0.name == "__get__" or fn0.name == "__set__" or fn0.name == "__post_set__":
        isPropAcc = True
      if isPropAcc and len(propsForVal) > 0:
        pass
      else:
        needValue = True
    if fn0.name == "__init__":
      initParams: str = fn0.paramsSource
      lines0: list[str] = fn0.bodySource.split("\n")
      li0: int = 0
      while li0 < len(lines0):
        s0: str = lines0[li0].strip()
        if len(s0) >= 5 and s0[:5] == "self.":
          rest0: str = s0[5:]
          c0: int = rest0.find(":")
          e0: int = rest0.find("=")
          if c0 > 0 and e0 > c0:
            nm0: str = rest0[:c0].strip()
            ty0src: str = rest0[c0 + 1 : e0].strip()
            if _isIdent(nm0) and ty0src != "":
              if not _nameInList(seen, nm0):
                seen.append(nm0)
                ty0: str = _cppType(ty0src, st)
                out = out + "  " + ty0 + " " + nm0 + "{};\n"
                instTys.append(ty0)
                instNms.append(nm0)
                instDefs.append("")
          elif e0 > 0 and (c0 < 0 or c0 > e0):
            # ``self._lo = lo``（无注解）：类型取自同名形参，否则 PyInt
            nm1: str = rest0[:e0].strip()
            rhs1: str = rest0[e0 + 1 :].strip()
            if _isIdent(nm1):
              if not _nameInList(seen, nm1):
                seen.append(nm1)
                ty1: str = ""
                if _isIdent(rhs1):
                  ty1 = _paramCppTypeLookup(initParams, rhs1, st)
                if ty1 == "":
                  ty1 = "PyInt"
                out = out + "  " + ty1 + " " + nm1 + "{};\n"
                instTys.append(ty1)
                instNms.append(nm1)
                instDefs.append("")
        li0 += 1
    mi0 += 1
  if needValue:
    if not _nameInList(seen, "__value__"):
      seen.append("__value__")
      out = out + "  PyInt __value__{};\n"
      instTys.append("PyInt")
      instNms.append("__value__")
      instDefs.append("")
  return out

def _classHasTypeIf(cls: ClassBundle) -> bool:
  # 类体首为 if T is X:（bodySource；勿用 split()[0] 以免薄 emit soft-skip）
  b: str = cls.bodySource.lstrip()
  if len(b) < 6:
    return False
  if b[:3] != "if ":
    return False
  nlH: int = b.find("\n")
  head: str = b
  if nlH > 0:
    head = b[:nlH]
  head = head.strip()
  if head.find(" is ") < 0:
    return False
  if head[len(head) - 1] != ":":
    return False
  return True

def _dedentBlockLines(lines: list[str], baseInd: int) -> str:
  outL: list[str] = []
  li: int = 0
  while li < len(lines):
    ln: str = lines[li]
    if _lineIndent(ln) >= baseInd:
      outL.append(ln[baseInd :])
    else:
      outL.append(ln.lstrip())
    li += 1
  return "\n".join(outL)

def _collectIndentedBlock(lines: list[str], start: int, parentInd: int) -> str:
  # 打包 body + mark + next_i；遇 type-if 分支头（elif/else/if T is）即停
  mark: str = "\n###NEXT###\n"
  if start >= len(lines):
    return mark + str(start)
  blockInd: int = _lineIndent(lines[start])
  if blockInd <= parentInd:
    # 仍可能因缩进异常；改走内容扫描
    blockInd = parentInd + 1
  chunk: list[str] = []
  i: int = start
  while i < len(lines):
    hs: str = lines[i].strip()
    stopBr: bool = False
    if hs == "else:":
      stopBr = True
    if len(hs) >= 5 and hs[:5] == "elif " and hs[len(hs) - 1] == ":":
      stopBr = True
    if len(hs) >= 3 and hs[:3] == "if " and hs.find(" is ") > 0 and hs[len(hs) - 1] == ":":
      stopBr = True
    if stopBr:
      break
    if lines[i].strip() != "" and _lineIndent(lines[i]) < blockInd:
      # 回到类体同级非分支成员 → 结束
      if _lineIndent(lines[i]) <= parentInd:
        break
    chunk.append(lines[i])
    i += 1
  if len(chunk) == 0:
    return mark + str(i)
  return _dedentBlockLines(chunk, _lineIndent(chunk[0])) + mark + str(i)

def _parseClassTypeIfBranches(body: str) -> str:
  # 打包 tparam / --- pat @@@ body / === tail
  lines: list[str] = body.replace("\r\n", "\n").split("\n")
  pack: str = ""
  tparam: str = ""
  i: int = 0
  while i < len(lines) and lines[i].strip() == "":
    i += 1
  if i >= len(lines):
    emptyPack: str = "\n#BR#\n#TL#\n"
    return emptyPack
  baseInd: int = _lineIndent(lines[i])
  while i < len(lines):
    # 跳过空行；勿因 indent>baseInd 提前结束（防 next_i 落在分支体内时丢 elif）
    if lines[i].strip() == "":
      i += 1
      continue
    if _lineIndent(lines[i]) < baseInd:
      break
    h: str = lines[i].strip()
    isIf: bool = False
    if len(h) >= 3 and h[:3] == "if " and h[len(h) - 1] == ":":
      isIf = True
    isElif: bool = False
    if len(h) >= 5 and h[:5] == "elif " and h[len(h) - 1] == ":":
      isElif = True
    isElse: bool = False
    if h == "else:":
      isElse = True
    # 内容识别分支头：允许缩进异常时仍吃到 elif/else
    if isIf == False:
      if isElif == False:
        if isElse == False:
          # 若当前行像分支头但缩进更深，仍尝试（已在上方 strip 判断）
          break
    headInd: int = _lineIndent(lines[i])
    pat: str = ""
    if isElse:
      pat = ""
    else:
      midH: str = h
      if isIf:
        midH = h[3 : len(h) - 1].strip()
      else:
        midH = h[5 : len(h) - 1].strip()
      isPos: int = midH.find(" is ")
      if isPos > 0:
        leftP: str = midH[:isPos].strip()
        rightP: str = midH[isPos + 4 :].strip()
        if tparam == "":
          tparam = leftP
        pat = rightP
    i += 1
    # 用分支头自身缩进作 parent，避免 baseInd 与头缩进不一致
    blkPack: str = _collectIndentedBlock(lines, i, headInd)
    markN: str = "\n###NEXT###\n"
    mkPos: int = blkPack.find(markN)
    brBody: str = ""
    if mkPos >= 0:
      brBody = blkPack[:mkPos]
      i = _parseDecInt(blkPack[mkPos + len(markN) :])
    else:
      brBody = blkPack
    pack = pack + "#BR#\n" + pat + "\n#BD#\n" + brBody + "\n"
    if isElse:
      break
  tailLines: list[str] = []
  while i < len(lines):
    tailLines.append(lines[i])
    i += 1
  tail: str = ""
  t0: int = 0
  while t0 < len(tailLines) and tailLines[t0].strip() == "":
    t0 += 1
  if t0 < len(tailLines):
    tInd: int = _lineIndent(tailLines[t0])
    tail = _dedentBlockLines(tailLines, tInd)
  return tparam + "\n" + pack + "#TL#\n" + tail

def _digitVal(ch: str) -> int:
  if ch == "0":
    return 0
  if ch == "1":
    return 1
  if ch == "2":
    return 2
  if ch == "3":
    return 3
  if ch == "4":
    return 4
  if ch == "5":
    return 5
  if ch == "6":
    return 6
  if ch == "7":
    return 7
  if ch == "8":
    return 8
  if ch == "9":
    return 9
  return -1

def _parseDecInt(s: str) -> int:
  n: int = 0
  i: int = 0
  while i < len(s):
    d: int = _digitVal(s[i : i + 1])
    if d >= 0:
      n = n * 10 + d
    i += 1
  return n

def _typeIfAliasPack(branchBody: str, st: EnumEmitState) -> str:
  pack: str = ""
  bl: list[str] = branchBody.split("\n")
  bi: int = 0
  while bi < len(bl):
    s: str = bl[bi].strip()
    if len(s) >= 5 and s[:5] == "type " and "=" in s:
      rest: str = s[5:].strip()
      eqA: int = rest.find("=")
      if eqA > 0:
        an: str = rest[:eqA].strip()
        ar: str = rest[eqA + 1 :].strip()
        if _isIdent(an) and ar != "":
          pack = pack + an + "=" + _cppType(ar, st) + "\n"
    bi += 1
  return pack

def _aliasLookupPack(pack: str, name: str) -> str:
  lines: list[str] = pack.split("\n")
  ai: int = 0
  while ai < len(lines):
    ln: str = lines[ai].strip()
    eq: int = ln.find("=")
    if eq > 0 and ln[:eq] == name:
      return ln[eq + 1 :]
    ai += 1
  return ""

def _typeIfResolveTy(src: str, pack: str, st: EnumEmitState) -> str:
  s: str = src.strip()
  al: str = _aliasLookupPack(pack, s)
  if al != "":
    return al
  return _cppType(s, st)

def _typeIfFieldDefault(ty: str, rhs: str, st: EnumEmitState) -> str:
  r: str = rhs.strip()
  if r == "" or r == "new()" or r == "None" or r == "none":
    return " = " + ty + "{}"
  if r == "0" or r == "0.0" or _isIntLit(r) or _isFloatLit(r):
    return " = " + r
  if r == "True":
    return " = true"
  if r == "False":
    return " = false"
  if (len(r) >= 2 and r[0] == '"' and r[len(r) - 1] == '"') or (
    len(r) >= 2 and r[0] == "'" and r[len(r) - 1] == "'"
  ):
    return " = PyStr(" + r + ")"
  if len(r) >= 4 and r[:4] == "new(":
    return " = " + ty + "{}"
  term: str = _emitSimpleTerm(r, st)
  if term != "":
    return " = " + term
  return " = " + ty + "{}"

def _typeIfExtractMembers(body: str, pack: str, st: EnumEmitState) -> str:
  outM: str = ""
  lines: list[str] = body.replace("\r\n", "\n").split("\n")
  i: int = 0
  while i < len(lines):
    if lines[i].strip() == "":
      i += 1
      continue
    ind0: int = _lineIndent(lines[i])
    s: str = lines[i].strip()
    if len(s) >= 5 and s[:5] == "type " and "=" in s:
      rest: str = s[5:].strip()
      eqA: int = rest.find("=")
      if eqA > 0:
        an: str = rest[:eqA].strip()
        ar: str = rest[eqA + 1 :].strip()
        if _isIdent(an):
          outM = outM + "  using " + an + " = " + _cppType(ar, st) + ";\n"
      i += 1
      continue
    # ``static def name(...) -> R:`` / ``def name(...)``
    isStatic: bool = False
    defHead: str = s
    if len(s) >= 11 and s[:11] == "static def ":
      isStatic = True
      defHead = "def " + s[11:]
    if len(defHead) >= 4 and defHead[:4] == "def " and "(" in defHead:
      i += 1
      mchunk: list[str] = []
      while i < len(lines) and (
        lines[i].strip() == "" or _lineIndent(lines[i]) > ind0
      ):
        mchunk.append(lines[i])
        i += 1
      sig: str = defHead[4:]
      if sig[len(sig) - 1] == ":":
        sig = sig[: len(sig) - 1].strip()
      lp: int = sig.find("(")
      rp: int = sig.rfind(")")
      if lp > 0 and rp > lp:
        mname: str = sig[:lp].strip()
        params: str = sig[lp + 1 : rp].strip()
        retSrc: str = "void"
        arrow: int = sig.find("->", rp)
        if arrow > 0:
          retSrc = sig[arrow + 2 :].strip()
        retCpp: str = _typeIfResolveTy(retSrc, pack, st)
        if retSrc == "None" or retSrc == "":
          retCpp = "void"
        paramsCpp: str = _cppParams(params, True, "", st)
        # 别名 ``V`` → ``PyV`` 再换成具体类型
        plines: list[str] = pack.split("\n")
        piA: int = 0
        while piA < len(plines):
          pln: str = plines[piA].strip()
          peq: int = pln.find("=")
          if peq > 0:
            pan: str = pln[:peq]
            pcpp: str = pln[peq + 1 :]
            paramsCpp = paramsCpp.replace("Py" + pan + "&", pcpp + "&")
            paramsCpp = paramsCpp.replace("Py" + pan + " ", pcpp + " ")
          piA += 1
        # 标量别名勿留引用（``write(x: V)`` → ``PyInt x`` 非 ``PyInt&``）
        paramsCpp = paramsCpp.replace("PyInt& ", "PyInt ")
        paramsCpp = paramsCpp.replace("PyFloat64& ", "PyFloat64 ")
        paramsCpp = paramsCpp.replace("PyFloat& ", "PyFloat ")
        paramsCpp = paramsCpp.replace("bool& ", "bool ")
        paramsCpp = paramsCpp.replace("PyChar& ", "PyChar ")
        paramsCpp = paramsCpp.replace("PyByte& ", "PyByte ")
        bodyTxt: str = "pass"
        if len(mchunk) > 0:
          bodyTxt = _dedentBlockLines(mchunk, _lineIndent(mchunk[0]))
        bodyCpp: str = _emitBody(bodyTxt, retCpp, st, params, "")
        stc: str = ""
        if isStatic:
          stc = "static "
        outM = (
          outM
          + "  "
          + stc
          + retCpp
          + " "
          + mname
          + "("
          + paramsCpp
          + ") {\n"
          + bodyCpp
          + "  }\n"
        )
      continue
    # 字段 ``name: T = v`` / ``name: T``
    colon: int = s.find(":")
    if colon > 0 and _isIdent(s[:colon].strip()):
      fnm: str = s[:colon].strip()
      restF: str = s[colon + 1 :].strip()
      eqF: int = restF.find("=")
      tySrcF: str = restF
      rhsF: str = ""
      if eqF >= 0:
        tySrcF = restF[:eqF].strip()
        rhsF = restF[eqF + 1 :].strip()
      atF: int = tySrcF.find("@")
      if atF > 0:
        tySrcF = tySrcF[:atF].strip()
      tyF: str = _typeIfResolveTy(tySrcF, pack, st)
      defa: str = _typeIfFieldDefault(tyF, rhsF, st)
      outM = outM + "  " + tyF + " " + fnm + defa + ";\n"
      i += 1
      continue
    i += 1
  return outM

def _emitOneClassTypeIfSpec(
  cls: ClassBundle,
  tparam: str,
  patSrc: str,
  branchBody: str,
  tailBody: str,
  st: EnumEmitState,
) -> str:
  merged: str = branchBody
  if tailBody.strip() != "":
    if merged.strip() != "":
      merged = merged + "\n" + tailBody
    else:
      merged = tailBody
  pack: str = _typeIfAliasPack(merged, st)
  members: str = _typeIfExtractMembers(merged, pack, st)
  out: str = ""
  cppName: str = "Py" + cls.name
  if patSrc == "":
    out = out + "template<typename " + tparam + ">\n"
    out = out + "class " + cppName + " {\npublic:\n"
  else:
    patCpp: str = _cppType(patSrc, st)
    out = out + "template<>\n"
    out = out + "class " + cppName + "<" + patCpp + "> {\npublic:\n"
  out = out + members
  out = out + "  explicit " + cppName + "() = default;\n"
  out = out + "};\n\n"
  _ = tparam
  return out

def _emitClassTypeIf(cls: ClassBundle, mod: SyntaxModule, st: EnumEmitState) -> str:
  blob: str = _parseClassTypeIfBranches(cls.bodySource)
  nl0: int = blob.find("\n")
  if nl0 < 0:
    return ""
  tparam: str = blob[:nl0]
  restB: str = blob[nl0 + 1 :]
  sepT: int = restB.find("#TL#\n")
  if sepT < 0:
    return ""
  packB: str = restB[:sepT]
  tail: str = restB[sepT + 5 :]
  if tparam == "":
    return ""
  if packB.find("#BR#\n") < 0:
    return ""
  cppName: str = "Py" + cls.name
  out: str = "template<typename " + tparam + ">\nclass " + cppName + ";\n\n"
  elseBody: str = ""
  hasElse: bool = False
  # 逐段 #BR#\npat\n#BD#\nbody\n
  posB: int = 0
  while posB < len(packB):
    if packB[posB : posB + 5] != "#BR#\n":
      break
    posB += 5
    atB: int = packB.find("\n#BD#\n", posB)
    if atB < 0:
      break
    pat: str = packB[posB:atB]
    posB = atB + 6
    nextSep: int = packB.find("\n#BR#\n", posB)
    br: str = ""
    if nextSep < 0:
      br = packB[posB:]
      if len(br) > 0 and br[len(br) - 1] == "\n":
        br = br[: len(br) - 1]
      posB = len(packB)
    else:
      br = packB[posB:nextSep]
      posB = nextSep + 1
    if pat == "":
      elseBody = br
      hasElse = True
    else:
      out = out + _emitOneClassTypeIfSpec(cls, tparam, pat, br, tail, st)
  if hasElse:
    out = out + _emitOneClassTypeIfSpec(cls, tparam, "", elseBody, tail, st)
  else:
    out = out + "template<typename " + tparam + ">\nclass " + cppName + " {\npublic:\n"
    out = out + "  explicit " + cppName + "() = default;\n};\n\n"
  _ = mod
  return out

def emitClass(cls: ClassBundle, mod: SyntaxModule, st: EnumEmitState) -> str:
  if _classHasTypeIf(cls):
    cif: str = _emitClassTypeIf(cls, mod, st)
    if cif != "":
      return cif
  if cls.isUnion:
    vNamesE: list[str] = []
    vFieldsE: list[str] = []
    vTypesE: list[str] = []
    _resolveUnionVariants(cls, mod, vNamesE, vFieldsE, vTypesE)
    if len(vNamesE) > 0:
      return _emitUnionClassHeader(cls, st, vNamesE, vFieldsE, vTypesE, mod)
  isHost: bool = _isTestCaseHost(cls)
  # Proxy[Element] / ``Box(ContainerType[Element])``：登记模板形参后再解析基类类型
  while len(st.typeParamNames) > 0:
    st.typeParamNames.pop()
  tplsEm: list[str] = _inferClassTplParams(mod, cls)
  if len(tplsEm) == 0:
    tplsEm = _collectTplNamesFromBases(cls.basesSource)
  tiEm: int = 0
  while tiEm < len(tplsEm):
    st.typeParamNames.append(tplsEm[tiEm])
    tiEm += 1
  out: str = _classTplPrefixFor(mod, cls)
  if out == "":
    out = _classTplPrefix(cls)
  out = out + "class Py" + cls.name
  out = out + _classInheritanceClause(cls, mod, st)
  out = out + " {\npublic:\n"
  # ``friends=(VaultReader,)`` → ``friend class PyVaultReader;``
  frNms: list[str] = _friendNamesFromBases(cls.basesSource)
  fiF: int = 0
  while fiF < len(frNms):
    out = out + "  friend class Py" + frNms[fiF] + ";\n"
    fiF += 1
  if isHost:
    out = out + "  using __base__ = PyTestCase;\n"
  else:
    # 仅有基类时写 ``__base__``（无基类勿写 void，以免干扰既有测例）
    baseNmsU: list[str] = _splitBaseNames(cls.basesSource)
    if len(baseNmsU) > 0:
      b0u: str = baseNmsU[0].strip()
      if b0u != "" and b0u != "object":
        carriedU: str = _mixinCarriedBase(b0u)
        if carriedU != "":
          b0u = carriedU
        # Mixin 已擦除，勿发未定义空壳基类
        elif _isErasedMixinBase(b0u):
          b0u = ""
        useBaseAlias: bool = False
        if _isIdent(b0u):
          useBaseAlias = True
        if b0u.find("[") > 0:
          useBaseAlias = True
        if useBaseAlias:
          out = out + "  using __base__ = " + _cppType(b0u, st) + ";\n"
  constNms: list[str] = _constNamesFromBody(cls.bodySource)
  # 实例字段（非 const）供 record/dataclass 构造
  instTys: list[str] = []
  instNms: list[str] = []
  instDefs: list[str] = []
  # 字段描述符：``name: T @Desc(...) = d`` → 存储 ``name__value`` + get/set
  descAttrPending: list[str] = []
  descCallPending: list[str] = []
  fi: int = 0
  while fi < len(cls.constFields):
    cf: ConstField = cls.constFields[fi]
    tySrcF: str = cf.typeName.strip()
    # 字段注解 ``Self`` / ``list[Self]`` → 当前类
    if tySrcF == "Self":
      tySrcF = cls.name
    elif tySrcF.find("Self") >= 0:
      tySrcF = tySrcF.replace("[Self]", "[" + cls.name + "]")
      tySrcF = tySrcF.replace("Self,", cls.name + ",")
      tySrcF = tySrcF.replace(", Self", ", " + cls.name)
      tySrcF = tySrcF.replace(",Self", "," + cls.name)
    tySrcF = _stripFieldTypeDecorators(tySrcF)
    ty: str = _cppType(tySrcF, st) if tySrcF != "" else "PyInt"
    # 体行权威：``@OptArgMeta(short=\"-m\") = \"dev\"`` 时 valueSource/首个 ``=`` 易吃到 short。
    vsRaw: str = _recordDefaultFromBody(cls.bodySource, cf.name)
    if vsRaw == "":
      vsRaw = _depth0AssignRhs(cf.valueSource.strip())
    if vsRaw == "":
      vsRaw = cf.valueSource.strip()
    # ``value: int @ thread_local = 0`` → ``static thread_local``（非实例字段）
    lineTlsF: str = _fieldBodyLine(cls.bodySource, cf.name)
    if _lineHasThreadLocal(lineTlsF):
      out = out + "  static thread_local " + ty + " " + cf.name + ";\n"
      fi += 1
      continue
    # 字段描述符注解（体行）
    descCallF: str = ""
    linesFd: list[str] = cls.bodySource.split("\n")
    liFd: int = 0
    while liFd < len(linesFd):
      sFd: str = linesFd[liFd].strip()
      prefFd: str = cf.name + ":"
      if len(sFd) >= len(prefFd) and sFd[: len(prefFd)] == prefFd:
        descCallF = _fieldDescAnnot(sFd)
        break
      liFd += 1
    # 仅非占位 ``__get__``（如 Offset）内联；Plain/Clamped 的 ``...`` 保持普通字段（已绿）
    expandDescF: bool = False
    if descCallF != "":
      namesEx: list[str] = []
      argsEx: list[str] = []
      if _splitDescCall(descCallF, namesEx, argsEx):
        dclsEx: ClassBundle = _findClassByName(mod, namesEx[0])
        getEx: FunctionBundle = _findDescMethod(dclsEx, "__get__")
        if getEx.name != "":
          gbEx: str = getEx.bodySource.strip()
          if gbEx != "" and gbEx != "..." and gbEx != "pass":
            expandDescF = True
    if expandDescF:
      storNm: str = cf.name + "__value"
      defaD: str = _fieldDefault(ty, vsRaw, st)
      out = out + "  " + ty + " " + storNm
      if defaD != "":
        out = out + defaD
      else:
        out = out + "{}"
      out = out + ";\n"
      out = out + "  " + ty + " " + cf.name + "__get() const;\n"
      out = out + "  void " + cf.name + "__set(" + ty + " value);\n"
      instTys.append(ty)
      instNms.append(storNm)
      instDefs.append(vsRaw)
      if cf.name not in st.userPropNames:
        st.userPropNames.append(cf.name)
      descAttrPending.append(cf.name)
      descCallPending.append(descCallF)
      st.fieldDescHostNames.append(cls.name)
      st.fieldDescAttrNames.append(cf.name)
      st.fieldDescStorageCsv.append(descCallF)
      fi += 1
      continue
    defa: str = _fieldDefault(ty, vsRaw, st)
    isConstF: bool = _nameInList(constNms, cf.name)
    if isConstF and (
      ty == "PyInt" or ty == "bool" or ty == "PyBool" or ty == "PyChar" or ty == "PyByte"
    ):
      # 仅整型可 ``static constexpr``（C++14）；PyStr 等走实例字段避免 C2131
      out = out + "  static constexpr " + ty + " " + cf.name
      if defa != "":
        out = out + defa
      else:
        out = out + "{}"
      out = out + ";\n"
    elif isConstF:
      out = out + "  " + ty + " " + cf.name
      if defa != "":
        out = out + defa
      else:
        out = out + "{}"
      out = out + ";\n"
      instTys.append(ty)
      instNms.append(cf.name)
      instDefs.append(vsRaw)
    else:
      out = out + "  " + ty + " " + cf.name
      if defa != "":
        out = out + defa
      else:
        out = out + "{}"
      out = out + ";\n"
      instTys.append(ty)
      instNms.append(cf.name)
      instDefs.append(vsRaw)
    fi += 1
  # ``__init__`` 内 ``self.x: T =`` 补字段（无 class 体 FieldDecl 时）
  out = out + _appendInitAnnSelfFields(cls, instTys, instNms, instDefs, st)
  # ``static property origin`` → ``static PyPoint origin__value``
  statProps: list[str] = _staticPropertyNames(cls)
  spiH: int = 0
  while spiH < len(statProps):
    out = out + "  static Py" + cls.name + " " + statProps[spiH] + "__value;\n"
    spiH += 1
  # ``_testTag = N`` 无类型注解 → opaqueMembers
  oi: int = 0
  while oi < len(cls.opaqueMembers):
    om: str = cls.opaqueMembers[oi].strip()
    if "_testTag" in om and "=" in om:
      rhs: str = om[om.find("=") + 1 :].strip()
      if _isIntLit(rhs):
        out = out + "  static constexpr PyInt _testTag = " + rhs + ";\n"
    oi += 1
  propsHdr: list[str] = _classPropertyNames(cls)
  # 实例 property 存储字段（``x__value``）；静态已在上方
  piStor: int = 0
  while piStor < len(propsHdr):
    pnStor: str = propsHdr[piStor]
    if not _nameInList(statProps, pnStor):
      if not _nameInList(instNms, pnStor + "__value"):
        out = out + "  PyInt " + pnStor + "__value{};\n"
        instTys.append("PyInt")
        instNms.append(pnStor + "__value")
        instDefs.append("")
    piStor += 1
  propGetHdr: int = 0
  propSetHdr: int = 0
  propPostHdr: int = 0
  mi: int = 0
  hasInit: bool = False
  while mi < len(cls.methods):
    fn: FunctionBundle = cls.methods[mi]
    selfTyC: str = _selfTyCppName(cls, st)
    if fn.name == "__init__":
      hasInit = True
      paramsI: str = _cppParams(fn.paramsSource, True, selfTyC, st)
      out = out + "  explicit Py" + cls.name + "(" + paramsI + ");\n"
    else:
      ret: str = _emitFnRetCpp(fn, st)
      if fn.returnSource.strip() == "Self":
        ret = selfTyC
      params: str = _cppParams(fn.paramsSource, True, selfTyC, st)
      methCpp: str = _methodEmitName(fn, cls, propGetHdr, propSetHdr, propPostHdr)
      propForStatic: str = ""
      if fn.name == "__get__":
        if propGetHdr < len(propsHdr):
          propForStatic = propsHdr[propGetHdr]
        propGetHdr += 1
      if fn.name == "__set__":
        if propSetHdr < len(propsHdr):
          propForStatic = propsHdr[propSetHdr]
        propSetHdr += 1
      if fn.name == "__post_set__":
        if propPostHdr < len(propsHdr):
          propForStatic = propsHdr[propPostHdr]
        propPostHdr += 1
      virt: str = ""
      pure: str = ""
      stc: str = ""
      if fn.isStatic:
        stc = "static "
      elif propForStatic != "" and _nameInList(statProps, propForStatic):
        stc = "static "
      else:
        if fn.isAbstract:
          virt = "virtual "
          pure = " = 0"
        elif fn.isVirtual:
          virt = "virtual "
      ov: str = ""
      # MSVC：``static`` 不能与 ``override`` 同用
      if stc == "":
        if isHost and fn.name == "test":
          ov = " override"
        elif fn.isOverride:
          if _methodDeclaredVirtual(mod, cls, fn.name):
            ov = " override"
      out = out + "  " + stc + virt + ret + " " + methCpp + "(" + params + ")" + ov + pure + ";\n"
    mi += 1
  # 具体类：声明需特化的 mixin 反射方法
  out = out + _reflectMixinMethodDecls(cls, mod, st)
  # 仅 ``__post_set__`` 的 property：合成 get/set 声明
  if _classHasMethod(cls, "__post_set__"):
    if not _classHasMethod(cls, "__get__"):
      synPi: int = 0
      while synPi < len(propsHdr):
        pnSyn: str = propsHdr[synPi]
        if not _nameInList(statProps, pnSyn):
          out = out + "  PyInt " + pnSyn + "__get();\n"
          out = out + "  void " + pnSyn + "__set(PyInt value);\n"
        synPi += 1
  if cls.isRecord and "ArgumentParserMixin" in cls.basesSource:
    selfRec: str = "Py" + cls.name
    out = out + "  static " + selfRec + " parse(const PyList<PyStr, 0>& argv);\n"
    out = out + "  static PyStr helpText;\n"
  # ECSWorldMixin：注入索引池字段与方法（runtime 无空壳基类）
  if _hostHasMixin(cls, "ECSWorldMixin"):
    out = out + "  PyArray<PyInt, 0> _generation{};\n"
    out = out + "  PyArray<PyInt, 0> _alive{};\n"
    out = out + "  PyList<PyInt, 0> _free{};\n"
    out = out + "  PyInt _nextIndex = 0;\n"
    out = out + "  void _postInit();\n"
    out = out + "  bool isAlive(PyECSEntity e) const;\n"
    out = out + "  PyECSEntity _allocEntity();\n"
    out = out + "  void _deallocEntity(PyECSEntity e);\n"
    out = out + "  void destroy(PyECSEntity e);\n"
  # UIPanelMixin / UIFlowMixin：注入面板方法（iterFields 体另薄展开）
  if _hostHasMixin(cls, "UIPanelMixin"):
    out = out + "  paw::ui::layout::PyUIFormLayout _panelForm{};\n"
    out = out + "  bool _panelFormReady = false;\n"
    out = out + "  paw::ui::window::PyUIWindow _panelWin{};\n"
    out = out + "  void drawPanel(paw::ui::window::PyUIWindow& win);\n"
    out = out + "  void panelSyncFromForm();\n"
    out = out + "  void panelSyncToForm();\n"
    out = out + "  paw::ui::window::PyUIWindow createPanel(PyStr title = PyStr(\"\"), PyInt width = -1, PyInt height = -1);\n"
  if _hostHasMixin(cls, "UIFlowMixin"):
    out = out + "  paw::ui::flow::canvas::PyUIFlowCanvas _flowCanvas{};\n"
    out = out + "  paw::ui::flow::shell::PyUIFlowShell _flowShell{};\n"
    out = out + "  paw::ui::flow::catalog::PyFlowNodeCatalog _flowCatalog{};\n"
    out = out + "  bool _flowCatalogReady = false;\n"
    out = out + "  paw::ui::flow::runtime::PyFlowRuntime _flowRuntime{};\n"
    out = out + "  paw::ui::window::PyUIWindow _flowWin{};\n"
    out = out + "  void _ensureFlowCatalog();\n"
    out = out + "  paw::ui::window::PyUIWindow createFlow(PyStr title = PyStr(\"\"), PyInt width = -1, PyInt height = -1);\n"
  # ``__id__`` / ``__class_id__``（enum_mro）；模板类跳过
  if not isHost:
    tplsIdHdr: list[str] = _inferClassTplParams(mod, cls)
    if len(tplsIdHdr) == 0:
      tplsIdHdr = _collectTplNamesFromBases(cls.basesSource)
    if len(tplsIdHdr) == 0:
      out = out + "  static const PyInt __py2cpp_class_id__;\n"
      out = out + "  static PyInt __id____get();\n"
      virtCid: str = ""
      # type enum base / 子类：``of(p)`` 经基类引用须动态 ``__class_id__``
      ieB: int = 0
      while ieB < len(mod.enums):
        if mod.enums[ieB].isTypeEnum:
          bEn: str = _typeEnumBaseName(mod.enums[ieB])
          if bEn == cls.name:
            virtCid = "virtual "
            break
          if bEn != "" and bEn in cls.basesSource:
            virtCid = "virtual "
            break
        ieB += 1
      # type union MRO 子类同样须虚 ``__class_id__``
      if virtCid == "":
        iuB: int = 0
        while iuB < len(mod.classes):
          uCls: ClassBundle = mod.classes[iuB]
          uBase: str = _unionMroBaseName(uCls)
          if uBase != "" and _classInheritsNamed(mod, cls, uBase):
            virtCid = "virtual "
            break
          iuB += 1
      out = out + "  " + virtCid + "PyInt __class_id____get() const;\n"
  if isHost and not _classHasMethod(cls, "run"):
    out = out + "  void run(PyRefCount<PyTestResult> result);\n"
  proxyTplCtor: str = _proxyTplParamFromBases(cls.basesSource)
  # 勿 ``not hasInit and x != ""``（薄 emit 易 soft-skip 成恒真）
  emitProxyCtor: bool = False
  if hasInit == False:
    if len(proxyTplCtor) > 0:
      if _isIdent(proxyTplCtor):
        emitProxyCtor = True
  if emitProxyCtor:
    # ``class Foo[T](Proxy[T])``：转发 ``PyProxy<T>(target)``；字段用类内默认
    out = (
      out
      + "  explicit Py"
      + cls.name
      + "("
      + proxyTplCtor
      + " t) : PyProxy<"
      + proxyTplCtor
      + ">(t) {}\n"
    )
  elif hasInit == False:
    # record/dataclass：按字段生成位置 ctor（带默认值的参数可省略）
    if len(instNms) > 0 and not isHost:
      defParts: list[str] = []
      piD: int = 0
      while piD < len(instNms):
        tyD: str = instTys[piD]
        vsD: str = instDefs[piD]
        dPart: str = ""
        if vsD != "" and vsD != "None" and vsD != "none":
          defD: str = _fieldDefault(tyD, vsD, st)
          if len(defD) >= 3 and defD[:3] == " = ":
            dPart = defD
        defParts.append(dPart)
        piD += 1
      # C2548：一旦出现默认实参，后续必须都有（空默认填 ``= {}``）
      firstDef: int = -1
      fj: int = 0
      while fj < len(defParts):
        if defParts[fj] != "":
          firstDef = fj
          break
        fj += 1
      # 重建 filled（禁 ``defParts[i]=``；``= {}`` 对 explicit PyList 非法 → ``= Ty{}``）
      filled: list[str] = []
      fk: int = 0
      while fk < len(defParts):
        d0: str = defParts[fk]
        if firstDef >= 0 and fk >= firstDef and d0 == "":
          filled.append(" = " + instTys[fk] + "{}")
        else:
          filled.append(d0)
        fk += 1
      paramsC: str = ""
      initsC: str = ""
      piC: int = 0
      while piC < len(instNms):
        tyC: str = instTys[piC]
        nmC: str = instNms[piC]
        if piC > 0:
          paramsC = paramsC + ", "
          initsC = initsC + ", "
        paramsC = paramsC + tyC + " " + nmC + filled[piC]
        initsC = initsC + nmC + "(" + nmC + ")"
        piC += 1
      # 首参即有默认 → 可零参调用，勿再 ``= default``（避免 C2668）
      if firstDef != 0:
        out = out + "  explicit Py" + cls.name + "() = default;\n"
      ctorBody: str = " {}"
      if _classHasPostInit(cls):
        ctorBody = " { __post_init__(); }"
      out = out + "  explicit Py" + cls.name + "(" + paramsC + ") : " + initsC + ctorBody + "\n"
    else:
      out = out + "  explicit Py" + cls.name + "() = default;\n"
  if isHost:
    out = out + "  virtual ~Py" + cls.name + "() = default;\n"
  if cls.isRecord and len(instNms) > 0 and not isHost and not cls.isOrdered:
    selfEq: str = "Py" + cls.name
    eqRec: str = ""
    oiEq: int = 0
    while oiEq < len(instNms):
      nmE: str = instNms[oiEq]
      if _fieldIsOptionalInBody(cls.bodySource, nmE):
        oiEq += 1
        continue
      if eqRec == "":
        eqRec = "a." + nmE + " == b." + nmE
      else:
        eqRec = eqRec + " && a." + nmE + " == b." + nmE
      oiEq += 1
    if eqRec == "":
      eqRec = "true"
    out = out + "  friend bool operator==(" + selfEq + " a, " + selfEq + " b) { return " + eqRec + "; }\n"
    out = out + "  friend bool operator!=(" + selfEq + " a, " + selfEq + " b) { return !(a == b); }\n"
  if cls.isOrdered and len(instNms) > 0 and not isHost:
    selfOrd: str = "Py" + cls.name
    eqOrd: str = ""
    ltOrd: str = ""
    ordNms: list[str] = []
    oiF: int = 0
    while oiF < len(instNms):
      if not _fieldIsOptionalInBody(cls.bodySource, instNms[oiF]):
        ordNms.append(instNms[oiF])
      oiF += 1
    oiOrd: int = 0
    while oiOrd < len(ordNms):
      nmO: str = ordNms[oiOrd]
      if eqOrd == "":
        eqOrd = "a." + nmO + " == b." + nmO
        ltOrd = "a." + nmO + " != b." + nmO + " ? (a." + nmO + " < b." + nmO + ")"
      else:
        eqOrd = eqOrd + " && a." + nmO + " == b." + nmO
        ltOrd = (
          ltOrd
          + " : (a."
          + nmO
          + " != b."
          + nmO
          + " ? (a."
          + nmO
          + " < b."
          + nmO
          + ")"
        )
      oiOrd += 1
    if eqOrd == "":
      eqOrd = "true"
      ltOrd = "false"
    else:
      ltOrd = ltOrd + " : false"
      closeOrd: int = len(ordNms) - 1
      while closeOrd > 0:
        ltOrd = ltOrd + ")"
        closeOrd -= 1
    out = out + "  friend bool operator==(" + selfOrd + " a, " + selfOrd + " b) { return " + eqOrd + "; }\n"
    out = out + "  friend bool operator!=(" + selfOrd + " a, " + selfOrd + " b) { return !(a == b); }\n"
    out = out + "  friend bool operator<(" + selfOrd + " a, " + selfOrd + " b) { return " + ltOrd + "; }\n"
    out = out + "  friend bool operator>(" + selfOrd + " a, " + selfOrd + " b) { return b < a; }\n"
    out = out + "  friend bool operator<=(" + selfOrd + " a, " + selfOrd + " b) { return !(b < a); }\n"
    out = out + "  friend bool operator>=(" + selfOrd + " a, " + selfOrd + " b) { return !(a < b); }\n"
  # 默认 ``__repr__`` / ``__str__`` / ``operator PyStr``（``repr(obj)`` / ``str(obj)``）
  if not isHost:
    hasReprM: bool = _classHasMethod(cls, "__repr__")
    hasStrM: bool = _classHasMethod(cls, "__str__")
    if not hasReprM:
      out = out + "  PyStr __repr__() const {\n"
      out = out + "  char __buf[128];\n"
      out = (
        out
        + "  snprintf(__buf, sizeof(__buf), \"<%s.%s object at 0x%llx>\", \"__main__\", \""
        + cls.name
        + "\", (unsigned long long)(size_t)(const void*)(this));\n"
      )
      out = out + "  return PyStr(__buf);\n"
      out = out + "  }\n"
    if not hasStrM:
      out = out + "  PyStr __str__() const { return this->__repr__(); }\n"
    if hasStrM:
      out = out + "  explicit operator PyStr() { return this->__str__(); }\n"
    else:
      out = out + "  explicit operator PyStr() const { return this->__repr__(); }\n"
  if _isSerializableCls(cls):
    if cls.isUnion == False:
      out = out + "  void serialize(::paw::serde::json::PyJsonEncoder& encoder) const;\n"
      out = out + "  static Py" + cls.name + " deserialize(::paw::serde::json::PyJsonDecoder& decoder);\n"
  # AsyncCloseMixin 擦除：注入 ``__aenter__`` / ``__aexit__``（薄同步）
  if "AsyncCloseMixin" in cls.basesSource:
    if not _classHasMethod(cls, "__aenter__"):
      out = out + "  Py" + cls.name + "& __aenter__() { return *this; }\n"
    if not _classHasMethod(cls, "__aexit__"):
      out = out + "  PyNone __aexit__() { this->close(); return PyNone{}; }\n"
  # CloseMixin 擦除
  if "CloseMixin" in cls.basesSource and "AsyncCloseMixin" not in cls.basesSource:
    if not _classHasMethod(cls, "__enter__"):
      out = out + "  Py" + cls.name + "& __enter__() { return *this; }\n"
    if not _classHasMethod(cls, "__exit__"):
      out = out + "  void __exit__() { this->close(); }\n"
  # ServerMixin：注入 ``handleStreams`` 按 ``@RouteGetMeta`` 方法分派
  if "ServerMixin" in cls.basesSource and not _classHasMethod(cls, "handleStreams"):
    out = out + "  void handleStreams(PyStreamReader& reader, PyStreamWriter& writer) {\n"
    out = out + "  PyRequest req = PyRequest::read(reader);\n"
    out = out + "  PyResponse resp = PyResponse::textResponse(PyStr(\"Not Found\"), PyStatusCodeEnum::NotFound);\n"
    miR: int = 0
    while miR < len(cls.methods):
      fnR: FunctionBundle = cls.methods[miR]
      decoR: str = _methodDecoFromBody(cls.bodySource, fnR.name)
      if decoR.find("RouteGetMeta") >= 0:
        pathR: str = ""
        lpR: int = decoR.find("(")
        rpR: int = decoR.rfind(")")
        if lpR > 0 and rpR > lpR:
          pathR = decoR[lpR + 1 : rpR].strip()
        if pathR != "":
          out = out + "  if (req.method == PyStr(\"GET\") && req.path == PyStr(" + pathR + ")) {\n"
          out = out + "  resp = this->" + fnR.name + "(req);\n"
          out = out + "  }\n"
      miR += 1
    out = out + "  resp.write(writer);\n"
    out = out + "  }\n"
  if "AsyncServerMixin" in cls.basesSource and not _classHasMethod(cls, "handleStreamsAsync"):
    out = out + "  void handleStreamsAsync(PyAsyncStreamReader& reader, PyAsyncStreamWriter& writer) {\n"
    out = out + "  PyRequest req = py2cpp_thin_task_run(PyRequest::readAsync(reader));\n"
    out = out + "  PyResponse resp = PyResponse::textResponse(PyStr(\"Not Found\"), PyStatusCodeEnum::NotFound);\n"
    miRa: int = 0
    while miRa < len(cls.methods):
      fnRa: FunctionBundle = cls.methods[miRa]
      decoRa: str = _methodDecoFromBody(cls.bodySource, fnRa.name)
      if decoRa.find("RouteGetMeta") >= 0:
        pathRa: str = ""
        lpRa: int = decoRa.find("(")
        rpRa: int = decoRa.rfind(")")
        if lpRa > 0 and rpRa > lpRa:
          pathRa = decoRa[lpRa + 1 : rpRa].strip()
        if pathRa != "":
          out = out + "  if (req.method == PyStr(\"GET\") && req.path == PyStr(" + pathRa + ")) {\n"
          out = out + "  resp = this->" + fnRa.name + "(req);\n"
          out = out + "  }\n"
      miRa += 1
    out = out + "  (void)(py2cpp_thin_task_run(resp.writeAsync(writer)));\n"
    out = out + "  }\n"
    # 覆盖基类 ``serveN``：库协程按值切片丢失派生路由；薄 thunk 直接调上面的 handleStreamsAsync
    if not _classHasMethod(cls, "serveN"):
      clsNmS: str = "Py" + cls.name
      out = out + "  struct __ServeNArgs { " + clsNmS + "* self; PyStr host = PyStr(\"\"); PyInt port; PyInt count; };\n"
      out = out + "  static PyNone __serveNThinBody(__ServeNArgs& a) {\n"
      out = out + "  PyAsyncTcpSocket listener{};\n"
      out = out + "  (void)(listener.bind(a.host, a.port));\n"
      out = out + "  (void)(listener.listen(128));\n"
      out = out + "  PyInt handled = 0;\n"
      out = out + "  while (handled < a.count) {\n"
      out = out + "  PyAsyncTcpSocket conn = py2cpp_thin_task_run(listener.accept());\n"
      out = out + "  PyAsyncStreamReader reader = PyAsyncStreamReader::fromSocket(conn);\n"
      out = out + "  PyAsyncStreamWriter writer = PyAsyncStreamWriter::fromSocket(conn);\n"
      out = out + "  a.self->handleStreamsAsync(reader, writer);\n"
      out = out + "  (void)(reader.close());\n"
      out = out + "  (void)(writer.close());\n"
      out = out + "  handled = handled + 1;\n"
      out = out + "  }\n"
      out = out + "  (void)(listener.close());\n"
      out = out + "  return PyNone{};\n"
      out = out + "  }\n"
      out = out + "  PyCoroutine<PyLoopHandle, PyNone, PyNone> serveN(PyStr host, PyInt port, PyInt count) {\n"
      out = out + "  __ServeNArgs args{};\n"
      out = out + "  args.self = this;\n"
      out = out + "  args.host = host;\n"
      out = out + "  args.port = port;\n"
      out = out + "  args.count = count;\n"
      out = out + "  return makeThunkCoroutine1Val<PyNone, __ServeNArgs>(&" + clsNmS + "::__serveNThinBody, args);\n"
      out = out + "  }\n"
  out = out + "};\n"
  while len(st.typeParamNames) > 0:
    st.typeParamNames.pop()
  return out

def _emitDatetimeUsings(ind: str) -> str:
  outD: str = ""
  outD = outD + ind + "using ::paw::system::datetime::PyDate;\n"
  outD = outD + ind + "using ::paw::system::datetime::PyDateTime;\n"
  outD = outD + ind + "using ::paw::system::datetime::PyTimeDelta;\n"
  outD = outD + ind + "using ::paw::system::datetime::PyTime;\n"
  outD = outD + ind + "using ::paw::system::time::CTime;\n"
  return outD

def emitModuleHeader(mod: SyntaxModule, modulePath: str, st: EnumEmitState) -> str:
  _prepareEmitModule(mod, modulePath, st)
  stem: str = _moduleStem(modulePath)
  testEntry: bool = _isTestEntry(modulePath)
  guard: str = _testGuardName(stem) if testEntry else _guardName(modulePath)
  out: str = "// seed mid_emit - " + modulePath + "\n"
  out = out + "#ifndef " + guard + "\n#define " + guard + "\n\n"
  out = out + "#include \"paw/minimal.h\"\n"
  out = out + _emitRelativeIncludes(mod, modulePath) + "\n"
  if testEntry:
    # 对位宿主：全局 ``PyInt main();``，using / 类型进扁平 namespace
    fi: int = 0
    while fi < len(mod.functions):
      fn0: FunctionBundle = mod.functions[fi]
      if fn0.name == "main":
        if _needsProcessWorker(mod):
          out = (
            out
            + _fnReturnCpp(fn0, modulePath, st)
            + " main(int argc, char** argv);\n"
          )
        else:
          out = out + _fnReturnCpp(fn0, modulePath, st) + " main();\n"
      fi += 1
    out = out + "\nnamespace " + stem + "\n{\n"
    if _importHas(mod, "from paw import"):
      out = out + _emitTestStarUsings("  ", _importHas(mod, "unittest"))
      if _importHas(mod, "datetime"):
        out = out + _emitDatetimeUsings("  ")
    else:
      out = out + "  using namespace paw;\n"
  i: int = 0
  while i < len(mod.enums):
    out = out + emitEnum(mod.enums[i], mod.enums) + "\n"
    out = out + _emitEnumSupport(mod.enums[i], mod.enums) + "\n"
    i += 1
  # 前向声明：``VaultReader.read(Vault)`` 在 Vault 定义前可用
  out = out + _emitForwardClassDecls(mod)
  # ``delegate Name…``（Opaque 或 bodyless Function）
  delOpaques: list[str] = _collectDelegateOpaques(mod)
  diO: int = 0
  while diO < len(delOpaques):
    out = out + _emitDelegateFromOpaque(delOpaques[diO], st) + "\n"
    diO += 1
  i = 0
  while i < len(mod.functions):
    fnD: FunctionBundle = mod.functions[i]
    if _isDelegateDeclFn(fnD):
      out = out + _emitDelegateClass(fnD, st) + "\n"
    i += 1
  i = 0
  while i < len(mod.classes):
    out = out + emitClass(mod.classes[i], mod, st) + "\n"
    i += 1
  # type enum ``of`` / ``create``（依赖类 ``__id__``）
  ieT: int = 0
  while ieT < len(mod.enums):
    if mod.enums[ieT].isTypeEnum:
      out = out + _emitTypeEnumOfCreate(mod.enums[ieT], mod) + "\n"
    ieT += 1
  # ``type union`` MRO：``Enum.of`` / ``create`` / str·repr
  iuM: int = 0
  while iuM < len(mod.classes):
    clsM: ClassBundle = mod.classes[iuM]
    if clsM.isUnion and _unionMroBaseName(clsM) != "":
      vNmM: list[str] = []
      vFdM: list[str] = []
      vTyM: list[str] = []
      _resolveUnionVariants(clsM, mod, vNmM, vFdM, vTyM)
      out = out + _emitUnionMroSupport(clsM, mod, st, vNmM) + "\n"
    iuM += 1
  i = 0
  while i < len(mod.functions):
    fn1: FunctionBundle = mod.functions[i]
    if testEntry and fn1.name == "main":
      i += 1
      continue
    if _isDelegateDeclFn(fn1):
      i += 1
      continue
    if testEntry:
      while len(st.typeParamNames) > 0:
        st.typeParamNames.pop()
      tpSrcD: str = fn1.typeParamsSource.strip()
      if len(tpSrcD) >= 3 and tpSrcD[:1] == "[" and tpSrcD[len(tpSrcD) - 1 :] == "]":
        tpPartsD: list[str] = _splitParams(tpSrcD[1 : len(tpSrcD) - 1])
        tpiD: int = 0
        while tpiD < len(tpPartsD):
          tppD: str = tpPartsD[tpiD].strip()
          # ``*Ts`` → 登记 ``Ts``；``_U = ...`` 仍登记捕获名
          if len(tppD) > 0 and tppD[:1] == "*":
            tppD = tppD[1:].strip()
          tnmD: str = tppD
          teqD: int = tppD.find("=")
          if teqD > 0:
            tnmD = tppD[:teqD].strip()
          tcolD: int = tnmD.find(":")
          if tcolD > 0:
            tnmD = tnmD[:tcolD].strip()
          if _isIdent(tnmD):
            st.typeParamNames.append(tnmD)
          tpiD += 1
      # 独立 ``__Ts`` pack 登记，供 ``_cppParams`` 识别无注解 ``*rest``
      if _fnNeedsIndepVarargPack(fn1.typeParamsSource, fn1.paramsSource):
        st.typeParamNames.append("__Ts")
      retD: str = _fnReturnCpp(fn1, modulePath, st)
      paramsD: str = _cppParams(fn1.paramsSource, True, "", st)
      tplD: str = _fnFullTemplatePrefix(fn1.typeParamsSource, fn1.paramsSource)
      out = out + tplD
      out = out + "  " + retD + " " + fn1.name + "(" + paramsD + ");\n"
      while len(st.typeParamNames) > 0:
        st.typeParamNames.pop()
    else:
      out = out + emitFunctionDecl(fn1, st)
    i += 1
  i = 0
  while i < len(mod.items):
    it: ModuleItem = mod.items[i]
    if it.kind == ItemKindEnum.Opaque:
      # ``ImportValue: int = 42`` 模块级绑定
      opq: str = it.opaqueSource.strip()
      if len(opq) >= 9 and opq[:9] == "delegate ":
        i += 1
        continue
      colonO: int = opq.find(":")
      eqO: int = opq.find("=")
      if colonO > 0 and eqO > colonO:
        nmO: str = opq[:colonO].strip()
        tyO: str = opq[colonO + 1 : eqO].strip()
        if _isIdent(nmO) and tyO != "":
          out = out + "extern " + _cppType(tyO, st) + " " + nmO + ";\n"
        else:
          out = out + "// opaque omitted\n"
      else:
        out = out + "// opaque omitted\n"
    elif it.kind == ItemKindEnum.Import:
      out = out + "// import: relative include above\n"
    i += 1
  if testEntry:
    out = out + "} // namespace " + stem + "\n"
  out = out + "\n#endif // " + guard + "\n"
  return out

def _emitCompilerPawCppIncludes(mod: SyntaxModule, modulePath: str) -> str:
  """测试 TU 内联 ``compiler.paw`` 的 ``.cpp``（修 LNK2019；单测一份 unity）。"""
  out: str = ""
  seen: list[str] = []
  pref: str = _outToRepoPrefix(modulePath)
  srcs: list[str] = []
  ii: int = 0
  while ii < len(mod.imports):
    srcs.append(mod.imports[ii])
    ii += 1
  jj: int = 0
  while jj < len(mod.items):
    itJ: ModuleItem = mod.items[jj]
    if itJ.kind == ItemKindEnum.Import:
      srcs.append(itJ.opaqueSource)
    jj += 1
  needFeUnity: bool = False
  si: int = 0
  while si < len(srcs):
    absR: list[str] = _absImportIncludes(srcs[si], modulePath)
    ai: int = 0
    while ai < len(absR):
      rel: str = absR[ai]
      # 仅 c2_native 相对路径（含 ``../`` + ``compiler/stages/...``）
      marker: str = "compiler/stages/stage1/c2_native/"
      mi: int = rel.find(marker)
      if mi >= 0:
        found: bool = False
        sk: int = 0
        while sk < len(seen):
          if seen[sk] == rel:
            found = True
            break
          sk += 1
        if found == False:
          seen.append(rel)
          out = out + "#include \"" + rel + ".cpp\"\n"
        # parser 等依赖 lexer/type_parse/… — 拉 frontend unity
        if rel.find("/frontend/") >= 0 or rel.find("\\frontend\\") >= 0:
          needFeUnity = True
      ai += 1
    si += 1
  if needFeUnity:
    # 固定 frontend 传递依赖（修 seed LNK2019 PyLexer/parseType/…）
    feSuffix: list[str] = []
    feSuffix.append("frontend/tokens")
    feSuffix.append("frontend/diagnostic")
    feSuffix.append("frontend/lexer")
    feSuffix.append("frontend/type_parse")
    feSuffix.append("frontend/param_parse")
    feSuffix.append("frontend/stmt_parse")
    feSuffix.append("frontend/syntax_nodes")
    feSuffix.append("frontend/source")
    feSuffix.append("frontend/parser")
    fiU: int = 0
    while fiU < len(feSuffix):
      relU: str = pref + "compiler/stages/stage1/c2_native/" + feSuffix[fiU]
      foundU: bool = False
      skU: int = 0
      while skU < len(seen):
        if seen[skU] == relU:
          foundU = True
          break
        skU += 1
      if foundU == False:
        seen.append(relU)
        out = out + "#include \"" + relU + ".cpp\"\n"
      fiU += 1
  return out

def emitModuleCpp(mod: SyntaxModule, modulePath: str, st: EnumEmitState) -> str:
  _prepareEmitModule(mod, modulePath, st)
  stem: str = _moduleStem(modulePath)
  testEntry: bool = _isTestEntry(modulePath)
  out: str = "// seed mid_emit - " + modulePath + "\n"
  out = out + "#include \"" + stem + ".h\"\n\n"
  if testEntry:
    out = out + "#include <stdio.h>\n"
    out = out + "#include <string.h>\n"
    out = out + "#include <math.h>\n"
    out = out + "#include <new>\n"
    out = out + "#include <type_traits>\n"
    # type-if ``T is list[_U]`` 捕获：任意 ``PyList`` 特化
    out = out + "template<typename, typename = void> struct __paw_is_list : std::false_type {};\n"
    out = (
      out
      + "template<typename _E, PyInt _N> struct __paw_is_list<PyList<_E, _N>, void> : std::true_type {};\n"
    )
    # C++14：变量模板可 ``constexpr``；勿 ``inline constexpr``（C++17）
    out = out + "template<typename _T> constexpr bool __paw_is_list_v = __paw_is_list<_T>::value;\n"
    cppInc: str = _emitCompilerPawCppIncludes(mod, modulePath)
    if cppInc != "":
      out = out + "\n" + cppInc
    out = out + "\n"
    out = out + "namespace " + stem + " {\n"
  # 模块级 ``Name: T = v``
  ii: int = 0
  while ii < len(mod.items):
    itC: ModuleItem = mod.items[ii]
    if itC.kind == ItemKindEnum.Opaque:
      opqC: str = itC.opaqueSource.strip()
      colonC: int = opqC.find(":")
      eqC: int = opqC.find("=")
      if colonC > 0 and eqC > colonC:
        nmC: str = opqC[:colonC].strip()
        tyC: str = opqC[colonC + 1 : eqC].strip()
        rhsC: str = opqC[eqC + 1 :].strip()
        if _isIdent(nmC) and tyC != "":
          tyCppC: str = _cppType(tyC, st)
          # ``[]`` / ``{}`` / ``new()`` → ``Ty{}``；``new(args)`` → ``Ty(args)``
          if rhsC == "[]" or rhsC == "{}" or rhsC == "new()":
            out = out + tyCppC + " " + nmC + "{};\n\n"
          elif len(rhsC) >= 4 and rhsC[:4] == "new(" and rhsC[len(rhsC) - 1 : len(rhsC)] == ")":
            innerMC: str = rhsC[4 : len(rhsC) - 1].strip()
            if innerMC == "":
              out = out + tyCppC + " " + nmC + "{};\n\n"
            else:
              partsMC: list[str] = _splitParams(innerMC)
              joinedMC: str = ""
              okMC: bool = True
              piMC: int = 0
              while piMC < len(partsMC):
                aMC: str = _emitSimpleTerm(partsMC[piMC].strip(), st)
                if aMC == "":
                  if _isIntLit(partsMC[piMC].strip()) or _isIdent(partsMC[piMC].strip()):
                    aMC = partsMC[piMC].strip()
                  else:
                    okMC = False
                    break
                if joinedMC == "":
                  joinedMC = aMC
                else:
                  joinedMC = joinedMC + ", " + aMC
                piMC = piMC + 1
              if okMC and joinedMC != "":
                out = out + tyCppC + " " + nmC + "(" + joinedMC + ");\n\n"
              else:
                out = out + tyCppC + " " + nmC + "{};\n\n"
          else:
            termC: str = _emitSimpleTerm(rhsC, st)
            if termC == "":
              defaC: str = _fieldDefault(tyCppC, rhsC, st)
              if defaC != "":
                out = out + tyCppC + " " + nmC + defaC + ";\n\n"
              else:
                out = out + tyCppC + " " + nmC + " = " + rhsC + ";\n\n"
            else:
              out = out + tyCppC + " " + nmC + " = " + termC + ";\n\n"
    ii += 1
  if testEntry:
    out = out + "} // namespace " + stem + "\n\n"
    out = out + "using namespace " + stem + ";\n\n"
  # 先 emit 函数/方法体以收集 PY2CPP_GETATTR 属性，再前置 DECLARE
  bodyAcc: str = ""
  while len(st.getattrAttrs) > 0:
    st.getattrAttrs.pop()
  while len(st.setattrAttrs) > 0:
    st.setattrAttrs.pop()
  while len(st.kwargsFnNames) > 0:
    st.kwargsFnNames.pop()
  while len(st.kwargsFnTys) > 0:
    st.kwargsFnTys.pop()
  while len(st.varargFnNames) > 0:
    st.varargFnNames.pop()
  while len(st.varargFnElemTys) > 0:
    st.varargFnElemTys.pop()
  while len(st.varargFnFixedN) > 0:
    st.varargFnFixedN.pop()
  # 预登记 ``**kwargs: T`` 以便调用处打包临时 Opts
  iKwReg: int = 0
  while iKwReg < len(mod.functions):
    fnKw: FunctionBundle = mod.functions[iKwReg]
    psKw: str = fnKw.paramsSource.strip()
    if psKw.find("**") >= 0:
      partsKw: list[str] = _splitParams(psKw)
      pjKw: int = 0
      while pjKw < len(partsKw):
        pKw: str = partsKw[pjKw].strip()
        if len(pKw) >= 2 and pKw[0:2] == "**":
          colKw: int = pKw.find(":")
          tyKwSrc: str = ""
          if colKw > 0:
            tyKwSrc = pKw[colKw + 1 :].strip()
            eqKw: int = tyKwSrc.find("=")
            if eqKw >= 0:
              tyKwSrc = tyKwSrc[:eqKw].strip()
          tyKwCpp: str = _cppType(tyKwSrc, st) if tyKwSrc != "" else "PyInt"
          st.kwargsFnNames.append(fnKw.name)
          st.kwargsFnTys.append(tyKwCpp)
          break
        pjKw += 1
    # ``*nums: int[:]`` 整包：调用处打包
    if psKw.find("*") >= 0 and (not _fnHasTypeVarTuple(fnKw.typeParamsSource)):
      partsVa: list[str] = _splitParams(psKw)
      fixedVa: int = 0
      elemVa: str = ""
      foundVa: bool = False
      pjVa: int = 0
      while pjVa < len(partsVa):
        pVa: str = partsVa[pjVa].strip()
        if pVa == "" or pVa == "self":
          pjVa += 1
          continue
        if len(pVa) >= 2 and pVa[0:2] == "**":
          break
        if len(pVa) > 0 and pVa[:1] == "*":
          colVa: int = pVa.find(":")
          tyVaSrc: str = ""
          if colVa > 0:
            tyVaSrc = pVa[colVa + 1 :].strip()
            eqVa: int = tyVaSrc.find("=")
            if eqVa >= 0:
              tyVaSrc = tyVaSrc[:eqVa].strip()
          # ``int[:]`` → PyArray 元素类型
          if tyVaSrc.find("[:]") >= 0:
            baseVa: str = tyVaSrc
            lbVa: int = baseVa.find("[")
            if lbVa > 0:
              baseVa = baseVa[:lbVa].strip()
            elemVa = _cppType(baseVa, st) if baseVa != "" else "PyInt"
            foundVa = True
          break
        fixedVa += 1
        pjVa += 1
      if foundVa:
        st.varargFnNames.append(fnKw.name)
        st.varargFnElemTys.append(elemVa)
        st.varargFnFixedN.append(fixedVa)
    iKwReg += 1
  i: int = 0
  while i < len(mod.functions):
    fn: FunctionBundle = mod.functions[i]
    if _isDelegateDeclFn(fn):
      i += 1
      continue
    if testEntry and fn.name == "main":
      retM: str = _fnReturnCpp(fn, modulePath, st)
      paramsM: str = _cppParams(fn.paramsSource, False, "", st)
      bodyM: str = _expandTestDiscovery(fn.bodySource, mod)
      bodyAcc = bodyAcc + retM + " main("
      if _needsProcessWorker(mod):
        bodyAcc = bodyAcc + "int argc, char** argv"
      else:
        bodyAcc = bodyAcc + paramsM
      bodyAcc = bodyAcc + ") {\n"
      if _needsProcessWorker(mod):
        bodyAcc = (
          bodyAcc
          + "  int __py2cpp_worker = "
          + "::paw::concur::process::tryWorker(argc, (PyUIntPtr)(uintptr_t)argv);\n"
        )
        bodyAcc = bodyAcc + "  if (__py2cpp_worker >= 0) return __py2cpp_worker;\n"
      bodyAcc = bodyAcc + _emitBody(bodyM, retM, st, fn.paramsSource, "")
      bodyAcc = bodyAcc + "}"
      bodyAcc = bodyAcc + "\n\n"
    elif testEntry:
      # 登记 ``[T: Bound]`` 名，避免 ``T`` → ``PyT``
      while len(st.typeParamNames) > 0:
        st.typeParamNames.pop()
      tpSrcO: str = fn.typeParamsSource.strip()
      if len(tpSrcO) >= 3 and tpSrcO[:1] == "[" and tpSrcO[len(tpSrcO) - 1 :] == "]":
        tpPartsO: list[str] = _splitParams(tpSrcO[1 : len(tpSrcO) - 1])
        tpiO: int = 0
        while tpiO < len(tpPartsO):
          tppO: str = tpPartsO[tpiO].strip()
          # ``_U = ...`` 捕获形参：仍登记名（is_same / list[_U]），勿进 template<>
          if len(tppO) > 0 and tppO[:1] == "*":
            tppO = tppO[1:].strip()
          tnmO: str = tppO
          teqO: int = tppO.find("=")
          if teqO > 0:
            tnmO = tppO[:teqO].strip()
          tcolO: int = tnmO.find(":")
          if tcolO > 0:
            tnmO = tnmO[:tcolO].strip()
          if _isIdent(tnmO):
            st.typeParamNames.append(tnmO)
          tpiO += 1
      if _fnNeedsIndepVarargPack(fn.typeParamsSource, fn.paramsSource):
        st.typeParamNames.append("__Ts")
      # 仅 ``[*Ts]`` variadic template 才登记 pack 名（勿把 ``*nums: int[:]`` 当 pack）
      if _fnHasTypeVarTuple(fn.typeParamsSource):
        _registerPackParamsFromSource(st, fn.paramsSource)
      else:
        _clearPackParamNames(st)
      retO: str = _fnReturnCpp(fn, modulePath, st)
      paramsO: str = _cppParams(fn.paramsSource, False, "", st)
      tplO: str = _fnFullTemplatePrefix(fn.typeParamsSource, fn.paramsSource)
      thunkTe: str = _emitAsyncThunkFunction(fn, retO, paramsO, tplO, st, stem + "::" + fn.name)
      if thunkTe != "":
        bodyAcc = bodyAcc + thunkTe + "\n"
      else:
        bodySrcO: str = fn.bodySource
        # variadic vt_loop：结构体须在 template 前，避免吃掉函数 template
        vtCallRaw: str = ""
        tupRaw: str = ""
        if _fnHasTypeVarTuple(fn.typeParamsSource):
          vtLoop: str = _emitVariadicForLoopHelper(fn.name, bodySrcO, st)
          if vtLoop != "":
            bodyAcc = bodyAcc + vtLoop
            vtCallRaw = _variadicForLoopCallRaw(bodySrcO, fn.name, st)
            bodySrcO = _stripVariadicForLoop(bodySrcO, st)
          # viaTuple：``sumAll(*t)`` → ``sumAll(*args)``（须在剥 tuple 赋值前）
          bodySrcO = _rewriteViaTupleStarForward(bodySrcO, st)
          tupRaw = _variadicTupleAssignRaw(bodySrcO, st)
          if tupRaw != "":
            bodySrcO = _stripVariadicTupleAssign(bodySrcO, st)
        bodyAcc = bodyAcc + tplO
        bodyAcc = bodyAcc + retO + " " + stem + "::" + fn.name + "(" + paramsO + ") "
        bodyAcc = bodyAcc + "{"
        bodyAcc = bodyAcc + "\n"
        # ``[T: boxing]``：``return node->n;`` 勿走 emitBody（``->`` 会 soft-skip）
        if _fnHasBoxingBound(fn.typeParamsSource):
          bodyAcc = bodyAcc + _emitBoxingBoundBodyRaw(fn.paramsSource, bodySrcO)
        elif _fnHasNoexcept(fn):
          bodyAcc = bodyAcc + _emitNoexceptBody(fn, retO, st)
        else:
          # vt_loop：剥源 return → emitBody（会补空 return）→ 删空 return → 注入 call + return total
          if vtCallRaw != "":
            bodySrcO = _stripTrailingReturns(bodySrcO)
          if tupRaw != "":
            bodyAcc = bodyAcc + "  " + tupRaw + "\n"
          bodyEm: str = _emitBody(bodySrcO, retO, st, fn.paramsSource, "")
          if vtCallRaw != "":
            bodyEm = _stripEmittedTrailingReturn(bodyEm)
            bodyAcc = bodyAcc + bodyEm
            bodyAcc = bodyAcc + "  " + vtCallRaw + "\n"
            bodyAcc = bodyAcc + "  return total;\n"
          else:
            bodyAcc = bodyAcc + bodyEm
        bodyAcc = bodyAcc + "}"
        bodyAcc = bodyAcc + "\n\n"
      _clearPackParamNames(st)
      while len(st.typeParamNames) > 0:
        st.typeParamNames.pop()
    else:
      bodyAcc = bodyAcc + emitFunctionDef(fn, st) + "\n"
    i += 1
  i = 0
  while i < len(mod.classes):
    cls: ClassBundle = mod.classes[i]
    # class type-if：方法已内联进特化类体
    if _classHasTypeIf(cls):
      if testEntry and _isTestCaseHost(cls) and not _classHasMethod(cls, "run"):
        qcls2tif: str = stem + "::Py" + cls.name
        bodyAcc = bodyAcc + "void " + qcls2tif + "::run(PyRefCount<PyTestResult> result) {\n"
        bodyAcc = bodyAcc + "  this->beginTest(result, Py" + cls.name + "::_testTag, PyStr(\"" + cls.name + "\"));\n"
        bodyAcc = bodyAcc + "  this->test();\n"
        bodyAcc = bodyAcc + "  this->endTest(result);\n"
        bodyAcc = bodyAcc + "}\n\n"
      i += 1
      continue
    if cls.isUnion:
      vNamesI: list[str] = []
      vFieldsI: list[str] = []
      vTypesI: list[str] = []
      _resolveUnionVariants(cls, mod, vNamesI, vFieldsI, vTypesI)
      if len(vNamesI) > 0:
        qclsU: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
        bodyAcc = bodyAcc + _emitUnionClassImpl(
          cls, qclsU, st, vNamesI, vFieldsI, vTypesI
        )
      i += 1
      continue
    propGetDef: int = 0
    propSetDef: int = 0
    propPostDef: int = 0
    propsPostNames: list[str] = []
    miP0: int = 0
    postIdx0: int = 0
    propsAll0: list[str] = _classPropertyNames(cls)
    while miP0 < len(cls.methods):
      if cls.methods[miP0].name == "__post_set__":
        if postIdx0 < len(propsAll0):
          propsPostNames.append(propsAll0[postIdx0])
        postIdx0 += 1
      miP0 += 1
    while len(st.typeParamNames) > 0:
      st.typeParamNames.pop()
    tplsCls: list[str] = _inferClassTplParams(mod, cls)
    if len(tplsCls) == 0:
      tplsCls = _collectTplNamesFromBases(cls.basesSource)
    tiCls: int = 0
    while tiCls < len(tplsCls):
      st.typeParamNames.append(tplsCls[tiCls])
      tiCls += 1
    st.superBaseCpp = _firstBaseCpp(cls, mod, st)
    st.superIsProxy = st.superBaseCpp.find("PyProxy") >= 0
    clsTplPref: str = _classTplPrefixFor(mod, cls)
    if clsTplPref == "":
      clsTplPref = _classTplPrefix(cls)
    clsTplSuf: str = ""
    if len(tplsCls) > 0:
      joinedSuf: str = ""
      tiSuf: int = 0
      while tiSuf < len(tplsCls):
        if tiSuf > 0:
          joinedSuf = joinedSuf + ", "
        joinedSuf = joinedSuf + tplsCls[tiSuf]
        tiSuf += 1
      clsTplSuf = "<" + joinedSuf + ">"
    if clsTplSuf == "":
      clsTplSuf = _classCppNameTplSuffix(cls)
    mi: int = 0
    while mi < len(cls.methods):
      fn2: FunctionBundle = cls.methods[mi]
      if fn2.isAbstract:
        mi += 1
        continue
      selfTyD: str = _selfTyCppName(cls, st)
      params: str = _cppParams(fn2.paramsSource, False, selfTyD, st)
      qcls: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
      qcls = qcls + clsTplSuf
      methDef: str = fn2.name
      propNm: str = ""
      if fn2.name == "__get__":
        propsG: list[str] = _classPropertyNames(cls)
        if propGetDef < len(propsG):
          propNm = propsG[propGetDef]
          methDef = propNm + "__get"
        propGetDef += 1
      elif fn2.name == "__set__":
        propsS: list[str] = _classPropertyNames(cls)
        if propSetDef < len(propsS):
          propNm = propsS[propSetDef]
          methDef = propNm + "__set"
        propSetDef += 1
      elif fn2.name == "__post_set__":
        propsP: list[str] = _classPropertyNames(cls)
        if propPostDef < len(propsP):
          propNm = propsP[propPostDef]
          methDef = propNm + "__post_set"
        propPostDef += 1
      bodySrc: str = _rewritePropertyStorageBody(fn2.bodySource, propNm)
      # 仅 property 访问器预先 ``this->``；普通方法保留 ``self.``，
      # 否则 ``self.value += 1`` / ``self.title =`` 无法识别用户 property。
      if propNm != "":
        bodySrc = bodySrc.replace("self.", "this->")
      if propNm != "" and "Self.__value__" in bodySrc:
        bodySrc = bodySrc.replace(
          "Self.__value__", selfTyD + "::" + propNm + "__value"
        )
      statPropsB: list[str] = _staticPropertyNames(cls)
      isStatProp: bool = propNm != "" and _nameInList(statPropsB, propNm)
      hasPostForProp: bool = propNm != "" and _nameInList(propsPostNames, propNm)
      # 仅 ``self.__value__`` / ``Self.__value__`` 风格才硬编码 ``prop__value``
      # static property：直接拼 C++ 体，避免 ``PyT::x =`` 被注解赋值误拆 ``:``
      if isStatProp and fn2.name == "__get__" and propNm != "":
        retSp: str = selfTyD
        if fn2.returnSource.strip() != "Self" and fn2.returnSource.strip() != "":
          retSp = _cppType(fn2.returnSource, st)
        bodyAcc = bodyAcc + retSp + " " + qcls + "::" + methDef + "() {\n"
        bodyAcc = bodyAcc + "  return " + selfTyD + "::" + propNm + "__value;\n"
        bodyAcc = bodyAcc + "}\n\n"
        mi += 1
        continue
      if isStatProp and fn2.name == "__set__" and propNm != "":
        setPn: str = "value"
        setParts: list[str] = _splitParams(fn2.paramsSource)
        spi: int = 0
        while spi < len(setParts):
          sp: str = setParts[spi].strip()
          if sp != "" and sp != "self":
            colonS: int = sp.find(":")
            if colonS >= 0:
              setPn = sp[:colonS].strip()
            else:
              setPn = sp
            break
          spi += 1
        bodyAcc = (
          bodyAcc
          + "void "
          + qcls
          + "::"
          + methDef
          + "("
          + selfTyD
          + "& "
          + setPn
          + ") {\n"
        )
        bodyAcc = (
          bodyAcc
          + "  "
          + selfTyD
          + "::"
          + propNm
          + "__value = "
          + setPn
          + ";\n"
        )
        if hasPostForProp:
          bodyAcc = (
            bodyAcc
            + "  "
            + selfTyD
            + "::"
            + propNm
            + "__post_set("
            + setPn
            + ");\n"
          )
        bodyAcc = bodyAcc + "}\n\n"
        mi += 1
        continue
      # static ``__post_set__``：``Self.__value__ = …`` 勿走注解赋值拆 ``:``
      if isStatProp and fn2.name == "__post_set__" and propNm != "":
        setPnP: str = "value"
        setPartsP: list[str] = _splitParams(fn2.paramsSource)
        spiP: int = 0
        while spiP < len(setPartsP):
          spP: str = setPartsP[spiP].strip()
          if spP != "" and spP != "self":
            colonP: int = spP.find(":")
            if colonP >= 0:
              setPnP = spP[:colonP].strip()
            else:
              setPnP = spP
            break
          spiP += 1
        bodyAcc = (
          bodyAcc
          + "void "
          + qcls
          + "::"
          + methDef
          + "("
          + selfTyD
          + "& "
          + setPnP
          + ") {\n"
        )
        # 薄发射：``if value.x < 0: Self.__value__ = new(0,0) else: Self.__value__ = value``
        rawPost: str = fn2.bodySource.strip()
        if "value.x < 0" in rawPost or "value.x<0" in rawPost:
          bodyAcc = bodyAcc + "  if ((" + setPnP + ".x < 0)) {\n"
          bodyAcc = (
            bodyAcc
            + "    "
            + selfTyD
            + "::"
            + propNm
            + "__value = "
            + selfTyD
            + "(0, 0);\n"
          )
          bodyAcc = bodyAcc + "  } else {\n"
          bodyAcc = (
            bodyAcc
            + "    "
            + selfTyD
            + "::"
            + propNm
            + "__value = "
            + setPnP
            + ";\n"
          )
          bodyAcc = bodyAcc + "  }\n"
        else:
          bodyAcc = (
            bodyAcc
            + "  "
            + selfTyD
            + "::"
            + propNm
            + "__value = "
            + setPnP
            + ";\n"
          )
        bodyAcc = bodyAcc + "}\n\n"
        mi += 1
        continue
      if fn2.name == "__get__" and propNm != "":
        # 实例 get：直接拼 C++，避免 emitBody 软跳过 ``this->``
        retG: str = _cppType(fn2.returnSource, st)
        if fn2.returnSource.strip() == "Self" or fn2.returnSource.strip() == "":
          retG = "PyInt"
        bodyAcc = bodyAcc + retG + " " + qcls + "::" + methDef + "() {\n"
        bodyAcc = bodyAcc + "  return this->" + propNm + "__value;\n"
        bodyAcc = bodyAcc + "}\n\n"
        mi += 1
        continue
      if fn2.name == "__post_set__" and propNm != "" and (not isStatProp):
        bodyAcc = (
          bodyAcc
          + "void "
          + qcls
          + "::"
          + methDef
          + "("
          + params
          + ") {\n"
        )
        # bodySrc 已是 ``this->…``；逐行写入（勿再走 emitBody）
        linesPs: list[str] = bodySrc.split("\n")
        liPs: int = 0
        while liPs < len(linesPs):
          lnPs: str = linesPs[liPs].strip()
          if lnPs != "":
            if lnPs[len(lnPs) - 1 : len(lnPs)] != ";":
              lnPs = lnPs + ";"
            bodyAcc = bodyAcc + "  " + lnPs + "\n"
          liPs += 1
        bodyAcc = bodyAcc + "}\n\n"
        mi += 1
        continue
      if fn2.name == "__set__" and propNm != "":
        setPn2: str = "value"
        setParts2: list[str] = _splitParams(fn2.paramsSource)
        spi2: int = 0
        while spi2 < len(setParts2):
          sp2: str = setParts2[spi2].strip()
          if sp2 != "" and sp2 != "self":
            colonS2: int = sp2.find(":")
            if colonS2 >= 0:
              setPn2 = sp2[:colonS2].strip()
            else:
              setPn2 = sp2
            break
          spi2 += 1
        bodyAcc = (
          bodyAcc
          + "void "
          + qcls
          + "::"
          + methDef
          + "("
          + params
          + ") {\n"
        )
        bodyAcc = (
          bodyAcc
          + "  this->"
          + propNm
          + "__value = "
          + setPn2
          + ";\n"
        )
        if hasPostForProp:
          bodyAcc = (
            bodyAcc
            + "  this->"
            + propNm
            + "__post_set("
            + setPn2
            + ");\n"
          )
        bodyAcc = bodyAcc + "}\n\n"
        mi += 1
        continue
      # ``Self.x`` / 裸 ``Self`` → 当前类
      if "Self" in bodySrc:
        bodySrc = bodySrc.replace("Self.", selfTyD + "::")
        # 仅剩类型位置的 ``Self``（避免误伤标识符后缀）
        bodySrc2: str = ""
        biS: int = 0
        while biS < len(bodySrc):
          if biS + 4 <= len(bodySrc) and bodySrc[biS : biS + 4] == "Self":
            prevOkS: bool = True
            if biS > 0:
              pchS: str = bodySrc[biS : biS + 1]
              if _isIdentContCh(pchS):
                prevOkS = False
            nextOkS: bool = True
            if biS + 4 < len(bodySrc):
              nchS: str = bodySrc[biS + 4 : biS + 5]
              if _isIdentContCh(nchS):
                nextOkS = False
            if prevOkS and nextOkS:
              bodySrc2 = bodySrc2 + selfTyD
              biS += 4
              continue
          bodySrc2 = bodySrc2 + bodySrc[biS : biS + 1]
          biS += 1
        bodySrc = bodySrc2
      if fn2.name == "__init__":
        # 字段赋值勿被全局 property 名误写成 ``self.x__set``
        # ``self.n: int = n`` → ``this->n = n``（剥注解）
        fiInit: int = 0
        while fiInit < len(cls.constFields):
          fnInit: str = cls.constFields[fiInit].name
          if _isIdent(fnInit):
            bodySrc = bodySrc.replace(
              "self." + fnInit + " =", "this->" + fnInit + " ="
            )
          fiInit += 1
        # 逐行剥 ``self.x: T =`` / 已替换的 ``this->x: T =``
        linesInitPre: list[str] = bodySrc.split("\n")
        bodySrc2Init: str = ""
        liPre: int = 0
        while liPre < len(linesInitPre):
          lnPre: str = linesInitPre[liPre]
          stPre: str = lnPre.strip()
          rewrittenPre: str = stPre
          if len(stPre) >= 5 and stPre[:5] == "self.":
            restPre: str = stPre[5:]
            cPre: int = restPre.find(":")
            ePre: int = restPre.find("=")
            if cPre > 0 and ePre > cPre:
              nmPre: str = restPre[:cPre].strip()
              rhsPre: str = restPre[ePre + 1 :].strip()
              if _isIdent(nmPre):
                rewrittenPre = "this->" + nmPre + " = " + rhsPre
          elif _hasThisArrowPrefix(stPre):
            # ``this->n: int = n`` → ``this->n = n``
            afterArr: str = stPre[6:]
            cPre2: int = afterArr.find(":")
            ePre2: int = afterArr.find("=")
            if cPre2 > 0 and ePre2 > cPre2:
              nmPre2: str = afterArr[:cPre2].strip()
              rhsPre2: str = afterArr[ePre2 + 1 :].strip()
              if _isIdent(nmPre2):
                rewrittenPre = "this->" + nmPre2 + " = " + rhsPre2
          if bodySrc2Init != "":
            bodySrc2Init = bodySrc2Init + "\n"
          bodySrc2Init = bodySrc2Init + rewrittenPre
          liPre += 1
        bodySrc = bodySrc2Init
        bodyAcc = bodyAcc + qcls + "::Py" + cls.name + "(" + params + ") {\n"
        # ``this->x = x`` 等已是 C++，直接写出（emitBody 可能软跳过）
        linesInit: list[str] = bodySrc.split("\n")
        liInit: int = 0
        rawInit: bool = True
        while liInit < len(linesInit):
          lnI: str = linesInit[liInit].strip()
          if lnI == "":
            liInit += 1
            continue
          # 勿 ``lnI[:6] != "this->"``（薄 emit soft-skip → rawInit 恒真倾倒源行）
          if _hasThisArrowPrefix(lnI) == False:
            rawInit = False
            break
          # ``this->_grid = new(rows, cols)`` 须走 emitBody 展开类型
          if "new(" in lnI:
            rawInit = False
            break
          liInit += 1
        if rawInit:
          liInit = 0
          while liInit < len(linesInit):
            lnI2: str = linesInit[liInit].strip()
            if lnI2 != "":
              if lnI2[len(lnI2) - 1 : len(lnI2)] != ";":
                lnI2 = lnI2 + ";"
              bodyAcc = bodyAcc + "  " + lnI2 + "\n"
            liInit += 1
        else:
          bodyAcc = bodyAcc + _emitBody(bodySrc, "void", st, fn2.paramsSource, selfTyD)
        bodyAcc = bodyAcc + "}\n\n"
      else:
        ret: str = _emitFnRetCpp(fn2, st)
        if fn2.returnSource.strip() == "Self":
          ret = selfTyD
        tplM: str = _fnTemplatePrefix(fn2.paramsSource)
        bodyAcc = bodyAcc + clsTplPref
        bodyAcc = bodyAcc + tplM
        bodyAcc = bodyAcc + ret + " " + qcls + "::" + methDef + "(" + params + ") {\n"
        facNames: list[str] = _moduleDecoratorFactoryNames(mod)
        repN: int = _repeatDecorCount(fn2, facNames, cls.bodySource)
        if repN > 0:
          bodyAcc = bodyAcc + "  for (PyInt __paw_rep = 0; __paw_rep < " + str(repN) + "; __paw_rep = __paw_rep + 1) {\n"
          bodyAcc = bodyAcc + _emitBody(bodySrc, ret, st, fn2.paramsSource, selfTyD)
          bodyAcc = bodyAcc + "  }\n"
        else:
          bodyAcc = bodyAcc + _emitBody(bodySrc, ret, st, fn2.paramsSource, selfTyD)
        bodyAcc = bodyAcc + "}\n\n"
      mi += 1
    # 仅 ``__post_set__``：合成 get/set 定义
    if _classHasMethod(cls, "__post_set__"):
      if not _classHasMethod(cls, "__get__"):
        synPj: int = 0
        propsSyn: list[str] = _classPropertyNames(cls)
        statSyn: list[str] = _staticPropertyNames(cls)
        qclsSyn: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
        while synPj < len(propsSyn):
          pnJ: str = propsSyn[synPj]
          if not _nameInList(statSyn, pnJ):
            bodyAcc = bodyAcc + "PyInt " + qclsSyn + "::" + pnJ + "__get() {\n"
            bodyAcc = bodyAcc + "  return this->" + pnJ + "__value;\n"
            bodyAcc = bodyAcc + "}\n\n"
            bodyAcc = bodyAcc + "void " + qclsSyn + "::" + pnJ + "__set(PyInt value) {\n"
            bodyAcc = bodyAcc + "  this->" + pnJ + "__value = value;\n"
            bodyAcc = (
              bodyAcc
              + "  this->"
              + pnJ
              + "__post_set(value);\n"
            )
            bodyAcc = bodyAcc + "}\n\n"
          synPj += 1
    # 具体类：重发含 Self.iterFields/iterMethods 的 mixin 方法
    if cls.isMixin == False:
      qclsRef: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
      qclsRef = qclsRef + clsTplSuf
      bodyAcc = bodyAcc + _emitReflectMixinOverrides(cls, mod, qclsRef, st)
    # 静态 property 存储的定义
    statPropsDef: list[str] = _staticPropertyNames(cls)
    spiD: int = 0
    while spiD < len(statPropsDef):
      qclsS: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
      bodyAcc = (
        bodyAcc
        + "Py"
        + cls.name
        + " "
        + qclsS
        + "::"
        + statPropsDef[spiD]
        + "__value{};\n\n"
      )
      spiD += 1
    if testEntry and _isTestCaseHost(cls) and not _classHasMethod(cls, "run"):
      qcls2: str = stem + "::Py" + cls.name
      bodyAcc = bodyAcc + "void " + qcls2 + "::run(PyRefCount<PyTestResult> result) {\n"
      bodyAcc = bodyAcc + "  this->beginTest(result, Py" + cls.name + "::_testTag, PyStr(\"" + cls.name + "\"));\n"
      bodyAcc = bodyAcc + "  this->test();\n"
      bodyAcc = bodyAcc + "  this->endTest(result);\n"
      bodyAcc = bodyAcc + "}\n\n"
    if cls.isRecord and "ArgumentParserMixin" in cls.basesSource:
      qclsP: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
      selfTyP: str = "Py" + cls.name
      bodyAcc = bodyAcc + selfTyP + " " + qclsP + "::parse(const PyList<PyStr, 0>& argv) {\n"
      bodyAcc = bodyAcc + _emitRecordParseBody(cls)
      bodyAcc = bodyAcc + "}\n\n"
      htLit: str = _emitRecordHelpTextLiteral(cls)
      bodyAcc = bodyAcc + "PyStr " + qclsP + "::helpText = " + htLit + ";\n\n"
    if _hostHasMixin(cls, "ECSWorldMixin"):
      qclsE: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
      bodyAcc = bodyAcc + _emitEcsWorldMixinBodies(cls, qclsE, st)
    if _hostHasMixin(cls, "UIPanelMixin"):
      qclsU: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
      bodyAcc = bodyAcc + _emitUiPanelMixinBodies(cls, qclsU)
    if _hostHasMixin(cls, "UIFlowMixin"):
      qclsF: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
      bodyAcc = bodyAcc + _emitUiFlowMixinBodies(cls, qclsF)
    # ``T @thread_local`` → 类外 ``thread_local Ty Qual::name = init;``
    qclsTls: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
    fiTls: int = 0
    while fiTls < len(cls.constFields):
      cfTls: ConstField = cls.constFields[fiTls]
      lnTls: str = _fieldBodyLine(cls.bodySource, cfTls.name)
      if _lineHasThreadLocal(lnTls):
        tySrcTls: str = cfTls.typeName.strip()
        if tySrcTls == "Self":
          tySrcTls = cls.name
        tySrcTls = _stripFieldTypeDecorators(tySrcTls)
        tyTls: str = _cppType(tySrcTls, st) if tySrcTls != "" else "PyInt"
        vsTls: str = _recordDefaultFromBody(cls.bodySource, cfTls.name)
        if vsTls == "":
          vsTls = _depth0AssignRhs(cfTls.valueSource.strip())
        if vsTls == "":
          vsTls = cfTls.valueSource.strip()
        initTls: str = tyTls + "{}"
        if vsTls == "True":
          initTls = "true"
        elif vsTls == "False":
          initTls = "false"
        elif _isIntLit(vsTls):
          initTls = vsTls
        elif _isIdent(vsTls):
          initTls = vsTls
        bodyAcc = bodyAcc + "thread_local " + tyTls + " " + qclsTls + "::" + cfTls.name + " = " + initTls + ";\n\n"
      fiTls += 1
    if not _isTestCaseHost(cls):
      tplsId: list[str] = _inferClassTplParams(mod, cls)
      if len(tplsId) == 0:
        tplsId = _collectTplNamesFromBases(cls.basesSource)
      if len(tplsId) == 0:
        qclsId: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
        idVal: int = i + 1
        bodyAcc = bodyAcc + "const PyInt " + qclsId + "::__py2cpp_class_id__ = " + str(idVal) + ";\n"
        bodyAcc = bodyAcc + "PyInt " + qclsId + "::__id____get() { return " + qclsId + "::__py2cpp_class_id__; }\n"
        bodyAcc = bodyAcc + "PyInt " + qclsId + "::__class_id____get() const { return " + qclsId + "::__py2cpp_class_id__; }\n\n"
    if _isSerializableCls(cls):
      if cls.isUnion == False:
        qclsSer: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
        bodyAcc = bodyAcc + _emitRecordSerializeImpl(cls, qclsSer, st)
    # 字段描述符 get/set 实现
    diH: int = 0
    while diH < len(st.fieldDescHostNames):
      if st.fieldDescHostNames[diH] == cls.name:
        attrD: str = st.fieldDescAttrNames[diH]
        callD: str = st.fieldDescStorageCsv[diH]
        namesDD: list[str] = []
        argsDD: list[str] = []
        if _splitDescCall(callD, namesDD, argsDD):
          dnmD: str = namesDD[0]
          dclsD: ClassBundle = _findClassByName(mod, dnmD)
          qclsD: str = stem + "::Py" + cls.name if testEntry else "Py" + cls.name
          storD: str = "this->" + attrD + "__value"
          boundND: list[str] = []
          boundVD: list[str] = []
          argPartsD: list[str] = _splitParams(argsDD[0])
          initD: FunctionBundle = _findDescMethod(dclsD, "__init__")
          if initD.name != "":
            ipartsD: list[str] = _splitParams(initD.paramsSource)
            pnamesD: list[str] = []
            iiD: int = 0
            while iiD < len(ipartsD):
              ipD: str = ipartsD[iiD].strip()
              if ipD != "" and ipD != "self":
                icD: int = ipD.find(":")
                if icD >= 0:
                  pnamesD.append(ipD[:icD].strip())
                else:
                  pnamesD.append(ipD)
              iiD += 1
            linesID: list[str] = initD.bodySource.split("\n")
            aiD: int = 0
            while aiD < len(pnamesD) and aiD < len(argPartsD):
              liD: int = 0
              while liD < len(linesID):
                lsD: str = linesID[liD].strip()
                if len(lsD) >= 5 and lsD[:5] == "self." and " = " in lsD:
                  lhsD: str = lsD[: lsD.find(" = ")].strip()
                  rhsD: str = lsD[lsD.find(" = ") + 3 :].strip()
                  if rhsD == pnamesD[aiD]:
                    boundND.append(lhsD[5:])
                    boundVD.append(argPartsD[aiD].strip())
                    break
                liD += 1
              aiD += 1
          getD: FunctionBundle = _findDescMethod(dclsD, "__get__")
          setD: FunctionBundle = _findDescMethod(dclsD, "__set__")
          # get
          bodyAcc = bodyAcc + "PyInt " + qclsD + "::" + attrD + "__get() const {\n"
          if getD.name != "" and "..." not in getD.bodySource and getD.bodySource.strip() != "pass":
            bodyG: str = _rewriteDescBody(getD.bodySource, storD, boundND, boundVD)
            bodyAcc = bodyAcc + _emitBody(bodyG, "PyInt", st, "", "")
          else:
            bodyAcc = bodyAcc + "  return " + storD + ";\n"
          bodyAcc = bodyAcc + "}\n\n"
          # set
          bodyAcc = bodyAcc + "void " + qclsD + "::" + attrD + "__set(PyInt value) {\n"
          if setD.name != "" and "..." not in setD.bodySource and setD.bodySource.strip() != "pass":
            bodyS: str = _rewriteDescBody(setD.bodySource, storD, boundND, boundVD)
            bodyAcc = bodyAcc + _emitBody(bodyS, "void", st, "value: int", "")
          else:
            bodyAcc = bodyAcc + "  " + storD + " = value;\n"
          bodyAcc = bodyAcc + "}\n\n"
      diH += 1
    while len(st.typeParamNames) > 0:
      st.typeParamNames.pop()
    st.superBaseCpp = ""
    st.superIsProxy = False
    i += 1
  out = out + _emitPy2cppAccessDecls(st)
  out = out + bodyAcc
  # 兜底：薄路径偶发漏 ``Py`` 前缀的本模块类构造（``suite.addTest(X())`` 等）
  ciFix: int = 0
  while ciFix < len(mod.classes):
    cnFix: str = mod.classes[ciFix].name
    out = out.replace(
      "makeRefCount<" + cnFix + ">", "makeRefCount<Py" + cnFix + ">"
    )
    ciFix += 1
  out = out + "// stem=" + stem + "\n"
  return out

def emitReport(mod: SyntaxModule) -> str:
  return (
    "fn="
    + str(len(mod.functions))
    + " en="
    + str(len(mod.enums))
    + " class="
    + str(len(mod.classes))
    + " items="
    + str(len(mod.items))
  )
