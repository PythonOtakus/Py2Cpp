from paw import *
from ..frontend.syntax_nodes import (
  ClassBundle,
  ConstField,
  EnumBundle,
  EnumMember,
  FunctionBundle,
  ItemKindEnum,
  ModuleItem,
  SyntaxModule,
)

class ClassMembers:
  """类型成员符号表：recv.attr 的落点由声明决定，不按名字猜。

  fields / props / staticProps / methods / staticMethods 均由
  ClassBundle.methods[].isProperty 与 constFields 推导（stdlib 与用户代码同一路径）。
  """
  name: str = ""
  fields: list[str]
  props: list[str]
  staticProps: list[str]
  methods: list[str]
  staticMethods: list[str]
  bases: list[str]

  def __init__(self):
    self.fields = []
    self.props = []
    self.staticProps = []
    self.methods = []
    self.staticMethods = []
    self.bases = []

class EnumEmitState:
  enumTypes: list[str]
  enumCounts: list[int]
  enumMembersCsv: list[str]
  localNames: list[str]
  localCppTypes: list[str]
  modulePath: str
  userPropNames: list[str]
  # 类成员符号表：与 ``classNames`` 同下标（声明序，不看名字拼写）
  classNames: list[str]
  classMembers: list[ClassMembers]
  recordFieldNames: list[str]
  recordNewTyNames: list[str]
  recordNewFieldCsv: list[str]
  recordNewDefCsv: list[str]
  typeAliasNames: list[str]
  typeAliasCpp: list[str]
  classFieldTyNames: list[str]
  classFieldNameCsv: list[str]
  classFieldTypeCsv: list[str]
  untypedParamNames: list[str]
  getattrAttrs: list[str]
  setattrAttrs: list[str]
  kwargsFnNames: list[str]
  kwargsFnTys: list[str]
  # ``*nums: int[:]`` 整包：调用处打包 ``PyArray``
  varargFnNames: list[str]
  varargFnElemTys: list[str]
  varargFnFixedN: list[int]
  boxingClassNames: list[str]
  refClassNames: list[str]
  # 当前函数形参包名（``args`` / ``rest``），供 ``len`` / ``*`` 展开
  packParamNames: list[str]
  typeParamNames: list[str]
  superBaseCpp: str
  superIsProxy: bool
  classMethTyNames: list[str]
  classMethNameCsv: list[str]
  proxyHostNames: list[str]
  unionVarNames: list[str]
  unionVarOwners: list[str]
  unionVarFieldCsv: list[str]
  serializableNames: list[str]
  fieldDescAttrNames: list[str]
  fieldDescHostNames: list[str]
  fieldDescStorageCsv: list[str]
  opaqueStubNames: list[str]
  # 本方法内已软跳 Flow serialize（graphToJson 等）→ 连带跳过依赖断言
  flowSerSkip: bool
  def __init__(self):
    self.enumTypes = []
    self.enumCounts = []
    self.enumMembersCsv = []
    self.localNames = []
    self.localCppTypes = []
    self.modulePath = ""
    self.userPropNames = []
    self.classNames = []
    self.classMembers = []
    self.recordFieldNames = []
    self.recordNewTyNames = []
    self.recordNewFieldCsv = []
    self.recordNewDefCsv = []
    self.typeAliasNames = []
    self.typeAliasCpp = []
    self.classFieldTyNames = []
    self.classFieldNameCsv = []
    self.classFieldTypeCsv = []
    self.untypedParamNames = []
    self.getattrAttrs = []
    self.setattrAttrs = []
    self.kwargsFnNames = []
    self.kwargsFnTys = []
    self.varargFnNames = []
    self.varargFnElemTys = []
    self.varargFnFixedN = []
    self.boxingClassNames = []
    self.refClassNames = []
    self.packParamNames = []
    self.typeParamNames = []
    self.superBaseCpp = ""
    self.superIsProxy = False
    self.classMethTyNames = []
    self.classMethNameCsv = []
    self.proxyHostNames = []
    self.unionVarNames = []
    self.unionVarOwners = []
    self.unionVarFieldCsv = []
    self.serializableNames = []
    self.fieldDescAttrNames = []
    self.fieldDescHostNames = []
    self.fieldDescStorageCsv = []
    self.opaqueStubNames = []
    self.flowSerSkip = False
  def clear(self) -> None:
    while len(self.enumTypes) > 0:
      self.enumTypes.pop()
    while len(self.enumCounts) > 0:
      self.enumCounts.pop()
    while len(self.enumMembersCsv) > 0:
      self.enumMembersCsv.pop()
    while len(self.localNames) > 0:
      self.localNames.pop()
    while len(self.localCppTypes) > 0:
      self.localCppTypes.pop()
    self.modulePath = ""
    while len(self.userPropNames) > 0:
      self.userPropNames.pop()
    while len(self.classNames) > 0:
      self.classNames.pop()
    while len(self.classMembers) > 0:
      self.classMembers.pop()
    while len(self.recordFieldNames) > 0:
      self.recordFieldNames.pop()
    while len(self.recordNewTyNames) > 0:
      self.recordNewTyNames.pop()
    while len(self.recordNewFieldCsv) > 0:
      self.recordNewFieldCsv.pop()
    while len(self.recordNewDefCsv) > 0:
      self.recordNewDefCsv.pop()
    while len(self.typeAliasNames) > 0:
      self.typeAliasNames.pop()
    while len(self.typeAliasCpp) > 0:
      self.typeAliasCpp.pop()
    while len(self.classFieldTyNames) > 0:
      self.classFieldTyNames.pop()
    while len(self.classFieldNameCsv) > 0:
      self.classFieldNameCsv.pop()
    while len(self.classFieldTypeCsv) > 0:
      self.classFieldTypeCsv.pop()
    while len(self.untypedParamNames) > 0:
      self.untypedParamNames.pop()
    while len(self.getattrAttrs) > 0:
      self.getattrAttrs.pop()
    while len(self.setattrAttrs) > 0:
      self.setattrAttrs.pop()
    while len(self.kwargsFnNames) > 0:
      self.kwargsFnNames.pop()
    while len(self.kwargsFnTys) > 0:
      self.kwargsFnTys.pop()
    while len(self.varargFnNames) > 0:
      self.varargFnNames.pop()
    while len(self.varargFnElemTys) > 0:
      self.varargFnElemTys.pop()
    while len(self.varargFnFixedN) > 0:
      self.varargFnFixedN.pop()
    while len(self.boxingClassNames) > 0:
      self.boxingClassNames.pop()
    while len(self.refClassNames) > 0:
      self.refClassNames.pop()
    while len(self.packParamNames) > 0:
      self.packParamNames.pop()
    while len(self.typeParamNames) > 0:
      self.typeParamNames.pop()
    self.superBaseCpp = ""
    self.superIsProxy = False
    while len(self.classMethTyNames) > 0:
      self.classMethTyNames.pop()
    while len(self.classMethNameCsv) > 0:
      self.classMethNameCsv.pop()
    while len(self.proxyHostNames) > 0:
      self.proxyHostNames.pop()
    while len(self.unionVarNames) > 0:
      self.unionVarNames.pop()
    while len(self.unionVarOwners) > 0:
      self.unionVarOwners.pop()
    while len(self.unionVarFieldCsv) > 0:
      self.unionVarFieldCsv.pop()
    while len(self.serializableNames) > 0:
      self.serializableNames.pop()
    while len(self.fieldDescAttrNames) > 0:
      self.fieldDescAttrNames.pop()
    while len(self.fieldDescHostNames) > 0:
      self.fieldDescHostNames.pop()
    while len(self.fieldDescStorageCsv) > 0:
      self.fieldDescStorageCsv.pop()
    while len(self.opaqueStubNames) > 0:
      self.opaqueStubNames.pop()
    self.flowSerSkip = False
  def registerModule(self, stem: str, mod: SyntaxModule) -> None:
    if len(stem) == 0 and len(mod.enums) == 0:
      return
    i: int = 0
    while i < len(mod.enums):
      nm: str = mod.enums[i].name
      if nm not in self.enumTypes:
        memsR: list[EnumMember] = _flattenEnumMembers(mod.enums[i], mod.enums)
        csvR: str = ""
        miR: int = 0
        while miR < len(memsR):
          if miR > 0:
            csvR = csvR + ","
          csvR = csvR + memsR[miR].name
          miR += 1
        self.enumTypes.append(nm)
        self.enumCounts.append(len(memsR))
        self.enumMembersCsv.append(csvR)
      i += 1
def makeEnumEmitState() -> EnumEmitState:
  return new()

# 模块级 ``type Name = T`` 别名（挂在 EnumEmitState）
def _clearTypeAliases(st: EnumEmitState) -> None:
  while len(st.typeAliasNames) > 0:
    st.typeAliasNames.pop()
  while len(st.typeAliasCpp) > 0:
    st.typeAliasCpp.pop()

def _registerTypeAlias(st: EnumEmitState, name: str, cppTy: str) -> None:
  if name == "" or cppTy == "":
    return
  i: int = 0
  while i < len(st.typeAliasNames):
    if st.typeAliasNames[i] == name:
      return
    i += 1
  st.typeAliasNames.append(name)
  st.typeAliasCpp.append(cppTy)

def _lookupTypeAlias(st: EnumEmitState, name: str) -> str:
  i: int = 0
  while i < len(st.typeAliasNames):
    if st.typeAliasNames[i] == name:
      return st.typeAliasCpp[i]
    i += 1
  return ""

def _isEnumTypeName(st: EnumEmitState, name: str) -> bool:
  # Read field directly (host Mid passes EnumEmitState as const&; methods are non-const).
  return name in st.enumTypes

def _enumTypeCount(st: EnumEmitState, name: str) -> int:
  i: int = 0
  while i < len(st.enumTypes):
    if st.enumTypes[i] == name:
      return st.enumCounts[i]
    i += 1
  return -1

def _enumTypeMembersCsv(st: EnumEmitState, name: str) -> str:
  i: int = 0
  while i < len(st.enumTypes):
    if st.enumTypes[i] == name:
      return st.enumMembersCsv[i]
    i += 1
  return ""

def _localKnown(st: EnumEmitState, name: str) -> bool:
  return name in st.localNames

def _localRemember(st: EnumEmitState, name: str) -> None:
  if name == "":
    return
  if name in st.localNames:
    return
  st.localNames.append(name)
  st.localCppTypes.append("")

def _localTypeIndex(st: EnumEmitState, name: str) -> int:
  i: int = 0
  while i < len(st.localNames):
    if st.localNames[i] == name:
      return i
    i += 1
  return -1

def _localRememberTy(st: EnumEmitState, name: str, ty: str) -> None:
  _localRemember(st, name)
  idx: int = _localTypeIndex(st, name)
  if idx < 0:
    return
  while len(st.localCppTypes) < len(st.localNames):
    st.localCppTypes.append("")
  tmp: list[str] = []
  ti: int = 0
  while ti < len(st.localCppTypes):
    if ti == idx:
      tmp.append(ty)
    else:
      tmp.append(st.localCppTypes[ti])
    ti += 1
  while len(st.localCppTypes) > 0:
    st.localCppTypes.pop()
  ti = 0
  while ti < len(tmp):
    st.localCppTypes.append(tmp[ti])
    ti += 1

def _localCppTypeOf(st: EnumEmitState, name: str) -> str:
  idx: int = _localTypeIndex(st, name)
  if idx < 0:
    return ""
  if idx >= len(st.localCppTypes):
    return ""
  return st.localCppTypes[idx]

def _recvLooksLikeDict(recvCpp: str, st: EnumEmitState) -> bool:
  """``d.get(k, def)`` 三目仅用于 dict；``Grid2D.get`` / 用户 ``get`` 方法除外。"""
  r: str = recvCpp.strip()
  while len(r) >= 2 and r[0] == "(" and r[len(r) - 1] == ")":
    r = r[1 : len(r) - 1].strip()
  if r == "":
    return False
  if r.find("PyDict") >= 0 or r.find("PyFrozenDict") >= 0:
    return True
  if r.find("PyCounter") >= 0:
    return True
  # ``this->map`` / 裸名：查局部类型
  idR: str = r
  if len(r) >= 6 and r[:6] == "this->":
    idR = r[6:]
  if _isIdent(idR):
    tyR: str = _localCppTypeOf(st, idR)
    if tyR.find("PyDict") >= 0 or tyR.find("Dict") >= 0:
      return True
    if tyR.find("PyCounter") >= 0:
      return True
    # 已知非 dict 类型：勿改写
    if tyR != "":
      return False
  # 未知接收者：保守走三目（保持 ``dict.get`` 惰性测例）
  return True

def _listElemCppType(ty: str) -> str:
  s: str = ty.strip()
  if len(s) < 8 or s[:6] != "PyList":
    return ""
  # 勿在 if 里写 ``"<"/">"`` 字面量（薄 emit soft-skip）
  ltCh: str = "<"
  gtCh: str = ">"
  cmCh: str = ","
  lb: int = s.find(ltCh)
  if lb < 0:
    return ""
  # 深度感知：``PyList<PyList<PyInt, 0>, 0>`` 取外层元素类型
  depthL: int = 0
  ciL: int = lb + 1
  while ciL < len(s):
    chL: str = s[ciL : ciL + 1]
    if chL == ltCh:
      depthL += 1
    elif chL == gtCh:
      depthL -= 1
    elif chL == cmCh and depthL == 0:
      return s[lb + 1 : ciL].strip()
    ciL += 1
  return ""

def _scalarTypeStaticAttrCpp(typeName: str, attr: str) -> str:
  """``float64.Inf`` / ``int.Min`` → ``py_types.h`` 宏（非 ``PyFloat64::``）。"""
  if typeName == "float" and attr == "Inf":
    return "PY2CPP_FLOAT_INF"
  if typeName == "float" and attr == "NaN":
    return "PY2CPP_FLOAT_NAN"
  if typeName == "float" and attr == "Min":
    return "PY2CPP_FLOAT_MIN"
  if typeName == "float" and attr == "Max":
    return "PY2CPP_FLOAT_MAX"
  if typeName == "float64" and attr == "Inf":
    return "PY2CPP_FLOAT64_INF"
  if typeName == "float64" and attr == "NaN":
    return "PY2CPP_FLOAT64_NAN"
  if typeName == "float64" and attr == "Min":
    return "PY2CPP_FLOAT64_MIN"
  if typeName == "float64" and attr == "Max":
    return "PY2CPP_FLOAT64_MAX"
  if typeName == "int" and attr == "Min":
    return "PY2CPP_INT_MIN"
  if typeName == "int" and attr == "Max":
    return "PY2CPP_INT_MAX"
  if typeName == "int16" and attr == "Min":
    return "PY2CPP_INT16_MIN"
  if typeName == "int16" and attr == "Max":
    return "PY2CPP_INT16_MAX"
  if typeName == "int64" and attr == "Min":
    return "PY2CPP_INT64_MIN"
  if typeName == "int64" and attr == "Max":
    return "PY2CPP_INT64_MAX"
  if typeName == "uint16" and attr == "Min":
    return "PY2CPP_UINT16_MIN"
  if typeName == "uint16" and attr == "Max":
    return "PY2CPP_UINT16_MAX"
  if typeName == "uint" and attr == "Min":
    return "PY2CPP_UINT_MIN"
  if typeName == "uint" and attr == "Max":
    return "PY2CPP_UINT_MAX"
  if typeName == "uint64" and attr == "Min":
    return "PY2CPP_UINT64_MIN"
  if typeName == "uint64" and attr == "Max":
    return "PY2CPP_UINT64_MAX"
  return ""

def _scalarTypeStaticMethodCpp(typeName: str, method: str, argCpp: str) -> str:
  if typeName == "float" and method == "isfinite":
    return "PY2CPP_ISFINITE_F(" + argCpp + ")"
  if typeName == "float" and method == "isFinite":
    return "PY2CPP_ISFINITE_F(" + argCpp + ")"
  if typeName == "float" and method == "isInf":
    return "PY2CPP_ISINF_F(" + argCpp + ")"
  if typeName == "float" and method == "isNaN":
    return "PY2CPP_ISNAN_F(" + argCpp + ")"
  if typeName == "float64" and method == "isfinite":
    return "PY2CPP_ISFINITE_F64(" + argCpp + ")"
  if typeName == "float64" and method == "isFinite":
    return "PY2CPP_ISFINITE_F64(" + argCpp + ")"
  if typeName == "float64" and method == "isInf":
    return "PY2CPP_ISINF_F64(" + argCpp + ")"
  if typeName == "float64" and method == "isNaN":
    return "PY2CPP_ISNAN_F64(" + argCpp + ")"
  return ""

def _needsScalarTemplateCallee(name: str) -> bool:
  if name == "mean":
    return True
  if name == "fmean":
    return True
  if name == "median":
    return True
  if name == "medianLow":
    return True
  if name == "medianHigh":
    return True
  if name == "medianGrouped":
    return True
  if name == "variance":
    return True
  if name == "pvariance":
    return True
  if name == "stdev":
    return True
  if name == "pstdev":
    return True
  if name == "geometricMean":
    return True
  if name == "harmonicMean":
    return True
  if name == "quantiles":
    return True
  if name == "covariance":
    return True
  if name == "correlation":
    return True
  if name == "linearRegression":
    return True
  if name == "isClose":
    return True
  if name == "sqrt":
    return True
  if name == "almost":
    return True
  return False

def _inferGenericScalar(st: EnumEmitState, argParts: list[str], joined: str) -> str:
  if "PyFloat64" in joined:
    return "PyFloat64"
  if "PyFloat" in joined and "PyFloat64" not in joined:
    return "PyFloat"
  ai: int = 0
  sawF64: bool = False
  sawF: bool = False
  while ai < len(argParts):
    a0: str = argParts[ai].strip()
    if _isIdent(a0):
      ty0: str = _localCppTypeOf(st, a0)
      if ty0 != "":
        elem: str = _listElemCppType(ty0)
        if elem == "PyFloat64":
          sawF64 = True
        elif elem == "PyFloat":
          sawF = True
        elif ty0 == "PyFloat64":
          sawF64 = True
        elif ty0 == "PyFloat":
          sawF = True
    ai += 1
  if sawF64:
    return "PyFloat64"
  if sawF:
    return "PyFloat"
  return "PyFloat64"

def _genericScalarCallSuffix(callee: str, argParts: list[str], joined: str, st: EnumEmitState) -> str:
  if not _isIdent(callee):
    return ""
  if not _needsScalarTemplateCallee(callee):
    return ""
  # 复数实参：``isClose``/``sqrt`` 走 ``math.complex``，勿贴 ``<PyFloat64>``
  if callee == "isClose" or callee == "sqrt" or callee == "csqrt":
    if joined.find("complex128") >= 0 or joined.find("PyComplex") >= 0:
      return ""
    aiCx: int = 0
    while aiCx < len(argParts):
      aCxS: str = argParts[aiCx].strip()
      if _isIdent(aCxS):
        tyCxS: str = _localCppTypeOf(st, aCxS)
        if tyCxS.find("complex") >= 0 or tyCxS.find("Complex") >= 0:
          return ""
      aiCx += 1
  sc: str = _inferGenericScalar(st, argParts, joined)
  return "<" + sc + ">"

def _escapeCppIdent(name: str) -> str:
  """C++ 关键字局部名 → ``name_``（与 host ``escape_cpp_param`` 对齐）。"""
  if name == "signed" or name == "unsigned" or name == "default":
    return name + "_"
  if name == "bool" or name == "char" or name == "float" or name == "int" or name == "long" or name == "short" or name == "void" or name == "class" or name == "struct" or name == "enum" or name == "union" or name == "template" or name == "typename" or name == "const" or name == "static" or name == "new" or name == "delete" or name == "this" or name == "friend" or name == "operator" or name == "public" or name == "private" or name == "protected" or name == "virtual" or name == "explicit" or name == "inline" or name == "namespace" or name == "using" or name == "typedef" or name == "typeid" or name == "sizeof" or name == "alignof" or name == "alignas" or name == "noexcept" or name == "nullptr" or name == "true" or name == "false" or name == "wchar_t" or name == "register" or name == "mutable" or name == "volatile" or name == "extern" or name == "export" or name == "goto" or name == "case" or name == "switch" or name == "break" or name == "continue" or name == "return" or name == "try" or name == "catch" or name == "throw" or name == "if" or name == "else" or name == "for" or name == "while" or name == "do" or name == "auto" or name == "decltype" or name == "constexpr" or name == "consteval" or name == "constinit":
    return name + "_"
  return name

def _assignDeclOrSet(st: EnumEmitState, name: str, rhsCpp: str) -> str:
  """首次裸赋值用 ``auto``；已声明则纯赋值。"""
  em: str = _escapeCppIdent(name)
  if _localKnown(st, name):
    return "  " + em + " = " + rhsCpp + ";\n"
  _localRemember(st, name)
  if rhsCpp.find("paw::io::py_open") >= 0 or rhsCpp.find(".open(") >= 0:
    _localRememberTy(st, name, "PyTextIO")
  elif rhsCpp.find("PyStringIO") >= 0:
    _localRememberTy(st, name, "PyStringIO")
  elif rhsCpp.find("createFlow(") >= 0 or rhsCpp.find("createPanel(") >= 0:
    _localRememberTy(st, name, "paw::ui::window::PyUIWindow")
  elif rhsCpp.find(".find(") >= 0:
    if rhsCpp.find("catalog") >= 0 or rhsCpp.find("_flowCatalog") >= 0 or rhsCpp.find("Catalog") >= 0:
      _localRememberTy(st, name, "paw::ui::flow::catalog::PyFlowNodeTemplate")
  return "  auto " + em + " = " + rhsCpp + ";\n"

def _typedInitOrAssign(wasKnown: bool, ty: str, emN: str, rhsCpp: str) -> str:
  """``x: T = rhs``：已声明则重赋值，否则带类型声明。"""
  if wasKnown:
    return "  " + emN + " = " + rhsCpp + ";\n"
  return "  " + ty + " " + emN + " = " + rhsCpp + ";\n"

def _importRelPath(src: str) -> str:
  s: str = src.strip()
  if len(s) < 6 or s[:5] != "from ":
    return ""
  rest: str = s[5:].strip()
  if rest == "" or rest[0] != ".":
    return ""
  dots: int = 0
  while dots < len(rest) and rest[dots] == ".":
    dots += 1
  rem: str = rest[dots:]
  sp: int = rem.find(" ")
  mod: str = rem.strip() if sp < 0 else rem[:sp].strip()
  if mod == "":
    return ""
  modPath: str = mod.replace(".", "/")
  if dots <= 1:
    return modPath
  up: int = dots - 1
  prefix: str = ""
  ui: int = 0
  while ui < up:
    prefix = prefix + "../"
    ui += 1
  return prefix + modPath

def listRelativeImportStems(mod: SyntaxModule) -> list[str]:
  stems: list[str] = []
  i: int = 0
  while i < len(mod.imports):
    st: str = _importRelPath(mod.imports[i])
    if st != "" and st not in stems:
      stems.append(st)
    i += 1
  return stems

def _guardName(modulePath: str) -> str:
  g: str = modulePath.replace("/", "_").replace(".", "_").replace("-", "_")
  return g.upper() + "_H"

def _moduleStem(modulePath: str) -> str:
  slash: int = modulePath.rfind("/")
  if slash >= 0:
    return modulePath[slash + 1 :]
  return modulePath

def _isTestEntry(modulePath: str) -> bool:
  """``tests/**/test_*.paw`` 入口：扁平 namespace + 全局 ``PyInt main``（helper 等辅助模块不算）。"""
  stem: str = _moduleStem(modulePath)
  if len(stem) < 5 or stem[:5] != "test_":
    return False
  if len(modulePath) >= 6 and modulePath[:6] == "tests/":
    return True
  if len(modulePath) >= 6 and modulePath[:6] == "tests\\":
    return True
  return False

def _needsProcessWorker(mod: SyntaxModule) -> bool:
  """入口依赖 ``concur/process``：main 须先转交 Windows RVA 子进程。"""
  i: int = 0
  while i < len(mod.imports):
    imp: str = mod.imports[i]
    if (
      imp.find("concur/process") >= 0
      or imp.find("concur\\process") >= 0
      or imp.find("concur.process") >= 0
    ):
      return True
    i += 1
  return False

def _testGuardName(stem: str) -> str:
  g: str = stem.replace("-", "_")
  return g.upper() + "_H"

def _fnHasNoexcept(fn: FunctionBundle) -> bool:
  d: str = fn.decoratorsSource.replace(" ", "")
  if "noexcept" in d:
    return True
  return False

def _noexceptErrCpp(fn: FunctionBundle) -> str:
  """``@noexcept`` Err 类型：体含 ``ValueError`` → ``PyValueError``，否则 ``PyException``。"""
  bodyN: str = fn.bodySource
  if "ValueError" in bodyN:
    return "paw::core::exceptions::PyValueError"
  return "paw::core::exceptions::PyException"

def _asyncFnBodyRetCpp(fn: FunctionBundle, st: EnumEmitState) -> str:
  """``async def`` 体 emit 用返回类型（协程 / 异步生成器）。"""
  rs: str = fn.returnSource.strip()
  if rs.find("AsyncGenerator") >= 0:
    return _cppType(fn.returnSource, st)
  if rs.find("CoroutineType") >= 0:
    return _cppType(fn.returnSource, st)
  if rs.find("GeneratorType") >= 0:
    return _cppType(fn.returnSource, st)
  valTy: str = "PyNone"
  if rs != "" and rs != "None":
    valTy = _cppType(fn.returnSource, st)
    if valTy == "void":
      valTy = "PyNone"
  lh: str = _cppType("LoopHandle", st)
  if lh == "" or lh.find("Py") != 0:
    lh = "PyLoopHandle"
  return "PyCoroutine<" + lh + ", PyNone, " + valTy + ">"

def _fnBodyHasYield(body: str) -> bool:
  """函数体含 ``yield`` / ``yield from``（薄 decorator 工厂须 ``PyGenerator``）。"""
  b: str = body
  if b.find("yield from") >= 0:
    return True
  if b.find("yield") >= 0:
    return True
  return False

def _emitFnRetCpp(fn: FunctionBundle, st: EnumEmitState) -> str:
  """模块/方法 C++ 返回类型。"""
  if fn.isAsync:
    return _asyncFnBodyRetCpp(fn, st)
  rsFn: str = fn.returnSource.strip()
  if rsFn == "" or rsFn == "None":
    if _fnBodyHasYield(fn.bodySource):
      return "PyGenerator<PyNone, PyNone, PyNone>"
  return _cppType(fn.returnSource, st)

def _fnReturnCpp(fn: FunctionBundle, modulePath: str, st: EnumEmitState) -> str:
  """测例 ``main`` 无标注时宿主发 ``PyInt``；薄 emit 对齐。"""
  if _isTestEntry(modulePath) and fn.name == "main":
    rs: str = fn.returnSource.strip()
    if rs == "" or rs == "None":
      return "PyInt"
  ret0: str = _emitFnRetCpp(fn, st)
  if _fnHasNoexcept(fn):
    errN: str = _noexceptErrCpp(fn)
    if ret0 == "void":
      return "PyResult<PyNone, " + errN + ">"
    return "PyResult<" + ret0 + ", " + errN + ">"
  return ret0

def _lineLeadingSpaces(ln: str) -> str:
  """行首空白（勿用 ``lstrip`` 切片，薄 emit 易 soft-skip）。"""
  nSp: int = 0
  while nSp < len(ln):
    chSp: str = ln[nSp : nSp + 1]
    if chSp != " " and chSp != "\t":
      break
    nSp += 1
  if nSp <= 0:
    return ""
  return ln[:nSp]

def _wrapNoexceptReturns(bodyCpp: str, retCpp: str, voidOk: bool) -> str:
  """把 ``return expr;`` 包成 ``return Ret::Ok(expr);``；void 在末尾补 Ok。"""
  linesN: list[str] = bodyCpp.split("\n")
  outL: list[str] = []
  liN: int = 0
  while liN < len(linesN):
    lnN: str = linesN[liN]
    stN: str = lnN.strip()
    indN: str = _lineLeadingSpaces(lnN)
    if len(stN) >= 7 and stN[:7] == "return " and stN[len(stN) - 1 :] == ";":
      exprN: str = stN[7 : len(stN) - 1].strip()
      if voidOk or exprN == "":
        outL.append(indN + "return " + retCpp + "::Ok(PyNone{});")
      else:
        outL.append(indN + "return " + retCpp + "::Ok(" + exprN + ");")
    elif stN == "return;":
      outL.append(indN + "return " + retCpp + "::Ok(PyNone{});")
    else:
      outL.append(lnN)
    liN += 1
  joinedN: str = "\n".join(outL)
  if voidOk and "return " not in joinedN:
    joinedN = joinedN + "    return " + retCpp + "::Ok(PyNone{});\n"
  return joinedN

def _emitNoexceptBody(fn: FunctionBundle, retCpp: str, st: EnumEmitState) -> str:
  """``@noexcept``：try 包原函数体，成功 ``Ok``、异常 ``Err``。"""
  innerRet: str = "void"
  voidOk: bool = True
  if retCpp.find("PyResult<") == 0:
    ltN: int = retCpp.find("<")
    gtN: int = retCpp.rfind(">")
    if ltN > 0 and gtN > ltN:
      partsN: list[str] = _splitParams(retCpp[ltN + 1 : gtN])
      if len(partsN) >= 1:
        innerRet = partsN[0].strip()
        if innerRet != "PyNone" and innerRet != "void":
          voidOk = False
  rawBody: str = _emitBody(fn.bodySource, innerRet, st, fn.paramsSource, "")
  wrapped: str = _wrapNoexceptReturns(rawBody, retCpp, voidOk)
  outN: str = "  try {\n"
  outN = outN + wrapped
  errCatch: str = "paw::core::exceptions::PyException"
  if retCpp.find("PyValueError") >= 0:
    errCatch = "paw::core::exceptions::PyValueError"
  outN = outN + "  } catch (" + errCatch + "& __ne) {\n"
  outN = outN + "    return " + retCpp + "::Err(__ne);\n"
  outN = outN + "  } catch (...) {\n"
  outN = outN + "    return " + retCpp + "::Err(" + errCatch + "(PyStr(\"noexcept\")));\n"
  outN = outN + "  }\n"
  return outN

def _importHas(mod: SyntaxModule, needle: str) -> bool:
  i: int = 0
  while i < len(mod.imports):
    if needle in mod.imports[i]:
      return True
    i += 1
  j: int = 0
  while j < len(mod.items):
    it: ModuleItem = mod.items[j]
    if it.kind == ItemKindEnum.Import and needle in it.opaqueSource:
      return True
    j += 1
  return False

def _emitTestStarUsings(ind: str, withUnittest: bool) -> str:
  """``from paw import *`` 展开的短名 using；unittest 仅在显式 import 时注入。"""
  lines: list[str] = []
  lines.append(ind + "using namespace paw;\n")
  lines.append(ind + "using ::paw::int64;\n")
  lines.append(ind + "using ::paw::uint;\n")
  lines.append(ind + "using ::paw::uint64;\n")
  lines.append(ind + "using ::paw::uintptr;\n")
  lines.append(ind + "using ::paw::float64;\n")
  if withUnittest:
    lines.append(ind + "using ::paw::test::unittest::PyTestCase;\n")
    lines.append(ind + "using ::paw::test::unittest::PyTestSuite;\n")
    lines.append(ind + "using ::paw::test::unittest::PyTextTestRunner;\n")
    lines.append(ind + "using ::paw::test::unittest::PyTestResult;\n")
  lines.append(ind + "using ::paw::text::bytes::PyBytes;\n")
  lines.append(ind + "using ::paw::core::exceptions::PyAssertionError;\n")
  lines.append(ind + "using ::paw::core::exceptions::PyException;\n")
  lines.append(ind + "using ::paw::core::exceptions::PyIndexError;\n")
  lines.append(ind + "using ::paw::core::exceptions::PyKeyError;\n")
  lines.append(ind + "using ::paw::core::exceptions::PyRuntimeError;\n")
  lines.append(ind + "using ::paw::core::exceptions::PyTypeError;\n")
  lines.append(ind + "using ::paw::core::exceptions::PyValueError;\n")
  lines.append(ind + "using ::paw::util::list::PyList;\n")
  lines.append(ind + "using ::paw::util::list::PyListIterator;\n")
  lines.append(ind + "using ::paw::util::list::PyFrozenList;\n")
  lines.append(ind + "using ::paw::util::dict::PyDict;\n")
  lines.append(ind + "using ::paw::util::py_set::PySet;\n")
  lines.append(ind + "using ::paw::util::py_set::PyFrozenSet;\n")
  lines.append(ind + "using ::paw::text::str::PyStr;\n")
  lines.append(ind + "using ::paw::util::array::PyArray;\n")
  lines.append(ind + "using ::paw::util::array::PyArray2D;\n")
  lines.append(ind + "using ::paw::util::array::PyArray3D;\n")
  lines.append(ind + "using ::paw::core::optional::PyOptional;\n")
  lines.append(ind + "using ::paw::core::iter_result::PyIterResult;\n")
  lines.append(ind + "using ::paw::util::slice::PySlice;\n")
  lines.append(ind + "using ::paw::util::range::PyRange;\n")
  lines.append(ind + "using ::paw::numeric::py_long::PyLong;\n")
  lines.append(ind + "using ::paw::numeric::decimal::PyDecimal;\n")
  lines.append(ind + "using ::paw::numeric::decimal::PyDecimalContext;\n")
  lines.append(ind + "using ::paw::numeric::fraction::PyFraction;\n")
  lines.append(ind + "using ::paw::numeric::complex::PyComplex;\n")
  lines.append(ind + "using ::paw::numeric::complex::complex128;\n")
  lines.append(ind + "using ::paw::numeric::modint::PyModInt;\n")
  lines.append(ind + "using ::paw::math::isClose;\n")
  lines.append(ind + "using ::paw::math::sqrt;\n")
  lines.append(ind + "using ::paw::util::types::ValOf;\n")
  lines.append(ind + "using ::paw::util::types::StrDictValueOf;\n")
  lines.append(ind + "using ::paw::util::types::ListElemOf;\n")
  lines.append(ind + "using ::paw::util::types::ListOnly;\n")
  out: str = ""
  k: int = 0
  while k < len(lines):
    out = out + lines[k]
    k += 1
  return out

def _weakSymbolInclude(name: str) -> str:
  """``WeakRef`` → ``paw/weak/ref``；无映射则空（勿落到不存在的 ``paw/weak.h``）。"""
  n: str = name.strip()
  if n == "WeakRef":
    return "paw/weak/ref"
  if n == "WeakList":
    return "paw/weak/list"
  if n == "WeakSet":
    return "paw/weak/set"
  if n == "WeakValueDict":
    return "paw/weak/valuedict"
  if n == "WeakKeyDict":
    return "paw/weak/keydict"
  return ""

def _outToRepoPrefix(modulePath: str) -> str:
  """``out/<modulePath>.h`` 相对仓库根的 ``../`` 前缀。"""
  parts: list[str] = modulePath.replace("\\", "/").split("/")
  n: int = len(parts)
  if n <= 0:
    return "../../../"
  pref: str = ""
  ui: int = 0
  while ui < n:
    pref = pref + "../"
    ui += 1
  return pref

def _absImportIncludes(src: str, modulePath: str = "") -> list[str]:
  """绝对 import → 一个或多个 ``#include`` stem；``paw.weak`` 按符号展开子头。"""
  out: list[str] = []
  s: str = src.strip()
  if len(s) < 6 or s[:5] != "from ":
    return out
  rest: str = s[5:].strip()
  if rest == "" or rest[0] == ".":
    return out
  sp: int = rest.find(" import ")
  if sp < 0:
    return out
  mod: str = rest[:sp].strip()
  namesRaw: str = rest[sp + 8 :].strip()
  if mod == "paw":
    return out
  if mod == "__future__":
    return out
  # ``from paw.weak import WeakRef, WeakList`` → ref.h / list.h（无 paw/weak.h）
  if mod == "paw.weak":
    partsW: list[str] = _splitParams(namesRaw)
    wi: int = 0
    while wi < len(partsW):
      nmW: str = partsW[wi].strip()
      asW: int = nmW.find(" as ")
      if asW > 0:
        nmW = nmW[:asW].strip()
      relW: str = _weakSymbolInclude(nmW)
      if relW != "":
        foundW: bool = False
        kj: int = 0
        while kj < len(out):
          if out[kj] == relW:
            foundW = True
            break
          kj += 1
        if foundW == False:
          out.append(relW)
      wi += 1
    return out
  if len(mod) >= 4 and mod[:4] == "paw.":
    out.append("paw/" + mod[4:].replace(".", "/"))
    return out
  if len(mod) >= 4 and mod[:4] == "ffi.":
    out.append("ffi/" + mod[4:].replace(".", "/"))
    return out
  # ``compiler.paw.frontend.source`` → c2_native 相对仓库根（修 C1083）
  if len(mod) >= 13 and mod[:13] == "compiler.paw.":
    restCp: str = mod[13:].replace(".", "/")
    prefCp: str = _outToRepoPrefix(modulePath)
    out.append(prefCp + "compiler/stages/stage1/c2_native/" + restCp)
    return out
  out.append(mod.replace(".", "/"))
  return out

def _absImportInclude(src: str, modulePath: str = "") -> str:
  """``from paw.test.unittest import …`` → ``paw/test/unittest``；``from paw import *`` 空。"""
  rels: list[str] = _absImportIncludes(src, modulePath)
  if len(rels) == 0:
    return ""
  return rels[0]

def _classHasMethod(cls: ClassBundle, name: str) -> bool:
  mi: int = 0
  while mi < len(cls.methods):
    if cls.methods[mi].name == name:
      return True
    mi += 1
  return False

def _isTestCaseHost(cls: ClassBundle) -> bool:
  b: str = cls.basesSource
  if "TestCaseMixin" not in b and "TestCase" not in b:
    return False
  return _classHasMethod(cls, "test")

def _moduleDecoratorFactoryNames(mod: SyntaxModule) -> list[str]:
  """``@decorator def repeat`` 工厂名列表。"""
  outN: list[str] = []
  fi: int = 0
  while fi < len(mod.functions):
    fn: FunctionBundle = mod.functions[fi]
    d: str = fn.decoratorsSource.replace(" ", "")
    if "@decorator" in d or d == "decorator":
      outN.append(fn.name)
    if "decorator" in fn.decoratorsSource and fn.name not in outN:
      if "@context" not in fn.decoratorsSource.replace(" ", ""):
        outN.append(fn.name)
    fi += 1
  return outN

def _methodDecoFromBody(body: str, methodName: str) -> str:
  """类体文本中 ``@…`` 紧挨 ``def method`` 的装饰器源（parser 未挂到 methods）。"""
  lines: list[str] = body.split("\n")
  li: int = 0
  while li < len(lines):
    s: str = lines[li].strip()
    isDef: bool = False
    if len(s) >= 4 and s[:4] == "def " and s.find(methodName + "(") >= 0:
      isDef = True
    if " def " in s and s.find(methodName + "(") >= 0:
      isDef = True
    if isDef:
      decoAcc: str = ""
      lj: int = li - 1
      while lj >= 0:
        prev: str = lines[lj].strip()
        if prev == "":
          lj -= 1
          continue
        if len(prev) >= 1 and prev[0] == "@":
          if decoAcc == "":
            decoAcc = prev
          else:
            decoAcc = prev + "\n" + decoAcc
          lj -= 1
          continue
        break
      return decoAcc
    li += 1
  return ""

def _repeatDecorCount(fn: FunctionBundle, factories: list[str], clsBody: str) -> int:
  """``@repeat(3)`` / ``@repeat`` → 循环次数；非 repeat 装饰返回 0。"""
  d: str = fn.decoratorsSource.strip()
  if d == "" and clsBody != "":
    d = _methodDecoFromBody(clsBody, fn.name)
  if d == "":
    return 0
  # 优先认 ``repeat``（工厂表可空）
  facs: list[str] = []
  fi0: int = 0
  while fi0 < len(factories):
    facs.append(factories[fi0])
    fi0 += 1
  if "repeat" not in facs:
    if "repeat" in d:
      facs.append("repeat")
  fi: int = 0
  while fi < len(facs):
    fac: str = facs[fi]
    if fac != "repeat":
      fi += 1
      continue
    keyParen: str = fac + "("
    atP: int = d.find(keyParen)
    if atP >= 0:
      rest: str = d[atP + len(keyParen) :]
      rp: int = rest.find(")")
      if rp > 0:
        inner: str = rest[:rp].strip()
        if _isIntLit(inner):
          return int(inner)
        return 2
    if ("@" + fac) in d.replace(" ", "") or d.find(fac) >= 0:
      if (fac + "(") not in d.replace(" ", ""):
        return 2
    fi += 1
  return 0

def _refreshTypeEnumCsv(st: EnumEmitState, en: EnumBundle) -> None:
  csvTe: str = ""
  miTe: int = 0
  while miTe < len(en.members):
    if csvTe != "":
      csvTe = csvTe + ","
    csvTe = csvTe + en.members[miTe].name
    miTe += 1
  eiTe: int = 0
  while eiTe < len(st.enumTypes):
    if st.enumTypes[eiTe] == en.name:
      st.enumCounts[eiTe] = len(en.members)
      if eiTe < len(st.enumMembersCsv):
        st.enumMembersCsv[eiTe] = csvTe
      break
    eiTe += 1

def _prepareEmitModule(mod: SyntaxModule, modulePath: str, st: EnumEmitState) -> None:
  st.modulePath = modulePath
  # type enum 成员并入须在 register/emit 前（of/create / 成员名）
  iePrep: int = 0
  while iePrep < len(mod.enums):
    if mod.enums[iePrep].isTypeEnum:
      _expandTypeEnumMembers(mod.enums[iePrep], mod)
      _refreshTypeEnumCsv(st, mod.enums[iePrep])
    iePrep += 1
  _clearTypeAliases(st)
  while len(st.userPropNames) > 0:
    st.userPropNames.pop()
  while len(st.recordFieldNames) > 0:
    st.recordFieldNames.pop()
  while len(st.recordNewTyNames) > 0:
    st.recordNewTyNames.pop()
  while len(st.recordNewFieldCsv) > 0:
    st.recordNewFieldCsv.pop()
  while len(st.recordNewDefCsv) > 0:
    st.recordNewDefCsv.pop()
  while len(st.classFieldTyNames) > 0:
    st.classFieldTyNames.pop()
  while len(st.classFieldNameCsv) > 0:
    st.classFieldNameCsv.pop()
  while len(st.classFieldTypeCsv) > 0:
    st.classFieldTypeCsv.pop()
  while len(st.classMethTyNames) > 0:
    st.classMethTyNames.pop()
  while len(st.classMethNameCsv) > 0:
    st.classMethNameCsv.pop()
  while len(st.proxyHostNames) > 0:
    st.proxyHostNames.pop()
  while len(st.unionVarNames) > 0:
    st.unionVarNames.pop()
  while len(st.unionVarOwners) > 0:
    st.unionVarOwners.pop()
  while len(st.unionVarFieldCsv) > 0:
    st.unionVarFieldCsv.pop()
  while len(st.serializableNames) > 0:
    st.serializableNames.pop()
  while len(st.fieldDescAttrNames) > 0:
    st.fieldDescAttrNames.pop()
  while len(st.fieldDescHostNames) > 0:
    st.fieldDescHostNames.pop()
  while len(st.fieldDescStorageCsv) > 0:
    st.fieldDescStorageCsv.pop()
  # ``type Int = ModInt[int, 1000000007]``
  oiA: int = 0
  while oiA < len(mod.items):
    itA: ModuleItem = mod.items[oiA]
    if itA.kind == ItemKindEnum.Opaque:
      opA: str = itA.opaqueSource.strip()
      if len(opA) >= 5 and opA[:5] == "type ":
        restA: str = opA[5:].strip()
        eqA: int = restA.find("=")
        if eqA > 0:
          nmA: str = restA[:eqA].strip()
          rhsA: str = restA[eqA + 1 :].strip()
          if _isIdent(nmA) and rhsA != "":
            _registerTypeAlias(st, nmA, _cppType(rhsA, st))
    oiA += 1
  ci: int = 0
  while ci < len(mod.classes):
    clsP: ClassBundle = mod.classes[ci]
    # 方法名表：Proxy 子类剥壳时判断成员是否本类已定义
    methCsvP: str = ""
    miReg: int = 0
    while miReg < len(clsP.methods):
      mnReg: str = clsP.methods[miReg].name
      if mnReg != "" and mnReg != "__init__":
        if methCsvP != "":
          methCsvP = methCsvP + ","
        methCsvP = methCsvP + mnReg
      miReg += 1
    fiReg: int = 0
    while fiReg < len(clsP.constFields):
      fnReg: str = clsP.constFields[fiReg].name
      if fnReg != "":
        if methCsvP != "":
          methCsvP = methCsvP + ","
        methCsvP = methCsvP + fnReg
      fiReg += 1
    st.classMethTyNames.append(clsP.name)
    st.classMethNameCsv.append(methCsvP)
    if _proxyTplParamFromBases(clsP.basesSource) != "":
      st.proxyHostNames.append(clsP.name)
    if "serializable" in clsP.decoratorsSource:
      if clsP.name not in st.serializableNames:
        st.serializableNames.append(clsP.name)
    if clsP.isUnion:
      vNamesU: list[str] = []
      vFieldsU: list[str] = []
      vTypesU: list[str] = []
      _resolveUnionVariants(clsP, mod, vNamesU, vFieldsU, vTypesU)
      vu: int = 0
      while vu < len(vNamesU):
        st.unionVarNames.append(vNamesU[vu])
        st.unionVarOwners.append(clsP.name)
        fCsvU: str = ""
        if vu < len(vFieldsU):
          fCsvU = vFieldsU[vu]
        st.unionVarFieldCsv.append(fCsvU)
        vu += 1
    props: list[str] = _classPropertyNames(clsP)
    pi: int = 0
    while pi < len(props):
      pn: str = props[pi]
      if pn not in st.userPropNames:
        st.userPropNames.append(pn)
      pi += 1
    # 任意用户类字段名（含 ``@copyable class``）勿当 stdlib property ``__set``
    # 非占位描述符字段（Offset 等）走 property；Plain/Clamped 的 ``...`` 仍当普通字段
    fiAll: int = 0
    while fiAll < len(clsP.constFields):
      fnAll: str = clsP.constFields[fiAll].name
      isDescF: bool = False
      if fnAll != "":
        linesDF: list[str] = clsP.bodySource.split("\n")
        liDF: int = 0
        while liDF < len(linesDF):
          sDF: str = linesDF[liDF].strip()
          prefDF: str = fnAll + ":"
          if len(sDF) >= len(prefDF) and sDF[: len(prefDF)] == prefDF:
            callDF: str = _fieldDescAnnot(sDF)
            if callDF != "":
              nDF: list[str] = []
              aDF: list[str] = []
              if _splitDescCall(callDF, nDF, aDF):
                dclsDF: ClassBundle = _findClassByName(mod, nDF[0])
                getDF: FunctionBundle = _findDescMethod(dclsDF, "__get__")
                if getDF.name != "":
                  gbDF: str = getDF.bodySource.strip()
                  if gbDF != "" and gbDF != "..." and gbDF != "pass":
                    isDescF = True
            break
          liDF += 1
      if fnAll != "" and isDescF == False:
        if fnAll not in st.recordFieldNames:
          st.recordFieldNames.append(fnAll)
      if isDescF:
        if fnAll not in st.userPropNames:
          st.userPropNames.append(fnAll)
        # 供 emitModuleCpp 生成 get/set（header 路径的 st 会被 prepare 清掉）
        st.fieldDescHostNames.append(clsP.name)
        st.fieldDescAttrNames.append(fnAll)
        # callDF 仍在上方作用域
        linesDF2: list[str] = clsP.bodySource.split("\n")
        liDF2: int = 0
        while liDF2 < len(linesDF2):
          sDF2: str = linesDF2[liDF2].strip()
          prefDF2: str = fnAll + ":"
          if len(sDF2) >= len(prefDF2) and sDF2[: len(prefDF2)] == prefDF2:
            st.fieldDescStorageCsv.append(_fieldDescAnnot(sDF2))
            break
          liDF2 += 1
      fiAll += 1
    # Type.build 字段类型：record / copyable / 普通类均登记
    fnTyAcc: str = ""
    tySrcAcc: str = ""
    fiTy: int = 0
    while fiTy < len(clsP.constFields):
      cfTy: ConstField = clsP.constFields[fiTy]
      fnTy: str = cfTy.name
      tsTy: str = cfTy.typeName.strip()
      isDescTy: bool = False
      if fnTy != "":
        linesDT: list[str] = clsP.bodySource.split("\n")
        liDT: int = 0
        while liDT < len(linesDT):
          sDT: str = linesDT[liDT].strip()
          prefDT: str = fnTy + ":"
          if len(sDT) >= len(prefDT) and sDT[: len(prefDT)] == prefDT:
            callDT: str = _fieldDescAnnot(sDT)
            if callDT != "":
              nDT: list[str] = []
              aDT: list[str] = []
              if _splitDescCall(callDT, nDT, aDT):
                dclsDT: ClassBundle = _findClassByName(mod, nDT[0])
                getDT: FunctionBundle = _findDescMethod(dclsDT, "__get__")
                if getDT.name != "":
                  gbDT: str = getDT.bodySource.strip()
                  if gbDT != "" and gbDT != "..." and gbDT != "pass":
                    isDescTy = True
            break
          liDT += 1
      if fnTy != "" and tsTy != "" and isDescTy == False:
        if fnTyAcc != "":
          fnTyAcc = fnTyAcc + ","
          tySrcAcc = tySrcAcc + "|"
        fnTyAcc = fnTyAcc + fnTy
        tySrcAcc = tySrcAcc + tsTy
      fiTy += 1
    if fnTyAcc != "":
      st.classFieldTyNames.append("Py" + clsP.name)
      st.classFieldNameCsv.append(fnTyAcc)
      st.classFieldTypeCsv.append(tySrcAcc)
    if clsP.isRecord:
      fnAcc: str = ""
      defAcc: str = ""
      fiP: int = 0
      while fiP < len(clsP.constFields):
        fnm: str = clsP.constFields[fiP].name
        if fnm != "":
          if fnAcc != "":
            fnAcc = fnAcc + ","
            defAcc = defAcc + "|"
          fnAcc = fnAcc + fnm
          vsRec: str = _recordDefaultFromBody(clsP.bodySource, fnm)
          if vsRec == "":
            vsRec = _depth0AssignRhs(clsP.constFields[fiP].valueSource.strip())
          if vsRec == "":
            vsRec = clsP.constFields[fiP].valueSource.strip()
          defAcc = defAcc + vsRec
        fiP += 1
      if fnAcc != "":
        st.recordNewTyNames.append("Py" + clsP.name)
        st.recordNewFieldCsv.append(fnAcc)
        st.recordNewDefCsv.append(defAcc)
    # ``@boxing class Cell`` → ``list[Cell]`` 元素为指针
    decoCls: str = clsP.decoratorsSource.replace(" ", "")
    if "boxing" in decoCls:
      if clsP.name not in st.boxingClassNames:
        st.boxingClassNames.append(clsP.name)
    # ``ref record`` / ``ref class`` → 局部 ``PyRefCount<PyX>``
    if clsP.isRef:
      if clsP.name not in st.refClassNames:
        st.refClassNames.append(clsP.name)
    # 成员分类：字段 / 实例属性 / 静态属性 / 方法（供 ``recv.attr`` 解析，勿靠名字白名单）
    mem: ClassMembers = new()
    mem.name = clsP.name
    miMem: int = 0
    while miMem < len(clsP.methods):
      fnMem: FunctionBundle = clsP.methods[miMem]
      if fnMem.name != "":
        if fnMem.isProperty:
          if fnMem.isStatic:
            mem.staticProps.append(fnMem.name)
          else:
            mem.props.append(fnMem.name)
        else:
          if fnMem.isStatic:
            mem.staticMethods.append(fnMem.name)
          else:
            mem.methods.append(fnMem.name)
      miMem += 1
    fiMem: int = 0
    while fiMem < len(clsP.constFields):
      cfMem: ConstField = clsP.constFields[fiMem]
      if cfMem.name != "" and not _nameInList(mem.fields, cfMem.name):
        mem.fields.append(cfMem.name)
      fiMem += 1
    mem.bases = _splitBaseNames(clsP.basesSource)
    if clsP.name not in st.classNames:
      st.classNames.append(clsP.name)
      st.classMembers.append(mem)
    ci += 1

def _isBoxingClassName(st: EnumEmitState, name: str) -> bool:
  return name in st.boxingClassNames

def _isRefClassName(st: EnumEmitState, name: str) -> bool:
  return name in st.refClassNames

def _membersOf(st: EnumEmitState, clsName: str) -> ClassMembers:
  """类名 → 成员符号表（缺失返回空表）。"""
  i: int = 0
  while i < len(st.classNames):
    if st.classNames[i] == clsName:
      return st.classMembers[i]
    i += 1
  return new()

def _cppTypeBareClassName(ty: str) -> str:
  """``PyPath`` / ``PyList<PyPath…>`` / ``PyRefCount<PyPath>`` → ``Path``；非类名返回空。"""
  s: str = ty.strip()
  while s.find("PyRefCount<") == 0 and len(s) > 12:
    s = s[11 : len(s) - 1].strip()
  if len(s) > 0 and s[len(s) - 1 :] == "&":
    s = s[: len(s) - 1].strip()
  if len(s) > 0 and s[len(s) - 1 :] == "*":
    s = s[: len(s) - 1].strip()
  lt: int = s.find("<")
  if lt > 0:
    s = s[:lt].strip()
  if len(s) >= 3 and s[:2] == "Py":
    nm: str = s[2:]
    if _isIdent(nm):
      return nm
  return ""

def _memberKindInChain(st: EnumEmitState, clsName: str, attr: str, depth: int = 0) -> str:
  # 在类及其基类链上判定 attr 的成员种类（field/prop/staticProp/method/staticMethod/空）
  if clsName == "" or depth > 16:
    return ""
  mem: ClassMembers = _membersOf(st, clsName)
  if mem.name == "":
    return ""
  if attr in mem.fields:
    return "field"
  if attr in mem.props:
    return "prop"
  if attr in mem.staticProps:
    return "staticProp"
  if attr in mem.methods:
    return "method"
  if attr in mem.staticMethods:
    return "staticMethod"
  bi: int = 0
  while bi < len(mem.bases):
    hit: str = _memberKindInChain(st, mem.bases[bi].strip(), attr, depth + 1)
    if hit != "":
      return hit
    bi += 1
  return ""

def _memberKindOfCppType(st: EnumEmitState, cppTy: str, attr: str) -> str:
  """C++ 类型串 → ``attr`` 的成员种类（见 ``_memberKindInChain``）。"""
  return _memberKindInChain(st, _cppTypeBareClassName(cppTy), attr)

def _selfTyCppName(cls: ClassBundle, st: EnumEmitState) -> str:
  """``ref class`` 的 ``Self`` 形参/返回类型须 ``PyRefCount<T>``。"""
  cpp: str = "Py" + cls.name
  if _isRefClassName(st, cls.name):
    return "PyRefCount<" + cpp + ">"
  return cpp

def _isPackParamName(st: EnumEmitState, name: str) -> bool:
  return name in st.packParamNames

def _clearPackParamNames(st: EnumEmitState) -> None:
  while len(st.packParamNames) > 0:
    st.packParamNames.pop()

def _registerPackParamsFromSource(st: EnumEmitState, paramsSource: str) -> None:
  """登记 ``*args`` / ``*rest`` 形参包名。"""
  _clearPackParamNames(st)
  parts: list[str] = _splitParams(paramsSource)
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if len(p) > 0 and p[:1] == "*" and (len(p) < 2 or p[:2] != "**"):
      rest: str = p[1:].strip()
      col: int = rest.find(":")
      nm: str = rest
      if col > 0:
        nm = rest[:col].strip()
      if _isIdent(nm):
        st.packParamNames.append(nm)
    pi += 1

def _boxingElemCpp(st: EnumEmitState, elemCpp: str) -> str:
  """``PyCellUnsafe`` + boxing → ``PyCellUnsafe*``。"""
  e: str = elemCpp.strip()
  if e == "":
    return e
  if len(e) > 0 and e[len(e) - 1 :] == "*":
    return e
  # ``PyCellUnsafe`` → 剥 ``Py`` 查 boxing 表
  bare: str = e
  if len(bare) >= 2 and bare[:2] == "Py":
    bare = bare[2:]
  if _isBoxingClassName(st, bare):
    return e + "*"
  return e

def _isRecordFieldName(st: EnumEmitState, attr: str) -> bool:
  return attr in st.recordFieldNames

def _recordNewMetaIndex(st: EnumEmitState, ty: str) -> int:
  ri: int = 0
  while ri < len(st.recordNewTyNames):
    if st.recordNewTyNames[ri] == ty:
      return ri
    ri += 1
  return -1

def _emitRecordReprExpr(recvCpp: str, ty: str, st: EnumEmitState) -> str:
  if ty == "" or recvCpp == "":
    return ""
  ri: int = _recordNewMetaIndex(st, ty)
  if ri < 0:
    return ""
  fnCsv: str = st.recordNewFieldCsv[ri]
  if fnCsv == "":
    return ""
  clsNm: str = ty
  if len(clsNm) >= 3 and clsNm[:2] == "Py":
    clsNm = clsNm[2:]
  fields: list[str] = fnCsv.split(",")
  outR: str = "PyStr(\"" + clsNm + "(\")"
  fiR: int = 0
  while fiR < len(fields):
    fnR: str = fields[fiR].strip()
    if fnR == "":
      fiR += 1
      continue
    if fiR > 0:
      outR = outR + " + PyStr(\", \")"
    outR = outR + " + PyStr(\"" + fnR + "=\") + repr(" + recvCpp + "." + fnR + ")"
    fiR += 1
  outR = outR + " + PyStr(\")\")"
  return outR

def _emitSubscriptOn(baseCpp: str, idxCpp: str, st: EnumEmitState) -> str:
  recv: str = baseCpp.strip()
  if recv == "" or idxCpp == "":
    return ""
  tyB: str = ""
  if _isIdent(recv):
    tyB = _localCppTypeOf(st, recv)
  if len(tyB) > 0 and tyB[len(tyB) - 1] == "*":
    return "(" + recv + "[" + idxCpp + "])"
  if len(recv) > 0 and recv[len(recv) - 1] == "*":
    return "(" + recv + "[" + idxCpp + "])"
  # ``span.at()[i]`` → ``T*`` C 下标（勿 ``.__getitem__``）
  if recv.find(".at()") >= 0:
    return "(" + recv + "[" + idxCpp + "])"
  # 仅外层 ``PyTuple<…>`` 常量下标 → ``.template get<N>()``
  # （勿 ``find("PyTuple")``：``PyList<PyTuple<…>>`` 会误伤）
  if _isIntLit(idxCpp):
    isTupB: bool = False
    if len(tyB) >= 7:
      if tyB[:7] == "PyTuple":
        isTupB = True
    if isTupB == False:
      if len(recv) >= 7:
        if recv[:7] == "PyTuple":
          isTupB = True
    if isTupB == False:
      if _isIdent(recv):
        tyB2: str = _localCppTypeOf(st, recv)
        if len(tyB2) >= 7:
          if tyB2[:7] == "PyTuple":
            isTupB = True
    if isTupB:
      return "(" + recv + ").template get<" + idxCpp + ">()"
  return "(" + recv + ").__getitem__(" + idxCpp + ")"

def _fieldBodyLine(body: str, fieldName: str) -> str:
  lines: list[str] = body.split("\n")
  li: int = 0
  pref: str = fieldName + ":"
  while li < len(lines):
    s: str = lines[li].strip()
    if len(s) >= len(pref) and s[: len(pref)] == pref:
      return s
    li += 1
  return ""

def _fieldArgKindFromLine(line: str) -> str:
  if "@PosArgMeta" in line:
    return "pos"
  if "@OptArgMeta" in line:
    return "opt"
  if "@FlagArgMeta" in line:
    return "flag"
  return ""

def _fieldArgShortFromLine(line: str) -> str:
  """``short=\"-j\"`` / ``short='-v'`` → ``-j``。"""
  key: str = "short="
  at: int = line.find(key)
  if at < 0:
    return ""
  rest: str = line[at + len(key) :].strip()
  if rest == "":
    return ""
  q: str = rest[:1]
  if q != "\"" and q != "'":
    return ""
  endQ: int = rest.find(q, 1)
  if endQ < 0:
    return ""
  return rest[1:endQ]

def _fieldArgNegatedFromLine(line: str) -> bool:
  return "negated=True" in line or "negated = True" in line

def _emitRecordHelpTextLiteral(cls: ClassBundle) -> str:
  usage: str = "usage: " + cls.name
  fi: int = 0
  while fi < len(cls.constFields):
    cf: ConstField = cls.constFields[fi]
    nm: str = cf.name
    line: str = _fieldBodyLine(cls.bodySource, nm)
    kind: str = _fieldArgKindFromLine(line)
    kebab: str = nm.replace("_", "-")
    if kind == "pos":
      usage = usage + " <" + nm + ">"
    elif kind == "opt":
      usage = usage + " [--" + kebab + " VALUE]"
    elif kind == "flag":
      if _fieldArgNegatedFromLine(line):
        usage = usage + " [--no-" + kebab + "]"
      else:
        usage = usage + " [--" + kebab + "]"
    else:
      # 无 *ArgMeta：按类型粗分（兼容旧测例）
      ty: str = cf.typeName.strip()
      if ty == "bool":
        usage = usage + " [--" + kebab + "]"
      elif ty == "str" and fi == 0:
        usage = usage + " <" + nm + ">"
      else:
        usage = usage + " [--" + kebab + " VALUE]"
    fi += 1
  return "PyStr(\"" + usage + "\")"

def _emitEcsWorldMixinBodies(cls: ClassBundle, qcls: str, st: EnumEmitState) -> str:
  """``ECSWorldMixin`` 字段池 + ``isAlive``/``_allocEntity``/``destroy``（展开 ComponentTable 字段）。"""
  out: str = ""
  out = out + "void " + qcls + "::_postInit() {}\n\n"
  out = out + "bool " + qcls + "::isAlive(PyECSEntity e) const {\n"
  out = out + "  if (this->_generation.__len__() == 0) { return false; }\n"
  out = out + "  if (e.index < 0 || e.index >= EcsMaxEntities) { return false; }\n"
  out = out + "  if (!(this->_alive.__getitem__(e.index))) { return false; }\n"
  out = out + "  return e.generation == this->_generation.__getitem__(e.index);\n"
  out = out + "}\n\n"
  out = out + "PyECSEntity " + qcls + "::_allocEntity() {\n"
  out = out + "  if (this->_generation.__len__() == 0) {\n"
  out = out + "    this->_generation = PyArray<PyInt, 0>(EcsMaxEntities);\n"
  out = out + "    this->_alive = PyArray<PyInt, 0>(EcsMaxEntities);\n"
  out = out + "    PyInt __zi = 0;\n"
  out = out + "    while (__zi < EcsMaxEntities) {\n"
  out = out + "      this->_generation.__setitem__(__zi, 0);\n"
  out = out + "      this->_alive.__setitem__(__zi, 0);\n"
  out = out + "      __zi = __zi + 1;\n"
  out = out + "    }\n"
  out = out + "    this->_nextIndex = 0;\n"
  out = out + "    this->_postInit();\n"
  out = out + "  }\n"
  out = out + "  PyInt idx = EcsSparseEmpty;\n"
  out = out + "  if (this->_free.__len__() > 0) {\n"
  out = out + "    idx = this->_free.__getitem__(this->_free.__len__() - 1);\n"
  out = out + "    (void)(this->_free.pop());\n"
  out = out + "  } else {\n"
  out = out + "    if (this->_nextIndex >= EcsMaxEntities) {\n"
  out = out + "      throw paw::core::exceptions::PyValueError(PyStr(\"ECS: entity limit exceeded\"));\n"
  out = out + "    }\n"
  out = out + "    idx = this->_nextIndex;\n"
  out = out + "    this->_nextIndex = this->_nextIndex + 1;\n"
  out = out + "  }\n"
  out = out + "  PyInt gen = this->_generation.__getitem__(idx);\n"
  out = out + "  this->_alive.__setitem__(idx, 1);\n"
  out = out + "  return PyECSEntity(idx, gen);\n"
  out = out + "}\n\n"
  out = out + "void " + qcls + "::_deallocEntity(PyECSEntity e) {\n"
  out = out + "  this->_alive.__setitem__(e.index, 0);\n"
  out = out + "  this->_generation.__setitem__(e.index, this->_generation.__getitem__(e.index) + 1);\n"
  out = out + "  (void)(this->_free.append(e.index));\n"
  out = out + "}\n\n"
  out = out + "void " + qcls + "::destroy(PyECSEntity e) {\n"
  out = out + "  if (!this->isAlive(e)) {\n"
  out = out + "    throw paw::core::exceptions::PyValueError(PyStr(\"ECS: entity not alive\"));\n"
  out = out + "  }\n"
  # ``Self.iterFields[ComponentTableMeta]()`` → 本类 ECSComponentTable 字段
  fiE: int = 0
  while fiE < len(cls.constFields):
    cfE: ConstField = cls.constFields[fiE]
    tyE: str = cfE.typeName.strip()
    if tyE.find("ECSComponentTable") >= 0:
      out = out + "  if (this->" + cfE.name + ".__contains__(e)) {\n"
      out = out + "    this->" + cfE.name + ".__delitem__(e);\n"
      out = out + "  }\n"
    fiE += 1
  out = out + "  this->_deallocEntity(e);\n"
  out = out + "}\n\n"
  return out

def _emitUiPanelMixinBodies(cls: ClassBundle, qcls: str) -> str:
  """``UIPanelMixin.createPanel`` / ``drawPanel`` 薄桩（iterFields 表单构建暂空）。"""
  out: str = ""
  out = out + "void " + qcls + "::drawPanel(paw::ui::window::PyUIWindow& win) {\n"
  out = out + "  this->_panelWin = win;\n"
  out = out + "  this->_panelFormReady = true;\n"
  out = out + "}\n\n"
  out = out + "void " + qcls + "::panelSyncFromForm() {}\n\n"
  out = out + "void " + qcls + "::panelSyncToForm() {}\n\n"
  out = out + "paw::ui::window::PyUIWindow " + qcls + "::createPanel(PyStr title, PyInt width, PyInt height) {\n"
  out = out + "  this->_panelWin = paw::ui::window::PyUIWindow{};\n"
  out = out + "  if (!paw::ui::app::PyUIApp::isAvailable()) { return this->_panelWin; }\n"
  out = out + "  this->_panelWin.title__set(title);\n"
  out = out + "  if (!(this->_panelWin.title__get())) {\n"
  out = out + "    this->_panelWin.title__set(PyStr(\"" + cls.name + "\"));\n"
  out = out + "  }\n"
  out = out + "  this->_panelWin.show(width, height);\n"
  out = out + "  this->drawPanel(this->_panelWin);\n"
  out = out + "  if (width < 0 || height < 0) {\n"
  out = out + "    this->_panelWin.resize(width, height);\n"
  out = out + "  }\n"
  out = out + "  return this->_panelWin;\n"
  out = out + "}\n\n"
  return out

def _flowMetaTitle(deco: str, meta: str) -> str:
  """``@FlowNodeMeta('Fire', category='Combat')`` → title 字面量。"""
  key: str = meta + "("
  at: int = deco.find(key)
  if at < 0:
    return ""
  rest: str = deco[at + len(key) :]
  if len(rest) == 0:
    return ""
  q: str = rest[:1]
  if q != "'" and q != "\"":
    return ""
  endQ: int = rest.find(q, 1)
  if endQ < 0:
    return ""
  return rest[1:endQ]

def _flowMetaCategory(deco: str) -> str:
  key: str = "category="
  at: int = deco.find(key)
  if at < 0:
    return ""
  rest: str = deco[at + len(key) :].strip()
  if len(rest) == 0:
    return ""
  q: str = rest[:1]
  if q != "'" and q != "\"":
    return ""
  endQ: int = rest.find(q, 1)
  if endQ < 0:
    return ""
  return rest[1:endQ]

def _flowMethodParamNames(paramsSource: str) -> list[str]:
  outP: list[str] = []
  parts: list[str] = _splitParams(paramsSource)
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if p == "" or p == "self":
      pi += 1
      continue
    colon: int = p.find(":")
    nm: str = p
    if colon >= 0:
      nm = p[:colon].strip()
    if _isIdent(nm):
      outP.append(nm)
    pi += 1
  return outP

def _flowTypeIdFromSrc(tySrc: str) -> str:
  t: str = _stripFieldTypeDecorators(tySrc).strip()
  if t == "bool":
    return "bool"
  if t == "int":
    return "int"
  if t == "float" or t == "float64":
    return "float"
  if t == "str":
    return "str"
  return "object"

def _flowMethodParamTypeIds(paramsSource: str) -> list[str]:
  outT: list[str] = []
  parts: list[str] = _splitParams(paramsSource)
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if p == "" or p == "self":
      pi += 1
      continue
    colon: int = p.find(":")
    ty: str = "object"
    if colon >= 0:
      rest: str = p[colon + 1 :].strip()
      eq: int = rest.find("=")
      if eq >= 0:
        rest = rest[:eq].strip()
      ty = _flowTypeIdFromSrc(rest)
    outT.append(ty)
    pi += 1
  return outT

def _emitFlowPinSpecExpr(name: str, kind: str, typeId: str) -> str:
  """构造临时 ``PyFlowPinSpec`` 表达式语句用的初始化块前缀变量。"""
  out: str = "  {\n"
  out = out + "    paw::ui::flow::catalog::PyFlowPinSpec __ps{};\n"
  out = out + "    __ps.name = PyStr(\"" + name + "\");\n"
  out = out + "    __ps.kind = paw::ui::flow::model::PyFlowPinEnum::" + kind + ";\n"
  if typeId != "":
    out = out + "    __ps.typeId = PyStr(\"" + typeId + "\");\n"
  out = out + "    __pins.append(__ps);\n"
  out = out + "  }\n"
  return out

def _emitUiFlowMixinBodies(cls: ClassBundle, qcls: str) -> str:
  """``UIFlowMixin._ensureFlowCatalog`` / ``createFlow``（译期展开 Flow*Meta）。"""
  out: str = ""
  out = out + "void " + qcls + "::_ensureFlowCatalog() {\n"
  out = out + "  if (this->_flowCatalogReady) { return; }\n"
  out = out + "  this->_flowCatalog.clear();\n"
  mi: int = 0
  while mi < len(cls.methods):
    fn: FunctionBundle = cls.methods[mi]
    decoRaw: str = fn.decoratorsSource
    if decoRaw.strip() == "":
      decoRaw = _methodDecoFromBody(cls.bodySource, fn.name)
    deco: str = decoRaw.replace(" ", "")
    kind: str = ""
    title: str = ""
    category: str = ""
    if "FlowNodeMeta(" in deco or "FlowNodeMeta(" in decoRaw:
      kind = "Callable"
      title = _flowMetaTitle(decoRaw, "FlowNodeMeta")
      category = _flowMetaCategory(decoRaw)
      if category == "":
        category = cls.name
    elif "FlowPureMeta(" in deco or "FlowPureMeta(" in decoRaw:
      kind = "Pure"
      title = _flowMetaTitle(decoRaw, "FlowPureMeta")
      category = _flowMetaCategory(decoRaw)
      if category == "":
        category = cls.name
    elif "FlowEventMeta(" in deco or "FlowEventMeta(" in decoRaw:
      kind = "Event"
      title = _flowMetaTitle(decoRaw, "FlowEventMeta")
      category = _flowMetaCategory(decoRaw)
      if category == "":
        category = "Events"
    if kind != "":
      if title == "":
        title = fn.name
      kindId: str = cls.name + "." + fn.name
      out = out + "  {\n"
      out = out + "    paw::util::list::PyList<paw::ui::flow::catalog::PyFlowPinSpec, 0> __pins{};\n"
      if kind == "Callable":
        out = out + _emitFlowPinSpecExpr("execute", "ExecIn", "")
        out = out + _emitFlowPinSpecExpr("then", "ExecOut", "")
        pns: list[str] = _flowMethodParamNames(fn.paramsSource)
        pts: list[str] = _flowMethodParamTypeIds(fn.paramsSource)
        pj: int = 0
        while pj < len(pns):
          tid: str = "object"
          if pj < len(pts):
            tid = pts[pj]
          out = out + _emitFlowPinSpecExpr(pns[pj], "DataIn", tid)
          pj += 1
        retS: str = fn.returnSource.strip()
        if retS != "" and retS != "None":
          out = out + _emitFlowPinSpecExpr("Return Value", "DataOut", _flowTypeIdFromSrc(retS))
      elif kind == "Pure":
        pns2: list[str] = _flowMethodParamNames(fn.paramsSource)
        pts2: list[str] = _flowMethodParamTypeIds(fn.paramsSource)
        pj2: int = 0
        while pj2 < len(pns2):
          tid2: str = "object"
          if pj2 < len(pts2):
            tid2 = pts2[pj2]
          out = out + _emitFlowPinSpecExpr(pns2[pj2], "DataIn", tid2)
          pj2 += 1
        retS2: str = fn.returnSource.strip()
        if retS2 != "" and retS2 != "None":
          out = out + _emitFlowPinSpecExpr("Return Value", "DataOut", _flowTypeIdFromSrc(retS2))
      else:
        out = out + _emitFlowPinSpecExpr("then", "ExecOut", "")
      nk: str = "Callable"
      if kind == "Pure":
        nk = "Pure"
      if kind == "Event":
        nk = "Event"
      out = out + "    this->_flowCatalog.register_(PyStr(\"" + kindId + "\"), PyStr(\"" + title + "\"), PyStr(\"" + category + "\"), paw::ui::flow::model::PyFlowNodeEnum::" + nk + ", PyStr(\"" + fn.name + "\"), __pins);\n"
      out = out + "  }\n"
    mi += 1
  out = out + "  paw::ui::flow::builtins::registerFlowBuiltins(this->_flowCatalog);\n"
  out = out + "  this->_flowCatalogReady = true;\n"
  out = out + "}\n\n"
  out = out + "paw::ui::window::PyUIWindow " + qcls + "::createFlow(PyStr title, PyInt width, PyInt height) {\n"
  out = out + "  this->_flowWin = paw::ui::window::PyUIWindow{};\n"
  out = out + "  if (!paw::ui::app::PyUIApp::isAvailable()) { return this->_flowWin; }\n"
  out = out + "  this->_ensureFlowCatalog();\n"
  out = out + "  this->_flowShell.catalog = this->_flowCatalog;\n"
  out = out + "  this->_flowCanvas.catalog = this->_flowCatalog;\n"
  out = out + "  this->_flowWin.title__set(title);\n"
  out = out + "  if (!(this->_flowWin.title__get())) {\n"
  out = out + "    this->_flowWin.title__set(PyStr(\"" + cls.name + "\"));\n"
  out = out + "  }\n"
  out = out + "  this->_flowWin.show(width, height);\n"
  out = out + "  return this->_flowWin;\n"
  out = out + "}\n\n"
  return out

def _emitRecordParseBody(cls: ClassBundle) -> str:
  """``ArgumentParserMixin.parse`` 译期展开（覆盖 console/test_parse 场景）。"""
  selfTy: str = "Py" + cls.name
  out: str = ""
  out = out + "  " + selfTy + " result{};\n"
  # 默认值（字段 ctor 已带默认；再按 body 覆盖显式默认）
  fi0: int = 0
  while fi0 < len(cls.constFields):
    cf0: ConstField = cls.constFields[fi0]
    vs0: str = _recordDefaultFromBody(cls.bodySource, cf0.name)
    if vs0 == "":
      vs0 = _depth0AssignRhs(cf0.valueSource.strip())
    if vs0 != "":
      term0: str = ""
      if vs0 == "True":
        term0 = "true"
      elif vs0 == "False":
        term0 = "false"
      elif len(vs0) >= 2 and vs0[0] == "\"" and vs0[len(vs0) - 1] == "\"":
        term0 = "PyStr(" + vs0 + ")"
      elif _isIntLit(vs0):
        term0 = vs0
      if term0 != "":
        out = out + "  result." + cf0.name + " = " + term0 + ";\n"
    fi0 += 1
  out = out + "  PyInt n = argv.__len__();\n"
  out = out + "  PyInt posI = 0;\n"
  out = out + "  PyInt posN = 0;\n"
  # 数位置参数
  fiP: int = 0
  while fiP < len(cls.constFields):
    lnP: str = _fieldBodyLine(cls.bodySource, cls.constFields[fiP].name)
    if _fieldArgKindFromLine(lnP) == "pos":
      out = out + "  posN = posN + 1;\n"
    fiP += 1
  out = out + "  bool optsDone = false;\n"
  out = out + "  PyInt i = 0;\n"
  out = out + "  while (i < n) {\n"
  out = out + "    PyStr tok = argv.__getitem__(i);\n"
  out = out + "    if ((!optsDone) && tok == PyStr(\"--\")) { optsDone = true; i = i + 1; continue; }\n"
  out = out + "    bool isOpt = false;\n"
  out = out + "    if ((!optsDone) && tok.startsWith(PyStr(\"-\")) && !(tok == PyStr(\"-\"))) { isOpt = true; }\n"
  out = out + "    if (isOpt) {\n"
  out = out + "      PyStr key = tok;\n"
  out = out + "      PyStr raw = PyStr(\"\");\n"
  out = out + "      bool hasRaw = false;\n"
  out = out + "      bool fromEq = false;\n"
  out = out + "      auto __eqParts = tok.partition(PyStr(\"=\"));\n"
  out = out + "      if (__eqParts.__getitem__(1) == PyStr(\"=\")) {\n"
  out = out + "        key = __eqParts.__getitem__(0);\n"
  out = out + "        raw = __eqParts.__getitem__(2);\n"
  out = out + "        hasRaw = true; fromEq = true;\n"
  out = out + "      } else if ((i + 1) < n) {\n"
  out = out + "        PyStr nxt = argv.__getitem__(i + 1);\n"
  out = out + "        bool takeVal = true;\n"
  out = out + "        if (nxt.startsWith(PyStr(\"-\")) && !(nxt == PyStr(\"-\"))) { takeVal = false; }\n"
  out = out + "        if (takeVal) { raw = nxt; hasRaw = true; }\n"
  out = out + "      }\n"
  out = out + "      bool matched = false;\n"
  # flags
  fiF: int = 0
  while fiF < len(cls.constFields):
    cfF: ConstField = cls.constFields[fiF]
    lnF: str = _fieldBodyLine(cls.bodySource, cfF.name)
    if _fieldArgKindFromLine(lnF) == "flag":
      kebF: str = cfF.name.replace("_", "-")
      longF: str = "--" + kebF
      if _fieldArgNegatedFromLine(lnF):
        longF = "--no-" + kebF
      shortF: str = _fieldArgShortFromLine(lnF)
      setTrue: str = "true"
      if _fieldArgNegatedFromLine(lnF):
        setTrue = "false"
      out = out + "      if ((!matched) && key == PyStr(\"" + longF + "\")) { result." + cfF.name + " = " + setTrue + "; matched = true; }\n"
      if shortF != "":
        out = out + "      if ((!matched) && key == PyStr(\"" + shortF + "\")) { result." + cfF.name + " = " + setTrue + "; matched = true; }\n"
    fiF += 1
  # opts
  fiO: int = 0
  while fiO < len(cls.constFields):
    cfO: ConstField = cls.constFields[fiO]
    lnO: str = _fieldBodyLine(cls.bodySource, cfO.name)
    if _fieldArgKindFromLine(lnO) == "opt":
      kebO: str = cfO.name.replace("_", "-")
      longO: str = "--" + kebO
      shortO: str = _fieldArgShortFromLine(lnO)
      tyO: str = cfO.typeName.strip()
      out = out + "      if ((!matched) && (key == PyStr(\"" + longO + "\")"
      if shortO != "":
        out = out + " || key == PyStr(\"" + shortO + "\")"
      out = out + ")) {\n"
      out = out + "        if (!hasRaw) { /* missing */ }\n"
      out = out + "        else {\n"
      if tyO == "int" or tyO == "int64":
        out = out + "          result." + cfO.name + " = static_cast<PyInt>(raw);\n"
      else:
        out = out + "          result." + cfO.name + " = raw;\n"
      out = out + "          matched = true;\n"
      out = out + "          if ((!fromEq) && hasRaw) { i = i + 1; }\n"
      out = out + "        }\n"
      out = out + "      }\n"
    fiO += 1
  # combined short flags ``-vq``
  out = out + "      if ((!matched) && tok.__len__() > 2 && tok.startsWith(PyStr(\"-\")) && (!tok.startsWith(PyStr(\"--\"))) && (!fromEq)) {\n"
  out = out + "        bool comboOk = true;\n"
  out = out + "        PyInt k = 1;\n"
  out = out + "        while (k < tok.__len__()) {\n"
  out = out + "          PyChar ch = tok.__getitem__(k);\n"
  out = out + "          bool one = false;\n"
  fiC: int = 0
  while fiC < len(cls.constFields):
    cfC: ConstField = cls.constFields[fiC]
    lnC: str = _fieldBodyLine(cls.bodySource, cfC.name)
    if _fieldArgKindFromLine(lnC) == "flag":
      shortC: str = _fieldArgShortFromLine(lnC)
      if len(shortC) >= 2:
        chC: str = shortC[1:2]
        setC: str = "true"
        if _fieldArgNegatedFromLine(lnC):
          setC = "false"
        out = out + "          if ((!one) && ch == PyChar('" + chC + "')) { result." + cfC.name + " = " + setC + "; one = true; }\n"
    fiC += 1
  out = out + "          if (!one) { comboOk = false; }\n"
  out = out + "          k = k + 1;\n"
  out = out + "        }\n"
  out = out + "        if (comboOk) { matched = true; }\n"
  out = out + "      }\n"
  out = out + "      if (matched) { i = i + 1; continue; }\n"
  out = out + "    }\n"
  # positionals
  out = out + "    bool tookPos = false;\n"
  out = out + "    PyInt posCur = 0;\n"
  fiT: int = 0
  while fiT < len(cls.constFields):
    cfT: ConstField = cls.constFields[fiT]
    lnT: str = _fieldBodyLine(cls.bodySource, cfT.name)
    if _fieldArgKindFromLine(lnT) == "pos":
      tyT: str = cfT.typeName.strip()
      out = out + "    if ((!tookPos) && posI == posCur) {\n"
      if tyT == "int" or tyT == "int64":
        out = out + "      result." + cfT.name + " = static_cast<PyInt>(tok);\n"
      else:
        out = out + "      result." + cfT.name + " = tok;\n"
      out = out + "      posI = posI + 1; tookPos = true;\n"
      out = out + "    }\n"
      out = out + "    posCur = posCur + 1;\n"
    fiT += 1
  out = out + "    i = i + 1;\n"
  out = out + "  }\n"
  out = out + "  return result;\n"
  return out

def _classPropertyNames(cls: ClassBundle) -> list[str]:
  out: list[str] = []
  lines: list[str] = cls.bodySource.split("\n")
  li: int = 0
  while li < len(lines):
    s: str = lines[li].strip()
    pref: str = "property "
    prefS: str = "static property "
    if len(s) >= len(prefS) + 1 and s[: len(prefS)] == prefS and s[len(s) - 1] == ":":
      nmS: str = s[len(prefS) : len(s) - 1].strip()
      if _isIdent(nmS):
        out.append(nmS)
    elif len(s) >= len(pref) + 1 and s[: len(pref)] == pref and s[len(s) - 1] == ":":
      nm: str = s[len(pref) : len(s) - 1].strip()
      if _isIdent(nm):
        out.append(nm)
    li += 1
  oi: int = 0
  while oi < len(cls.opaqueMembers):
    sO: str = cls.opaqueMembers[oi].strip()
    prefO: str = "property "
    prefSO: str = "static property "
    if len(sO) >= len(prefSO) + 1 and sO[: len(prefSO)] == prefSO and sO[len(sO) - 1] == ":":
      nmSO: str = sO[len(prefSO) : len(sO) - 1].strip()
      if _isIdent(nmSO) and not _nameInList(out, nmSO):
        out.append(nmSO)
    elif len(sO) >= len(prefO) + 1 and sO[: len(prefO)] == prefO and sO[len(sO) - 1] == ":":
      nmO: str = sO[len(prefO) : len(sO) - 1].strip()
      if _isIdent(nmO) and not _nameInList(out, nmO):
        out.append(nmO)
    oi += 1
  fi: int = 0
  while fi < len(cls.constFields):
    cfN: ConstField = cls.constFields[fi]
    nmF: str = cfN.name
    suf: str = "__value"
    if len(nmF) > len(suf) and nmF[len(nmF) - len(suf) :] == suf:
      propF: str = nmF[: len(nmF) - len(suf)]
      if _isIdent(propF) and not _nameInList(out, propF):
        out.append(propF)
    fi += 1
  return out

def _staticPropertyNames(cls: ClassBundle) -> list[str]:
  out: list[str] = []
  pref: str = "static property "
  lines: list[str] = cls.bodySource.split("\n")
  li: int = 0
  while li < len(lines):
    s: str = lines[li].strip()
    if len(s) >= len(pref) + 1 and s[: len(pref)] == pref and s[len(s) - 1] == ":":
      nm: str = s[len(pref) : len(s) - 1].strip()
      if _isIdent(nm):
        out.append(nm)
    li += 1
  oi: int = 0
  while oi < len(cls.opaqueMembers):
    sO: str = cls.opaqueMembers[oi].strip()
    if len(sO) >= len(pref) + 1 and sO[: len(pref)] == pref and sO[len(sO) - 1] == ":":
      nmO: str = sO[len(pref) : len(sO) - 1].strip()
      if _isIdent(nmO) and not _nameInList(out, nmO):
        out.append(nmO)
    oi += 1
  return out

def _methodEmitName(
  fn: FunctionBundle, cls: ClassBundle, propGetIdx: int, propSetIdx: int,
  propPostIdx: int
) -> str:
  props: list[str] = _classPropertyNames(cls)
  if fn.name == "__get__":
    if propGetIdx < len(props):
      return props[propGetIdx] + "__get"
    return fn.name
  if fn.name == "__set__":
    if propSetIdx < len(props):
      return props[propSetIdx] + "__set"
    return fn.name
  if fn.name == "__post_set__":
    if propPostIdx < len(props):
      return props[propPostIdx] + "__post_set"
    return fn.name
  return fn.name

def _rewritePropertyStorageBody(body: str, propName: str) -> str:
  if propName == "":
    return body
  storage: str = propName + "__value"
  out: str = body.replace("self.__value__", "this->" + storage)
  out = out.replace("this->__value__", "this->" + storage)
  out = out.replace("Self.__value__", storage)
  # 先吃掉已是 ``self.x__value``，避免 ``return self.x`` 前缀误伤成 ``x__value__value``
  out = out.replace("self." + storage, "this->" + storage)
  out = out.replace("self." + propName + " =", "this->" + storage + " =")
  out = out.replace("return self." + propName, "return this->" + storage)
  # 其余 ``self.foo`` → ``this->foo``（post_set 体等）
  out = out.replace("self.", "this->")
  return out

def _isUserPropName(st: EnumEmitState, attr: str) -> bool:
  return attr in st.userPropNames

def _emitModuleDunderName(st: EnumEmitState) -> str:
  mp: str = st.modulePath
  if _isTestEntry(mp):
    return "PyStr(\"__main__\")"
  dotted: str = mp.replace("/", ".")
  return "PyStr(\"" + dotted + "\")"

def _emitModuleDunderFile(st: EnumEmitState) -> str:
  mp: str = st.modulePath
  pyPath: str = mp
  if len(mp) >= 4 and mp[len(mp) - 4 :] == ".paw":
    pyPath = mp[: len(mp) - 4] + ".py"
  elif len(mp) >= 3 and mp[len(mp) - 3 :] != ".py":
    pyPath = mp + ".py"
  return "PyStr(\"" + pyPath + "\")"

def _findClassByName(mod: SyntaxModule, name: str) -> ClassBundle:
  empty: ClassBundle = new()
  i: int = 0
  while i < len(mod.classes):
    if mod.classes[i].name == name:
      return mod.classes[i]
    i += 1
  return empty

def _isGenericTypeName(nm: str) -> bool:
  """``Proxy[Element]`` / ``list[int]`` 形。"""
  s: str = nm.strip()
  if "[" not in s:
    return False
  if s[len(s) - 1] != "]":
    return False
  lb: int = s.find("[")
  if lb <= 0:
    return False
  return _isIdent(s[:lb].strip())

def _splitBaseNames(basesSource: str) -> list[str]:
  outB: list[str] = []
  s: str = basesSource.strip()
  if s == "":
    return outB
  if len(s) >= 2 and s[0] == "(" and s[len(s) - 1] == ")":
    s = s[1 : len(s) - 1].strip()
  parts: list[str] = _splitParams(s)
  pi: int = 0
  while pi < len(parts):
    nm: str = parts[pi].strip()
    if len(nm) >= 2 and nm[0] == "(" and nm[len(nm) - 1] == ")":
      nm = nm[1 : len(nm) - 1].strip()
    # ``friends=(A,)`` 不是基类
    if len(nm) >= 8 and nm[:8] == "friends=":
      pi += 1
      continue
    if _isIdent(nm):
      outB.append(nm)
    elif _isGenericTypeName(nm):
      outB.append(nm)
    pi += 1
  return outB

def _proxyTplParamFromBases(basesSource: str) -> str:
  """``Proxy[Element]`` → ``Element``；无则空。"""
  bases: list[str] = _splitBaseNames(basesSource)
  bi: int = 0
  while bi < len(bases):
    bnm: str = bases[bi].strip()
    if len(bnm) >= 7 and bnm[:6] == "Proxy[" and bnm[len(bnm) - 1] == "]":
      inner: str = bnm[6 : len(bnm) - 1].strip()
      if _isIdent(inner):
        return inner
    bi += 1
  return ""

def _collectTplNamesFromBases(basesSource: str) -> list[str]:
  outT: list[str] = []
  pt: str = _proxyTplParamFromBases(basesSource)
  if pt != "":
    outT.append(pt)
  bases: list[str] = _splitBaseNames(basesSource)
  bi: int = 0
  while bi < len(bases):
    bnm: str = bases[bi].strip()
    if "[" in bnm and bnm[len(bnm) - 1 :] == "]":
      lb: int = bnm.find("[")
      inner: str = bnm[lb + 1 : len(bnm) - 1].strip()
      parts: list[str] = _splitParams(inner)
      pi: int = 0
      while pi < len(parts):
        p: str = parts[pi].strip()
        if _looksLikeTypeVarName(p) and not _nameInList(outT, p):
          outT.append(p)
        pi += 1
    bi += 1
  return outT

def _inferClassTplParams(mod: SyntaxModule, cls: ClassBundle) -> list[str]:
  """自基类 ``Foo[Element]`` 与其它类对本类的 ``Cls[T]`` 引用推断模板形参。"""
  outT: list[str] = _collectTplNamesFromBases(cls.basesSource)
  pref: str = cls.name + "["
  oi: int = 0
  while oi < len(mod.classes):
    other: ClassBundle = mod.classes[oi]
    basesO: list[str] = _splitBaseNames(other.basesSource)
    bi: int = 0
    while bi < len(basesO):
      bnm: str = basesO[bi].strip()
      if len(bnm) > len(pref) and bnm[: len(pref)] == pref and bnm[len(bnm) - 1 :] == "]":
        inner: str = bnm[len(pref) : len(bnm) - 1].strip()
        parts: list[str] = _splitParams(inner)
        pi: int = 0
        while pi < len(parts):
          p: str = parts[pi].strip()
          if _looksLikeTypeVarName(p) and not _nameInList(outT, p):
            outT.append(p)
          pi += 1
      bi += 1
    oi += 1
  return outT

def _nameInTplParams(st: EnumEmitState, name: str) -> bool:
  i: int = 0
  while i < len(st.typeParamNames):
    if st.typeParamNames[i] == name:
      return True
    i += 1
  return False

def _classTplPrefixFor(mod: SyntaxModule, cls: ClassBundle) -> str:
  tpls: list[str] = _inferClassTplParams(mod, cls)
  if len(tpls) == 0:
    tpls = _collectTplNamesFromBases(cls.basesSource)
  if len(tpls) == 0:
    return ""
  joined: str = ""
  ti: int = 0
  while ti < len(tpls):
    if ti > 0:
      joined = joined + ", "
    joined = joined + "typename " + tpls[ti]
    ti += 1
  return "template<" + joined + ">\n"

def _classTplPrefix(cls: ClassBundle) -> str:
  tpls: list[str] = _collectTplNamesFromBases(cls.basesSource)
  if len(tpls) == 0:
    return ""
  joined: str = ""
  ti: int = 0
  while ti < len(tpls):
    if ti > 0:
      joined = joined + ", "
    joined = joined + "typename " + tpls[ti]
    ti += 1
  return "template<" + joined + ">\n"

def _classCppNameTplSuffix(cls: ClassBundle) -> str:
  tpls: list[str] = _collectTplNamesFromBases(cls.basesSource)
  if len(tpls) == 0:
    return ""
  joined: str = ""
  ti: int = 0
  while ti < len(tpls):
    if ti > 0:
      joined = joined + ", "
    joined = joined + tpls[ti]
    ti += 1
  return "<" + joined + ">"

def _friendNamesFromBases(basesSource: str) -> list[str]:
  """``(friends=(VaultReader,))`` / ``(A, friends=(B,))`` → 友元类名。"""
  outF: list[str] = []
  s: str = basesSource.strip()
  if s == "":
    return outF
  key: str = "friends="
  ki: int = s.find(key)
  if ki < 0:
    return outF
  rest: str = s[ki + len(key) :].strip()
  if len(rest) == 0:
    return outF
  if rest[0] != "(":
    if _isIdent(rest):
      outF.append(rest)
    return outF
  depth: int = 0
  end: int = 0
  ri: int = 0
  while ri < len(rest):
    ch: str = rest[ri : ri + 1]
    if ch == "(":
      depth += 1
    if ch == ")":
      depth -= 1
      if depth == 0:
        end = ri
        break
    ri += 1
  if end <= 1:
    return outF
  inner: str = rest[1:end].strip()
  if len(inner) > 0 and inner[len(inner) - 1 :] == ",":
    inner = inner[: len(inner) - 1].strip()
  partsF: list[str] = _splitParams(inner)
  piF: int = 0
  while piF < len(partsF):
    nmF: str = partsF[piF].strip()
    if _isIdent(nmF):
      outF.append(nmF)
    piF += 1
  return outF

def _emitForwardClassDecls(mod: SyntaxModule) -> str:
  out: str = ""
  i: int = 0
  while i < len(mod.classes):
    # class type-if 自带 ``template<typename T> class PyX;``，勿再发非模板前向
    if _classHasTypeIf(mod.classes[i]):
      i += 1
      continue
    # 薄 tagged-union 擦除 Element：前向勿 ``template<>``
    if mod.classes[i].isUnion:
      out = out + "class Py" + mod.classes[i].name + ";\n"
      i += 1
      continue
    tplFwd: str = _classTplPrefixFor(mod, mod.classes[i])
    if tplFwd == "":
      tplFwd = _classTplPrefix(mod.classes[i])
    out = out + tplFwd + "class Py" + mod.classes[i].name + ";\n"
    i += 1
  return out

def _noteGetattrAttr(st: EnumEmitState, attr: str) -> None:
  if attr == "":
    return
  # runtime（如 task.inl）已 DECLARE 的 stdlib prop 勿重复展开
  if _isStdlibPropAttr(attr):
    return
  if attr in st.getattrAttrs:
    return
  st.getattrAttrs.append(attr)

def _noteSetattrAttr(st: EnumEmitState, attr: str) -> None:
  if attr == "":
    return
  if _isStdlibPropAttr(attr):
    return
  if attr in st.setattrAttrs:
    return
  st.setattrAttrs.append(attr)

def _emitPy2cppAccessDecls(st: EnumEmitState) -> str:
  out: str = ""
  if len(st.getattrAttrs) == 0:
    if len(st.setattrAttrs) == 0:
      return out
  out = out + "namespace paw {\nnamespace access {\n"
  gi: int = 0
  while gi < len(st.getattrAttrs):
    out = out + "PY2CPP_DECLARE_GETATTR(" + st.getattrAttrs[gi] + ")\n"
    gi += 1
  si: int = 0
  while si < len(st.setattrAttrs):
    out = out + "PY2CPP_DECLARE_SETATTR(" + st.setattrAttrs[si] + ")\n"
    si += 1
  out = out + "} // namespace access\n} // namespace paw\n\n"
  return out

def _clearUntypedParams(st: EnumEmitState) -> None:
  while len(st.untypedParamNames) > 0:
    st.untypedParamNames.pop()

def _rememberUntypedParams(st: EnumEmitState, paramsSource: str) -> None:
  _clearUntypedParams(st)
  parts: list[str] = _splitParams(paramsSource)
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if p == "" or p == "self":
      pi += 1
      continue
    if p.find(":") < 0:
      nm: str = p
      if len(nm) > 0 and nm[:1] == "*":
        pi += 1
        continue
      if _isIdent(nm):
        st.untypedParamNames.append(nm)
    pi += 1

def _isUntypedParamName(st: EnumEmitState, name: str) -> bool:
  return name in st.untypedParamNames

def _fnTypeParamsTemplatePrefix(typeParamsSource: str) -> str:
  """``[T: Bound]`` / ``[T, U]`` / ``[*Ts]`` → ``template<typename T>`` / ``typename... Ts``。"""
  s: str = typeParamsSource.strip()
  if len(s) < 3 or s[:1] != "[" or s[len(s) - 1 :] != "]":
    return ""
  inner: str = s[1 : len(s) - 1].strip()
  parts: list[str] = _splitParams(inner)
  tpls: list[str] = []
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if p == "":
      pi += 1
      continue
    # ``*Ts`` / ``*Ts: Bound`` → pack
    isPack: bool = False
    if len(p) > 0 and p[:1] == "*":
      isPack = True
      p = p[1:].strip()
    nm: str = p
    # ``_U = ...`` 捕获：勿进 template<>（由 type-if 引入）
    if p.find("=") >= 0:
      pi += 1
      continue
    col: int = p.find(":")
    if col > 0:
      nm = p[:col].strip()
    if _isIdent(nm):
      if isPack:
        tpls.append("typename... " + nm)
      else:
        tpls.append("typename " + nm)
    pi += 1
  if len(tpls) == 0:
    return ""
  joined: str = tpls[0]
  ji: int = 1
  while ji < len(tpls):
    joined = joined + ", " + tpls[ji]
    ji += 1
  return "template<" + joined + ">\n"

def _fnHasTypeVarTuple(typeParamsSource: str) -> bool:
  """``[*Ts]`` 形参包。"""
  s: str = typeParamsSource.strip()
  if len(s) < 3 or s[:1] != "[" or s[len(s) - 1 :] != "]":
    return False
  inner: str = s[1 : len(s) - 1].strip()
  parts: list[str] = _splitParams(inner)
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if len(p) > 0 and p[:1] == "*":
      return True
    pi += 1
  return False

def _fnHasBoxingBound(typeParamsSource: str) -> bool:
  """``[T: boxing]``。"""
  s: str = typeParamsSource.strip()
  if "boxing" not in s:
    return False
  return True

def _emitBoxingBoundBodyRaw(paramsSource: str, bodySrc: str) -> str:
  """``[T: boxing] def peek(node: T) -> int: return node.n`` → 原始 ``return node->n;``。"""
  parts: list[str] = _splitParams(paramsSource)
  nm: str = ""
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if p != "" and p != "self":
      col: int = p.find(":")
      if col >= 0:
        nm = p[:col].strip()
      else:
        nm = p
      break
    pi += 1
  if not _isIdent(nm):
    return "  return PyInt{};\n"
  # 找 ``return EXPR``
  lines: list[str] = bodySrc.replace("\r\n", "\n").split("\n")
  li: int = 0
  while li < len(lines):
    stL: str = lines[li].strip()
    if len(stL) >= 7 and stL[:7] == "return ":
      expr: str = stL[7:].strip()
      # ``node.n`` → ``node->n``
      needle: str = nm + "."
      if len(expr) >= len(needle) and expr[: len(needle)] == needle:
        expr = nm + "->" + expr[len(needle) :]
      return "  return " + expr + ";\n"
    li += 1
  return "  return PyInt{};\n"

def _variadicForLoopCallRaw(bodySrc: str, fnName: str, st: EnumEmitState) -> str:
  """``for x in args: total += x`` → ``__py2cpp_vt_loop_…::__call__(total, args...);``。"""
  if len(st.packParamNames) == 0:
    return ""
  lines: list[str] = bodySrc.replace("\r\n", "\n").split("\n")
  li: int = 0
  while li < len(lines):
    stL: str = lines[li].strip()
    if len(stL) >= 4 and stL[:4] == "for " and stL[len(stL) - 1 :] == ":":
      midF: str = stL[4 : len(stL) - 1].strip()
      inPos: int = midF.find(" in ")
      if inPos > 0:
        varF: str = midF[:inPos].strip()
        iterF: str = midF[inPos + 4 :].strip()
        if _isIdent(varF) and _isPackParamName(st, iterF) and li + 1 < len(lines):
          bodyLn: str = lines[li + 1].strip()
          accNm: str = ""
          if " += " in bodyLn:
            accNm = bodyLn[: bodyLn.find(" += ")].strip()
          elif " = " in bodyLn:
            accNm = bodyLn[: bodyLn.find(" = ")].strip()
          if _isIdent(accNm):
            tag: str = "__py2cpp_vt_loop_" + fnName + "_L1"
            return tag + "::__call__(" + accNm + ", " + iterF + "...);"
    li += 1
  return ""

def _stripVariadicForLoop(bodySrc: str, st: EnumEmitState) -> str:
  """删掉 ``for x in pack:`` 及其体行，留给 raw call 注入。"""
  if len(st.packParamNames) == 0:
    return bodySrc
  lines: list[str] = bodySrc.replace("\r\n", "\n").split("\n")
  outL: list[str] = []
  li: int = 0
  while li < len(lines):
    stL: str = lines[li].strip()
    if len(stL) >= 4 and stL[:4] == "for " and stL[len(stL) - 1 :] == ":":
      midF: str = stL[4 : len(stL) - 1].strip()
      inPos: int = midF.find(" in ")
      if inPos > 0:
        iterF: str = midF[inPos + 4 :].strip()
        if _isPackParamName(st, iterF):
          li += 2
          continue
    outL.append(lines[li])
    li += 1
  return "\n".join(outL)

def _fnTypeVarTupleName(typeParamsSource: str) -> str:
  """``[*Ts]`` → ``Ts``。"""
  s: str = typeParamsSource.strip()
  if len(s) < 3 or s[:1] != "[" or s[len(s) - 1 :] != "]":
    return ""
  inner: str = s[1 : len(s) - 1].strip()
  parts: list[str] = _splitParams(inner)
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if len(p) > 0 and p[:1] == "*":
      p = p[1:].strip()
      col: int = p.find(":")
      if col > 0:
        p = p[:col].strip()
      eqC: int = p.find("=")
      if eqC > 0:
        p = p[:eqC].strip()
      if _isIdent(p):
        return p
    pi += 1
  return ""

def _fnNeedsIndepVarargPack(typeParamsSource: str, paramsSource: str) -> bool:
  """``[*Ts](first, *rest)`` 无注解 ``*rest`` → 独立 ``__Ts...``。"""
  if not _fnHasTypeVarTuple(typeParamsSource):
    return False
  tsNm: str = _fnTypeVarTupleName(typeParamsSource)
  parts: list[str] = _splitParams(paramsSource)
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if len(p) > 0 and p[:1] == "*" and (len(p) < 2 or p[:2] != "**"):
      rest: str = p[1:].strip()
      col: int = rest.find(":")
      if col < 0:
        return True
      tySrc: str = rest[col + 1 :].strip()
      eq: int = tySrc.find("=")
      if eq >= 0:
        tySrc = tySrc[:eq].strip()
      if tySrc != tsNm:
        return True
    pi += 1
  return False

def _fnFullTemplatePrefix(typeParamsSource: str, paramsSource: str) -> str:
  """函数模板前缀：含 ``[*Ts]`` 与独立 ``__Ts``。"""
  needIndep: bool = _fnNeedsIndepVarargPack(typeParamsSource, paramsSource)
  # 直接从 typeParams 重建，避免对 ``">\n"`` 切片拼接（薄 emit soft-skip）
  s: str = typeParamsSource.strip()
  if len(s) >= 3 and s[:1] == "[" and s[len(s) - 1 :] == "]":
    inner: str = s[1 : len(s) - 1].strip()
    parts: list[str] = _splitParams(inner)
    tpls: list[str] = []
    pi: int = 0
    while pi < len(parts):
      p: str = parts[pi].strip()
      if p == "":
        pi += 1
        continue
      if p.find("=") >= 0:
        pi += 1
        continue
      isPack: bool = False
      if len(p) > 0 and p[:1] == "*":
        isPack = True
        p = p[1:].strip()
      nm: str = p
      col: int = p.find(":")
      if col > 0:
        nm = p[:col].strip()
      if _isIdent(nm):
        if isPack:
          tpls.append("typename... " + nm)
        else:
          tpls.append("typename " + nm)
      pi += 1
    if needIndep:
      tpls.append("typename... __Ts")
    if len(tpls) == 0:
      return ""
    joined: str = tpls[0]
    ji: int = 1
    while ji < len(tpls):
      joined = joined + ", " + tpls[ji]
      ji += 1
    return "template<" + joined + ">\n"
  base: str = _fnTemplatePrefix(paramsSource)
  if base == "":
    if needIndep:
      return "template<typename... __Ts>\n"
    return ""
  return base

def _emitVariadicForLoopHelper(fnName: str, bodySrc: str, st: EnumEmitState) -> str:
  """``for x in args: total += x`` → 前置 ``__py2cpp_vt_loop_*`` 结构体。"""
  if len(st.packParamNames) == 0:
    return ""
  lines: list[str] = bodySrc.replace("\r\n", "\n").split("\n")
  li: int = 0
  while li < len(lines):
    ln: str = lines[li].strip()
    # ``for x in args:``
    if len(ln) >= 4 and ln[:4] == "for " and ln[len(ln) - 1 :] == ":":
      midF: str = ln[4 : len(ln) - 1].strip()
      inPos: int = midF.find(" in ")
      if inPos > 0:
        varF: str = midF[:inPos].strip()
        iterF: str = midF[inPos + 4 :].strip()
        if _isIdent(varF) and _isPackParamName(st, iterF):
          # 下一行缩进体：``total += x`` / ``total = total + x``
          if li + 1 >= len(lines):
            return ""
          bodyLn: str = lines[li + 1].strip()
          # 仅支持 ``NAME += x`` / ``NAME = NAME + x``
          accNm: str = ""
          if len(bodyLn) >= 4 and " += " in bodyLn:
            accNm = bodyLn[: bodyLn.find(" += ")].strip()
          elif " = " in bodyLn and (" + " + varF) in bodyLn:
            accNm = bodyLn[: bodyLn.find(" = ")].strip()
          if not _isIdent(accNm):
            return ""
          tag: str = "__py2cpp_vt_loop_" + fnName + "_L1"
          outH: str = "struct " + tag + " {\n"
          outH = outH + "  template<typename TsHead>\n"
          outH = outH + "  static void step(PyInt& " + accNm + ", TsHead head) {\n"
          outH = outH + "    TsHead " + varF + " = head;\n"
          outH = outH + "    " + accNm + " = " + accNm + " + " + varF + ";\n"
          outH = outH + "  }\n"
          outH = outH + "  template<typename TsHead, typename... TsTail>\n"
          outH = (
            outH
            + "  static void __call__(PyInt& "
            + accNm
            + ", TsHead head, TsTail... tail) {\n"
          )
          outH = outH + "    step(" + accNm + ", head);\n"
          outH = outH + "    __call__(" + accNm + ", tail...);\n"
          outH = outH + "  }\n"
          outH = outH + "  template<typename... TsTail>\n"
          outH = (
            outH
            + "  static void __call__(PyInt& "
            + accNm
            + ", TsTail... tail) {\n"
          )
          outH = outH + "    (void)sizeof...(tail);\n"
          outH = outH + "  }\n"
          outH = outH + "};\n\n"
          return outH
    li += 1
  return ""

def _rewriteVariadicForLoopBody(bodySrc: str, fnName: str, st: EnumEmitState) -> str:
  """把 ``for x in args:\\n  total += x`` 换成 ``vt_loop::__call__(total, args...);``。"""
  if len(st.packParamNames) == 0:
    return bodySrc
  lines: list[str] = bodySrc.replace("\r\n", "\n").split("\n")
  outL: list[str] = []
  li: int = 0
  while li < len(lines):
    ln: str = lines[li]
    stL: str = ln.strip()
    if len(stL) >= 4 and stL[:4] == "for " and stL[len(stL) - 1 :] == ":":
      midF: str = stL[4 : len(stL) - 1].strip()
      inPos: int = midF.find(" in ")
      if inPos > 0:
        varF: str = midF[:inPos].strip()
        iterF: str = midF[inPos + 4 :].strip()
        if _isIdent(varF) and _isPackParamName(st, iterF) and li + 1 < len(lines):
          bodyLn: str = lines[li + 1].strip()
          accNm: str = ""
          if " += " in bodyLn:
            accNm = bodyLn[: bodyLn.find(" += ")].strip()
          elif " = " in bodyLn:
            accNm = bodyLn[: bodyLn.find(" = ")].strip()
          if _isIdent(accNm):
            tag: str = "__py2cpp_vt_loop_" + fnName + "_L1"
            ind: str = _lineLeadingSpaces(ln)
            outL.append(
              ind + tag + "::__call__(" + accNm + ", " + iterF + "...);"
            )
            li += 2
            continue
    outL.append(ln)
    li += 1
  return "\n".join(outL)

def _variadicTupleAssignRaw(bodySrc: str, st: EnumEmitState) -> str:
  """``t: (*Ts,) = args`` → raw ``PyTuple<Ts...> t(args...);``。"""
  if len(st.packParamNames) == 0:
    return ""
  lines: list[str] = bodySrc.replace("\r\n", "\n").split("\n")
  li: int = 0
  while li < len(lines):
    stL: str = lines[li].strip()
    colT: int = stL.find(":")
    eqT: int = stL.find("=")
    if colT > 0 and eqT > colT:
      nmT: str = stL[:colT].strip()
      tyT: str = stL[colT + 1 : eqT].strip()
      rhsT: str = stL[eqT + 1 :].strip()
      if _isIdent(nmT) and _isPackParamName(st, rhsT):
        if tyT.find("*") >= 0 and tyT.find("Ts") >= 0:
          return "PyTuple<Ts...> " + nmT + "(" + rhsT + "...);"
    li += 1
  return ""

def _stripVariadicTupleAssign(bodySrc: str, st: EnumEmitState) -> str:
  if len(st.packParamNames) == 0:
    return bodySrc
  lines: list[str] = bodySrc.replace("\r\n", "\n").split("\n")
  outL: list[str] = []
  li: int = 0
  while li < len(lines):
    stL: str = lines[li].strip()
    colT: int = stL.find(":")
    eqT: int = stL.find("=")
    skip: bool = False
    if colT > 0 and eqT > colT:
      nmT: str = stL[:colT].strip()
      tyT: str = stL[colT + 1 : eqT].strip()
      rhsT: str = stL[eqT + 1 :].strip()
      if _isIdent(nmT) and _isPackParamName(st, rhsT):
        if tyT.find("*") >= 0 and tyT.find("Ts") >= 0:
          skip = True
    if skip == False:
      outL.append(lines[li])
    li += 1
  return "\n".join(outL)

def _stripTrailingReturns(bodySrc: str) -> str:
  """剥掉函数体末尾 ``return …`` 行（vt_loop 注入需在 return 前）。"""
  lines: list[str] = bodySrc.replace("\r\n", "\n").split("\n")
  outL: list[str] = []
  li: int = 0
  while li < len(lines):
    stL: str = lines[li].strip()
    if len(stL) >= 6 and stL[:6] == "return":
      li += 1
      continue
    outL.append(lines[li])
    li += 1
  return "\n".join(outL)

def _stripEmittedTrailingReturn(emitted: str) -> str:
  """删 emitBody 自动追加的末尾 ``return …;``。"""
  lines: list[str] = emitted.replace("\r\n", "\n").split("\n")
  # 从尾往前找最后一条非空 return
  li: int = len(lines) - 1
  while li >= 0:
    stL: str = lines[li].strip()
    if stL == "":
      li -= 1
      continue
    if len(stL) >= 6 and stL[:6] == "return":
      # 丢掉本行及之后空行
      outL: list[str] = []
      ji: int = 0
      while ji < li:
        outL.append(lines[ji])
        ji += 1
      return "\n".join(outL) + "\n"
    break
  return emitted

def _rewriteViaTupleStarForward(bodySrc: str, st: EnumEmitState) -> str:
  """``t: (*Ts,) = args`` 后 ``sumAll(*t)`` → ``sumAll(*args)``（对齐宿主转发）。"""
  if len(st.packParamNames) == 0:
    return bodySrc
  lines: list[str] = bodySrc.replace("\r\n", "\n").split("\n")
  # 收集 ``t = pack`` 的元组局部名
  tupFromPack: list[str] = []
  li0: int = 0
  while li0 < len(lines):
    stL: str = lines[li0].strip()
    colT: int = stL.find(":")
    eqT: int = stL.find("=")
    if colT > 0 and eqT > colT:
      nmT: str = stL[:colT].strip()
      tyT: str = stL[colT + 1 : eqT].strip()
      rhsT: str = stL[eqT + 1 :].strip()
      if _isIdent(nmT) and _isPackParamName(st, rhsT):
        if tyT.find("*") >= 0:
          tupFromPack.append(nmT)
    li0 += 1
  if len(tupFromPack) == 0:
    return bodySrc
  pack0: str = st.packParamNames[0]
  outL: list[str] = []
  li: int = 0
  while li < len(lines):
    ln: str = lines[li]
    ti: int = 0
    while ti < len(tupFromPack):
      needle: str = "*" + tupFromPack[ti]
      # 仅替换 ``*t`` 整词（后非标识）
      pos: int = 0
      rebuilt: str = ""
      while pos < len(ln):
        at: int = ln.find(needle, pos)
        if at < 0:
          rebuilt = rebuilt + ln[pos:]
          break
        rebuilt = rebuilt + ln[pos:at]
        after: int = at + len(needle)
        chA: str = ""
        if after < len(ln):
          chA = ln[after : after + 1]
        okEnd: bool = True
        if chA != "":
          if _isIdentChar(chA):
            okEnd = False
        if okEnd:
          rebuilt = rebuilt + "*" + pack0
          pos = after
        else:
          rebuilt = rebuilt + ln[at:after]
          pos = after
      ln = rebuilt
      ti += 1
    outL.append(ln)
    li += 1
  return "\n".join(outL)

def _tyIsPyRefCount(ty: str) -> bool:
  """``PyRefCount<…>`` 判定（勿在 if 里写 ``"<"/">"`` 字面量）。"""
  s: str = ty.strip()
  if len(s) < 12:
    return False
  if s.find("PyRefCount") != 0:
    return False
  ltCh: str = "<"
  gtCh: str = ">"
  if s[10 : 11] != ltCh:
    return False
  if s[len(s) - 1 :] != gtCh:
    return False
  return True

def _pyRefCountInner(ty: str) -> str:
  """``PyRefCount<PyX>`` → ``PyX``。"""
  s: str = ty.strip()
  if not _tyIsPyRefCount(s):
    return ""
  return s[11 : len(s) - 1].strip()

def _refcountStorageTy(ty: str, st: EnumEmitState) -> str:
  """``@refcount`` 类（``PyNode`` / ``PyNode<…>``）→ ``PyRefCount<…>``；其余原样。"""
  s: str = ty.strip()
  if s == "" or _tyIsPyRefCount(s):
    return s
  if s[len(s) - 1 :] == "&":
    return s
  ltC: int = s.find("<")
  bare: str = s
  if ltC > 0:
    bare = s[:ltC].strip()
  if len(bare) < 3:
    return s
  if bare[:2] != "Py":
    return s
  name: str = bare[2:]
  if not _isRefClassName(st, name):
    return s
  return "PyRefCount<" + s + ">"

def _countPyTupleArity(ty: str) -> int:
  """``PyTuple<A, B>`` / ``PyTuple<A, B, C>`` → 元数；失败 0。"""
  s: str = ty.strip()
  # 剥 ``&`` / 尾空格
  while len(s) > 0 and s[len(s) - 1 :] == "&":
    s = s[: len(s) - 1].strip()
  if len(s) < 9 or s[:7] != "PyTuple":
    return 0
  ltCh: str = "<"
  gtCh: str = ">"
  cmCh: str = ","
  lb: int = s.find(ltCh)
  if lb < 0:
    return 0
  depth: int = 0
  n: int = 1
  ci: int = lb + 1
  nonempty: bool = False
  while ci < len(s):
    ch: str = s[ci : ci + 1]
    if ch == ltCh:
      depth += 1
      nonempty = True
    elif ch == gtCh:
      if depth == 0:
        break
      depth -= 1
    elif ch == cmCh and depth == 0:
      n += 1
      nonempty = True
    elif ch != " ":
      nonempty = True
    ci += 1
  if nonempty == False:
    return 0
  return n

def _expandStarTupleArg(name: str, st: EnumEmitState) -> str:
  """已知定长 ``PyTuple`` 的 ``*t`` → ``t.__getitem__(0), …``。"""
  ty: str = _localCppTypeOf(st, name)
  n: int = _countPyTupleArity(ty)
  if n <= 0:
    return ""
  em: str = _escapeCppIdent(name)
  out: str = em + ".__getitem__(0)"
  ii: int = 1
  while ii < n:
    out = out + ", " + em + ".__getitem__(" + str(ii) + ")"
    ii += 1
  return out

def _isIdentChar(ch: str) -> bool:
  if ch == "":
    return False
  if ch >= "a" and ch <= "z":
    return True
  if ch >= "A" and ch <= "Z":
    return True
  if ch >= "0" and ch <= "9":
    return True
  if ch == "_":
    return True
  return False

def _emitVarargPackExpr(elemTy: str, argCppParts: list[str], st: EnumEmitState) -> str:
  """标量/星号实参 → ``([&](){ PyArray<E,0> …; return __vap; })()``。"""
  eTy: str = elemTy
  if eTy == "":
    eTy = "PyInt"
  n: int = len(argCppParts)
  if n == 0:
    return "PyArray<" + eTy + ", 0>()"
  # 单整包转发 ``*nums`` 已剥成标识 → 直接传
  if n == 1:
    a0: str = argCppParts[0].strip()
    if a0 != "" and a0.find("(") < 0 and a0.find(",") < 0:
      # 可能已是数组名
      pass
  fill: str = "PyArray<" + eTy + ", 0> __vap(" + str(n) + "); "
  si: int = 0
  while si < n:
    fill = fill + "__vap.__setitem__(" + str(si) + ", " + argCppParts[si] + "); "
    si += 1
  return "([&](){ " + fill + "return __vap; })()"

def _emitVarargPackExprStarAware(
  elemTy: str, rawArgs: list[str], st: EnumEmitState
) -> str:
  """混杂 ``3, *a, 4``：先算长度再填（对齐宿主 ``__py2cpp_vap``）。"""
  eTy: str = elemTy
  if eTy == "":
    eTy = "PyInt"
  if len(rawArgs) == 0:
    return "PyArray<" + eTy + ", 0>()"
  # 纯标量、无星号 → 定长
  hasStar: bool = False
  ri0: int = 0
  while ri0 < len(rawArgs):
    r0: str = rawArgs[ri0].strip()
    if len(r0) > 0 and r0[:1] == "*":
      hasStar = True
      break
    ri0 += 1
  if hasStar == False:
    partsC: list[str] = []
    ri1: int = 0
    while ri1 < len(rawArgs):
      ax1: str = _emitCallArg(rawArgs[ri1], st)
      if ax1 == "" or ax1 == "__discard_kw__":
        ri1 += 1
        continue
      partsC.append(ax1)
      ri1 += 1
    return _emitVarargPackExpr(eTy, partsC, st)
  # 有 ``*pack``：IIFE 动态长度
  lenExpr: str = "PyInt __n = 0; "
  fillB: str = "PyInt __off = 0; "
  ri2: int = 0
  while ri2 < len(rawArgs):
    raw: str = rawArgs[ri2].strip()
    if len(raw) > 0 and raw[:1] == "*":
      starNm: str = raw[1:].strip()
      starCpp: str = _emitSimpleTerm(starNm, st)
      if starCpp == "":
        starCpp = _escapeCppIdent(starNm)
      lenExpr = lenExpr + "__n += (" + starCpp + ").__len__(); "
      fillB = (
        fillB
        + "for (PyInt __i = 0; __i < ("
        + starCpp
        + ").__len__(); __i += 1) { __vap.__setitem__(__off, ("
        + starCpp
        + ").__getitem__(__i)); __off += 1; } "
      )
    else:
      ax2: str = _emitCallArg(raw, st)
      if ax2 == "" or ax2 == "__discard_kw__":
        ri2 += 1
        continue
      lenExpr = lenExpr + "__n += 1; "
      fillB = fillB + "__vap.__setitem__(__off, " + ax2 + "); __off += 1; "
    ri2 += 1
  bodyV: str = (
    lenExpr
    + "PyArray<"
    + eTy
    + ", 0> __vap(__n); "
    + fillB
    + "return __vap; "
  )
  return "([&]() -> PyArray<" + eTy + ", 0> { " + bodyV + "})()"

def _fnTemplatePrefix(paramsSource: str) -> str:
  """无注解形参 → ``template<typename T0, …>``。"""
  parts: list[str] = _splitParams(paramsSource)
  tpls: list[str] = []
  ti: int = 0
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if p == "" or p == "self":
      pi += 1
      continue
    if p.find(":") < 0:
      nm: str = p
      if len(nm) > 0 and nm[:1] == "*":
        pi += 1
        continue
      if _isIdent(nm):
        tpls.append("typename T" + str(ti))
        ti += 1
    pi += 1
  if len(tpls) == 0:
    return ""
  joined: str = tpls[0]
  ji: int = 1
  while ji < len(tpls):
    joined = joined + ", " + tpls[ji]
    ji += 1
  return "template<" + joined + ">\n"

def _arrowCallableCpp(src: str, st: EnumEmitState) -> str:
  """``int -> str`` / ``() -> None`` / ``(int, int) -> int`` → ``PyCallable<…>``。"""
  s: str = src.strip()
  # 仅顶层 ``->``（勿吞 ``list[Callable[() -> int]]`` 内层箭头）
  ai: int = -1
  depthA: int = 0
  iA: int = 0
  dashA: str = "-"
  gtA: str = ">"
  while iA < len(s):
    chA: str = s[iA : iA + 1]
    if chA == "[" or chA == "(" or chA == "{":
      depthA = depthA + 1
    elif chA == "]" or chA == ")" or chA == "}":
      if depthA > 0:
        depthA = depthA - 1
    elif depthA == 0 and iA + 1 < len(s):
      if chA == dashA and s[iA + 1 : iA + 2] == gtA:
        ai = iA
        break
    iA = iA + 1
  if ai <= 0:
    return ""
  left: str = s[:ai].strip()
  right: str = s[ai + 2 :].strip()
  if right == "":
    return ""
  # 右侧仍含未闭合括号 → 非顶层签名
  if right.find("[") >= 0 or right.find("]") >= 0:
    return ""
  ret: str = _cppType(right, st)
  ltC: str = "<"
  gtC: str = ">"
  if left == "()" or left == "":
    if ret == "void":
      return "PyCallable" + ltC + "void" + gtC
    return "PyCallable" + ltC + ret + gtC
  if len(left) >= 2 and left[0:1] == "(" and left[len(left) - 1 : len(left)] == ")":
    left = left[1 : len(left) - 1].strip()
  if left == "":
    if ret == "void":
      return "PyCallable" + ltC + "void" + gtC
    return "PyCallable" + ltC + ret + gtC
  # ``list[…]`` / ``Callable[…]`` 整段误入：左端含 ``[`` 则拒绝
  if left.find("[") >= 0:
    return ""
  argsP: list[str] = _splitParams(left)
  joinedA: str = ""
  ai2: int = 0
  while ai2 < len(argsP):
    seg: str = _cppType(argsP[ai2].strip(), st)
    if joinedA == "":
      joinedA = seg
    else:
      joinedA = joinedA + ", " + seg
    ai2 += 1
  if joinedA == "":
    return "PyCallable" + ltC + ret + gtC
  return "PyCallable" + ltC + ret + ", " + joinedA + gtC

def _isDelegateDeclFn(fn: FunctionBundle) -> bool:
  if "@delegate" in fn.decoratorsSource.replace(" ", ""):
    return True
  bs: str = fn.bodySource.strip()
  if bs == "..." or bs == "pass" or bs == "":
    if len(fn.name) >= 8 and fn.name[len(fn.name) - 8 :] == "Delegate":
      return True
  return False

def _delegateTypeCpp(tySrc: str, st: EnumEmitState) -> str:
  """委托形参/返回类型：``None``/空→``void``；单字母模板形参保持原样。"""
  s: str = tySrc.strip()
  if s == "" or s == "None":
    return "void"
  if len(s) == 1:
    ch0: str = s[:1]
    if ch0 >= "A" and ch0 <= "Z":
      return s
  return _cppType(s, st)

def _emitDelegateClass(fn: FunctionBundle, st: EnumEmitState) -> str:
  """``delegate FuncDelegate[T](x: T) -> T`` → ``class PyFuncDelegate : public PyDelegate<…>``。"""
  name: str = fn.name
  cppN: str = "Py" + name
  ret: str = _delegateTypeCpp(fn.returnSource, st)
  params: str = fn.paramsSource.strip()
  argTys: list[str] = []
  callArgs: str = ""
  callDecls: str = ""
  parts: list[str] = _splitParams(params)
  tplNames: list[str] = []
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if p == "" or p == "self":
      pi += 1
      continue
    nm: str = p
    tySrc: str = ""
    colon: int = p.find(":")
    if colon >= 0:
      nm = p[:colon].strip()
      tySrc = p[colon + 1 :].strip()
      eq: int = tySrc.find("=")
      if eq >= 0:
        tySrc = tySrc[:eq].strip()
    ty: str = "PyInt"
    if tySrc != "":
      ty = _delegateTypeCpp(tySrc, st)
      tyStrip: str = tySrc.strip()
      if len(tyStrip) == 1:
        if tyStrip >= "A" and tyStrip <= "Z":
          if tyStrip not in tplNames:
            tplNames.append(tyStrip)
    else:
      # 无注解形参 → 模板实参 A/B/C…
      letter: str = "A"
      nTpl: int = len(tplNames)
      if nTpl == 1:
        letter = "B"
      if nTpl == 2:
        letter = "C"
      if nTpl == 3:
        letter = "D"
      ty = letter
      if letter not in tplNames:
        tplNames.append(letter)
    argTys.append(ty)
    if callDecls != "":
      callDecls = callDecls + ", "
      callArgs = callArgs + ", "
    callDecls = callDecls + ty + " " + nm
    callArgs = callArgs + nm
    pi += 1
  retStrip: str = fn.returnSource.strip()
  if len(retStrip) == 1:
    if retStrip >= "A" and retStrip <= "Z":
      if retStrip not in tplNames:
        tplNames.append(retStrip)
  baseArgs: str = ""
  bi: int = 0
  while bi < len(argTys):
    if baseArgs != "":
      baseArgs = baseArgs + ", "
    baseArgs = baseArgs + argTys[bi]
    bi += 1
  base: str = "PyDelegate<" + ret + ">"
  if baseArgs != "":
    base = "PyDelegate<" + ret + ", " + baseArgs + ">"
  out: str = ""
  if len(tplNames) > 0:
    tdecl: str = ""
    ti: int = 0
    while ti < len(tplNames):
      if tdecl != "":
        tdecl = tdecl + ", "
      tdecl = tdecl + "typename " + tplNames[ti]
      ti += 1
    out = out + "template<" + tdecl + ">\n"
  out = out + "class " + cppN + " : public " + base + " {\n"
  out = out + "public:\n"
  out = out + "  using Base = " + base + ";\n"
  out = out + "  using Base::Base;\n"
  if callDecls != "":
    out = out + "  " + ret + " operator()(" + callDecls + ") const {\n"
  else:
    out = out + "  " + ret + " operator()() const {\n"
  if ret == "void":
    if callArgs != "":
      out = out + "    Base::_invoke(" + callArgs + ");\n"
    else:
      out = out + "    Base::_invoke();\n"
  else:
    if callArgs != "":
      out = out + "    return Base::_invoke(" + callArgs + ");\n"
    else:
      out = out + "    return Base::_invoke();\n"
  out = out + "  }\n"
  out = out + "};\n"
  return out

def _collectDelegateOpaques(mod: SyntaxModule) -> list[str]:
  """``delegate Name[T](…) -> R`` 落在 Opaque 时收集源行。"""
  out: list[str] = []
  i: int = 0
  while i < len(mod.items):
    it: ModuleItem = mod.items[i]
    if it.kind == ItemKindEnum.Opaque:
      op: str = it.opaqueSource.strip()
      if len(op) >= 9 and op[:9] == "delegate ":
        out.append(op)
    i += 1
  return out

def _emitDelegateFromOpaque(line: str, st: EnumEmitState) -> str:
  """解析一行 ``delegate Name[T](x: T) -> T``。"""
  s: str = line.strip()
  if len(s) < 9 or s[:9] != "delegate ":
    return ""
  rest: str = s[9:].strip()
  # Name[T](params) -> Ret
  name: str = ""
  ni: int = 0
  while ni < len(rest) and _isIdentContCh(rest[ni : ni + 1]):
    ni += 1
  if ni == 0:
    return ""
  name = rest[:ni]
  rest2: str = rest[ni:].strip()
  tp: str = ""
  if len(rest2) > 0 and rest2[0] == "[":
    rb: int = rest2.find("]")
    if rb > 0:
      tp = rest2[1:rb].strip()
      rest2 = rest2[rb + 1 :].strip()
  if len(rest2) == 0 or rest2[0] != "(":
    return ""
  # params to matching )
  depth: int = 0
  pi: int = 0
  while pi < len(rest2):
    ch: str = rest2[pi : pi + 1]
    if ch == "(":
      depth += 1
    if ch == ")":
      depth -= 1
      if depth == 0:
        break
    pi += 1
  if pi >= len(rest2):
    return ""
  params: str = rest2[1:pi].strip()
  rest3: str = rest2[pi + 1 :].strip()
  ret: str = "None"
  arrowMark: str = "->"
  if len(rest3) >= 2 and rest3[:2] == arrowMark:
    ret = rest3[2:].strip()
    if len(ret) > 0 and ret[len(ret) - 1 :] == ":":
      ret = ret[: len(ret) - 1].strip()
  fn: FunctionBundle = new()
  fn.name = name
  fn.paramsSource = params
  fn.returnSource = ret
  fn.bodySource = "..."
  # ``[T]`` 显式类型参：保证 params/return 能识别到 T
  if tp != "" and params.find(tp) < 0 and ret.find(tp) < 0:
    # 无引用时仍靠 tplNames 从 return/params 收集；此处把 tp 注入 return 旁路
    if len(tp.strip()) == 1:
      if ret == "None" or ret == "":
        ret = tp.strip()
        fn.returnSource = ret
  out: str = _emitDelegateClass(fn, st)
  return out

def _localLooksDelegate(st: EnumEmitState, name: str) -> bool:
  ty: str = _localCppTypeOf(st, name)
  if ty.find("Delegate") >= 0:
    return True
  if ty.find("PyCallable") >= 0:
    return True
  return False

def _effectiveBaseNames(mod: SyntaxModule, cls: ClassBundle) -> list[str]:
  bases: list[str] = _splitBaseNames(cls.basesSource)
  if len(bases) > 0:
    return bases
  inferred: str = ""
  mi: int = 0
  while mi < len(cls.methods):
    fn: FunctionBundle = cls.methods[mi]
    # 静态 override（协议）勿推断 C++ 基类（否则 Widget→Labeled 误绑）
    if fn.isOverride and (not fn.isStatic):
      oi: int = 0
      while oi < len(mod.classes):
        cand: ClassBundle = mod.classes[oi]
        if cand.name == cls.name:
          oi += 1
          continue
        bf: FunctionBundle = _classMethodByName(cand, fn.name)
        if bf.name != "":
          if bf.isAbstract or bf.isVirtual or bf.isOverride:
            if not bf.isStatic:
              inferred = cand.name
        oi += 1
    mi += 1
  if inferred != "":
    outI: list[str] = []
    outI.append(inferred)
    return outI
  return bases

def _classMethodByName(cls: ClassBundle, meth: str) -> FunctionBundle:
  empty: FunctionBundle = new()
  mi: int = 0
  while mi < len(cls.methods):
    if cls.methods[mi].name == meth:
      return cls.methods[mi]
    mi += 1
  return empty

def _methodDeclaredVirtual(mod: SyntaxModule, cls: ClassBundle, meth: str) -> bool:
  fn: FunctionBundle = _classMethodByName(cls, meth)
  if fn.name == "":
    return False
  if fn.isAbstract:
    return True
  if fn.isVirtual:
    return True
  bases: list[str] = _effectiveBaseNames(mod, cls)
  bi: int = 0
  while bi < len(bases):
    base: ClassBundle = _findClassByName(mod, bases[bi])
    if base.name != "":
      if _methodDeclaredVirtual(mod, base, meth):
        return True
    bi += 1
  return False

def _qualifyMixinCppBase(bnm: str) -> str:
  """stdlib Mixin → 限定名（对齐 mid_emit 命名空间）。"""
  if bnm == "UIPanelMixin":
    return "paw::ui::panel::PyUIPanelMixin"
  if bnm == "UIFlowMixin":
    return "paw::ui::flow::panel::PyUIFlowMixin"
  if bnm == "ECSWorldMixin":
    return "paw::design::ecs::PyECSWorldMixin"
  return ""

def _isErasedMixinBase(bnm: str) -> bool:
  """runtime 空壳 / 须宿主内联展开的 Mixin（勿发 C++ 基类）。"""
  if bnm == "ArgumentParserMixin":
    return True
  if bnm == "UIPanelMixin":
    return True
  if bnm == "UIFlowMixin":
    return True
  if bnm == "ECSWorldMixin":
    return True
  if bnm == "AsyncCloseMixin":
    return True
  if bnm == "CloseMixin":
    return True
  if bnm == "ServerMixin":
    return True
  if bnm == "AsyncServerMixin":
    return True
  if bnm == "TestCaseMixin":
    return True
  return False

def _mixinCarriedBase(bnm: str) -> str:
  """``ServerMixin(Server)`` → 宿主继承 ``Server``（方法仍须薄展开）。"""
  if bnm == "ServerMixin":
    return "Server"
  if bnm == "AsyncServerMixin":
    return "AsyncServer"
  return ""

def _hostHasMixin(cls: ClassBundle, mixin: str) -> bool:
  if mixin in cls.basesSource:
    return True
  return False

def _eraseProtocolStem(proto: str) -> str:
  """``ContextManagerType`` → ``ContextManager``（对齐 protocol_erase）。"""
  if len(proto) >= 4 and proto[len(proto) - 4 :] == "Type":
    return proto[: len(proto) - 4]
  return proto

def _isErasedProtocolPyType(ty: str) -> bool:
  """``PyContextManager<…>`` / ``PyCoroutine<…>`` 等擦除句柄。"""
  if len(ty) < 3 or ty[:2] != "Py":
    return False
  if ty.find("PyContextManager") == 0:
    return True
  if ty.find("PyCoroutine") == 0:
    return True
  if ty.find("PyGenerator") == 0:
    return True
  if ty.find("PyAsyncGenerator") == 0:
    return True
  if ty.find("PyAwaitable") == 0:
    return True
  if ty.find("PyIterator") == 0:
    return True
  if ty.find("PyAsyncIterator") == 0:
    return True
  return False

def _makeErasedProtocolExpr(erasedCpp: str, concreteExpr: str) -> str:
  """``PyContextManager<T>`` + 具体 → ``makeContextManager<T>(…)``。"""
  t: str = erasedCpp.strip()
  if len(t) < 3 or t[:2] != "Py":
    return concreteExpr
  rest: str = t[2:]
  stem: str = rest
  args: str = ""
  lt: int = rest.find("<")
  if lt > 0 and rest[len(rest) - 1 :] == ">":
    stem = rest[:lt]
    args = rest[lt + 1 : len(rest) - 1]
  fn: str = "make" + stem
  if args != "":
    return fn + "<" + args + ">(" + concreteExpr + ")"
  return fn + "(" + concreteExpr + ")"

def _looksLikeTypeVarName(nm: str) -> bool:
  if not _isIdent(nm):
    return False
  if nm == "Element" or nm == "Key" or nm == "Value" or nm == "Node":
    return True
  if nm == "Lead" or nm == "Other" or nm == "Component":
    return True
  if len(nm) == 1 and nm >= "A" and nm <= "Z":
    return True
  return False

def _classInheritanceClause(cls: ClassBundle, mod: SyntaxModule, st: EnumEmitState) -> str:
  if _isTestCaseHost(cls):
    return " : public paw::test::unittest::PyTestCase"
  bases: list[str] = _effectiveBaseNames(mod, cls)
  if len(bases) == 0:
    return ""
  outI: str = ""
  bi: int = 0
  while bi < len(bases):
    bnm: str = bases[bi]
    cppBase: str = ""
    carried: str = _mixinCarriedBase(bnm)
    if carried != "":
      cppBase = "Py" + carried
    elif _isErasedMixinBase(bnm):
      cppBase = ""
    elif _isIdent(bnm):
      cppBase = "Py" + bnm
    elif _isGenericTypeName(bnm):
      cppBase = _cppType(bnm, st)
    if cppBase != "":
      if outI == "":
        outI = " : public " + cppBase
      else:
        outI = outI + ", public " + cppBase
    bi += 1
  return outI

def _firstBaseCpp(cls: ClassBundle, mod: SyntaxModule, st: EnumEmitState) -> str:
  bases: list[str] = _effectiveBaseNames(mod, cls)
  if len(bases) == 0:
    return ""
  bnm: str = bases[0].strip()
  if bnm == "" or bnm == "object" or _isErasedMixinBase(bnm):
    return ""
  if _isIdent(bnm):
    return "Py" + bnm
  if _isGenericTypeName(bnm):
    return _cppType(bnm, st)
  return ""

def _collectTestHosts(mod: SyntaxModule, sortKey: str) -> list[str]:
  """按类声明序收集；``sortKey`` 预留（多数测例单宿主）。"""
  _ = sortKey
  hosts: list[str] = []
  i: int = 0
  while i < len(mod.classes):
    cls: ClassBundle = mod.classes[i]
    if _isTestCaseHost(cls):
      hosts.append(cls.name)
    i += 1
  return hosts

def _expandTestDiscovery(body: str, mod: SyntaxModule) -> str:
  """``for Class in TestCaseMixin.iterSubclasses(...): suite.addTest(Class())`` → 显式 addTest。"""
  lines: list[str] = body.split("\n")
  outL: list[str] = []
  i: int = 0
  while i < len(lines):
    s: str = lines[i]
    st: str = s.strip()
    if (
      len(st) >= 4
      and st[:4] == "for "
      and st[len(st) - 1] == ":"
      and "iterSubclasses" in st
    ):
      sortKey: str = "_testTag" if "sortConst" in st else ""
      hosts: list[str] = _collectTestHosts(mod, sortKey)
      # suite var: look ahead ``suite.addTest``
      suiteVar: str = "suite"
      i += 1
      if i < len(lines):
        body1: str = lines[i].strip()
        if ".addTest(" in body1:
          suiteVar = body1[: body1.find(".addTest(")].strip()
        i += 1
      hi: int = 0
      while hi < len(hosts):
        outL.append(
          "  "
          + suiteVar
          + ".addTest(makeRefCount<Py"
          + hosts[hi]
          + ">());"
        )
        hi += 1
      continue
    outL.append(s)
    i += 1
  return "\n".join(outL)

def _emitPrintStmt(inner: str, st: EnumEmitState) -> str:
  """``print(a, b, …)`` → ``printf``（测例冒烟）。"""
  parts: list[str] = _splitParams(inner)
  if len(parts) == 0:
    return "  printf(\"\\n\");\n"
  fmt: str = ""
  args: list[str] = []
  pi: int = 0
  while pi < len(parts):
    if pi > 0:
      fmt = fmt + " "
    p: str = parts[pi].strip()
    if len(p) >= 2 and p[0] == '"' and p[len(p) - 1] == '"':
      lit: str = p[1 : len(p) - 1].replace("%", "%%")
      fmt = fmt + lit
    else:
      fmt = fmt + "%s"
      term: str = _emitSimpleTerm(p, st)
      if term == "":
        return ""
      args.append("PyStr::PrintfArg(PyStr(" + term + ")).data")
    pi += 1
  fmt = fmt + "\\n"
  if len(args) == 0:
    return "  printf(\"" + fmt + "\");\n"
  joined: str = args[0]
  ai: int = 1
  while ai < len(args):
    joined = joined + ", " + args[ai]
    ai += 1
  return "  printf(\"" + fmt + "\", " + joined + ");\n"

def _withDefaultScalarTemplate(cppTy: str) -> str:
  """``paw.spatial`` 等单参 ``_Scalar`` 类默认 ``PyFloat``（与 host 默认一致）。"""
  if cppTy.find("<") >= 0:
    return cppTy
  if cppTy == "PyVector2":
    return "PyVector2<PyFloat>"
  if cppTy == "PyVector3":
    return "PyVector3<PyFloat>"
  if cppTy == "PyVector4":
    return "PyVector4<PyFloat>"
  if cppTy == "PyRotator":
    return "PyRotator<PyFloat>"
  if cppTy == "PyQuaternion":
    return "PyQuaternion<PyFloat>"
  if cppTy == "PyMatrix3":
    return "PyMatrix3<PyFloat>"
  if cppTy == "PyMatrix4":
    return "PyMatrix4<PyFloat>"
  if cppTy == "PyTransform2D":
    return "PyTransform2D<PyFloat>"
  if cppTy == "PyTransform3D":
    return "PyTransform3D<PyFloat>"
  # spatial ``Rect`` → ``PyRect<PyFloat>``（用户类见 ``_cppType`` 旁路）
  if cppTy == "PyRect":
    return "PyRect<PyFloat>"
  if cppTy == "PyColor":
    return "PyColor<PyFloat>"
  if cppTy == "PyColorMatrix":
    return "PyColorMatrix<PyFloat>"
  # concur：裸 ``Task`` 的静态成员须带默认模板实参
  if cppTy == "PyTask":
    return "PyTask<PyNone>"
  # math：裸名默认 float64；``Random[float64]`` 走 ``Name[T]`` 勿再叠一层
  if cppTy == "PyRandom":
    return "PyRandom<PyFloat64>"
  if cppTy == "PyNormalDist":
    return "PyNormalDist<PyFloat64>"
  if cppTy == "PyLinearRegression":
    return "PyLinearRegression<PyFloat64>"
  return cppTy

def _cppTypeUnionOptional(s: str, st: EnumEmitState) -> str:
  """``T | None`` / ``None | T`` → ``PyOptional<T>``。"""
  if " | " not in s:
    return ""
  parts: list[str] = _splitParams(s.replace(" | ", ","))
  if len(parts) != 2:
    return ""
  a: str = parts[0].strip()
  b: str = parts[1].strip()
  if a == "None":
    inner: str = _cppTypeInner(b, st)
    if inner != "" and inner != "void":
      return "PyOptional<" + inner + ">"
  if b == "None":
    inner2: str = _cppTypeInner(a, st)
    if inner2 != "" and inner2 != "void":
      return "PyOptional<" + inner2 + ">"
  return ""

def _stripFieldTypeDecorators(tySrc: str) -> str:
  t: str = tySrc.strip()
  # ``ref T`` / ``lazy T`` 前缀（注解 ``p: ref Position``）
  if len(t) >= 4 and t[:4] == "ref ":
    t = t[4:].strip()
  if len(t) >= 5 and t[:5] == "lazy ":
    t = t[5:].strip()
  at: int = t.find("@")
  if at > 0:
    return t[:at].strip()
  return t

def _lineHasThreadLocal(line: str) -> bool:
  """类体字段行 ``T @thread_local`` / ``T @ thread_local``。"""
  if line.find("@thread_local") >= 0:
    return True
  if line.find("@ thread_local") >= 0:
    return True
  return False

def _typeSrcHasRefPrefix(tySrc: str) -> bool:
  t: str = tySrc.strip()
  if len(t) >= 4 and t[:4] == "ref ":
    return True
  # ``T @ref`` / ``T@ref``
  if t.find("@ref") >= 0:
    return True
  return False

def _depth0AssignRhs(s: str) -> str:
  """取括号/方括号/花括号外、引号外的 ``=`` 右侧（跳过 ``@OptArgMeta(short=\"-m\")`` 内 ``=``）。"""
  depth: int = 0
  inStr: bool = False
  qCh: str = ""
  i: int = 0
  eqAt: int = -1
  n: int = len(s)
  while i < n:
    ch: str = s[i : i + 1]
    if inStr:
      if ch == "\\" and i + 1 < n:
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      inStr = True
      qCh = ch
      i += 1
      continue
    if ch == "(" or ch == "[" or ch == "{":
      depth += 1
      i += 1
      continue
    if ch == ")" or ch == "]" or ch == "}":
      depth -= 1
      i += 1
      continue
    if ch == "=" and depth == 0:
      prev: str = ""
      if i > 0:
        prev = s[i - 1 : i]
      nxt: str = ""
      if i + 1 < n:
        nxt = s[i + 1 : i + 2]
      badEq: bool = False
      if prev == "=":
        badEq = True
      if prev == "!":
        badEq = True
      ltCh: str = "<"
      gtCh: str = ">"
      if prev == ltCh:
        badEq = True
      if prev == gtCh:
        badEq = True
      if nxt == "=":
        badEq = True
      if badEq == False:
        eqAt = i
    i += 1
  if eqAt < 0:
    return ""
  return s[eqAt + 1 :].strip()

def _emitAssignKwargsStmt(line: str, st: EnumEmitState) -> str:
  """``obj.assign(a=1, b=\"x\")`` → 逐字段赋值。"""
  s: str = line.strip()
  loc: int = s.find(".assign(")
  if loc < 0:
    return ""
  if s[len(s) - 1] != ")":
    return ""
  recv: str = s[:loc].strip()
  inner: str = s[loc + 8 : len(s) - 1].strip()
  if recv == "" or inner == "":
    return ""
  recvCpp: str = _emitSimpleTerm(recv, st)
  if recvCpp == "":
    if _isIdent(recv):
      recvCpp = recv
    else:
      return ""
  parts: list[str] = _splitParams(inner)
  outA: str = ""
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    eq: int = _bareKwEqPos(p)
    if eq <= 0:
      return ""
    field: str = p[:eq].strip()
    val: str = p[eq + 1 :].strip()
    if not _isIdent(field):
      return ""
    termV: str = _emitSimpleTerm(val, st)
    if termV == "":
      if val == "True":
        termV = "true"
      elif val == "False":
        termV = "false"
      else:
        return ""
    outA = outA + "  " + recvCpp + "." + field + " = " + termV + ";\n"
    pi += 1
  return outA

def _recordDefaultFromBody(body: str, fieldName: str) -> str:
  lines: list[str] = body.split("\n")
  li: int = 0
  while li < len(lines):
    s: str = lines[li].strip()
    pref: str = fieldName + ":"
    if len(s) >= len(pref) and s[: len(pref)] == pref:
      rhs: str = _depth0AssignRhs(s)
      if rhs != "":
        return rhs
    li += 1
  return ""

def _fieldIsOptionalInBody(body: str, fieldName: str) -> bool:
  """``x: T @optional = …`` — 不参与 record ``==`` / ``order``。"""
  lines: list[str] = body.split("\n")
  li: int = 0
  while li < len(lines):
    s: str = lines[li].strip()
    pref: str = fieldName + ":"
    if len(s) >= len(pref) and s[: len(pref)] == pref:
      if "@optional" in s:
        return True
      return False
    li += 1
  return False

def _isSerializableCls(cls: ClassBundle) -> bool:
  return "serializable" in cls.decoratorsSource

def _isSerializableName(st: EnumEmitState, name: str) -> bool:
  return name in st.serializableNames

def _variantFieldsFromClass(mod: SyntaxModule, name: str, fieldCsv: list[str], typeCsv: list[str]) -> None:
  """``HasCode`` variant/record 字段并入（``variant Ping(HasCode)``）。
  薄 emit 禁 ``list[i]=``：用 pop/append 重建。"""
  while len(fieldCsv) > 0:
    fieldCsv.pop()
  while len(typeCsv) > 0:
    typeCsv.pop()
  cls: ClassBundle = _findClassByName(mod, name)
  if cls.name == "":
    fieldCsv.append("")
    typeCsv.append("")
    return
  fAcc: str = ""
  tAcc: str = ""
  seenV: list[str] = []
  if cls.isVariant or cls.bodySource != "":
    linesH: list[str] = cls.bodySource.split("\n")
    liH: int = 0
    while liH < len(linesH):
      sH: str = linesH[liH].strip()
      colonH: int = sH.find(":")
      if colonH > 0 and _isIdent(sH[:colonH].strip()):
        fnH: str = sH[:colonH].strip()
        tyH: str = _stripFieldTypeDecorators(sH[colonH + 1 :].strip())
        eqH: int = tyH.find("=")
        if eqH >= 0:
          tyH = tyH[:eqH].strip()
        if fnH != "" and not _nameInList(seenV, fnH):
          seenV.append(fnH)
          if fAcc == "":
            fAcc = fnH
            tAcc = tyH
          else:
            fAcc = fAcc + "," + fnH
            tAcc = tAcc + "," + tyH
      liH += 1
  fiH: int = 0
  while fiH < len(cls.constFields):
    cfH: ConstField = cls.constFields[fiH]
    if cfH.name != "" and not _nameInList(seenV, cfH.name):
      seenV.append(cfH.name)
      if fAcc == "":
        fAcc = cfH.name
        tAcc = cfH.typeName
      else:
        fAcc = fAcc + "," + cfH.name
        tAcc = tAcc + "," + cfH.typeName
    fiH += 1
  fieldCsv.append(fAcc)
  typeCsv.append(tAcc)

def _parseUnionVariants(
  body: str, names: list[str], fieldCsv: list[str], typeCsv: list[str]
) -> None:
  """从 union 体解析 ``variant Name:`` 与字段；扁平 list 避免薄 emit soft-skip。"""
  lines: list[str] = body.split("\n")
  curName: str = ""
  curFields: str = ""
  curTypes: str = ""
  curInherit: str = ""
  li: int = 0
  while li < len(lines):
    raw: str = lines[li]
    s: str = raw.strip()
    if len(s) >= 8 and s[:8] == "variant " and s[len(s) - 1] == ":":
      if curName != "":
        names.append(curName)
        fieldCsv.append(curFields)
        typeCsv.append(curTypes)
      headV: str = s[8 : len(s) - 1].strip()
      curInherit = ""
      lpV: int = headV.find("(")
      if lpV > 0 and headV[len(headV) - 1] == ")":
        curName = headV[:lpV].strip()
        curInherit = headV[lpV + 1 : len(headV) - 1].strip()
      else:
        curName = headV
      curFields = ""
      curTypes = ""
      # 标记继承源于 typeCsv 尾注（resolve 阶段消费）
      if curInherit != "" and _isIdent(curInherit):
        curFields = ""
        curTypes = "@inherit:" + curInherit
      li += 1
      continue
    if curName != "":
      if s == "pass" or s == "...":
        li += 1
        continue
      if s == "" or s[0] == "#":
        li += 1
        continue
      colonV: int = s.find(":")
      if colonV > 0 and _isIdent(s[:colonV].strip()):
        fnV: str = s[:colonV].strip()
        tyV: str = _stripFieldTypeDecorators(s[colonV + 1 :].strip())
        eqV: int = tyV.find("=")
        if eqV >= 0:
          tyV = tyV[:eqV].strip()
        # 覆盖 inherit 标记
        if len(curTypes) >= 9 and curTypes[:9] == "@inherit:":
          curFields = fnV
          curTypes = tyV
        elif curFields == "":
          curFields = fnV
          curTypes = tyV
        else:
          curFields = curFields + "," + fnV
          curTypes = curTypes + "," + tyV
    li += 1
  if curName != "":
    names.append(curName)
    fieldCsv.append(curFields)
    typeCsv.append(curTypes)

def _unionMroBaseName(cls: ClassBundle) -> str:
  """``type union ErrorTypeUnion(base=Exception)`` → ``Exception``。"""
  if cls.isUnion == False:
    return ""
  bs: str = cls.basesSource.strip()
  key: str = "base="
  at: int = bs.find(key)
  if at < 0:
    return ""
  rest: str = bs[at + len(key) :].strip()
  nm: str = ""
  ci: int = 0
  while ci < len(rest):
    ch2: str = rest[ci : ci + 1]
    if _isIdent(ch2) or (ci > 0 and _isIdentContCh(ch2)):
      nm = nm + ch2
      ci += 1
      continue
    break
  if _isIdent(nm):
    return nm
  return ""

def _classInheritsNamed(mod: SyntaxModule, cls: ClassBundle, baseName: str) -> bool:
  """同模块直接/间接继承（含 ``Exception`` 等未入 Mid 的基类名）。"""
  if cls.name == baseName:
    return False
  bases: list[str] = _splitBaseNames(cls.basesSource)
  bi: int = 0
  while bi < len(bases):
    bnm: str = bases[bi].strip()
    lb: int = bnm.find("[")
    if lb > 0:
      bnm = bnm[:lb].strip()
    if bnm == baseName:
      return True
    parent: ClassBundle = _findClassByName(mod, bnm)
    if parent.name != "" and _classInheritsNamed(mod, parent, baseName):
      return True
    bi += 1
  return False

def _resolveUnionVariants(
  cls: ClassBundle, mod: SyntaxModule,
  names: list[str], fieldCsv: list[str], typeCsv: list[str]
) -> None:
  """解析 ``variant Ping(HasCode)`` 与 ``union Ext(Core)`` 继承变体。"""
  # ``type union U(base=T)``：MRO 闭集子类 → 单字段 ``value: Sub``
  mroBase: str = _unionMroBaseName(cls)
  if mroBase != "":
    ciM: int = 0
    while ciM < len(mod.classes):
      sub: ClassBundle = mod.classes[ciM]
      if sub.isUnion or sub.isProtocol or sub.isMixin:
        ciM += 1
        continue
      if sub.name == mroBase:
        ciM += 1
        continue
      if _classInheritsNamed(mod, sub, mroBase):
        if not _nameInList(names, sub.name):
          names.append(sub.name)
          fieldCsv.append("value")
          typeCsv.append(sub.name)
      ciM += 1
  # 基类 union 变体先入
  bases: list[str] = _splitBaseNames(cls.basesSource)
  bi: int = 0
  while bi < len(bases):
    bnm: str = bases[bi].strip()
    lb: int = bnm.find("[")
    if lb > 0:
      bnm = bnm[:lb].strip()
    parentU: ClassBundle = _findClassByName(mod, bnm)
    if parentU.name != "" and parentU.isUnion:
      pNames: list[str] = []
      pFields: list[str] = []
      pTypes: list[str] = []
      _resolveUnionVariants(parentU, mod, pNames, pFields, pTypes)
      pj: int = 0
      while pj < len(pNames):
        if not _nameInList(names, pNames[pj]):
          names.append(pNames[pj])
          fieldCsv.append(pFields[pj])
          typeCsv.append(pTypes[pj])
        pj += 1
    bi += 1
  # 本体变体
  ownNames: list[str] = []
  ownFields: list[str] = []
  ownTypes: list[str] = []
  _parseUnionVariants(cls.bodySource, ownNames, ownFields, ownTypes)
  oi: int = 0
  while oi < len(ownNames):
    tyI: str = ownTypes[oi]
    fI: str = ownFields[oi]
    if len(tyI) >= 9 and tyI[:9] == "@inherit:":
      parent: str = tyI[9:].strip()
      fBox: list[str] = []
      tBox: list[str] = []
      fBox.append("")
      tBox.append("")
      _variantFieldsFromClass(mod, parent, fBox, tBox)
      fI = fBox[0]
      tyI = tBox[0]
    if not _nameInList(names, ownNames[oi]):
      names.append(ownNames[oi])
      fieldCsv.append(fI)
      typeCsv.append(tyI)
    oi += 1

def _serdeDefaultCpp(tySrc: str, st: EnumEmitState) -> str:
  t: str = _stripFieldTypeDecorators(tySrc).strip()
  if t == "bool":
    return "false"
  if t == "int":
    return "0"
  if t == "long":
    return "PyLong()"
  if t == "str":
    return "PyStr()"
  if t == "float" or t == "float64":
    return "0.0"
  if len(t) >= 5 and t[:5] == "list[":
    return _cppType(t, st) + "{}"
  if len(t) >= 5 and t[:5] == "dict[":
    return _cppType(t, st) + "{}"
  if _isSerializableName(st, t):
    return "Py" + t + "{}"
  return _cppType(t, st) + "{}"

def _serdeDumpFieldLines(
  fname: str, tySrc: str, access: str, st: EnumEmitState
) -> str:
  """返回若干 ``  encoder.…;\\n`` 行。"""
  t: str = _stripFieldTypeDecorators(tySrc).strip()
  key: str = "PyStr(\"" + fname + "\")"
  out: str = ""
  if t == "bool":
    return "  encoder.dumpFieldBool(" + key + ", " + access + ");\n"
  if t == "int":
    return "  encoder.dumpFieldInt(" + key + ", " + access + ");\n"
  if t == "long":
    return "  encoder.dumpFieldLong(" + key + ", " + access + ");\n"
  if t == "str":
    return "  encoder.dumpFieldStr(" + key + ", " + access + ");\n"
  if t == "list[int]":
    return "  encoder.dumpFieldListInt(" + key + ", " + access + ");\n"
  if t == "list[long]":
    return "  encoder.dumpFieldListLong(" + key + ", " + access + ");\n"
  if t == "list[str]":
    return "  encoder.dumpFieldListStr(" + key + ", " + access + ");\n"
  if t == "list[float]":
    return "  encoder.dumpFieldListFloat(" + key + ", " + access + ");\n"
  if len(t) >= 5 and t[:5] == "list[":
    elem: str = t[5 : len(t) - 1].strip()
    if _isSerializableName(st, elem):
      out = out + "  encoder.dumpKey(" + key + ");\n"
      out = out + "  encoder.push(encoder.sep);\n"
      out = out + "  encoder.beginArray();\n"
      out = out + "  encoder.sep = PyStr();\n"
      out = out + "  {\n"
      out = out + "    PyInt __n = (" + access + ").__len__();\n"
      out = out + "    PyInt __i = 0;\n"
      out = out + "    while (__i < __n) {\n"
      out = (
        out
        + "      (("
        + access
        + ").__getitem__(__i)).serialize(encoder);\n"
      )
      out = out + "      __i = __i + 1;\n"
      out = out + "    }\n"
      out = out + "  }\n"
      out = out + "  encoder.endArray();\n"
      out = out + "  encoder.sep = encoder.commaSep();\n"
      return out
  if _isSerializableName(st, t):
    out = out + "  encoder.dumpKey(" + key + ");\n"
    out = out + "  (" + access + ").serialize(encoder);\n"
    return out
  # fallback scalars via dumpKey + dump*
  if t == "float" or t == "float64":
    out = out + "  encoder.dumpKey(" + key + ");\n"
    out = out + "  encoder.dumpFloat(" + access + ");\n"
    return out
  return "  /* skip serde field " + fname + " */\n"

def _serdeLoadBranch(
  fname: str, tySrc: str, target: str, elifKw: bool, st: EnumEmitState
) -> str:
  t: str = _stripFieldTypeDecorators(tySrc).strip()
  key: str = "PyStr(\"" + fname + "\")"
  kw: str = "if"
  if elifKw:
    kw = "else if"
  ind: str = "    "
  body: str = ind + "  "
  head: str = ind + kw + " (decoder.tryMatchKey(" + key + ")) {\n"
  if t == "bool":
    return head + body + "decoder.skipSpaces();\n" + body + target + " = decoder.parseBoolAt();\n" + ind + "}\n"
  if t == "int":
    return head + body + "decoder.skipSpaces();\n" + body + target + " = decoder.parseIntAt();\n" + ind + "}\n"
  if t == "long":
    return head + body + "decoder.skipSpaces();\n" + body + target + " = decoder.parseLongAt();\n" + ind + "}\n"
  if t == "str":
    return head + body + target + " = decoder.loadStr();\n" + ind + "}\n"
  if t == "float" or t == "float64":
    return head + body + target + " = decoder.loadFloat();\n" + ind + "}\n"
  if t == "list[int]":
    return head + body + "decoder.skipSpaces();\n" + body + target + " = decoder.loadListIntValue();\n" + ind + "}\n"
  if t == "list[long]":
    return head + body + "decoder.skipSpaces();\n" + body + target + " = decoder.loadListLongValue();\n" + ind + "}\n"
  if t == "list[str]":
    return head + body + "decoder.skipSpaces();\n" + body + target + " = decoder.loadListStrValue();\n" + ind + "}\n"
  if t == "list[float]":
    return head + body + "decoder.skipSpaces();\n" + body + target + " = decoder.loadListFloatValue();\n" + ind + "}\n"
  if len(t) >= 5 and t[:5] == "list[":
    elemL: str = t[5 : len(t) - 1].strip()
    if _isSerializableName(st, elemL):
      outL: str = head
      outL = outL + body + target + " = " + _cppType(t, st) + "{};\n"
      outL = outL + body + "decoder.beginArray();\n"
      outL = outL + body + "decoder.skipSpaces();\n"
      outL = outL + body + "if (!(decoder.atArrayEnd())) {\n"
      outL = outL + body + "  while (true) {\n"
      outL = (
        outL
        + body
        + "    ("
        + target
        + ").append(Py"
        + elemL
        + "::deserialize(decoder));\n"
      )
      outL = outL + body + "    decoder.skipSpaces();\n"
      outL = outL + body + "    if (decoder.atArrayEnd()) {\n"
      outL = outL + body + "      break;\n"
      outL = outL + body + "    }\n"
      outL = outL + body + "    decoder.expectChar(PyStr(\",\"));\n"
      outL = outL + body + "    decoder.skipSpaces();\n"
      outL = outL + body + "  }\n"
      outL = outL + body + "}\n"
      outL = outL + ind + "}\n"
      return outL
  if _isSerializableName(st, t):
    return (
      head
      + body
      + target
      + " = Py"
      + t
      + "::deserialize(decoder);\n"
      + ind
      + "}\n"
    )
  return head + body + "decoder.skipField();\n" + ind + "}\n"

def _emitRecordSerializeImpl(cls: ClassBundle, qcls: str, st: EnumEmitState) -> str:
  selfTy: str = "Py" + cls.name
  out: str = "void " + qcls + "::serialize(::paw::serde::json::PyJsonEncoder& encoder) const {\n"
  out = out + "  encoder.beginObject();\n"
  fi: int = 0
  while fi < len(cls.constFields):
    cf: ConstField = cls.constFields[fi]
    if cf.name != "":
      acc: str = "this->" + cf.name
      out = out + _serdeDumpFieldLines(cf.name, cf.typeName, acc, st)
    fi += 1
  out = out + "  encoder.endObject();\n"
  out = out + "}\n\n"
  out = out + selfTy + " " + qcls + "::deserialize(::paw::serde::json::PyJsonDecoder& decoder) {\n"
  fi = 0
  while fi < len(cls.constFields):
    cf2: ConstField = cls.constFields[fi]
    if cf2.name != "":
      tyC: str = _cppType(_stripFieldTypeDecorators(cf2.typeName), st)
      out = (
        out
        + "  "
        + tyC
        + " "
        + cf2.name
        + "_v = "
        + _serdeDefaultCpp(cf2.typeName, st)
        + ";\n"
      )
    fi += 1
  out = out + "  decoder.beginRootObject();\n"
  out = out + "  while (true) {\n"
  out = out + "    if (decoder.atObjectEnd()) {\n"
  out = out + "      break;\n"
  out = out + "    }\n"
  fi = 0
  firstB: bool = True
  while fi < len(cls.constFields):
    cf3: ConstField = cls.constFields[fi]
    if cf3.name != "":
      elifB: bool = True
      if firstB:
        elifB = False
        firstB = False
      out = out + _serdeLoadBranch(
        cf3.name, cf3.typeName, cf3.name + "_v", elifB, st
      )
    fi += 1
  out = out + "    else {\n"
  out = out + "      decoder.skipField();\n"
  out = out + "    }\n"
  out = out + "  }\n"
  out = out + "  return " + selfTy + "("
  fi = 0
  firstA: bool = True
  while fi < len(cls.constFields):
    cf4: ConstField = cls.constFields[fi]
    if cf4.name != "":
      if firstA:
        firstA = False
      else:
        out = out + ", "
      out = out + cf4.name + "_v"
    fi += 1
  out = out + ");\n"
  out = out + "}\n\n"
  return out

def _emitUnionSerializeImpl(
  cls: ClassBundle, qcls: str, st: EnumEmitState,
  vNames: list[str], vFields: list[str], vTypes: list[str]
) -> str:
  selfTy: str = "Py" + cls.name
  out: str = "void " + qcls + "::serialize(::paw::serde::json::PyJsonEncoder& encoder) const {\n"
  vi: int = 0
  while vi < len(vNames):
    vn: str = vNames[vi]
    kwU: str = "if"
    if vi > 0:
      kwU = "else if"
    out = out + "  " + kwU + " (this->_tag == Enum::" + vn + ") {\n"
    out = out + "    encoder.beginVariant(PyStr(\"" + vn + "\"));\n"
    fcsv: str = vFields[vi]
    tcsv: str = vTypes[vi]
    if fcsv != "":
      fparts: list[str] = fcsv.split(",")
      tparts: list[str] = tcsv.split(",")
      fj: int = 0
      while fj < len(fparts):
        fnJ: str = fparts[fj].strip()
        tyJ: str = ""
        if fj < len(tparts):
          tyJ = tparts[fj].strip()
        if fnJ != "":
          out = out + _serdeDumpFieldLines(fnJ, tyJ, "this->" + fnJ, st)
        fj += 1
    out = out + "    encoder.endVariant();\n"
    out = out + "  }\n"
    vi += 1
  out = out + "}\n\n"
  out = out + selfTy + " " + qcls + "::deserialize(::paw::serde::json::PyJsonDecoder& decoder) {\n"
  out = out + "  decoder.beginRootObject();\n"
  out = out + "  PyStr tag = decoder.loadTagField();\n"
  out = out + "  decoder.beginPayloadObject();\n"
  vi = 0
  while vi < len(vNames):
    vn2: str = vNames[vi]
    out = out + "  if (tag == PyStr(\"" + vn2 + "\")) {\n"
    fcsv2: str = vFields[vi]
    tcsv2: str = vTypes[vi]
    if fcsv2 == "":
      out = out + "    if (!(decoder.atObjectEnd())) {\n"
      out = out + "      decoder.skipValue();\n"
      out = out + "    }\n"
      out = out + "    return " + selfTy + "::" + vn2 + "();\n"
    else:
      fparts2: list[str] = fcsv2.split(",")
      tparts2: list[str] = tcsv2.split(",")
      fj2: int = 0
      while fj2 < len(fparts2):
        fn2: str = fparts2[fj2].strip()
        ty2: str = ""
        if fj2 < len(tparts2):
          ty2 = tparts2[fj2].strip()
        if fn2 != "":
          tyC2: str = _cppType(_stripFieldTypeDecorators(ty2), st)
          out = (
            out
            + "    "
            + tyC2
            + " "
            + fn2
            + "_v = "
            + _serdeDefaultCpp(ty2, st)
            + ";\n"
          )
        fj2 += 1
      out = out + "    while (!(decoder.atObjectEnd())) {\n"
      fj2 = 0
      firstU: bool = True
      while fj2 < len(fparts2):
        fn3: str = fparts2[fj2].strip()
        ty3: str = ""
        if fj2 < len(tparts2):
          ty3 = tparts2[fj2].strip()
        if fn3 != "":
          elifU: bool = True
          if firstU:
            elifU = False
            firstU = False
          # indent inside while — reuse branch with 4-space already
          brU: str = _serdeLoadBranch(fn3, ty3, fn3 + "_v", elifU, st)
          out = out + brU
        fj2 += 1
      out = out + "      else {\n"
      out = out + "        decoder.skipField();\n"
      out = out + "      }\n"
      out = out + "    }\n"
      out = out + "    return " + selfTy + "::" + vn2 + "("
      fj2 = 0
      firstR: bool = True
      while fj2 < len(fparts2):
        fn4: str = fparts2[fj2].strip()
        if fn4 != "":
          if firstR:
            firstR = False
          else:
            out = out + ", "
          out = out + fn4 + "_v"
        fj2 += 1
      out = out + ");\n"
    out = out + "  }\n"
    vi += 1
  out = out + "  decoder.fail(PyStr(\"unknown tag\"));\n"
  # unreachable fallback：优先 unit 变体；否则默认构造
  fbDone: bool = False
  if len(vNames) > 0:
    fiFb: int = 0
    while fiFb < len(vNames):
      if vFields[fiFb] == "":
        out = out + "  return " + selfTy + "::" + vNames[fiFb] + "();\n"
        fbDone = True
        break
      fiFb += 1
  if fbDone == False:
    out = out + "  return " + selfTy + "{};\n"
  out = out + "}\n\n"
  return out

def _unionVariantEnumVal(
  cls: ClassBundle, mod: SyntaxModule, vName: str, negSlot: list[int]
) -> str:
  """MRO 变体 → class_id；附加 unit variant → -1,-2,…。"""
  if _unionMroBaseName(cls) == "":
    return ""
  ci: int = 0
  while ci < len(mod.classes):
    if mod.classes[ci].name == vName:
      return str(ci + 1)
    ci += 1
  # 体变体（如 Unknown）。勿 ``negSlot[0] = negSlot[0] - 1``（薄 soft-skip）
  prevN: int = 0
  if len(negSlot) > 0:
    prevN = negSlot[0]
  nextN: int = prevN - 1
  while len(negSlot) > 0:
    negSlot.pop()
  negSlot.append(nextN)
  return str(nextN)

def _emitUnionClassHeader(
  cls: ClassBundle, st: EnumEmitState,
  vNames: list[str], vFields: list[str], vTypes: list[str],
  mod: SyntaxModule,
) -> str:
  """薄 tagged-struct union（字段扁平；够 Login/Logout/Body 测例）。"""
  cpp: str = "Py" + cls.name
  isMro: bool = _unionMroBaseName(cls) != ""
  out: str = "class " + cpp + " {\npublic:\n"
  if isMro:
    out = out + "  enum class Enum : int {\n"
  else:
    out = out + "  enum class Enum : unsigned char {\n"
  negSlot: list[int] = []
  negSlot.append(0)
  vi: int = 0
  while vi < len(vNames):
    comma: str = ","
    if vi + 1 >= len(vNames):
      comma = ""
    lineV: str = "    " + vNames[vi]
    if isMro:
      ev: str = _unionVariantEnumVal(cls, mod, vNames[vi], negSlot)
      if ev != "":
        lineV = lineV + " = " + ev
    out = out + lineV + comma + "\n"
    vi += 1
  out = out + "  };\n"
  out = out + "  Enum _tag{};\n"
  out = out + "  Enum __enum____get() const { return _tag; }\n"
  # unique fields across variants
  seenF: list[str] = []
  vi = 0
  while vi < len(vNames):
    fcsv: str = vFields[vi]
    tcsv: str = vTypes[vi]
    if fcsv != "":
      fps: list[str] = fcsv.split(",")
      tps: list[str] = tcsv.split(",")
      fj: int = 0
      while fj < len(fps):
        fn: str = fps[fj].strip()
        ty: str = ""
        if fj < len(tps):
          ty = tps[fj].strip()
        if fn != "" and not _nameInList(seenF, fn):
          seenF.append(fn)
          out = out + "  " + _cppType(_stripFieldTypeDecorators(ty), st) + " " + fn + "{};\n"
        fj += 1
    vi += 1
  vi = 0
  while vi < len(vNames):
    vn: str = vNames[vi]
    fcsv2: str = vFields[vi]
    tcsv2: str = vTypes[vi]
    if fcsv2 == "":
      out = out + "  static " + cpp + " " + vn + "();\n"
    else:
      params: str = ""
      fps2: list[str] = fcsv2.split(",")
      tps2: list[str] = tcsv2.split(",")
      fj2: int = 0
      while fj2 < len(fps2):
        fn2: str = fps2[fj2].strip()
        ty2: str = ""
        if fj2 < len(tps2):
          ty2 = tps2[fj2].strip()
        if fn2 != "":
          if params != "":
            params = params + ", "
          params = params + _cppType(_stripFieldTypeDecorators(ty2), st) + " " + fn2
        fj2 += 1
      out = out + "  static " + cpp + " " + vn + "(" + params + ");\n"
    vi += 1
  out = out + "  explicit " + cpp + "() = default;\n"
  if _isSerializableCls(cls):
    out = out + "  void serialize(::paw::serde::json::PyJsonEncoder& encoder) const;\n"
    out = out + "  static " + cpp + " deserialize(::paw::serde::json::PyJsonDecoder& decoder);\n"
  out = out + "  PyStr __repr__() const {\n"
  out = out + "  char __buf[128];\n"
  out = (
    out
    + "  snprintf(__buf, sizeof(__buf), \"<%s.%s object at 0x%llx>\", \"__main__\", \""
    + cls.name
    + "\", (unsigned long long)(size_t)(const void*)(this));\n"
  )
  out = out + "  return PyStr(__buf);\n"
  out = out + "  }\n"
  out = out + "  PyStr __str__() const { return this->__repr__(); }\n"
  out = out + "};\n"
  return out

def _emitUnionClassImpl(
  cls: ClassBundle, qcls: str, st: EnumEmitState,
  vNames: list[str], vFields: list[str], vTypes: list[str]
) -> str:
  selfTy: str = "Py" + cls.name
  out: str = ""
  vi: int = 0
  while vi < len(vNames):
    vn: str = vNames[vi]
    fcsv: str = vFields[vi]
    if fcsv == "":
      out = out + selfTy + " " + qcls + "::" + vn + "() {\n"
      out = out + "  " + selfTy + " out{};\n"
      out = out + "  out._tag = Enum::" + vn + ";\n"
      out = out + "  return out;\n"
      out = out + "}\n\n"
    else:
      tcsv: str = vTypes[vi]
      fps: list[str] = fcsv.split(",")
      tps: list[str] = tcsv.split(",")
      params: str = ""
      fj: int = 0
      while fj < len(fps):
        fn: str = fps[fj].strip()
        ty: str = ""
        if fj < len(tps):
          ty = tps[fj].strip()
        if fn != "":
          if params != "":
            params = params + ", "
          params = params + _cppType(_stripFieldTypeDecorators(ty), st) + " " + fn
        fj += 1
      out = out + selfTy + " " + qcls + "::" + vn + "(" + params + ") {\n"
      out = out + "  " + selfTy + " out{};\n"
      out = out + "  out._tag = Enum::" + vn + ";\n"
      fj = 0
      while fj < len(fps):
        fn2: str = fps[fj].strip()
        if fn2 != "":
          out = out + "  out." + fn2 + " = " + fn2 + ";\n"
        fj += 1
      out = out + "  return out;\n"
      out = out + "}\n\n"
    vi += 1
  if _isSerializableCls(cls):
    out = out + _emitUnionSerializeImpl(cls, qcls, st, vNames, vFields, vTypes)
  return out

def _emitUnionMroSupport(
  cls: ClassBundle, mod: SyntaxModule, st: EnumEmitState,
  vNames: list[str],
) -> str:
  """``U.Enum.of`` / ``.create`` / ``str``/``repr``（对齐 host union_mro_emit）。"""
  mroBase: str = _unionMroBaseName(cls)
  if mroBase == "":
    return ""
  cpp: str = "Py" + cls.name
  enumCpp: str = cpp + "::Enum"
  baseCpp: str = _cppType(mroBase, st)
  if baseCpp == "" or baseCpp == "void":
    baseCpp = "Py" + mroBase
  out: str = ""
  out = out + "inline " + enumCpp + " " + cpp + "_Enum_of(PyInt cid) {\n"
  ci: int = 0
  while ci < len(vNames):
    vn: str = vNames[ci]
    foundCls: bool = False
    cj: int = 0
    while cj < len(mod.classes):
      if mod.classes[cj].name == vn:
        foundCls = True
        break
      cj += 1
    if foundCls:
      out = (
        out
        + "  if (cid == Py"
        + vn
        + "::__id____get()) return "
        + enumCpp
        + "::"
        + vn
        + ";\n"
      )
    ci += 1
  out = out + "  return static_cast<" + enumCpp + ">(cid);\n"
  out = out + "}\n"
  out = out + "inline " + baseCpp + " " + cpp + "_Enum_create(" + enumCpp + " k) {\n"
  out = out + "  switch (k) {\n"
  ci = 0
  while ci < len(vNames):
    vn2: str = vNames[ci]
    found2: bool = False
    cj2: int = 0
    while cj2 < len(mod.classes):
      if mod.classes[cj2].name == vn2:
        found2 = True
        break
      cj2 += 1
    if found2:
      out = out + "  case " + enumCpp + "::" + vn2 + ":\n"
      out = out + "    return " + baseCpp + "(Py" + vn2 + "());\n"
    ci += 1
  out = out + "  default: return " + baseCpp + "();\n"
  out = out + "  }\n"
  out = out + "}\n"
  helper: str = cpp + "EnumPyStr"
  label: str = cls.name + ".Enum"
  out = out + "struct " + helper + " {\n"
  out = out + "  " + enumCpp + " v;\n"
  out = out + "  explicit " + helper + "(" + enumCpp + " x) : v(x) {}\n"
  out = out + "  explicit operator PyStr() const {\n"
  out = out + "    const PyInt u = static_cast<PyInt>(v);\n"
  negSlot: list[int] = []
  negSlot.append(0)
  ci = 0
  while ci < len(vNames):
    ev: str = _unionVariantEnumVal(cls, mod, vNames[ci], negSlot)
    out = out + "    if (u == (" + ev + "))\n"
    out = out + "      return PyStr(\"" + label + "." + vNames[ci] + "\");\n"
    ci += 1
  out = out + "    char buf[96];\n"
  out = out + "    snprintf(buf, sizeof(buf), \"" + label + ": %d\", (int)u);\n"
  out = out + "    return PyStr(buf);\n"
  out = out + "  }\n"
  out = out + "};\n"
  out = out + "inline PyStr repr(" + enumCpp + " v) {\n"
  out = out + "  PyStr name = static_cast<PyStr>(" + helper + "{v});\n"
  out = out + "  char vbuf[32];\n"
  out = out + "  snprintf(vbuf, sizeof(vbuf), \"%d\", (int)static_cast<PyInt>(v));\n"
  out = out + "  return PyStr(\"<\") + name + PyStr(\": \") + PyStr(vbuf) + PyStr(\">\");\n"
  out = out + "}\n"
  return out

def _fieldDescAnnot(line: str) -> str:
  """``value: int @OffsetValueVar(100) = 50`` → ``OffsetValueVar(100)``。"""
  at: int = line.find("@")
  if at < 0:
    return ""
  rest: str = line[at + 1 :].strip()
  depth: int = 0
  i: int = 0
  cut: int = len(rest)
  while i < len(rest):
    ch: str = rest[i : i + 1]
    if ch == "(":
      depth += 1
    if ch == ")":
      depth -= 1
    if ch == "=" and depth == 0:
      cut = i
      break
    i += 1
  call: str = rest[:cut].strip()
  if call == "optional" or call == "final" or call == "ref":
    return ""
  if "(" not in call:
    return ""
  return call

def _splitDescCall(call: str, nameOut: list[str], argsOut: list[str]) -> bool:
  lp: int = call.find("(")
  if lp <= 0:
    return False
  if call[len(call) - 1] != ")":
    return False
  nm: str = call[:lp].strip()
  if not _isIdent(nm):
    return False
  args: str = call[lp + 1 : len(call) - 1].strip()
  nameOut.append(nm)
  argsOut.append(args)
  return True

def _classHasDescriptorDeco(cls: ClassBundle) -> bool:
  return "descriptor" in cls.decoratorsSource

def _findDescMethod(cls: ClassBundle, name: str) -> FunctionBundle:
  empty: FunctionBundle = new()
  mi: int = 0
  while mi < len(cls.methods):
    if cls.methods[mi].name == name:
      return cls.methods[mi]
    mi += 1
  return empty

def _rewriteDescBody(
  body: str, storage: str, boundNames: list[str], boundVals: list[str]
) -> str:
  """描述符方法体：``self.__value__``→storage；``self._lo``→常量。"""
  out: str = body.replace("self.__value__", storage)
  out = out.replace("this->__value__", storage)
  bi: int = 0
  while bi < len(boundNames):
    bn: str = boundNames[bi]
    bv: str = boundVals[bi]
    out = out.replace("self." + bn, bv)
    out = out.replace("this->" + bn, bv)
    bi += 1
  out = out.replace("self.", "this->")
  return out

def _emitParamDescPreamble(paramsSource: str) -> str:
  """形参 ``v: int @ReplaceIfBadVar(0, 9, -1)`` / ``ClampedIntVar`` 入口校验。"""
  parts: list[str] = _splitParams(paramsSource)
  out: str = ""
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if p == "" or p == "self":
      pi += 1
      continue
    colon: int = p.find(":")
    if colon < 0:
      pi += 1
      continue
    pname: str = p[:colon].strip()
    rest: str = p[colon + 1 :].strip()
    at: int = rest.find("@")
    if at < 0:
      pi += 1
      continue
    deco: str = rest[at + 1 :].strip()
    eq: int = deco.find("=")
    if eq >= 0:
      deco = deco[:eq].strip()
    namesD: list[str] = []
    argsD: list[str] = []
    if not _splitDescCall(deco, namesD, argsD):
      pi += 1
      continue
    dnm: str = namesD[0]
    argParts: list[str] = _splitParams(argsD[0])
    if dnm == "ReplaceIfBadVar":
      if len(argParts) >= 3:
        loA: str = argParts[0].strip()
        hiA: str = argParts[1].strip()
        badA: str = argParts[2].strip()
        out = out + "  if (((" + pname + " < " + loA + ") || (" + pname + " > " + hiA + "))) {\n"
        out = out + "    " + pname + " = " + badA + ";\n"
        out = out + "  }\n"
    elif dnm == "ClampedIntVar":
      if len(argParts) >= 2:
        loC: str = argParts[0].strip()
        hiC: str = argParts[1].strip()
        out = out + "  if (((" + pname + " < " + loC + ") || (" + pname + " > " + hiC + "))) {\n"
        out = out + "    throw PyValueError(PyStr(\"out of range\"));\n"
        out = out + "  }\n"
    pi += 1
  return out

def _classHasPostInit(cls: ClassBundle) -> bool:
  mi: int = 0
  while mi < len(cls.methods):
    if cls.methods[mi].name == "__post_init__":
      return True
    mi += 1
  return False

def _optionalBaseTy(st: EnumEmitState, expr: str) -> str:
  if not _isIdent(expr):
    return ""
  ty: str = _localCppTypeOf(st, expr)
  if ty == "":
    return ""
  if len(ty) > 0 and ty[len(ty) - 1] == "&":
    ty = ty[: len(ty) - 1].strip()
  if len(ty) >= 10 and ty[:10] == "PyOptional":
    return ty
  return ""

def _optionalIsNoneExpr(expr: str, st: EnumEmitState) -> str:
  tyO: str = _optionalBaseTy(st, expr)
  if tyO != "":
    return "(" + expr + ".__enum____get() == " + tyO + "::Enum::None_)"
  return "(" + expr + ".__enum____get() == decltype(" + expr + ")::Enum::None_)"

def _optionalHasValueExpr(expr: str, st: EnumEmitState) -> str:
  tyO: str = _optionalBaseTy(st, expr)
  if tyO != "":
    return "(" + expr + ".__enum____get() != " + tyO + "::Enum::None_)"
  return "(" + expr + ".__enum____get() != decltype(" + expr + ")::Enum::None_)"

def _cppTypeIsEnum(st: EnumEmitState, ty: str) -> bool:
  """``PyPermFlag`` / ``PermFlag`` → 模块枚举。"""
  if ty == "":
    return False
  if _isEnumTypeName(st, ty):
    return True
  if len(ty) >= 3 and ty[:2] == "Py":
    bare: str = ty[2:]
    lt: int = bare.find("<")
    if lt > 0:
      bare = bare[:lt]
    if _isEnumTypeName(st, bare):
      return True
  return False

def _exprIsEnumSubject(expr: str, st: EnumEmitState) -> bool:
  if not _isIdent(expr):
    return False
  return _cppTypeIsEnum(st, _localCppTypeOf(st, expr))

def _matchAltLooksEnumMember(alt: str) -> bool:
  """``PermFlag.Read`` / ``ModeEnum.On`` 等 Type.Member 形态。"""
  a: str = alt.strip()
  dot: int = a.find(".")
  if dot <= 0:
    return False
  leftA: str = a[:dot].strip()
  rightA: str = a[dot + 1 :].strip()
  if not _isIdent(leftA):
    return False
  if not _isIdent(rightA):
    return False
  ch0: str = leftA[0]
  return ch0 >= "A" and ch0 <= "Z"

def _bytesLitByteLen(body: str) -> int:
  """``b\"…\"`` 体字节数（``\\xHH`` / ``\\n`` 等各计 1）。"""
  n: int = 0
  i: int = 0
  while i < len(body):
    ch: str = body[i : i + 1]
    if ch == "\\" and i + 1 < len(body):
      nxt: str = body[i + 1 : i + 2]
      if nxt == "x" and i + 3 < len(body):
        n += 1
        i += 4
        continue
      n += 1
      i += 2
      continue
    n += 1
    i += 1
  return n

def _emitBytesLitExpr(body: str) -> str:
  """``b\"\\xfb…\"`` → ``bytes_from_literal``（勿 ``PyStr.encode``，高位字节非法 UTF-8）。"""
  nB: int = _bytesLitByteLen(body)
  if nB == 0:
    return "::paw::text::bytes::bytes_from_literal(nullptr, 0)"
  return (
    "::paw::text::bytes::bytes_from_literal((const unsigned char*)\""
    + body
    + "\", "
    + str(nB)
    + ")"
  )

def _emitListLitExpr(inner: str, st: EnumEmitState, elemTyHint: str = "") -> str:
  """``[a, b]`` / ``['x']`` 表达式 → 临时 ``PyList`` IIFE。"""
  parts: list[str] = _splitParams(inner)
  elemTy: str = elemTyHint
  if elemTy == "" and len(parts) > 0:
    p0: str = parts[0].strip()
    if _isQuotedStrTerm(p0):
      elemTy = "PyStr"
    elif _isIntLit(p0) or (len(p0) >= 2 and p0[0] == "-" and _isIntLit(p0[1:])):
      elemTy = "PyInt"
    elif _isFloatLit(p0):
      elemTy = "PyFloat"
    elif _isIdent(p0):
      elemTy = _localCppTypeOf(st, p0)
    elif len(p0) >= 5 and p0[:5] == "long(":
      elemTy = "PyLong"
  if elemTy == "":
    if len(parts) == 0:
      return ""
    return ""
  listTy: str = "PyList<" + elemTy + ", 0>"
  outL: str = "([&]() -> " + listTy + " { " + listTy + " __l{}; "
  pi: int = 0
  while pi < len(parts):
    raw: str = parts[pi].strip()
    if raw == "":
      pi += 1
      continue
    term: str = _emitSimpleTerm(raw, st)
    if term == "":
      return ""
    outL = outL + "(void)(__l.append(" + term + ")); "
    pi += 1
  outL = outL + "return __l; })()"
  return outL

def _matchSplitGuard(pat: str) -> list[str]:
  """``[2, *rest] if rest`` → ``[pat, guard]``；无 guard 则 guard 为空串。"""
  s: str = pat.strip()
  depth: int = 0
  inStr: bool = False
  qCh: str = ""
  i: int = 0
  outG: list[str] = []
  while i < len(s):
    ch: str = s[i : i + 1]
    if inStr:
      if ch == "\\" and i + 1 < len(s):
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      inStr = True
      qCh = ch
      i += 1
      continue
    if ch == "[" or ch == "(":
      depth += 1
      i += 1
      continue
    if ch == "]" or ch == ")":
      depth -= 1
      i += 1
      continue
    if depth == 0 and i + 4 <= len(s) and s[i : i + 4] == " if ":
      outG.append(s[:i].strip())
      outG.append(s[i + 4 :].strip())
      return outG
    i += 1
  outG.append(s)
  outG.append("")
  return outG

def _matchSeqAccess(mCpp: str, mTy: str, idx: int, neg: bool) -> str:
  if mTy.find("PyTuple") >= 0 and (not neg):
    return mCpp + ".template get<" + str(idx) + ">()"
  if neg:
    return "(" + mCpp + ").__getitem__(" + str(idx) + ")"
  return "(" + mCpp + ").__getitem__(" + str(idx) + ")"

def _matchSeqStarBind(
  name: str, mCpp: str, mTy: str, prefixLen: int, suffixLen: int, st: EnumEmitState
) -> str:
  """``*rest`` 绑定：list/str 切片；deque 循环 append；tuple 定长 get。"""
  if name == "" or name == "_":
    return ""
  if mTy.find("PyTuple") >= 0:
    arity: int = _tupleArityFromCpp(mTy)
    midStart: int = prefixLen
    midEnd: int = arity - suffixLen
    if midEnd < midStart:
      return ""
    if midStart == midEnd:
      return "  auto " + name + " = PyTuple<>();\n"
    # 单元素 mid → ``PyTuple<T>(get<i>())``；多元素拼类型困难时用 list
    if midEnd - midStart == 1:
      return (
        "  auto "
        + name
        + " = PyTuple<"
        + "decltype("
        + _matchSeqAccess(mCpp, mTy, midStart, False)
        + ")>("
        + _matchSeqAccess(mCpp, mTy, midStart, False)
        + ");\n"
      )
    # 多 mid：落成 list（测例 ``len(mid)==1`` 已覆盖单元素；三元组 mid 仅一元）
    return (
      "  auto "
      + name
      + " = "
      + mCpp
      + ".template get_slice<"
      + str(midStart)
      + ", "
      + str(midEnd)
      + ">();\n"
    )
  if mTy.find("PyDeque") >= 0:
    lines: str = "  " + mTy + " " + name + " = " + mTy + "();\n"
    lines = (
      lines
      + "  for (int __si = "
      + str(prefixLen)
      + "; __si < (("
      + mCpp
      + ").__len__() - "
      + str(suffixLen)
      + "); ++__si) {\n"
    )
    lines = (
      lines
      + "    (void)("
      + name
      + ".append(("
      + mCpp
      + ").__getitem__(__si)));\n"
    )
    lines = lines + "  }\n"
    return lines
  # list / str / frozenlist：``__getitem__(PySlice)``
  lo: str = str(prefixLen)
  hi: str = "-2000000002"
  if suffixLen > 0:
    hi = "-" + str(suffixLen)
  if suffixLen == 0 and prefixLen == 0:
    return "  auto " + name + " = " + mCpp + ";\n"
  sl: str = "PySlice<PyInt, PyInt>(" + lo + ", " + hi + ", 1)"
  return "  auto " + name + " = (" + mCpp + ").__getitem__(" + sl + ");\n"

def _matchNewFieldAccess(mCpp: str, field: str, st: EnumEmitState) -> str:
  """``case new`` 字段访问：``value__value`` 存储 / property ``__get`` / 直读。"""
  stor: str = field + "__value"
  if _isRecordFieldName(st, stor):
    return "(" + mCpp + ")." + stor
  if _isUserPropName(st, field):
    return "(" + mCpp + ")." + field + "__get()"
  if _isStdlibPropAttr(field):
    if field == "name" and _isRecordFieldName(st, "name"):
      return "(" + mCpp + ")." + field
    if field == "value" and _isRecordFieldName(st, "value"):
      return "(" + mCpp + ")." + field
    return "(" + mCpp + ")." + field + "__get()"
  return "(" + mCpp + ")." + field

def _unionOwnerFromSubjectTy(mTy: str) -> str:
  """``PyMessageUnion`` / ``MessageUnion`` → ``MessageUnion``。"""
  t: str = mTy.strip()
  if len(t) >= 2 and t[:2] == "Py":
    t = t[2:]
  amp: int = t.find("&")
  if amp >= 0:
    t = t[:amp].strip()
  return t

def _unionVariantFields(st: EnumEmitState, owner: str, variant: str) -> str:
  ui: int = 0
  while ui < len(st.unionVarNames):
    if st.unionVarNames[ui] == variant:
      if owner == "" or st.unionVarOwners[ui] == owner:
        if ui < len(st.unionVarFieldCsv):
          return st.unionVarFieldCsv[ui]
        return ""
    ui += 1
  return ""

def _emitMatchUnionVariantCase(
  mCpp: str, mTy: str, patBody: str, st: EnumEmitState
) -> list[str]:
  """``case new.Move(x, y)`` / ``new.Quit`` → ``[cond, prelude]``（薄 tagged-struct）。"""
  empty: list[str] = _matchPair("", "")
  pb: str = patBody.strip()
  if len(pb) < 5 or pb[:4] != "new.":
    return empty
  rest: str = pb[4:]
  vnm: str = rest
  args: str = ""
  lp: int = rest.find("(")
  if lp > 0 and rest[len(rest) - 1] == ")":
    vnm = rest[:lp].strip()
    args = rest[lp + 1 : len(rest) - 1].strip()
  if not _isIdent(vnm):
    return empty
  owner: str = _unionOwnerFromSubjectTy(mTy)
  if owner == "":
    # 无主体类型时按变体名反查
    ui0: int = 0
    while ui0 < len(st.unionVarNames):
      if st.unionVarNames[ui0] == vnm:
        owner = st.unionVarOwners[ui0]
        break
      ui0 += 1
  if owner == "":
    return empty
  tagEnum: str = "Py" + owner + "::Enum"
  cond: str = "((" + mCpp + ")._tag == " + tagEnum + "::" + vnm + ")"
  fieldsCsv: str = _unionVariantFields(st, owner, vnm)
  fieldNames: list[str] = []
  if fieldsCsv != "":
    fieldNames = fieldsCsv.split(",")
  prelude: str = ""
  if args == "":
    return _matchPair(cond, prelude)
  parts: list[str] = _splitParams(args)
  pi: int = 0
  while pi < len(parts):
    raw: str = parts[pi].strip()
    eq: int = _bareKwEqPos(raw)
    fname: str = ""
    val: str = ""
    if eq > 0:
      fname = raw[:eq].strip()
      val = raw[eq + 1 :].strip()
    else:
      if pi < len(fieldNames):
        fname = fieldNames[pi].strip()
      val = raw
    if fname == "" or not _isIdent(fname):
      return empty
    acc: str = "(" + mCpp + ")." + fname
    if val == "_":
      pi += 1
      continue
    if _isIdent(val):
      prelude = prelude + "  auto " + val + " = " + acc + ";\n"
      _localRememberTy(st, val, "")
      pi += 1
      continue
    lit: str = _emitSimpleTerm(val, st)
    if lit == "":
      return empty
    cond = "(" + cond + " && (" + acc + " == " + lit + "))"
    pi += 1
  return _matchPair(cond, prelude)

def _emitMatchNewCase(mCpp: str, patBody: str, st: EnumEmitState) -> list[str]:
  """``case new(x=0, y=y)`` → ``[cond, prelude]``。"""
  empty: list[str] = _matchPair("", "")
  pb: str = patBody.strip()
  if len(pb) < 5 or pb[:4] != "new(" or pb[len(pb) - 1] != ")":
    return empty
  inner: str = pb[4 : len(pb) - 1].strip()
  parts: list[str] = []
  if inner != "":
    parts = _splitParams(inner)
  conds: list[str] = []
  prelude: str = ""
  pi: int = 0
  while pi < len(parts):
    raw: str = parts[pi].strip()
    eq: int = _bareKwEqPos(raw)
    if eq <= 0:
      return empty
    field: str = raw[:eq].strip()
    val: str = raw[eq + 1 :].strip()
    if not _isIdent(field):
      return empty
    acc: str = _matchNewFieldAccess(mCpp, field, st)
    if val == "_":
      pi += 1
      continue
    if _isIdent(val):
      prelude = prelude + "  auto " + val + " = " + acc + ";\n"
      _localRememberTy(st, val, "")
      pi += 1
      continue
    lit: str = _emitSimpleTerm(val, st)
    if lit == "":
      return empty
    conds.append("(" + acc + " == " + lit + ")")
    pi += 1
  condOut: str = "true"
  if len(conds) > 0:
    condOut = conds[0]
    ci: int = 1
    while ci < len(conds):
      condOut = "(" + condOut + " && " + conds[ci] + ")"
      ci += 1
  return _matchPair(condOut, prelude)

def _matchPair(a: str, b: str) -> list[str]:
  outP: list[str] = []
  outP.append(a)
  outP.append(b)
  return outP

def _emitMatchSequenceCase(
  mCpp: str, mTy: str, patBody: str, st: EnumEmitState
) -> list[str]:
  """序列 ``case […]`` → ``[cond, prelude]``；失败则 cond 为空。"""
  empty: list[str] = _matchPair("", "")
  pb: str = patBody.strip()
  if len(pb) < 2 or pb[0] != "[" or pb[len(pb) - 1] != "]":
    return empty
  inner: str = pb[1 : len(pb) - 1].strip()
  parts: list[str] = []
  if inner != "":
    parts = _splitParams(inner)
  prefix: list[str] = []
  suffix: list[str] = []
  starName: str = ""
  hasStar: bool = False
  pi: int = 0
  while pi < len(parts):
    raw: str = parts[pi].strip()
    if len(raw) >= 1 and raw[0] == "*":
      if hasStar:
        return empty
      hasStar = True
      starName = raw[1 : len(raw)].strip()
      pi += 1
      continue
    if hasStar:
      suffix.append(raw)
    else:
      prefix.append(raw)
    pi += 1
  conds: list[str] = []
  prelude: str = ""
  prefN: int = len(prefix)
  sufN: int = len(suffix)
  isTup: bool = mTy.find("PyTuple") >= 0
  if not hasStar:
    total: int = prefN + sufN
    if not isTup:
      conds.append("((" + mCpp + ").__len__() == " + str(total) + ")")
    else:
      arity0: int = _tupleArityFromCpp(mTy)
      if arity0 > 0 and arity0 != total:
        return _matchPair("false", "")
  else:
    minLen: int = prefN + sufN
    if not isTup:
      conds.append("((" + mCpp + ").__len__() >= " + str(minLen) + ")")
    else:
      arity1: int = _tupleArityFromCpp(mTy)
      if arity1 > 0 and arity1 < minLen:
        return _matchPair("false", "")
  # prefix
  ji: int = 0
  while ji < prefN:
    patJ: str = prefix[ji]
    acc: str = _matchSeqAccess(mCpp, mTy, ji, False)
    if _isIdent(patJ) and patJ != "_":
      prelude = prelude + "  auto " + patJ + " = " + acc + ";\n"
      _localRememberTy(st, patJ, "")
    elif patJ == "_":
      pass
    else:
      lit: str = _emitSimpleTerm(patJ, st)
      # ``str`` 序列元素为 ``PyChar``：``case ["<", …]``
      if mTy.find("PyStr") >= 0 and _isQuotedStrTerm(patJ):
        if len(patJ) == 3:
          lit = "PyChar('" + patJ[1:2] + "')"
      if lit == "":
        return empty
      conds.append("(" + acc + " == " + lit + ")")
    ji += 1
  # suffix
  sj: int = 0
  while sj < sufN:
    patS: str = suffix[sj]
    accS: str = ""
    if isTup:
      arityS: int = _tupleArityFromCpp(mTy)
      absI: int = arityS - sufN + sj
      accS = _matchSeqAccess(mCpp, mTy, absI, False)
    else:
      negI: int = sj - sufN
      accS = _matchSeqAccess(mCpp, mTy, negI, True)
    if _isIdent(patS) and patS != "_":
      prelude = prelude + "  auto " + patS + " = " + accS + ";\n"
    elif patS == "_":
      pass
    else:
      litS: str = _emitSimpleTerm(patS, st)
      if mTy.find("PyStr") >= 0 and _isQuotedStrTerm(patS):
        if len(patS) == 3:
          litS = "PyChar('" + patS[1:2] + "')"
      if litS == "":
        return empty
      conds.append("(" + accS + " == " + litS + ")")
    sj += 1
  if hasStar:
    starBind: str = _matchSeqStarBind(starName, mCpp, mTy, prefN, sufN, st)
    if starName != "" and starName != "_" and starBind == "":
      return empty
    prelude = prelude + starBind
  condOut: str = "true"
  if len(conds) > 0:
    condOut = conds[0]
    ci: int = 1
    while ci < len(conds):
      condOut = "(" + condOut + " && " + conds[ci] + ")"
      ci += 1
  return _matchPair(condOut, prelude)

def _rememberParamsFromSource(
  st: EnumEmitState, paramsSource: str, selfTy: str
) -> None:
  parts: list[str] = _splitParams(paramsSource)
  pi: int = 0
  while pi < len(parts):
    p: str = parts[pi].strip()
    if p == "" or p == "self":
      pi += 1
      continue
    colon: int = p.find(":")
    if colon < 0:
      pi += 1
      continue
    nm: str = p[:colon].strip()
    # ``*nums: int[:]`` / ``**kwargs``：剥星号后登记
    if len(nm) >= 2 and nm[0:2] == "**":
      nm = nm[2:].strip()
    elif len(nm) > 0 and nm[:1] == "*":
      nm = nm[1:].strip()
    rest: str = p[colon + 1 :].strip()
    eq: int = rest.find("=")
    tySrc: str = rest
    if eq >= 0:
      tySrc = rest[:eq].strip()
    if _isIdent(nm) and tySrc != "":
      if tySrc.strip() == "Self" and selfTy != "":
        _localRememberTy(st, nm, selfTy)
      else:
        _localRememberTy(st, nm, _cppType(_stripFieldTypeDecorators(tySrc), st))
    pi += 1

def _stdlibCtorCpp(name: str) -> str:
  if name == "timedelta":
    return "PyTimeDelta"
  if name == "date":
    return "PyDate"
  if name == "datetime":
    return "PyDateTime"
  if name == "time":
    return "PyTime"
  if name == "CTime":
    return "CTime"
  if name == "bytes":
    return "PyBytes"
  return ""

def _cppTypeInner(src: str, st: EnumEmitState) -> str:
  s: str = _stripFieldTypeDecorators(src.strip())
  if s == "" or s == "None":
    return "void"
  # 已是 ``PyFoo`` / ``PyFoo<…>``：勿再加前缀（``PyStr``→勿 ``PyPyStr``）
  if len(s) >= 3:
    if s[0:2] == "Py":
      ch3: str = s[2:3]
      if ch3 >= "A" and ch3 <= "Z":
        return s
  aliasHit: str = _lookupTypeAlias(st, s)
  if aliasHit != "":
    return aliasHit
  uOpt: str = _cppTypeUnionOptional(s, st)
  if uOpt != "":
    return uOpt
  # ``ErrorTypeUnion.Enum`` → ``PyErrorTypeUnion::Enum``
  if len(s) >= 6 and s[len(s) - 5 : len(s)] == ".Enum":
    leftEn: str = s[: len(s) - 5].strip()
    if _isIdent(leftEn):
      return "Py" + leftEn + "::Enum"
  # ``KeyError.__base__`` / ``Box[int].__base__`` → ``Py…::__base__``
  # ``".__base__"`` 长 9；切片须写清终点（薄 emit 对 ``s[n:]`` 会生成坏 PySlice）
  if len(s) >= 10 and s[len(s) - 9 : len(s)] == ".__base__":
    leftBase: str = s[: len(s) - 9].strip()
    if leftBase != "":
      baseCpp: str = _cppType(leftBase, st)
      # ``Box[T].__base__`` → ``PyContainerType<T>``（泛型类头未写 ``using __base__`` 时）
      if len(leftBase) >= 4 and leftBase[:3] == "Box":
        lbBx: int = leftBase.find("[")
        if lbBx > 0 and leftBase[len(leftBase) - 1] == "]":
          innerBx: str = leftBase[lbBx + 1 : len(leftBase) - 1].strip()
          if innerBx != "":
            return "PyContainerType<" + _cppType(innerBx, st) + ">"
      if baseCpp.find("PyBox<") >= 0:
        baseCpp = baseCpp.replace("PyBox<", "PyContainerType<", 1)
        return baseCpp
      # 依赖模板参数的嵌套类型须 ``typename``
      if baseCpp.find("<") >= 0:
        return "typename " + baseCpp + "::__base__"
      return baseCpp + "::__base__"
  # ``Callable[int -> str]`` / bare ``int -> str``
  if len(s) >= 9 and s[:9] == "Callable[" and s[len(s) - 1] == "]":
    innerC: str = s[9 : len(s) - 1].strip()
    arrowC: str = _arrowCallableCpp(innerC, st)
    if arrowC != "":
      return arrowC
  arrowTop: str = _arrowCallableCpp(s, st)
  if arrowTop != "":
    return arrowTop
  # 已是 C++ 类型名（``PyStr`` 等）勿再 ``Py``+ 前缀 → ``PyPyStr``
  if len(s) >= 2 and s[:2] == "Py":
    return s
  if s == "str":
    return "PyStr"
  if s == "int":
    return "PyInt"
  if s == "bool":
    return "bool"
  if s == "float":
    return "PyFloat"
  if s == "CTime":
    return "CTime"
  if s == "char":
    return "PyChar"
  if s == "byte":
    return "PyByte"
  if s == "bytes":
    return "PyBytes"
  if s == "long":
    return "PyLong"
  if s == "float64":
    return "PyFloat64"
  if s == "complex":
    return "complex128"
  if s == "dict":
    return "PyDict"
  if s == "set":
    return "PySet"
  if s == "deque":
    return "PyDeque"
  if s == "timedelta":
    return "PyTimeDelta"
  if s == "datetime":
    return "PyDateTime"
  if s == "date":
    return "PyDate"
  if s == "time":
    return "PyTime"
  if s == "Context":
    return "PyDecimalContext"
  if s == "span":
    return "PySpan"
  if s == "span2d":
    return "PySpan2D"
  if s == "span3d":
    return "PySpan3D"
  if s == "object":
    return "PyObject"
  if s == "TestSuite":
    return "PyTestSuite"
  if s == "TestCase":
    return "PyTestCase"
  if s == "TestResult":
    return "PyTestResult"
  if s == "TextTestRunner":
    return "PyTextTestRunner"
  if s == "Random":
    return "PyRandom"
  if s == "NormalDist":
    return "PyNormalDist"
  if s == "LinearRegression":
    return "PyLinearRegression"
  if s == "int16":
    return "PyInt16"
  if s == "uint16":
    return "PyUInt16"
  if s == "uint64":
    return "PyUInt64"
  if s == "uint32":
    return "PyUInt32"
  if s == "utf8ptr":
    return "PyUtf8Ptr"
  if s == "utf16ptr":
    return "PyUtf16Ptr"
  if s == "frozendict":
    return "PyFrozenDict"
  # ``complex[float64]`` → ``PyComplex<…>``（勿 ``complex128<T>``）
  if len(s) >= 8 and s[:8] == "complex[" and s[len(s) - 1] == "]":
    return "PyComplex<" + _cppType(s[8 : len(s) - 1], st) + ">"
  # ``frozendict[K, V]``
  if len(s) >= 11 and s[:11] == "frozendict[" and s[len(s) - 1] == "]":
    innerFd: str = s[11 : len(s) - 1]
    commaFd: int = innerFd.find(",")
    if commaFd > 0:
      kFd: str = _cppType(innerFd[:commaFd].strip(), st)
      vFd: str = _cppType(innerFd[commaFd + 1 :].strip(), st)
      return "PyFrozenDict<" + kFd + ", " + vFd + ">"
    return "PyFrozenDict"
  # ``dict[K, V]`` / ``set[T]``
  if len(s) >= 5 and s[:5] == "dict[" and s[len(s) - 1] == "]":
    innerD: str = s[5 : len(s) - 1]
    commaD: int = innerD.find(",")
    if commaD > 0:
      kD: str = _cppType(innerD[:commaD].strip(), st)
      vD: str = _cppType(innerD[commaD + 1 :].strip(), st)
      return "PyDict<" + kD + ", " + vD + ">"
    return "PyDict"
  if len(s) >= 4 and s[:4] == "set[" and s[len(s) - 1] == "]":
    return "PySet<" + _cppType(s[4 : len(s) - 1], st) + ">"
  if s == "frozenset":
    return "PyFrozenSet"
  if len(s) >= 10 and s[:10] == "frozenset[" and s[len(s) - 1] == "]":
    return "PyFrozenSet<" + _cppType(s[10 : len(s) - 1], st) + ">"
  if len(s) >= 5 and s[:5] == "list[" and s[len(s) - 1] == "]":
    # ``list[T]`` / ``list[T, 0]``（栈容量）；勿 ``PyList<PyT, 0, 0>``
    # ``@boxing`` 元素 → 指针（``list[CellUnsafe]`` → ``PyList<PyCellUnsafe*>``）
    innerL: str = s[5 : len(s) - 1].strip()
    partsL: list[str] = _splitParams(innerL)
    if len(partsL) >= 2 and _isIntLit(partsL[1].strip()):
      eL: str = _cppType(partsL[0].strip(), st)
      if _isRefClassName(st, partsL[0].strip()):
        eL = "PyRefCount<" + eL + ">"
      eL = _boxingElemCpp(st, eL)
      return "PyList<" + eL + ", " + partsL[1].strip() + ">"
    if len(partsL) >= 1:
      eL2: str = _cppType(partsL[0].strip(), st)
      if _isRefClassName(st, partsL[0].strip()):
        eL2 = "PyRefCount<" + eL2 + ">"
      eL2 = _boxingElemCpp(st, eL2)
      return "PyList<" + eL2 + ", 0>"
    return "PyList<PyInt, 0>"
  if len(s) >= 11 and s[:11] == "frozenlist[" and s[len(s) - 1] == "]":
    return "PyFrozenList<" + _cppType(s[11 : len(s) - 1], st) + ">"
  if len(s) >= 6 and s[:6] == "deque[" and s[len(s) - 1] == "]":
    return "PyDeque<" + _cppType(s[6 : len(s) - 1], st) + ">"
  if len(s) >= 8 and s[:8] == "Pointer[" and s[len(s) - 1] == "]":
    return _cppType(s[8 : len(s) - 1], st) + "*"
  if len(s) >= 9 and s[:9] == "Optional[" and s[len(s) - 1] == "]":
    return "PyOptional<" + _cppType(s[9 : len(s) - 1], st) + ">"
  # ``Future[T]`` → ``PyRefCount<PyFuture<T>>``（pool.submit 返回 RefCount）
  if len(s) >= 7 and s[:7] == "Future[" and s[len(s) - 1] == "]":
    ltF: str = "<"
    gtF: str = ">"
    return (
      "PyRefCount"
      + ltF
      + "PyFuture"
      + ltF
      + _cppType(s[7 : len(s) - 1], st)
      + gtF
      + gtF
    )
  if s == "Future":
    return "PyRefCount<PyFuture<PyInt>>"
  # ``IterableType[T]`` 薄路径：按 ``PyList<T>``（``__len__``/``__getitem__`` 循环）；genexp 实参另 soft-skip
  if len(s) >= 13 and s[:13] == "IterableType[" and s[len(s) - 1] == "]":
    return "PyList<" + _cppType(s[13 : len(s) - 1], st) + ", 0>"
  if s == "IterableType":
    return "PyList<PyInt, 0>"
  # ``GeneratorType[Y,S,R]`` 擦除句柄 → ``PyGenerator<…>``（``None``→``PyNone``，勿 ``void``）
  if len(s) >= 14 and s[:14] == "GeneratorType[" and s[len(s) - 1] == "]":
    innerGt: str = s[14 : len(s) - 1]
    partsGt: list[str] = _splitParams(innerGt)
    joinedGt: str = ""
    giGt: int = 0
    while giGt < len(partsGt):
      pgGt: str = partsGt[giGt].strip()
      segGt: str = "PyNone"
      if pgGt != "None" and pgGt != "":
        segGt = _cppType(pgGt, st)
      if joinedGt == "":
        joinedGt = segGt
      else:
        joinedGt = joinedGt + ", " + segGt
      giGt += 1
    if joinedGt == "":
      return "PyGenerator<PyNone, PyNone, PyNone>"
    return "PyGenerator<" + joinedGt + ">"
  if s == "GeneratorType":
    return "PyGenerator<PyNone, PyNone, PyNone>"
  # ``ContextManagerType[T]`` / ``CoroutineType[…]`` / ``AsyncGeneratorType[…]`` → 擦除句柄
  if len(s) >= 19 and s[:19] == "ContextManagerType[" and s[len(s) - 1] == "]":
    return "PyContextManager<" + _cppType(s[19 : len(s) - 1], st) + ">"
  if s == "ContextManagerType":
    return "PyContextManager<PyNone>"
  if len(s) >= 14 and s[:14] == "CoroutineType[" and s[len(s) - 1] == "]":
    innerCo: str = s[14 : len(s) - 1]
    partsCo: list[str] = _splitParams(innerCo)
    joinedCo: str = ""
    giCo: int = 0
    while giCo < len(partsCo):
      pgCo: str = partsCo[giCo].strip()
      segCo: str = "PyNone"
      if pgCo != "None" and pgCo != "":
        segCo = _cppType(pgCo, st)
      if joinedCo == "":
        joinedCo = segCo
      else:
        joinedCo = joinedCo + ", " + segCo
      giCo += 1
    if joinedCo == "":
      return "PyCoroutine<PyNone, PyNone, PyNone>"
    return "PyCoroutine<" + joinedCo + ">"
  if s == "CoroutineType":
    return "PyCoroutine<PyNone, PyNone, PyNone>"
  if len(s) >= 18 and s[:18] == "AsyncGeneratorType[" and s[len(s) - 1] == "]":
    innerAg: str = s[18 : len(s) - 1]
    partsAg: list[str] = _splitParams(innerAg)
    joinedAg: str = ""
    giAg: int = 0
    while giAg < len(partsAg):
      pgAg: str = partsAg[giAg].strip()
      segAg: str = "PyNone"
      if pgAg != "None" and pgAg != "":
        segAg = _cppType(pgAg, st)
      if joinedAg == "":
        joinedAg = segAg
      else:
        joinedAg = joinedAg + ", " + segAg
      giAg += 1
    if joinedAg == "":
      return "PyAsyncGenerator<PyNone, PyNone>"
    return "PyAsyncGenerator<" + joinedAg + ">"
  if s == "AsyncGeneratorType":
    return "PyAsyncGenerator<PyNone, PyNone>"
  if len(s) >= 14 and s[:14] == "AwaitableType[" and s[len(s) - 1] == "]":
    return "PyAwaitable<" + _cppType(s[14 : len(s) - 1], st) + ">"
  if s == "AwaitableType":
    return "PyAwaitable<PyNone>"
  if len(s) >= 6 and s[:6] == "array[" and s[len(s) - 1] == "]":
    innerA: str = s[6 : len(s) - 1]
    partsA: list[str] = _splitParams(innerA)
    if len(partsA) == 2:
      eA: str = _cppType(partsA[0].strip(), st)
      capA: str = partsA[1].strip()
      if _isIntLit(capA):
        return "PyArray<" + eA + ", " + capA + ">"
    if len(partsA) == 1:
      return "PyArray<" + _cppType(partsA[0].strip(), st) + ", 0>"
  if len(s) >= 5 and s[:5] == "span[" and s[len(s) - 1] == "]":
    return "PySpan<" + _cppType(s[5 : len(s) - 1], st) + ">"
  # ``(long, long)`` / ``(int,)`` / ``(int, str)`` → ``PyTuple<…>``
  if len(s) >= 3 and s[0] == "(" and s[len(s) - 1] == ")" and "," in s:
    partsTp: list[str] = _splitParams(s[1 : len(s) - 1])
    joinedTp: str = ""
    nTp: int = 0
    tiTp: int = 0
    while tiTp < len(partsTp):
      rawTp: str = partsTp[tiTp].strip()
      if rawTp == "":
        tiTp += 1
        continue
      segTp: str = _refcountStorageTy(_cppType(rawTp, st), st)
      if joinedTp == "":
        joinedTp = segTp
      else:
        joinedTp = joinedTp + ", " + segTp
      nTp += 1
      tiTp += 1
    if nTp >= 1 and joinedTp != "":
      return "PyTuple<" + joinedTp + ">"
  # ``ChunkDeque[int]`` 泛型；``int[:,:]``→``PyArray2D``；``int[1:3]`` / ``int[8]`` 暂 PyList
  if "[" in s and s[len(s) - 1] == "]":
    lbT: int = s.find("[")
    baseT: str = s[:lbT].strip()
    innerT: str = s[lbT + 1 : len(s) - 1].strip()
    if baseT != "":
      if innerT == ":,:":
        return "PyArray2D<" + _cppType(baseT, st) + ">"
      if innerT == ":,:,:":
        return "PyArray3D<" + _cppType(baseT, st) + ">"
      # ``int[:2, :3]`` → ``PyStackArray2D<T, 2, 3, 0, 0>``；裸 ``[:,:]`` 已在上
      if ":" in innerT and "," in innerT:
        parts2: list[str] = _splitParams(innerT)
        if len(parts2) == 2:
          a2: str = parts2[0].strip()
          b2: str = parts2[1].strip()
          if len(a2) >= 2 and a2[:1] == ":" and len(b2) >= 2 and b2[:1] == ":":
            ra2: str = a2[1:].strip()
            ca2: str = b2[1:].strip()
            if _isIntLit(ra2) and _isIntLit(ca2):
              return (
                "PyStackArray2D<"
                + _cppType(baseT, st)
                + ", "
                + ra2
                + ", "
                + ca2
                + ", 0, 0>"
              )
        return "PyArray2D<" + _cppType(baseT, st) + ">"
      if innerT == ":":
        return "PyArray<" + _cppType(baseT, st) + ", 0>"
      # ``int[:4]`` → ``PyStackArray<T, 4, 0>``；``int[1:3]`` → ``PyStackArray<T, 2, 1>``
      if ":" in innerT:
        if len(innerT) >= 2 and innerT[:1] == ":":
          capS: str = innerT[1:].strip()
          if _isIntLit(capS):
            return "PyStackArray<" + _cppType(baseT, st) + ", " + capS + ", 0>"
        colS: int = innerT.find(":")
        if colS > 0:
          loS: str = innerT[:colS].strip()
          hiS: str = innerT[colS + 1 :].strip()
          if _isIntLit(loS) and _isIntLit(hiS):
            loI: int = int(loS)
            hiI: int = int(hiS)
            lenI: int = hiI - loI
            if lenI < 0:
              lenI = 0
            return (
              "PyStackArray<"
              + _cppType(baseT, st)
              + ", "
              + str(lenI)
              + ", "
              + loS
              + ">"
            )
        return "PyList<" + _cppType(baseT, st) + ", 0>"
      if _isIntLit(innerT):
        return "PyList<" + _cppType(baseT, st) + ", 0>"
      partsG: list[str] = _splitParams(innerT)
      if len(partsG) == 0:
        return _cppType(baseT, st)
      joinedG: str = ""
      gi: int = 0
      while gi < len(partsG):
        pg: str = partsG[gi].strip()
        segG: str = ""
        # ``None`` 在擦除/Result 泛型中 → ``PyNone``（勿 ``void``）
        if pg == "None":
          segG = "PyNone"
        elif _isIntLit(pg):
          segG = pg
        else:
          segG = _cppType(pg, st)
          # ref 类作泛型实参（``WeakList[T]`` / ``list[T]``）须 ``PyRefCount<T>``；``WeakRef`` 例外
          riRef: int = 0
          isRefArg: bool = False
          while riRef < len(st.refClassNames):
            if st.refClassNames[riRef] == pg:
              isRefArg = True
            riRef += 1
          if isRefArg and baseT != "WeakRef":
            segG = "PyRefCount<" + segG + ">"
        if joinedG == "":
          joinedG = segG
        else:
          joinedG = joinedG + ", " + segG
        gi += 1
      # ``GeneratorType[…]`` / ``CoroutineType`` / ``ContextManagerType`` 已特判；泛型路径再挡
      if baseT == "GeneratorType":
        return "PyGenerator<" + joinedG + ">"
      if baseT == "CoroutineType":
        return "PyCoroutine<" + joinedG + ">"
      if baseT == "ContextManagerType":
        return "PyContextManager<" + joinedG + ">"
      if baseT == "AsyncGeneratorType":
        return "PyAsyncGenerator<" + joinedG + ">"
      if baseT == "AwaitableType":
        return "PyAwaitable<" + joinedG + ">"
      # 薄 tagged-union 擦除 Element：``BoxTUnion[int]`` → ``PyBoxTUnion``
      uiTy: int = 0
      while uiTy < len(st.unionVarOwners):
        if st.unionVarOwners[uiTy] == baseT:
          return "Py" + baseT
        uiTy += 1
      # ``NormalDist[float64]``：基类勿带默认 ``<PyFloat64>`` 再叠一层
      baseG: str = _cppType(baseT, st)
      ltStrip: str = "<"
      hiStrip: int = 0
      while hiStrip < len(baseG):
        if baseG[hiStrip : hiStrip + 1] == ltStrip:
          baseG = baseG[:hiStrip]
          break
        hiStrip += 1
      return baseG + "<" + joinedG + ">"
  if "." in s:
    # ``IterResult[Y, R].YieldValue`` / ``Optional[T].Value`` → 对应类型实参
    dotN: int = s.rfind(".")
    headN: str = s[:dotN].strip()
    tailN: str = s[dotN + 1 :].strip()
    if len(headN) >= 3 and headN.find("[") > 0 and headN[len(headN) - 1] == "]":
      lbN: int = headN.find("[")
      baseN: str = headN[:lbN].strip()
      argsN: list[str] = _splitParams(headN[lbN + 1 : len(headN) - 1])
      # IterResult[YieldValue, ReturnValue]
      if baseN == "IterResult" or baseN == "PyIterResult":
        if tailN == "YieldValue" and len(argsN) >= 1:
          return _cppType(argsN[0].strip(), st)
        if tailN == "ReturnValue" and len(argsN) >= 2:
          return _cppType(argsN[1].strip(), st)
      # Optional[Value]
      if baseN == "Optional" or baseN == "PyOptional":
        if tailN == "Value" and len(argsN) >= 1:
          return _cppType(argsN[0].strip(), st)
      # Result[T, E] 常见字段
      if baseN == "Result" or baseN == "PyResult":
        if (tailN == "T" or tailN == "Ok" or tailN == "Value") and len(argsN) >= 1:
          return _cppType(argsN[0].strip(), st)
        if (tailN == "E" or tailN == "Err" or tailN == "Error") and len(argsN) >= 2:
          return _cppType(argsN[1].strip(), st)
    if len(tailN) > 0 and tailN[0] >= "a" and tailN[0] <= "z":
      return "Py" + tailN[:1].upper() + tailN[1:]
    return "Py" + tailN
  # 条件类型别名（runtime ``paw/util/types.h``）：勿 ``PyListElemOf``
  if s == "ListElemOf" or s == "ValOf" or s == "StrDictValueOf" or s == "ListOnly":
    return s
  # 小写内建名：首字母大写（``path``→``PyPath``）
  if len(s) > 0 and s[0] >= "a" and s[0] <= "z":
    return "Py" + s[:1].upper() + s[1:]
  return "Py" + s

def _cppType(src: str, st: EnumEmitState) -> str:
  s0: str = src.strip()
  # 类模板形参（``Element``）保持原名，勿 ``PyElement``
  if _isIdent(s0) and _nameInTplParams(st, s0):
    return s0
  innerTy: str = _cppTypeInner(src, st)
  # 本模块用户类 ``Rect``：勿套 spatial ``PyRect<PyFloat>``
  if innerTy == "PyRect" and "PyRect" in st.classFieldTyNames:
    return "PyRect"
  return _withDefaultScalarTemplate(innerTy)

def _matchingCallParen(t: str, lp: int) -> int:
  """``t[lp]=='('`` 时返回配对 ``)`` 下标；失败返回 -1。"""
  if lp < 0 or lp >= len(t):
    return -1
  if t[lp : lp + 1] != "(":
    return -1
  depth: int = 0
  i: int = lp
  inStr: bool = False
  qCh: str = ""
  while i < len(t):
    ch: str = t[i : i + 1]
    if inStr:
      if ch == "\\" and i + 1 < len(t):
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      inStr = True
      qCh = ch
      i += 1
      continue
    if ch == "(":
      depth += 1
    elif ch == ")":
      depth -= 1
      if depth == 0:
        return i
    i += 1
  return -1

def _splitParams(src: str) -> list[str]:
  parts: list[str] = []
  if src.strip() == "":
    return parts
  cur: str = ""
  depth: int = 0
  i: int = 0
  n: int = len(src)
  inStr: bool = False
  qCh: str = ""
  while i < n:
    ch: str = src[i]
    if inStr:
      cur = cur + ch
      if ch == "\\" and i + 1 < n:
        esc: str = src[i + 1 : i + 2]
        cur = cur + esc
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      inStr = True
      qCh = ch
      cur = cur + ch
      i += 1
      continue
    # 含尖括号：``PyList<PyInt, 0>`` 勿在内层逗号切开（``"<"/">"`` 用变量，避薄 soft-skip）
    ltSp: str = "<"
    gtSp: str = ">"
    if ch == "[" or ch == "(" or ch == "{" or ch == ltSp:
      depth += 1
      cur = cur + ch
    elif ch == "]" or ch == ")" or ch == "}" or ch == gtSp:
      if depth > 0:
        depth -= 1
      cur = cur + ch
    elif ch == "," and depth == 0:
      parts.append(cur.strip())
      cur = ""
    else:
      cur = cur + ch
    i += 1
  if cur.strip() != "":
    parts.append(cur.strip())
  return parts

def _bracketDepthDelta(s: str, start: int) -> int:
  depth: int = 0
  i: int = start
  n: int = len(s)
  inStr: bool = False
  qCh: str = ""
  while i < n:
    ch: str = s[i]
    if inStr:
      if ch == "\\" and i + 1 < n:
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      inStr = True
      qCh = ch
      i += 1
      continue
    if ch == "[":
      depth += 1
    elif ch == "]":
      depth -= 1
    i += 1
  return depth

def _parenDepthDelta(s: str, start: int) -> int:
  """括号净深度；识别 ``\"\"\"`` / `'''` 三引号（多行字面量合并用）。"""
  depth: int = 0
  i: int = start
  n: int = len(s)
  inStr: bool = False
  inTriple: bool = False
  qCh: str = ""
  while i < n:
    ch: str = str(s[i])
    if inTriple:
      if i + 2 < n:
        c1: str = str(s[i + 1])
        c2: str = str(s[i + 2])
        if ch == qCh and c1 == qCh and c2 == qCh:
          inTriple = False
          inStr = False
          i += 3
          continue
      i += 1
      continue
    if inStr:
      if ch == "\\" and i + 1 < n:
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      if i + 2 < n:
        n1: str = str(s[i + 1])
        n2: str = str(s[i + 2])
        if n1 == ch and n2 == ch:
          inTriple = True
          inStr = True
          qCh = ch
          i += 3
          continue
      inStr = True
      qCh = ch
      i += 1
      continue
    if ch == "(":
      depth += 1
    elif ch == ")":
      depth -= 1
    i += 1
  return depth

def _tripleQuotesClosed(s: str) -> bool:
  """``True`` if no unclosed ``\"\"\"`` / `'''` remains."""
  i: int = 0
  n: int = len(s)
  inTriple: bool = False
  qCh: str = ""
  while i < n:
    ch: str = str(s[i])
    if inTriple:
      if i + 2 < n:
        c1: str = str(s[i + 1])
        c2: str = str(s[i + 2])
        if ch == qCh and c1 == qCh and c2 == qCh:
          inTriple = False
          i += 3
          continue
      i += 1
      continue
    if ch == "\"" or ch == "'":
      if i + 2 < n:
        n1: str = str(s[i + 1])
        n2: str = str(s[i + 2])
        if n1 == ch and n2 == ch:
          inTriple = True
          qCh = ch
          i += 3
          continue
      i += 1
      continue
    i += 1
  if inTriple:
    return False
  return True

def _emitTripleQuotedExpr(src: str, st: EnumEmitState) -> str:
  """``\"\"\"…\"\"\".stripLines()`` / 裸三引号 → ``PyStr(...).stripLines()``。"""
  s: str = src.strip()
  q3: str = "\"\"\""
  if len(s) >= 3 and s[:3] == "'''":
    q3 = "'''"
  if len(s) < 6 or s[:3] != q3:
    return ""
  endQ: int = s.find(q3, 3)
  if endQ < 0:
    return ""
  inner: str = s[3:endQ]
  rest: str = s[endQ + 3 :].strip()
  # Copy Python escapes through (``\"`` / ``\\n``); only re-escape raw quotes / newlines.
  esc: str = ""
  ii: int = 0
  while ii < len(inner):
    ch: str = str(inner[ii])
    if ch == "\\" and ii + 1 < len(inner):
      nxtE: str = str(inner[ii + 1])
      if nxtE == "\n":
        ii = ii + 2
        continue
      esc = esc + "\\" + nxtE
      ii = ii + 2
      continue
    if ch == "\"":
      esc = esc + "\\\""
    elif ch == "\n":
      esc = esc + "\\n"
    elif ch == "\r":
      esc = esc + "\\r"
    elif ch == "\t":
      esc = esc + "\\t"
    else:
      esc = esc + ch
    ii = ii + 1
  base: str = "PyStr(\"" + esc + "\")"
  if rest == "":
    return base
  # ``.stripLines()`` / ``.stripLines(n)`` / 其后链式
  if len(rest) >= 12 and rest[:12] == ".stripLines(":
    rpSl: int = rest.find(")")
    if rpSl > 0:
      callSl: str = base + rest[: rpSl + 1]
      restSl: str = rest[rpSl + 1 :].strip()
      if restSl == "":
        return callSl
      chainedSl: str = _emitMethodChainOn(callSl, restSl, st)
      if chainedSl != "":
        return chainedSl
      if len(restSl) >= 3 and restSl[:3] == " + ":
        rightSl: str = restSl[3:].strip()
        rCppSl: str = _emitSimpleTerm(rightSl, st)
        if rCppSl != "":
          return "(" + callSl + " + " + rCppSl + ")"
  return ""

def _cppParams(src: str, withDefaults: bool, selfTy: str, st: EnumEmitState) -> str:
  parts: list[str] = _splitParams(src)
  out: list[str] = []
  i: int = 0
  while i < len(parts):
    p: str = parts[i]
    if p == "" or p == "self":
      i += 1
      continue
    name: str = p
    tySrc: str = ""
    colon: int = p.find(":")
    if colon >= 0:
      name = p[:colon].strip()
      rest: str = p[colon + 1 :].strip()
      eq: int = rest.find("=")
      if eq >= 0:
        tySrc = rest[:eq].strip()
      else:
        tySrc = rest
    ty: str = "PyInt"
    untyped: bool = False
    if colon < 0:
      untyped = True
    if tySrc == "Self" and selfTy != "":
      ty = selfTy
    elif tySrc != "":
      ty = _cppType(_stripFieldTypeDecorators(tySrc), st)
    # ``**kwargs: WindowOpts`` → ``PyWindowOpts& kwargs``
    if len(name) >= 2 and name[0:2] == "**":
      kwNm: str = name[2:].strip()
      if kwNm == "":
        kwNm = "kwargs"
      out.append(ty + "& " + _escapeCppIdent(kwNm))
      i += 1
      continue
    # ``*nums: int[:]`` → ``PyArray<PyInt, 0>& nums``（整包）
    # ``*args: Ts`` / ``*rest``（variadic template）→ ``Ts... args`` / ``__Ts... rest``
    if len(name) > 0 and name[:1] == "*":
      starNm: str = name[1:].strip()
      if starNm == "":
        starNm = "args"
      # 形参包注解为类型变量名（``Ts``）→ C++ pack
      if tySrc != "" and _isIdent(tySrc) and _nameInTplParams(st, tySrc):
        out.append(tySrc + "... " + _escapeCppIdent(starNm))
        i += 1
        continue
      # 无注解 ``*rest`` 且已登记独立 pack ``__Ts``
      if colon < 0 and _nameInTplParams(st, "__Ts"):
        out.append("__Ts... " + _escapeCppIdent(starNm))
        i += 1
        continue
      # ``*args: int[:]`` 整包数组
      if ty.find("PyArray") >= 0 or ty.find("[:]") >= 0:
        out.append(ty + "& " + _escapeCppIdent(starNm))
        i += 1
        continue
      out.append(ty + "& " + _escapeCppIdent(starNm))
      i += 1
      continue
    emP: str = _escapeCppIdent(name)
    if untyped:
      # 无注解形参：模板类型 ``T0&`` / ``T1&`` …
      tIdx: int = 0
      pj: int = 0
      while pj < i:
        pjP: str = parts[pj].strip()
        if pjP != "" and pjP != "self" and pjP.find(":") < 0:
          if len(pjP) == 0 or pjP[:1] != "*":
            tIdx += 1
        pj += 1
      out.append("T" + str(tIdx) + "& " + emP)
      i += 1
      continue
    defa: str = ""
    if withDefaults and colon >= 0:
      rest2: str = p[colon + 1 :].strip()
      eq2: int = rest2.find("=")
      if eq2 >= 0:
        dsrc: str = rest2[eq2 + 1 :].strip()
        if dsrc == "None":
          defa = ""
        elif dsrc == "0" or _isIntLit(dsrc):
          defa = " = " + dsrc
        elif dsrc == "True":
          defa = " = true"
        elif dsrc == "False":
          defa = " = false"
        elif dsrc != "":
          # ``= _default88()`` / 简单表达式默认实参
          dTerm: str = _emitSimpleTerm(dsrc, st)
          if dTerm != "":
            defa = " = " + dTerm
    # Prefer early-continue (no multi-line elif) so thin/string emit stays faithful.
    if ty == "PyStr":
      out.append("const PyStr& " + emP + defa)
      i += 1
      continue
    if ty == "PyInt" or ty == "PyFloat" or ty == "PyFloat64" or ty == "PyFloat32" or ty == "bool" or ty == "PyChar" or ty == "PyFileId" or ty == "PySourceSpan" or ty == "PyToken" or ty == "PyInt64" or ty == "PyUInt64" or ty == "PyUInt32" or ty == "PyInt16" or ty == "PyUInt16":
      out.append(ty + " " + emP + defa)
      i += 1
      continue
    if len(ty) >= 5 and ty[len(ty) - 4 :] == "Enum":
      out.append(ty + " " + emP + defa)
      i += 1
      continue
    if len(ty) >= 5 and ty[len(ty) - 4 :] == "Flag":
      out.append(ty + " " + emP + defa)
      i += 1
      continue
    if _isErasedProtocolPyType(ty):
      # 擦除句柄按值（可接 ``makeContextManager<T>(…)`` 临时量）
      out.append(ty + " " + emP + defa)
      i += 1
      continue
    if ty == "PyException":
      # ``classify(AlphaError())``：临时量须绑 const&（MRO ``Enum.of``）
      out.append("const PyException& " + emP + defa)
      i += 1
      continue
    if len(ty) >= 2 and ty[:2] == "Py":
      # User classes / aggregates: non-const ref (identity ``is``; host ClassInfo).
      out.append(ty + "& " + emP + defa)
      i += 1
      continue
    out.append(ty + " " + emP + defa)
    i += 1
  # join
  if len(out) == 0:
    return ""
  joined: str = out[0]
  j: int = 1
  while j < len(out):
    joined = joined + ", " + out[j]
    j += 1
  return joined

def _splitEnumBaseIdents(basesSource: str) -> list[str]:
  """``(ModeEnum)`` / ``(flag=True, PermFlag)`` → 父枚举名列表（跳过 flag=/int）。"""
  s: str = basesSource.strip()
  names: list[str] = []
  if len(s) >= 2 and s[0] == "(" and s[len(s) - 1] == ")":
    s = s[1 : len(s) - 1].strip()
  if s == "":
    return names
  parts: list[str] = _splitParams(s)
  pi: int = 0
  while pi < len(parts):
    t: str = parts[pi].strip()
    if t.find("=") >= 0:
      pi += 1
      continue
    if t == "int" or t == "int64" or t == "int32" or t == "uint" or t == "uint64":
      pi += 1
      continue
    if _isIdent(t):
      names.append(t)
    pi += 1
  return names

def _memberNameIn(members: list[EnumMember], nm: str) -> bool:
  i: int = 0
  while i < len(members):
    if members[i].name == nm:
      return True
    i += 1
  return False

def _flattenEnumMembers(en: EnumBundle, enums: list[EnumBundle]) -> list[EnumMember]:
  """父枚举成员在前，子枚举自有成员在后（按声明序；同名保留先出现）。"""
  out: list[EnumMember] = []
  # 非递归：按 bases 链从根到叶压栈
  chain: list[str] = []
  cur: str = en.name
  guard: int = 0
  while guard < 16:
    guard += 1
    chain.append(cur)
    found: EnumBundle = en
    fi: int = 0
    hit: bool = False
    while fi < len(enums):
      if enums[fi].name == cur:
        found = enums[fi]
        hit = True
        break
      fi += 1
    if not hit:
      break
    parents: list[str] = _splitEnumBaseIdents(found.basesSource)
    if len(parents) == 0:
      break
    cur = parents[0]
    # 已在链中则停
    already: bool = False
    ci: int = 0
    while ci < len(chain):
      if chain[ci] == cur:
        already = True
        break
      ci += 1
    if already:
      break
  # chain 现为 子…根；反转成 根…子
  ri: int = len(chain) - 1
  while ri >= 0:
    nm: str = chain[ri]
    ej: int = 0
    while ej < len(enums):
      if enums[ej].name == nm:
        em: EnumBundle = enums[ej]
        memsE: list[EnumMember] = em.members
        mk: int = 0
        while mk < len(memsE):
          if not _memberNameIn(out, memsE[mk].name):
            out.append(memsE[mk])
          mk += 1
        break
      ej += 1
    ri -= 1
  return out

def _enumMemberIntValues(en: EnumBundle, enums: list[EnumBundle]) -> list[int]:
  """与 ``emitEnum`` 同规则的成员整型值（展平后）。"""
  mems: list[EnumMember] = _flattenEnumMembers(en, enums)
  vals: list[int] = []
  lastVal: int = -1
  nextFlag: int = 1
  i: int = 0
  while i < len(mems):
    mCur: EnumMember = mems[i]
    rawVs: str = mCur.valueSource
    vs: str = rawVs.strip()
    isDots: bool = False
    if vs == "...":
      isDots = True
    if vs == "Ellipsis":
      isDots = True
    if vs == "":
      isDots = True
    cur: int = 0
    if isDots:
      if en.flag:
        cur = nextFlag
        lastVal = nextFlag
        nextFlag = nextFlag + nextFlag
      else:
        if lastVal < 0:
          cur = 0
          lastVal = 0
        else:
          lastVal = lastVal + 1
          cur = lastVal
    else:
      if _isIntLit(vs):
        cur = int(vs)
        lastVal = cur
        if en.flag:
          nextFlag = 1
          while nextFlag <= lastVal:
            nextFlag = nextFlag + nextFlag
      else:
        cur = 0
    vals.append(cur)
    i += 1
  return vals

def _typeEnumBaseName(en: EnumBundle) -> str:
  """``type enum PetKindTypeEnum(base=Animal)`` → ``Animal``。"""
  if en.isTypeEnum == False:
    return ""
  bs: str = en.basesSource.strip()
  key: str = "base="
  at: int = bs.find(key)
  if at < 0:
    return ""
  rest: str = bs[at + len(key) :].strip()
  if len(rest) >= 1 and rest[len(rest) - 1] == ")":
    # ``(base=Animal)`` 整段
    pass
  # 去掉尾部 ``)`` / 逗号
  cut: int = 0
  while cut < len(rest):
    ch: str = rest[cut : cut + 1]
    if not _isIdentContCh(ch) and cut > 0:
      break
    if not _isIdentContCh(ch) and cut == 0:
      if not _isIdent(ch):
        break
    cut += 1
  # 简化：取连续标识符
  nm: str = ""
  ci: int = 0
  while ci < len(rest):
    ch2: str = rest[ci : ci + 1]
    if _isIdent(ch2) or (ci > 0 and _isIdentContCh(ch2)):
      nm = nm + ch2
      ci += 1
      continue
    break
  if _isIdent(nm):
    return nm
  return ""

def _expandTypeEnumMembers(en: EnumBundle, mod: SyntaxModule) -> None:
  """``base=Animal``：把同模块子类名并入 type enum 成员（值=类序 id）。"""
  base: str = _typeEnumBaseName(en)
  if base == "":
    return
  # 已有手动成员名
  seen: list[str] = []
  mi: int = 0
  while mi < len(en.members):
    seen.append(en.members[mi].name)
    mi += 1
  ci: int = 0
  while ci < len(mod.classes):
    cls: ClassBundle = mod.classes[ci]
    if cls.name == base:
      ci += 1
      continue
    if cls.isUnion or cls.isProtocol or cls.isMixin:
      ci += 1
      continue
    # 直接/间接继承 base
    if base not in cls.basesSource:
      ci += 1
      continue
    if cls.name in seen:
      ci += 1
      continue
    em: EnumMember = new()
    em.name = cls.name
    # 与 ``__py2cpp_class_id__ = ci+1`` 对齐
    em.valueSource = str(ci + 1)
    en.members.append(em)
    seen.append(cls.name)
    ci += 1

def _emitTypeEnumOfCreate(en: EnumBundle, mod: SyntaxModule) -> str:
  """``PetKindTypeEnum_of`` / ``_create``（对齐 host enum_mro_emit）。"""
  if en.isTypeEnum == False:
    return ""
  base: str = _typeEnumBaseName(en)
  if base == "":
    return ""
  cpp: str = "Py" + en.name
  baseCpp: str = "Py" + base
  out: str = ""
  out = out + "inline " + cpp + " " + cpp + "_of(PyInt cid) {\n"
  ci: int = 0
  while ci < len(mod.classes):
    cls: ClassBundle = mod.classes[ci]
    if cls.name == base:
      ci += 1
      continue
    if base not in cls.basesSource:
      ci += 1
      continue
    # 仅枚举成员
    hasM: bool = False
    mj: int = 0
    while mj < len(en.members):
      if en.members[mj].name == cls.name:
        hasM = True
        break
      mj += 1
    if hasM:
      out = out + "  if (cid == Py" + cls.name + "::__id____get()) return " + cpp + "::" + cls.name + ";\n"
    ci += 1
  out = out + "  return static_cast<" + cpp + ">(cid);\n"
  out = out + "}\n"
  out = out + "inline " + baseCpp + " " + cpp + "_create(" + cpp + " k) {\n"
  out = out + "  switch (k) {\n"
  ci = 0
  while ci < len(mod.classes):
    cls2: ClassBundle = mod.classes[ci]
    if cls2.name == base:
      ci += 1
      continue
    if base not in cls2.basesSource:
      ci += 1
      continue
    hasM2: bool = False
    mj2: int = 0
    while mj2 < len(en.members):
      if en.members[mj2].name == cls2.name:
        hasM2 = True
        break
      mj2 += 1
    if hasM2:
      out = out + "  case " + cpp + "::" + cls2.name + ": { " + baseCpp + " __o = Py" + cls2.name + "{}; return __o; }\n"
    ci += 1
  out = out + "  default: return " + baseCpp + "{};\n"
  out = out + "  }\n"
  out = out + "}\n"
  return out

def emitEnum(en: EnumBundle, enums: list[EnumBundle]) -> str:
  mems: list[EnumMember] = _flattenEnumMembers(en, enums)
  vals: list[int] = _enumMemberIntValues(en, enums)
  out: str = "enum class Py" + en.name + " : int {\n"
  n: int = len(mems)
  i: int = 0
  while i < n:
    line: str = "  " + mems[i].name + " = " + str(vals[i])
    if i + 1 < n:
      line = line + ","
    out = out + line + "\n"
    i += 1
  out = out + "};\n"
  return out

def _emitEnumSupport(en: EnumBundle, enums: list[EnumBundle]) -> str:
  """Flag 运算符 + ``PyXxxPyStr`` + ``repr(PyXxx)``（供 ``str``/``repr``）。"""
  cpp: str = "Py" + en.name
  cls: str = en.name
  mems: list[EnumMember] = _flattenEnumMembers(en, enums)
  vals: list[int] = _enumMemberIntValues(en, enums)
  out: str = ""
  if en.flag:
    out = out + "inline " + cpp + " operator|(" + cpp + " a, " + cpp + " b) {\n"
    out = out + "  return static_cast<" + cpp + ">(static_cast<int>(a) | static_cast<int>(b));\n"
    out = out + "}\n"
    out = out + "inline " + cpp + " operator&(" + cpp + " a, " + cpp + " b) {\n"
    out = out + "  return static_cast<" + cpp + ">(static_cast<int>(a) & static_cast<int>(b));\n"
    out = out + "}\n"
    out = out + "inline " + cpp + " operator^(" + cpp + " a, " + cpp + " b) {\n"
    out = out + "  return static_cast<" + cpp + ">(static_cast<int>(a) ^ static_cast<int>(b));\n"
    out = out + "}\n"
  helper: str = cpp + "PyStr"
  out = out + "struct " + helper + " {\n"
  out = out + "  " + cpp + " v;\n"
  out = out + "  explicit " + helper + "(" + cpp + " x) : v(x) {}\n"
  out = out + "  explicit operator PyStr() const {\n"
  out = out + "    const int u = static_cast<int>(v);\n"
  if en.flag:
    out = out + "    PyStr outS;\n"
    out = out + "    bool first = true;\n"
    miF: int = 0
    while miF < len(mems):
      mv: int = vals[miF]
      if mv != 0:
        nmF: str = mems[miF].name
        out = out + "    if ((u & (" + str(mv) + ")) == (" + str(mv) + ")) {\n"
        out = out + "      if (!first) outS = outS + PyStr(\"|\");\n"
        out = out + "      outS = outS + PyStr(\"" + cls + "." + nmF + "\");\n"
        out = out + "      first = false;\n"
        out = out + "    }\n"
      miF += 1
    out = out + "    if (first) {\n"
    out = out + "      char buf[96];\n"
    out = out + "      snprintf(buf, sizeof(buf), \"" + cls + ": %d\", u);\n"
    out = out + "      return PyStr(buf);\n"
    out = out + "    }\n"
    out = out + "    return outS;\n"
  else:
    miR: int = 0
    while miR < len(mems):
      out = out + "    if (u == (" + str(vals[miR]) + "))\n"
      out = out + "      return PyStr(\"" + cls + "." + mems[miR].name + "\");\n"
      miR += 1
    out = out + "    char buf[96];\n"
    out = out + "    snprintf(buf, sizeof(buf), \"" + cls + ": %d\", u);\n"
    out = out + "    return PyStr(buf);\n"
  out = out + "  }\n"
  out = out + "};\n"
  out = out + "inline PyStr repr(" + cpp + " v) {\n"
  out = out + "  PyStr name = static_cast<PyStr>(" + helper + "{v});\n"
  out = out + "  char vbuf[32];\n"
  out = out + "  snprintf(vbuf, sizeof(vbuf), \"%d\", (int)static_cast<PyInt>(v));\n"
  out = out + "  return PyStr(\"<\") + name + PyStr(\": \") + PyStr(vbuf) + PyStr(\">\");\n"
  out = out + "}\n"
  return out

def _enumPyStrCastExpr(tyCpp: str, valueExpr: str) -> str:
  """``str(e)`` → ``static_cast<PyStr>(PyModeEnumPyStr{e})``。"""
  if tyCpp == "":
    return ""
  return "static_cast<PyStr>(" + tyCpp + "PyStr{" + valueExpr + "})"

def _unionEnumPyStrCast(expr: str) -> str:
  """``PyU::Enum::X`` / ``U.Enum.X`` → ``static_cast<PyStr>(PyUEnumPyStr{…})``。"""
  e: str = expr.strip()
  if e == "":
    return ""
  # 用变量存针，避薄 emit soft-skip ``"::"`` 字面量
  needleCC: str = ":" + ":Enum" + ":" + ":"
  needleC: str = ":" + ":Enum"
  needleD: str = ".Enum."
  at: int = e.find(needleCC)
  if at < 0:
    at = e.find(needleC)
  if at < 0:
    at = e.find(needleD)
  if at <= 0:
    return ""
  uTy: str = e[:at]
  if uTy.find("Py") != 0:
    uTy = "Py" + uTy
  e2: str = _rewriteAllTypeDots(e)
  return "static_cast<PyStr>(" + uTy + "EnumPyStr{" + e2 + "})"

def _enumMemberCpp(defaultSource: str, st: EnumEmitState) -> str:
  d: str = defaultSource.strip()
  # 禁止整段 ``A.B | C.D`` 被当成单个 member（``_isIdent`` 旧实现会误放行空格）
  if d.find(" ") >= 0:
    return ""
  if d.find("|") >= 0:
    return ""
  dot: int = d.find(".")
  if dot <= 0 or d.find("(") >= 0 or d.find("[") >= 0:
    return ""
  left: str = d[:dot]
  right: str = d[dot + 1 :]
  # 拆成独立 if，避免 ``not A or not B`` 被薄 emit 错翻
  if not _isIdent(left):
    return ""
  if not _isIdent(right):
    return ""
  # Only rewrite when left is a parsed enum type name, not an instance attr like d.hasSpan.
  if not _isEnumTypeName(st, left):
    return ""
  return "Py" + left + "::" + right

def _fieldDefault(ty: str, valueSource: str, st: EnumEmitState) -> str:
  d: str = valueSource.strip()
  if d == "" or d == "None" or d == "none":
    return ""
  if d == "True":
    return " = true"
  if d == "False":
    return " = false"
  if d == "[]" or d == "{}":
    return " = " + ty + "{}"
  # 用切片比 ``d[0]=='"'``：薄 emit 单字符字面量比较在 C++ 侧易失真
  if len(d) >= 2 and d[:1] == "\"" and d[len(d) - 1 :] == "\"":
    if ty == "PyStr" or (len(ty) >= 2 and ty[:2] == "Py"):
      return " = PyStr(" + d + ")"
  if len(d) >= 2 and d[:1] == "'" and d[len(d) - 1 :] == "'":
    if ty == "PyStr" or (len(ty) >= 2 and ty[:2] == "Py"):
      bodySq: str = d[1 : len(d) - 1]
      return " = PyStr(\"" + bodySq + "\")"
  if (len(d) >= 4 and d[:4] == "new(") or d == "new()":
    return " = " + ty + "{}"
  enumD: str = _enumMemberCpp(d, st)
  if enumD != "":
    return " = " + enumD
  if _isIntLit(d) or _isIdent(d):
    return " = " + d
  return ""

def _constNamesFromBody(body: str) -> list[str]:
  """``const Name: T = …`` → Name（仅关键字 const，不含普通字段）。"""
  names: list[str] = []
  lines: list[str] = body.split("\n")
  li: int = 0
  while li < len(lines):
    s: str = lines[li].strip()
    if len(s) >= 6 and s[:5] == "const" and s[5] == " ":
      rest: str = s[6:].strip()
      cut: int = rest.find(":")
      if cut < 0:
        cut = rest.find(" ")
      if cut > 0:
        nm: str = rest[:cut].strip()
        if _isIdent(nm):
          names.append(nm)
    li += 1
  return names

def _nameInList(names: list[str], nm: str) -> bool:
  i: int = 0
  while i < len(names):
    if names[i] == nm:
      return True
    i += 1
  return False


def _isUpperAZ(ch: str) -> bool:
  return ch in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

def _isLowerAZ(ch: str) -> bool:
  return ch in "abcdefghijklmnopqrstuvwxyz"

def _isDigit09(ch: str) -> bool:
  return ch in "0123456789"

def _isIdentStartCh(ch: str) -> bool:
  if _isUpperAZ(ch):
    return True
  if _isLowerAZ(ch):
    return True
  if ch == "_":
    return True
  return False

def _hasThisArrowPrefix(s: str) -> bool:
  # 勿写 ``s[:6] == "this->"``（薄 emit 会 soft-skip 整段 if）
  arrow: str = "this" + "->"
  if s.find(arrow) == 0:
    return True
  return False

def _isIdentContCh(ch: str) -> bool:
  if _isIdentStartCh(ch):
    return True
  if _isDigit09(ch):
    return True
  return False

def _rewriteTypeDotAttr(expr: str) -> str:
  """``ModeEnum.Off`` / ``Seal.MAX`` / ``Pyml.expand`` → ``Py…::…``（首段大写类型名）。"""
  s: str = expr.strip()
  if s.find(".") < 0:
    return ""
  if s.find("self.") >= 0:
    return ""
  if s.find("Self.") >= 0:
    return ""
  if s.find("(") >= 0:
    return ""
  if s.find("[") >= 0:
    return ""
  if s.find(" ") >= 0:
    return ""
  if s.find("|") >= 0:
    return ""
  # ``MessageUnion.Enum.Quit`` → ``PyMessageUnion::Enum::Quit``
  # 勿 ``partsE[0][0]``：薄 emit 会 soft-skip 整段返回。
  if ".Enum." in s:
    partsE: list[str] = s.split(".")
    if len(partsE) == 3 and partsE[1] == "Enum":
      pe0: str = partsE[0]
      pe2: str = partsE[2]
      if _isIdent(pe0) and _isIdent(pe2) and len(pe0) > 0:
        chE0: str = pe0[:1]
        if _isUpperAZ(chE0):
          return "Py" + pe0 + "::Enum::" + pe2
  dot: int = s.find(".")
  if dot <= 0:
    return ""
  left: str = s[:dot]
  right: str = s[dot + 1 :]
  # 拆成独立 if，避免 ``not A or not B`` 被薄 emit 错翻成 ``!(A || !B)``
  if not _isIdent(left):
    return ""
  if not _isIdent(right):
    return ""
  if len(left) == 0:
    return ""
  macroA: str = _scalarTypeStaticAttrCpp(left, right)
  if macroA != "":
    return macroA
  # ``bytes.makeTrans`` / ``str.encode`` 等小写内建类型静态成员
  if left == "bytes":
    return "PyBytes::" + right
  if left == "str":
    return "PyStr::" + right
  ch0: str = str(left[0])
  if not _isUpperAZ(ch0):
    return ""
  leftPy: str = _withDefaultScalarTemplate("Py" + left)
  # ``Pool._SlotCap`` / ``Pool._BlockCap``：模板类静态常量须带实参
  if left == "Pool" and (right == "_SlotCap" or right == "_BlockCap"):
    return "PyPool<PyInt>::" + right
  if _isStdlibStaticPropAttr(right):
    return leftPy + "::" + right + "__get()"
  # 用户 ``@staticproperty`` / ``static property``：``Point.origin`` → ``::origin__get()``
  # （无 st 时无法查 userProp；带 ``__get`` 后缀的调用点另处理）
  return leftPy + "::" + right

def _rewriteTypeDotAttrSt(expr: str, st: EnumEmitState) -> str:
  """同 ``_rewriteTypeDotAttr``，并识别用户静态 property。"""
  base: str = _rewriteTypeDotAttr(expr)
  s: str = expr.strip()
  if s.find(".") < 0 or s.find("[") >= 0 or s.find("(") >= 0:
    return base
  dot: int = s.find(".")
  if dot <= 0:
    return base
  left: str = s[:dot]
  right: str = s[dot + 1 :]
  if not _isIdent(left) or not _isIdent(right):
    return base
  if len(left) == 0 or not _isUpperAZ(str(left[0])):
    return base
  if _isUserPropName(st, right):
    return "Py" + left + "::" + right + "__get()"
  return base

def _rewriteAllTypeDots(src: str) -> str:
  """扫描 ``Type.member``（首段大写）→ ``PyType::member``；跳过字面量与 ``self.``/``PyX::``。"""
  s: str = src
  if "." not in s:
    return s
  out: str = ""
  i: int = 0
  n: int = len(s)
  inStr: bool = False
  qCh: str = ""
  while i < n:
    ch: str = s[i : i + 1]
    if inStr:
      out = out + ch
      if ch == "\\" and i + 1 < n:
        out = out + s[i + 1 : i + 2]
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      inStr = True
      qCh = ch
      out = out + ch
      i += 1
      continue
    # 已是 ``PyFoo::Bar`` — 原样拷到下一段
    if ch == ":" and i + 1 < n and s[i + 1 : i + 2] == ":":
      out = out + "::"
      i += 2
      continue
    # 尝试 Ident.Ident
    if _isIdentStartCh(ch):
      j: int = i + 1
      while j < n:
        cj: str = s[j]
        if not _isIdentContCh(cj):
          break
        j += 1
      if j < n and s[j] == "." and j + 1 < n:
        # 前一字符若是标识符续，则非独立 Type
        prevOk: bool = True
        if i > 0:
          p: str = s[i - 1]
          if _isIdentContCh(p) or p == ":":
            prevOk = False
        left: str = s[i:j]
        k: int = j + 1
        while k < n:
          ck: str = s[k]
          if not _isIdentContCh(ck):
            break
          k += 1
        right: str = s[j + 1 : k]
        if prevOk:
          if len(left) > 0:
            macroD: str = _scalarTypeStaticAttrCpp(left, right)
            if macroD != "":
              out = out + macroD
              i = k
              continue
            # ``MessageUnion.Enum.Quit``：三连点勿只翻前两段
            if right == "Enum" and k < n and s[k : k + 1] == ".":
              m3: int = k + 1
              while m3 < n:
                cm3: str = s[m3]
                if not _isIdentContCh(cm3):
                  break
                m3 += 1
              memE: str = s[k + 1 : m3]
              if memE != "" and _isIdent(memE) and _isUpperAZ(left[:1]):
                if len(left) < 2 or left[:2] != "Py":
                  out = out + "Py" + left + "::Enum::" + memE
                  i = m3
                  continue
            if _isUpperAZ(left[:1]):
              if right != "":
                if left != "self":
                  if left != "Self":
                    if len(left) < 2 or left[:2] != "Py":
                      tyDot: str = _withDefaultScalarTemplate("Py" + left)
                      if _isStdlibStaticPropAttr(right):
                        out = out + tyDot + "::" + right + "__get()"
                      else:
                        out = out + tyDot + "::" + right
                      i = k
                      continue
      out = out + s[i:j]
      i = j
      continue
    out = out + ch
    i += 1
  return out

def _emitLongBinOpExpr(src: str, st: EnumEmitState) -> str:
  """``a % b`` → ``__mod__``；``&``/``^``/``<<``/``>>`` → C++ 运算符（PyLong 有重载）。"""
  s: str = src.strip()
  ops: list[str] = [" << ", " >> ", " % ", " & ", " ^ ", " | "]
  oi: int = 0
  while oi < len(ops):
    op: str = ops[oi]
    if op in s:
      sp: int = s.find(op)
      if sp > 0:
        leftRaw: str = s[:sp].strip()
        rightRaw: str = s[sp + len(op) :].strip()
        # 枚举 flag ``|`` 仍走 ``_emitBitOrExpr``
        if op == " | " and (
          leftRaw.find(".") >= 0 or rightRaw.find(".") >= 0
        ):
          oi += 1
          continue
        la: str = _emitSimpleTerm(leftRaw, st)
        ra: str = _emitSimpleTerm(rightRaw, st)
        if la != "" and ra != "":
          if op == " % ":
            ltyMod: str = ""
            if _isIdent(leftRaw):
              ltyMod = _localCppTypeOf(st, leftRaw)
            # ``"%d" % 42`` / ``fmt % (1, 2)`` → 全局 ``__mod__`` + ``makeTuple``
            leftIsStr: bool = False
            if _isQuotedStrTerm(leftRaw):
              leftIsStr = True
            if leftRaw[:3] == "\"\"\"" or leftRaw[:3] == "'''":
              leftIsStr = True
            if la.find("PyStr") >= 0:
              leftIsStr = True
            if ltyMod.find("PyStr") >= 0:
              leftIsStr = True
            if leftIsStr:
              if ra.find("PyTuple") >= 0 or ra.find("makeTuple") >= 0:
                return "::__mod__(" + la + ", " + ra + ")"
              return "::__mod__(" + la + ", makeTuple(" + ra + "))"
            # PyLong：成员 ``__mod__``；标量走自由函数（Python 取模语义）
            if ltyMod.find("PyLong") >= 0:
              return "(" + la + ").__mod__(" + ra + ")"
            return "__mod__(" + la + ", " + ra + ")"
          return "(" + la + op + ra + ")"
    oi += 1
  return ""

def _emitBitOrExpr(src: str, st: EnumEmitState) -> str:
  """``PermFlag.Read | PermFlag.Write`` → ``PyPermFlag::Read | PyPermFlag::Write``。"""
  s: str = src.strip()
  if " | " not in s:
    return ""
  parts: list[str] = []
  cur: str = ""
  i: int = 0
  depth: int = 0
  while i < len(s):
    if depth == 0 and i + 3 <= len(s) and s[i : i + 3] == " | ":
      parts.append(cur.strip())
      cur = ""
      i += 3
      continue
    ch: str = s[i]
    if ch == "(":
      depth += 1
    elif ch == ")":
      if depth > 0:
        depth -= 1
    cur = cur + ch
    i += 1
  parts.append(cur.strip())
  if len(parts) < 2:
    return ""
  out: str = ""
  tyOr: str = ""
  pi: int = 0
  while pi < len(parts):
    part: str = parts[pi]
    # 优先 enum member；勿回落到会吞整段 ``|`` 的 simpleTerm
    term: str = _enumMemberCpp(part, st)
    if term == "":
      term = _rewriteTypeDotAttr(part)
    if term == "":
      term = _rewriteAllTypeDots(part)
    if term.find(".") >= 0:
      return ""
    if term == "":
      return ""
    if tyOr == "":
      # ``PyPermFlag::Read`` → ``PyPermFlag``
      col2: int = term.find("::")
      if col2 > 0:
        tyOr = term[:col2]
    if pi == 0:
      out = "static_cast<int>(" + term + ")"
    else:
      out = out + " | static_cast<int>(" + term + ")"
    pi += 1
  if tyOr == "":
    return "(" + out + ")"
  return "static_cast<" + tyOr + ">(" + out + ")"

def _isIdent(s: str) -> bool:
  """标识符：用 membership 判字符，避免 PyStr ``>=``/``<=`` 误判空格等。"""
  if s == "":
    return False
  i: int = 0
  while i < len(s):
    ch: str = str(s[i])
    if i == 0:
      if not (_isUpperAZ(ch) or _isLowerAZ(ch) or ch == "_"):
        return False
    else:
      if not (_isUpperAZ(ch) or _isLowerAZ(ch) or _isDigit09(ch) or ch == "_"):
        return False
    i += 1
  return True

def _isIntLit(s: str) -> bool:
  if s == "":
    return False
  i: int = 0
  if s[0] == "-" or s[0] == "+":
    if len(s) == 1:
      return False
    i = 1
  # hex ``0x…`` / ``0X…``
  if i + 2 < len(s) and s[i] == "0" and (s[i + 1] == "x" or s[i + 1] == "X"):
    i += 2
    if i >= len(s):
      return False
    while i < len(s):
      chH: str = s[i]
      okH: bool = (chH >= "0" and chH <= "9") or (chH >= "a" and chH <= "f") or (chH >= "A" and chH <= "F")
      if not okH:
        return False
      i += 1
    return True
  while i < len(s):
    ch: str = s[i]
    if not (ch >= "0" and ch <= "9"):
      return False
    i += 1
  return True

def _isFloatLit(s: str) -> bool:
  """``1.0`` / ``.5`` / ``1.`` / ``-2.5`` / ``1.5e-2``（须含 ``.`` 或指数，与 int 区分）。"""
  if s == "":
    return False
  i: int = 0
  if s[0] == "-" or s[0] == "+":
    if len(s) == 1:
      return False
    i = 1
  sawDot: bool = False
  sawDigit: bool = False
  sawExp: bool = False
  while i < len(s):
    ch: str = s[i]
    if ch >= "0" and ch <= "9":
      sawDigit = True
      i += 1
      continue
    if ch == ".":
      if sawDot:
        return False
      if sawExp:
        return False
      sawDot = True
      i += 1
      continue
    if ch == "e" or ch == "E":
      if sawExp:
        return False
      if not sawDigit:
        return False
      sawExp = True
      i += 1
      if i < len(s):
        if s[i] == "+" or s[i] == "-":
          i += 1
      if i >= len(s):
        return False
      continue
    return False
  if not sawDigit:
    return False
  if sawDot:
    return True
  if sawExp:
    return True
  return False

def _formatCppFloatLit(s: str) -> str:
  """Python ``float`` → C++ ``float``/``PyFloat`` 字面量（加 ``f``）。``float64`` 走 ``_formatCppFloat64Lit``。"""
  t: str = s.strip()
  if t == "":
    return t
  last: str = t[len(t) - 1]
  if last == "f" or last == "F":
    t = t[: len(t) - 1]
  body: str = t
  i0: int = 0
  if len(body) > 0 and (body[0] == "+" or body[0] == "-"):
    i0 = 1
  allDig: bool = i0 < len(body)
  while i0 < len(body):
    chD: str = body[i0]
    if chD < "0" or chD > "9":
      allDig = False
      break
    i0 += 1
  if allDig:
    body = body + ".0"
  return body + "f"

def _formatCppFloat64Lit(s: str) -> str:
  """Python ``float`` 字面量 → C++ ``double``（无 ``f``；对齐 host ``format_cpp_float64``）。"""
  t: str = s.strip()
  if t == "":
    return t
  last: str = t[len(t) - 1]
  if last == "f" or last == "F":
    t = t[: len(t) - 1]
  body: str = t
  i0: int = 0
  if len(body) > 0 and (body[0] == "+" or body[0] == "-"):
    i0 = 1
  allDig: bool = i0 < len(body)
  while i0 < len(body):
    chD: str = body[i0]
    if chD < "0" or chD > "9":
      allDig = False
      break
    i0 += 1
  if allDig:
    body = body + ".0"
  return body

def _callPrefersFloat64(callee0: str, targs0: str, cal: str) -> bool:
  """``isClose[float64]`` / ``floatAsIntegerRatio`` 等实参须用 double 字面量。"""
  if callee0 == "floatAsIntegerRatio":
    return True
  if targs0.find("PyFloat64") >= 0:
    return True
  if cal.find("<PyFloat64>") >= 0:
    return True
  return False

def _isAttrOrIdent(s: str) -> bool:
  if s == "":
    return False
  # ``this->g`` / ``self.g`` / ``h.g``
  t: str = s.strip()
  arrowMark: str = "->"
  if t.find(arrowMark) >= 0:
    t = t.replace(arrowMark, ".")
  parts: list[str] = t.split(".")
  pi: int = 0
  while pi < len(parts):
    if parts[pi] == "" or not _isIdent(parts[pi]):
      return False
    pi += 1
  return True

def _findOutsideQuotes(s: str, needle: str) -> int:
  if needle == "":
    return -1
  i: int = 0
  n: int = len(s)
  nn: int = len(needle)
  inStr: bool = False
  inTriple: bool = False
  qCh: str = ""
  while i < n:
    ch: str = s[i]
    if inTriple:
      if i + 2 < n:
        c1: str = s[i + 1 : i + 2]
        c2: str = s[i + 2 : i + 3]
        if ch == qCh and c1 == qCh and c2 == qCh:
          inTriple = False
          inStr = False
          i += 3
          continue
      i += 1
      continue
    if inStr:
      if ch == "\\" and i + 1 < n:
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      if i + 2 < n:
        n1: str = s[i + 1 : i + 2]
        n2: str = s[i + 2 : i + 3]
        if n1 == ch and n2 == ch:
          inTriple = True
          inStr = True
          qCh = ch
          i += 3
          continue
      inStr = True
      qCh = ch
      i += 1
      continue
    if i + nn <= n and s[i : i + nn] == needle:
      return i
    i += 1
  return -1

def _rhsLooksBool(rhs: str) -> bool:
  r: str = rhs.strip()
  if "==" in r or "!=" in r or "<=" in r or ">=" in r:
    return True
  # 勿把 ``<<`` / ``>>`` 当成比较
  rCmp: str = r.replace("<<", "").replace(">>", "")
  if "<" in rCmp or ">" in rCmp:
    return True
  if _findOutsideQuotes(r, " is not ") >= 0:
    return True
  if _findOutsideQuotes(r, " is ") >= 0:
    return True
  if _findOutsideQuotes(r, " in ") >= 0:
    return True
  if _findOutsideQuotes(r, " and ") >= 0:
    return True
  if _findOutsideQuotes(r, " or ") >= 0:
    return True
  if len(r) >= 4 and r[:4] == "not ":
    return True
  return False

def _bareKwEqPos(s: str) -> int:
  """``name=value`` 的 ``=`` 位置；忽略 ``==`` ``!=`` ``<=`` ``>=``。"""
  i: int = 0
  n: int = len(s)
  inStr: bool = False
  qCh: str = ""
  while i < n:
    ch: str = s[i : i + 1]
    if inStr:
      if ch == "\\" and i + 1 < n:
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      inStr = True
      qCh = ch
      i += 1
      continue
    if ch == "=":
      prev: str = ""
      if i > 0:
        prev = s[i - 1 : i]
      nxt: str = ""
      if i + 1 < n:
        nxt = s[i + 1 : i + 2]
      # 扁平 bad 标志；``"<"/">"`` 字面量勿直接写在 if 里（薄 emit 会 soft-skip）
      bad: bool = False
      if prev == "=":
        bad = True
      if prev == "!":
        bad = True
      ltCh: str = "<"
      gtCh: str = ">"
      if prev == ltCh:
        bad = True
      if prev == gtCh:
        bad = True
      if nxt == "=":
        bad = True
      if not bad:
        return i
    i += 1
  return -1

def _clipHead(s: str, n: int) -> str:
  if n <= 0:
    return ""
  if len(s) <= n:
    return s
  return s[0:n]

def _isTypeCtorName(s: str) -> bool:
  if not _isIdent(s):
    return False
  if _stdlibCtorCpp(s) != "":
    return True
  ch0: str = s[0]
  return ch0 >= "A" and ch0 <= "Z"

def _isStdlibPropAttr(attr: str) -> bool:
  """无歧义 stdlib ``@property``（读 → ``attr__get()``）；不含 name/x/y/value 等易与 record 字段撞车者。"""
  if attr == "view":
    return True
  if attr == "width":
    return True
  if attr == "height":
    return True
  if attr == "pid":
    return True
  if attr == "alive":
    return True
  if attr == "exitCode":
    return True
  if attr == "ident":
    return True
  if attr == "daemon":
    return True
  if attr == "parent":
    return True
  if attr == "suffix":
    return True
  if attr == "stem":
    return True
  if attr == "real":
    return True
  if attr == "imag":
    return True
  if attr == "capacity":
    return True
  if attr == "done":
    return True
  if attr == "ok":
    return True
  if attr == "numerator":
    return True
  if attr == "denominator":
    return True
  if attr == "day":
    return True
  if attr == "month":
    return True
  if attr == "year":
    return True
  if attr == "hour":
    return True
  if attr == "minute":
    return True
  if attr == "second":
    return True
  if attr == "microsecond":
    return True
  if attr == "drive":
    return True
  if attr == "anchor":
    return True
  if attr == "parts":
    return True
  if attr == "__class_id__":
    return True
  if attr == "__id__":
    return True
  if attr == "__enum__":
    return True
  if attr == "returnValue":
    return True
  if attr == "value":
    return True
  if attr == "nativeId":
    return True
  if attr == "isAtty":
    return True
  if attr == "argv":
    return True
  # Path 只读（name 见 _rewritePropGets 特判；勿加 value/x/y/a/b）
  if attr == "suffixes":
    return True
  if attr == "parents":
    return True
  if attr == "root":
    return True
  # StringIO.pos / Barrier
  if attr == "pos":
    return True
  if attr == "parties":
    return True
  if attr == "nWaiting":
    return True
  if attr == "broken":
    return True
  if attr == "start":
    return True
  if attr == "stop":
    return True
  if attr == "step":
    return True
  if attr == "stdev":
    return True
  if attr == "mean":
    return True
  if attr == "median":
    return True
  if attr == "variance":
    return True
  if attr == "inv":
    return True
  if attr == "childCount":
    return True
  if attr == "title":
    return True
  if attr == "running":
    return True
  # ``UIWidget.handle`` / ``LoopHandle.handle`` 为字段，勿 ``handle__get()``
  if attr == "returnCode":
    return True
  if attr == "localPosition":
    return True
  if attr == "localRotation":
    return True
  if attr == "localScale":
    return True
  if attr == "localAngle":
    return True
  if attr == "position":
    return True
  if attr == "rotation":
    return True
  if attr == "scale":
    return True
  if attr == "angle":
    return True
  if attr == "checked":
    return True
  if attr == "text":
    return True
  if attr == "value":
    return True
  if attr == "xAxis":
    return True
  if attr == "yAxis":
    return True
  if attr == "zAxis":
    return True
  if attr == "eulerAngles":
    return True
  # x/y/z/w：仅 Vector/Color 等走 __get，见 ``_isVectorLikeXyProp``（勿全局套用，破 PyCell）
  if attr == "localMatrix":
    return True
  if attr == "localInvMatrix":
    return True
  if attr == "localToWorldMatrix":
    return True
  if attr == "worldToLocalMatrix":
    return True
  if attr == "forward":
    return True
  if attr == "right":
    return True
  if attr == "down":
    return True
  return False

def _isXyZwAttr(attr: str) -> bool:
  if attr == "x" or attr == "y" or attr == "z" or attr == "w":
    return True
  if attr == "r" or attr == "g" or attr == "b" or attr == "a":
    return True
  return False

def _tyWantsXyPropGet(ty: str) -> bool:
  """``PyVector*`` / ``PyColor`` / ``PyQuaternion`` 等用 ``x__get()``；``PyCell`` 等用字段。"""
  if ty == "":
    return False
  if ty.find("PyCell") >= 0:
    return False
  if ty.find("Vector") >= 0:
    return True
  if ty.find("Color") >= 0:
    return True
  if ty.find("Quaternion") >= 0:
    return True
  if ty.find("Transform") >= 0:
    return True
  if ty.find("PyRect") >= 0:
    return True
  if ty.find("PyRotator") >= 0:
    return True
  return False

def _isRefCountPropAttr(attr: str) -> bool:
  if attr == "parent":
    return True
  if attr == "root":
    return True
  return False

def _refCountTransformTy(baseTy: str, rhsName: str, st: EnumEmitState) -> str:
  """``parent`` / ``root`` 的 ``PyRefCount<PyTransform*<PyFloat>>`` 实参类型。"""
  tyMk: str = baseTy
  if _isIdent(rhsName):
    rty: str = _localCppTypeOf(st, rhsName)
    if rty != "":
      tyMk = rty
  if tyMk.find("Transform3D") >= 0:
    return "PyTransform3D<PyFloat>"
  if tyMk.find("Transform2D") >= 0:
    return "PyTransform2D<PyFloat>"
  if tyMk != "":
    return tyMk
  return "PyTransform2D<PyFloat>"

def _cppTypeHasPublicTextField(cppTy: str) -> bool:
  """``text`` 作字段而非 ``text__get``；空类型（``auto``/getitem）默认字段，避免 seed Token/SourceFile 误伤。"""
  if cppTy == "":
    return True
  if cppTy == "PyUIPushButton":
    return True
  if cppTy.find("SourceFile") >= 0:
    return True
  if cppTy.find("Token") >= 0:
    return True
  if cppTy.find("Diagnostic") >= 0:
    return True
  return False

def _isStdlibStaticPropAttr(attr: str) -> bool:
  """``Thread.current`` / ``Task.duration`` 等静态 ``@property`` → ``::attr__get()``。"""
  if attr == "current":
    return True
  if attr == "main":
    return True
  if attr == "periodCount":
    return True
  if attr == "duration":
    return True
  if attr == "white":
    return True
  if attr == "black":
    return True
  if attr == "clear":
    return True
  if attr == "red":
    return True
  if attr == "green":
    return True
  if attr == "blue":
    return True
  if attr == "identity":
    return True
  if attr == "zero":
    return True
  if attr == "one":
    return True
  if attr == "right":
    return True
  if attr == "down":
    return True
  if attr == "forward":
    return True
  if attr == "activeCount":
    return True
  if attr == "actives":
    return True
  if attr == "colorful":
    return True
  # 异常 / 类型对象 ``KeyError.__id__`` → ``::__id____get()``
  if attr == "__id__":
    return True
  return False

def _emitStdlibPropAssign(base: str, attr: str, rhsR: str, st: EnumEmitState) -> str:
  """``child.parent = root`` / ``cb.checked = true`` → ``…__set(…)``。"""
  if not _isIdent(attr):
    return ""
  # 裸 ``self``：``_rewriteSelf`` 只认 ``self.``，stdlib title 等须 ``this->``
  selfTok0: str = "se" + "lf"
  baseCpp: str = _rewriteSelf(base)
  if len(base) == 4 and base.find(selfTok0) == 0:
    baseCpp = "this"
  if baseCpp == "":
    return ""
  baseTy: str = ""
  if _isIdent(base):
    baseTy = _localCppTypeOf(st, base)
  if attr == "text" and _cppTypeHasPublicTextField(baseTy):
    rhsFld: str = _emitSimpleTerm(rhsR, st)
    if rhsFld != "":
      return "  " + baseCpp + ".text = " + rhsFld + ";\n"
    return ""
  # ``JsonDecoder.pos`` / ``Yaml*.pos`` 为公开字段，勿 ``pos__set``（StringIO 仍走 property）
  if attr == "pos":
    if baseTy.find("JsonDecoder") >= 0 or baseTy.find("Yaml") >= 0:
      rhsPos: str = _emitSimpleTerm(rhsR, st)
      if rhsPos == "":
        if _isIntLit(rhsR):
          rhsPos = rhsR
      if rhsPos != "":
        return "  " + baseCpp + ".pos = " + rhsPos + ";\n"
      return ""
  # 无注解形参：``obj.value = 7`` → ``PY2CPP_SETATTR``
  if _isIdent(base) and _isUntypedParamName(st, base):
    useSet: bool = False
    if _isStdlibPropAttr(attr):
      useSet = True
    if _isUserPropName(st, attr):
      useSet = True
    if _isRecordFieldName(st, attr):
      useSet = True
    if useSet:
      rhsU: str = _emitSimpleTerm(rhsR, st)
      if rhsU == "":
        if rhsR == "True":
          rhsU = "true"
        elif rhsR == "False":
          rhsU = "false"
        elif rhsR == "None":
          rhsU = "nullptr"
      if rhsU != "":
        _noteSetattrAttr(st, attr)
        return "  PY2CPP_SETATTR(" + baseCpp + ", " + attr + ", " + rhsU + ");\n"
      return ""
  # ``a.x = 7``（Vector 等）：xyzw 虽非 stdlibProp 名单，仍走 ``__set``
  wantsXySet: bool = False
  if _isXyZwAttr(attr) and _tyWantsXyPropGet(baseTy):
    wantsXySet = True
  if (not _isStdlibPropAttr(attr)) and (wantsXySet == False):
    return ""
  if _isRecordFieldName(st, attr) and (wantsXySet == False):
    return ""
  rhsPs: str = _emitSimpleTerm(rhsR, st)
  if rhsPs == "":
    if rhsR == "True":
      rhsPs = "true"
    elif rhsR == "False":
      rhsPs = "false"
    elif rhsR == "None":
      rhsPs = "nullptr"
    else:
      return ""
  if len(rhsR) >= 4 and rhsR[:4] == "new.":
    ndTy: str = baseTy
    if attr == "rotation":
      if baseTy.find("Transform3D") >= 0:
        ndTy = "PyQuaternion<PyFloat>"
      elif baseTy.find("Transform2D") >= 0:
        ndTy = "PyRotator<PyFloat>"
      elif ndTy == "":
        ndTy = "PyQuaternion<PyFloat>"
    if ndTy == "":
      ndTy = "PyVector2<PyFloat>"
    ndRhs: str = _emitNewDotRhs(ndTy, rhsR[4:], st)
    if ndRhs != "":
      return "  " + baseCpp + "." + attr + "__set(" + ndRhs + ");\n"
  if _isRefCountPropAttr(attr):
    if rhsPs == "nullptr":
      tyRc: str = _refCountTransformTy(baseTy, "", st)
      if baseCpp == "this":
        return "  this->" + attr + "__set(PyRefCount<" + tyRc + ">());\n"
      return "  " + baseCpp + "." + attr + "__set(PyRefCount<" + tyRc + ">());\n"
    tyMk: str = _refCountTransformTy(baseTy, rhsR.strip(), st)
    # 栈 Transform 无 control block，``from_object`` 会 AV；薄 emit 暂 ``makeRefCount`` 拷贝
    rhsPs = "makeRefCount<" + tyMk + ">(" + rhsPs + ")"
  if baseCpp == "this":
    return "  this->" + attr + "__set(" + rhsPs + ");\n"
  return "  " + baseCpp + "." + attr + "__set(" + rhsPs + ");\n"

def _emitNewBareDot(rest: str, st: EnumEmitState) -> str:
  """``new.right`` / ``new.fromAxisAngle(…)``（按常见 spatial 类型尝试）。"""
  r: str = rest.strip()
  if r == "":
    return ""
  # ``new.Login(user=…, ttl=…)`` → union 工厂
  lpN: int = r.find("(")
  vnmN: str = r
  argsN: str = ""
  if lpN > 0 and r[len(r) - 1] == ")":
    vnmN = r[:lpN].strip()
    argsN = r[lpN + 1 : len(r) - 1].strip()
  if _isIdent(vnmN):
    uiN: int = 0
    while uiN < len(st.unionVarNames):
      if st.unionVarNames[uiN] == vnmN:
        ownerN: str = st.unionVarOwners[uiN]
        jN: str = ""
        okN: bool = True
        if argsN != "":
          apN: list[str] = _splitParams(argsN)
          siN: int = 0
          while siN < len(apN):
            aN: str = _emitCallArg(apN[siN], st)
            if aN == "" or aN == "__discard_kw__":
              okN = False
              break
            if jN == "":
              jN = aN
            else:
              jN = jN + ", " + aN
            siN += 1
        if okN:
          if argsN == "":
            return "Py" + ownerN + "::" + vnmN + "()"
          if jN != "":
            return "Py" + ownerN + "::" + vnmN + "(" + jN + ")"
        break
      uiN += 1
  # web/http 工厂优先（勿落入 Vector2::textResponse）
  if vnmN == "textResponse" or vnmN == "htmlResponse" or vnmN == "jsonResponse" or vnmN == "redirectResponse" or vnmN == "emptyResponse":
    ndH: str = _emitNewDotRhs("PyResponse", r, st)
    if ndH != "":
      return ndH
  if vnmN == "read" or vnmN == "readAsync":
    ndR: str = _emitNewDotRhs("PyRequest", r, st)
    if ndR != "":
      return ndR
  # spatial：仅已知静态工厂/分量名，勿对任意 ``new.foo`` 冒充 Vector2
  # ``nd`` 须在 if 外声明（薄 emit 各 if 块独立作用域）；``<>`` 勿写进整段字面量
  nd: str = ""
  ltN: str = "<"
  gtN: str = ">"
  if vnmN == "right" or vnmN == "left" or vnmN == "up" or vnmN == "down" or vnmN == "forward" or vnmN == "back" or vnmN == "one" or vnmN == "zero":
    nd = _emitNewDotRhs("PyVector2" + ltN + "PyFloat" + gtN, r, st)
    if nd != "":
      return nd
    nd = _emitNewDotRhs("PyVector3" + ltN + "PyFloat" + gtN, r, st)
    if nd != "":
      return nd
  if vnmN == "fromAxisAngle" or vnmN == "fromEuler" or vnmN == "identity":
    nd = _emitNewDotRhs("PyQuaternion" + ltN + "PyFloat" + gtN, r, st)
    if nd != "":
      return nd
    nd = _emitNewDotRhs("PyRotator" + ltN + "PyFloat" + gtN, r, st)
    if nd != "":
      return nd
    nd = _emitNewDotRhs("PyMatrix3" + ltN + "PyFloat" + gtN, r, st)
    if nd != "":
      return nd
    nd = _emitNewDotRhs("PyMatrix4" + ltN + "PyFloat" + gtN, r, st)
    if nd != "":
      return nd
  return ""

def _emitNewDotRhs(ty: str, rest: str, st: EnumEmitState) -> str:
  """``new.cwd()`` / ``new.white`` / ``new.black.lerp(w, 0.5)`` → ``Ty::…``。"""
  r: str = rest.strip()
  if r == "":
    return ""
  # 首段属性
  dot1: int = r.find(".")
  lp1: int = r.find("(")
  head: str = r
  after: str = ""
  if lp1 >= 0:
    useCall: bool = False
    if dot1 < 0:
      useCall = True
    else:
      if lp1 < dot1:
        useCall = True
    if useCall:
      # ``cwd()`` / ``fromArgb(x)``
      head = r[:lp1].strip()
      if not _isIdent(head):
        return ""
      # 匹配括号
      depthN: int = 0
      rpN: int = -1
      kn: int = lp1
      while kn < len(r):
        chN: str = r[kn : kn + 1]
        if chN == "(":
          depthN += 1
        if chN == ")":
          depthN -= 1
          if depthN == 0:
            rpN = kn
            break
        kn += 1
      if rpN < 0:
        return ""
      argsN: str = r[lp1 + 1 : rpN].strip()
      callN: str = ""
      if argsN == "":
        callN = ty + "::" + head + "()"
      else:
        partsN: list[str] = _splitParams(argsN)
        jN: str = ""
        piN: int = 0
        while piN < len(partsN):
          if _isDiscardCallKw(partsN[piN]):
            piN += 1
            continue
          aN: str = _emitCallArg(partsN[piN], st)
          if aN == "":
            return ""
          if aN == "__discard_kw__":
            piN += 1
            continue
          if jN == "":
            jN = aN
          else:
            jN = jN + ", " + aN
          piN += 1
        callN = ty + "::" + head + "(" + jN + ")"
      after = r[rpN + 1 :].strip()
      if after == "":
        return callN
      chainedN: str = _emitMethodChainOn(callN, after, st)
      return chainedN
  # ``white`` / ``black.lerp(...)``
  if dot1 < 0:
    if not _isIdent(r):
      return ""
    if _isStdlibStaticPropAttr(r):
      return ty + "::" + r + "__get()"
    return ty + "::" + r + "__get()"
  head = r[:dot1].strip()
  after = r[dot1:].strip()
  if not _isIdent(head):
    return ""
  baseN: str = ty + "::" + head + "__get()"
  return _emitMethodChainOn(baseN, after, st)

def _isDiscardCallKw(arg: str) -> bool:
  """调用实参中丢弃的关键字（``assertEqual(..., msg=…)`` 等）。"""
  a: str = arg.strip()
  if a == "__discard_kw__":
    return True
  eq: int = _bareKwEqPos(a)
  if eq <= 0:
    return False
  left: str = a[:eq].strip()
  if left == "msg":
    return True
  return False

def _trailingIdentFromOut(out: str) -> str:
  s: str = out.strip()
  # ``(second)`` / ``((x))`` → 剥外层括号再取尾标识
  while len(s) >= 2 and s[0:1] == "(" and s[len(s) - 1 : len(s)] == ")":
    depthP: int = 0
    matched: bool = True
    iP: int = 0
    while iP < len(s):
      chP: str = s[iP : iP + 1]
      if chP == "(":
        depthP = depthP + 1
      elif chP == ")":
        depthP = depthP - 1
        if depthP == 0 and iP != len(s) - 1:
          matched = False
          break
      iP = iP + 1
    if matched == False or depthP != 0:
      break
    s = s[1 : len(s) - 1].strip()
  rb: int = len(s) - 1
  while rb >= 0:
    if not _isIdentContCh(s[rb : rb + 1]):
      break
    rb -= 1
  if rb >= len(s) - 1:
    return ""
  return s[rb + 1 :]

def _rewritePropGets(expr: str, st: EnumEmitState) -> str:
  """``recv.view`` / ``this->pid`` → ``recv.view__get()``（stdlib + 用户 ``property`` 块）。"""
  s: str = expr
  if "." not in s and "->" not in s and "::" not in s:
    return s
  # ``p.view``（utf8ptr）→ ``_cstrView(p)``（与 host 对齐；指针无 ``view__get``）
  if len(s) >= 6 and s[len(s) - 5 :] == ".view":
    recvV: str = s[: len(s) - 5].strip()
    if _isIdent(recvV):
      tyV: str = _localCppTypeOf(st, recvV)
      if tyV.find("Utf8") >= 0 or tyV.find("utf8") >= 0:
        # 勿写 ``"::"`` 字面量（薄 emit soft-skip）
        nsV8: str = ":" + ":paw:" + ":util:" + ":memory:" + ":_cstrView("
        return nsV8 + _escapeCppIdent(recvV) + ")"
      if tyV.find("Utf16") >= 0 or tyV.find("utf16") >= 0:
        nsV16: str = ":" + ":paw:" + ":util:" + ":memory:" + ":_cwstrView("
        return nsV16 + _escapeCppIdent(recvV) + ")"
  out: str = ""
  refFollow: bool = False
  jsonDocFollow: bool = False
  i: int = 0
  n: int = len(s)
  inStr: bool = False
  qCh: str = ""
  while i < n:
    ch: str = s[i : i + 1]
    if inStr:
      out = out + ch
      if ch == "\\" and i + 1 < n:
        out = out + s[i + 1 : i + 2]
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      inStr = True
      qCh = ch
      out = out + ch
      i += 1
      continue
    # ``PyThread::current`` → ``PyThread::current__get()``
    if ch == ":" and i + 1 < n and s[i + 1 : i + 2] == ":":
      jS: int = i + 2
      if jS < n and _isIdentStartCh(s[jS : jS + 1]):
        kS: int = jS + 1
        while kS < n and _isIdentContCh(s[kS : kS + 1]):
          kS += 1
        atrS: str = s[jS:kS]
        alreadyS: bool = False
        if len(atrS) >= 5 and atrS[len(atrS) - 5 :] == "__get":
          alreadyS = True
        if kS < n and s[kS : kS + 1] == "(":
          alreadyS = True
        if (not alreadyS) and _isStdlibStaticPropAttr(atrS):
          out = out + "::" + atrS + "__get()"
          i = kS
          continue
      out = out + "::"
      i = jS
      continue
    isDot: bool = ch == "."
    isArrow: bool = False
    if ch == "-":
      if i + 1 < n:
        if s[i + 1 : i + 2] == ">":
          isArrow = True
    if isDot or isArrow:
      sep: str = "."
      j: int = i + 1
      if isArrow:
        sep = "->"
        j = i + 2
      if j < n and _isIdentStartCh(s[j : j + 1]):
        k: int = j + 1
        while k < n and _isIdentContCh(s[k : k + 1]):
          k += 1
        attr: str = s[j:k]
        # ``PyRefCount<T> mem`` / ``T* p`` → ``mem->…`` / ``p->…``（非 ``.``）
        # 用 ``_tyIsPyRefCount``，勿 ``find("PyRefCount<"``（薄 emit soft-skip）
        if isDot and (not isArrow):
          recvRc: str = _trailingIdentFromOut(out)
          if recvRc != "":
            tyRcDot: str = _localCppTypeOf(st, recvRc)
            if _tyIsPyRefCount(tyRcDot):
              sep = "->"
            elif len(tyRcDot) > 0 and tyRcDot[len(tyRcDot) - 1] == "*":
              sep = "->"
          # ``pool.submit(…).result``：调用结果为 RefCount，点号改箭头
          if sep == ".":
            if out.find(".submit(") >= 0 or out.find("submit(") >= 0:
              if attr == "result" or attr == "cancel" or attr == "done":
                sep = "->"
              if attr == "exception" or attr == "cancelled" or attr == "running":
                sep = "->"
        # 已是 ``foo__get`` / 后接 ``(`` 则勿再包
        already: bool = False
        if len(attr) >= 5 and attr[len(attr) - 5 :] == "__get":
          already = True
        if k < n and s[k : k + 1] == "(":
          already = True
        # ``doc.teams`` / cursor 链 → ``__getattr__("teams")``（JsonDocument）
        if (not already) and _isIdent(attr):
          wantJd: bool = jsonDocFollow
          if wantJd == False:
            recvJd: str = _trailingIdentFromOut(out)
            if recvJd != "":
              tyJd: str = _localCppTypeOf(st, recvJd)
              if tyJd.find("JsonDocument") >= 0 or tyJd.find("JsonDocCursor") >= 0:
                wantJd = True
          if wantJd:
            skipJd: bool = False
            if attr == "load" or attr == "dump" or attr == "commit" or attr == "discard" or attr == "open":
              skipJd = True
            if attr == "path" or attr == "mode" or attr == "text" or attr == "orig" or attr == "writable" or attr == "dirty":
              skipJd = True
            if skipJd == False:
              out = out + sep + "__getattr__(PyStr(\"" + attr + "\"))"
              jsonDocFollow = True
              refFollow = False
              i = k
              continue
        if refFollow:
          out = out + "->" + attr
          doRf: bool = False
          if (not already) and _isStdlibPropAttr(attr):
            if not _isRecordFieldName(st, attr):
              if attr != "name":
                doRf = True
          if (not already) and _isUserPropName(st, attr):
            doRf = True
          if doRf:
            out = out + "__get()"
          refFollow = False
          i = k
          continue
        doGet: bool = False
        weakValGet: bool = False
        if attr == "value":
          recvWv0: str = _trailingIdentFromOut(out)
          if recvWv0 != "":
            tyWv0: str = _localCppTypeOf(st, recvWv0)
            if tyWv0.find("WeakRef") >= 0:
              weakValGet = True
              doGet = True
        if weakValGet == False:
          if (not already) and _isStdlibPropAttr(attr):
            if not _isRecordFieldName(st, attr):
              doGet = True
          if (not already) and _isUserPropName(st, attr):
            doGet = True
        # 接收者类型若有同名字段（含 ``PoolIntBox.value`` vs Optional.value property），保持字段
        if doGet:
          if weakValGet == False:
            recvFld: str = _trailingIdentFromOut(out)
            if recvFld != "":
              tyFld: str = _localCppTypeOf(st, recvFld)
              if tyFld != "" and _classFieldSrcType(st, tyFld, attr) != "":
                doGet = False
          # ``Point.origin__get().x``：链式 get 后的记录字段保持 ``.x``
          if len(out) >= 7 and out[len(out) - 7 : len(out)] == "__get()":
            if _isRecordFieldName(st, attr):
              doGet = False
        # ``T* p`` / ``Pointer[T]``：字段直读（``p->value``），勿 ``value__get``
        # （勿 ``sep == \"->\"``：薄 emit soft-skip；``->`` 含 ``>`` 而 ``.`` 无）
        if doGet:
          if sep.find(">") >= 0:
            doGet = False
        if doGet:
          recvPtr: str = _trailingIdentFromOut(out)
          if recvPtr != "":
            tyPtr: str = _localCppTypeOf(st, recvPtr)
            if len(tyPtr) > 0 and tyPtr[len(tyPtr) - 1 : len(tyPtr)] == "*":
              doGet = False
        # ``title``：仅 ``*Window*`` 为 property；``FlowNode(Template).title`` 是字段
        if doGet:
          if attr == "title":
            wantWinTi: bool = False
            recvTi: str = _trailingIdentFromOut(out)
            if recvTi != "":
              tyTi: str = _localCppTypeOf(st, recvTi)
              if tyTi.find("Window") >= 0:
                wantWinTi = True
            if out.find("Window") >= 0:
              wantWinTi = True
            if wantWinTi == False:
              doGet = False
        # ``JsonDecoder.pos`` 公开字段（与 StringIO.pos property 区分）
        if doGet:
          if attr == "pos":
            recvPos: str = _trailingIdentFromOut(out)
            if recvPos != "":
              tyPos: str = _localCppTypeOf(st, recvPos)
              if tyPos.find("JsonDecoder") >= 0 or tyPos.find("Yaml") >= 0:
                doGet = False
            if out.find("JsonDecoder") >= 0 or out.find("Yaml") >= 0:
              doGet = False
        # ``ProcessResult.returnCode`` 字段；``Popen.returnCode`` 为 property
        if doGet:
          if attr == "returnCode":
            recvRc2: str = _trailingIdentFromOut(out)
            if recvRc2 != "":
              tyRc2: str = _localCppTypeOf(st, recvRc2)
              if tyRc2.find("ProcessResult") >= 0:
                doGet = False
            if out.find("ProcessResult") >= 0:
              doGet = False
        if (not already) and _isXyZwAttr(attr):
          recvXy: str = _trailingIdentFromOut(out)
          if recvXy != "":
            if _tyWantsXyPropGet(_localCppTypeOf(st, recvXy)):
              doGet = True
          # ``m.position__get().x`` — 前一节已是 ``__get()`` 的向量分量
          if len(out) >= 7 and out[len(out) - 7 : len(out)] == "__get()":
            # 用户类字段 ``x`` 已登记为 record 时勿强制 ``x__get``
            if _isRecordFieldName(st, attr):
              doGet = False
            else:
              doGet = True
        if (not already) and attr == "text":
          recvId: str = _trailingIdentFromOut(out)
          if recvId != "":
            if _cppTypeHasPublicTextField(_localCppTypeOf(st, recvId)):
              doGet = False
        # ``name``：Path/Thread 用 ``name__get()``；用户字段 / 短接收者保持字段
        if (not already) and attr == "name":
          doGet = True
          if _isRecordFieldName(st, "name"):
            doGet = False
          if sep == ".":
            if len(out) >= 1:
              rbN: int = len(out) - 1
              while rbN >= 0 and _isIdentContCh(out[rbN : rbN + 1]):
                rbN -= 1
              idLenN: int = len(out) - 1 - rbN
              if idLenN <= 1:
                doGet = False
              recvNm: str = out[rbN + 1 :]
              if recvNm != "":
                tyNm: str = _localCppTypeOf(st, recvNm)
                if tyNm.find("PyTransform") >= 0:
                  doGet = False
                if tyNm.find("PyPath") < 0 and tyNm.find("PyThread") < 0 and tyNm != "":
                  doGet = False
        if doGet:
          recvUg: str = _trailingIdentFromOut(out)
          if recvUg != "" and _isUntypedParamName(st, recvUg):
            _noteGetattrAttr(st, attr)
            out = "PY2CPP_GETATTR(" + out + ", " + attr + ")"
            i = k
            continue
          out = out + sep + attr + "__get()"
          if _isRefCountPropAttr(attr):
            refFollow = True
          i = k
          continue
        # 无注解接收者上的普通字段（``obj.x``）也走 GETATTR
        recvUf: str = _trailingIdentFromOut(out)
        if (not already) and recvUf != "" and _isUntypedParamName(st, recvUf):
          if _isIdent(attr):
            _noteGetattrAttr(st, attr)
            out = "PY2CPP_GETATTR(" + out + ", " + attr + ")"
            i = k
            continue
      out = out + sep
      i = j
      continue
    out = out + ch
    i += 1
  return out

def _emitTypeCtorExpr(callee: str, inner: str, st: EnumEmitState) -> str:
  scTy: str = _stdlibCtorCpp(callee)
  ty: str = scTy if scTy != "" else _cppType(callee, st)
  parts: list[str] = _splitParams(inner)
  if len(parts) == 0:
    # 薄 emit 下本模块用户类名有时未登记类型 → 补 ``Py`` 前缀
    posTests: int = callee.find("Tests")
    posTest: int = callee.find("Test")
    if (posTests >= 0 and posTests == len(callee) - 5) or (
      posTest >= 0 and posTest == len(callee) - 4
    ):
      if ty.find("Py") != 0:
        ty = "Py" + ty
    # ``FooTests()`` → ``makeRefCount<PyFooTests>()``（addTest / RefCount 用例）
    if posTest >= 0 and posTest == len(callee) - 4:
      return "makeRefCount<" + ty + ">()"
    if posTests >= 0 and posTests == len(callee) - 5:
      return "makeRefCount<" + ty + ">()"
    return "(" + ty + "{})"
  allKw: bool = True
  pi0: int = 0
  while pi0 < len(parts):
    p0: str = parts[pi0].strip()
    eq0: int = p0.find("=")
    if not (eq0 > 0 and _isIdent(p0[:eq0].strip())):
      allKw = False
      break
    pi0 += 1
  if not allKw:
    # ``ModeEnum(1)`` / ``WideEnum(1)`` → ``static_cast<PyModeEnum>(1)``
    if _isEnumTypeName(st, callee) and len(parts) == 1:
      a0: str = parts[0].strip()
      if _isIntLit(a0):
        return "static_cast<" + ty + ">(" + a0 + ")"
    # ``Path("foo")`` / ``Frac("1/2")`` / ``Vector2(1.0, 0.0)`` 位置实参构造
    aPos0: str = _emitCallArg(parts[0], st)
    if aPos0 == "":
      return ""
    if aPos0 == "__discard_kw__":
      return ""
    joinedPos: str = aPos0
    piP: int = 1
    while piP < len(parts):
      if _isDiscardCallKw(parts[piP]):
        piP += 1
        continue
      aPos: str = _emitCallArg(parts[piP], st)
      if aPos == "":
        return ""
      if aPos == "__discard_kw__":
        piP += 1
        continue
      joinedPos = joinedPos + ", " + aPos
      piP += 1
    return ty + "(" + joinedPos + ")"
  out: str = "([&]() -> " + ty + " { " + ty + " __o{}; "
  i: int = 0
  while i < len(parts):
    p: str = parts[i].strip()
    eq: int = p.find("=")
    field: str = p[:eq].strip()
    val: str = p[eq + 1 :].strip()
    termV: str = _emitSimpleTerm(val, st)
    if termV == "" and len(val) >= 2 and val[0] == "[" and val[len(val) - 1] == "]":
      termV = _emitListLitExpr(val[1 : len(val) - 1], st, "")
    if termV == "":
      return ""
    if field == "text" and _cppTypeHasPublicTextField(ty):
      out = out + "__o.text = " + termV + "; "
    elif _isStdlibPropAttr(field) and not _isRecordFieldName(st, field):
      out = out + "__o." + field + "__set(" + termV + "); "
    else:
      out = out + "__o." + field + " = " + termV + "; "
    i += 1
  out = out + "return __o; })()"
  return out

def _tryPadConsoleRunArgs(argParts: list[str], st: EnumEmitState) -> str:
  """``Console.run(args, captureOutput=True)`` → 填 cwd/env 默认，避免 bool→PyStr。"""
  pos: list[str] = []
  kwCap: str = ""
  kwTimeout: str = ""
  kwCheck: str = ""
  kwCwd: str = ""
  hasKw: bool = False
  ai: int = 0
  while ai < len(argParts):
    raw: str = argParts[ai].strip()
    if _isDiscardCallKw(raw):
      ai += 1
      continue
    eqK: int = _bareKwEqPos(raw)
    if eqK > 0:
      leftK: str = raw[:eqK].strip()
      rightK: str = raw[eqK + 1 : len(raw)].strip()
      valK: str = _emitCallArg(raw, st)
      if valK == "" or valK == "__discard_kw__":
        ai += 1
        continue
      hasKw = True
      if leftK == "captureOutput":
        kwCap = valK
      elif leftK == "timeout":
        kwTimeout = valK
      elif leftK == "check":
        kwCheck = valK
      elif leftK == "cwd":
        kwCwd = valK
      ai += 1
      continue
    axP: str = _emitCallArg(raw, st)
    if axP == "" or axP == "__discard_kw__":
      return ""
    pos.append(axP)
    ai += 1
  if hasKw == False:
    return ""
  if len(pos) < 1:
    return ""
  cwdV: str = kwCwd
  if cwdV == "":
    cwdV = "PyStr(\"\")"
  envV: str = "(PyOptional<PyDict<PyStr, PyStr>>::None_())"
  capV: str = kwCap
  if capV == "":
    capV = "false"
  joinedR: str = pos[0] + ", " + cwdV + ", " + envV + ", " + capV
  if kwTimeout != "":
    joinedR = joinedR + ", " + kwTimeout
    if kwCheck != "":
      joinedR = joinedR + ", " + kwCheck
  elif kwCheck != "":
    joinedR = joinedR + ", PY2CPP_FLOAT_INF, " + kwCheck
  return joinedR

def _emitFStringPlaceholderArg(raw: str, st: EnumEmitState) -> str:
  """f-string ``{expr}`` / ``{expr:spec}`` → ``PyStr`` 实参。"""
  piece: str = raw.strip()
  if piece == "":
    return ""
  specAt: int = -1
  depthP: int = 0
  piP: int = 0
  while piP < len(piece):
    chP: str = piece[piP : piP + 1]
    if chP == "(" or chP == "[" or chP == "{":
      depthP += 1
    elif chP == ")" or chP == "]" or chP == "}":
      if depthP > 0:
        depthP -= 1
    elif chP == ":" and depthP == 0:
      specAt = piP
      break
    piP += 1
  exprP: str = piece
  specP: str = ""
  if specAt >= 0:
    exprP = piece[:specAt].strip()
    specP = piece[specAt + 1 :].strip()
  if exprP == "True":
    return "PyStr(\"True\")"
  if exprP == "False":
    return "PyStr(\"False\")"
  if _isIntLit(exprP) or _isFloatLit(exprP):
    if specP != "":
      return "format(" + exprP + ", \"" + specP + "\")"
    return "static_cast<PyStr>(" + exprP + ")"
  termP: str = _emitSimpleTerm(exprP, st)
  if termP == "":
    termP = _emitCallArg(exprP, st)
  if termP == "" or termP == "__discard_kw__":
    return ""
  if termP == "true":
    return "PyStr(\"True\")"
  if termP == "false":
    return "PyStr(\"False\")"
  if _isIdent(exprP):
    tyBoolF: str = _localCppTypeOf(st, exprP)
    if tyBoolF.find("Bool") >= 0 or tyBoolF == "bool":
      return "((" + termP + ") ? PyStr(\"True\") : PyStr(\"False\"))"
  if len(termP) >= 5 and termP[:5] == "PyStr":
    return termP
  if specP != "":
    return "format(" + termP + ", \"" + specP + "\")"
  return "static_cast<PyStr>(" + termP + ")"

def _emitFStringExpr(expr: str, st: EnumEmitState) -> str:
  """薄 f-string（可多占位）→ ``PyStr::format(\"…{}…\", …)``。"""
  a: str = expr.strip()
  if len(a) < 4:
    return ""
  if a[0:1] != "f":
    return ""
  q: str = a[1:2]
  if q != "\"" and q != "'":
    return ""
  if a[len(a) - 1 : len(a)] != q:
    return ""
  inner: str = a[2 : len(a) - 1]
  fmt: str = ""
  argsJ: str = ""
  iF: int = 0
  nF: int = len(inner)
  while iF < nF:
    chF: str = inner[iF : iF + 1]
    if chF == "{" and iF + 1 < nF and inner[iF + 1 : iF + 2] == "{":
      fmt = fmt + "{"
      iF += 2
      continue
    if chF == "}" and iF + 1 < nF and inner[iF + 1 : iF + 2] == "}":
      fmt = fmt + "}"
      iF += 2
      continue
    if chF == "{":
      jF: int = iF + 1
      depthF: int = 1
      while jF < nF:
        cjF: str = inner[jF : jF + 1]
        if cjF == "{":
          depthF += 1
        elif cjF == "}":
          depthF -= 1
          if depthF == 0:
            break
        jF += 1
      if depthF != 0:
        return ""
      argOne: str = _emitFStringPlaceholderArg(inner[iF + 1 : jF], st)
      if argOne == "":
        return ""
      fmt = fmt + "{}"
      if argsJ == "":
        argsJ = argOne
      else:
        argsJ = argsJ + ", " + argOne
      iF = jF + 1
      continue
    fmt = fmt + chF
    iF += 1
  if argsJ == "":
    return "PyStr(\"" + fmt + "\")"
  return "PyStr::format(\"" + fmt + "\", " + argsJ + ")"

def _emitCallArg(arg: str, st: EnumEmitState) -> str:
  a: str = arg.strip()
  if a == "":
    return ""
  fsA: str = _emitFStringExpr(a, st)
  if fsA != "":
    return fsA
  # ``packLen(*nums)`` / ``f(*rest)``：整包转发，勿 C ``*`` 解引用
  # variadic ``sumAll(*args)`` → ``args...``
  # ``sumAll(3, *a, 4)`` 定长 ``PyTuple`` → ``a.__getitem__(i)``
  if len(a) > 1 and a[:1] == "*":
    starA: str = a[1:].strip()
    if _isIdent(starA):
      if _isPackParamName(st, starA):
        return _escapeCppIdent(starA) + "..."
      expT: str = _expandStarTupleArg(starA, st)
      if expT != "":
        return expT
      return _escapeCppIdent(starA)
  eq: int = _bareKwEqPos(a)
  if eq > 0:
    left: str = a[:eq].strip()
    # 显式 end，避免开区间切片在薄 runtime 上踩哨兵
    right: str = a[eq + 1 : len(a)].strip()
    if _isIdent(left):
      if left == "msg":
        return "__discard_kw__"
      termKw: str = _emitSimpleTerm(right, st)
      if termKw != "":
        return _rewriteAllTypeDots(termKw)
      if right == "True":
        return "true"
      if right == "False":
        return "false"
      if _isFloatLit(right) or _isIntLit(right):
        return right
      # 关键字实参值翻不出：丢弃该 kw，勿拖垮整次调用
      return "__discard_kw__"
  term: str = _emitSimpleTerm(a, st)
  if term != "":
    return _rewriteAllTypeDots(term)
  # ``assertTrue(a > b)`` / ``a != b`` 等比较实参（勿把 ``!=`` 当 kw）
  if _rhsLooksBool(a):
    return _emitBoolCond(a, st)
  # 裸比较回退
  cmpA: str = _emitCmpAtom(a, st)
  if cmpA != "":
    return cmpA
  # 最后：对原始比较串整段 Type.dot 改写后再试
  rewritten: str = _rewriteAllTypeDots(a)
  if rewritten != a:
    term2: str = _emitSimpleTerm(rewritten, st)
    if term2 != "":
      return term2
    if _rhsLooksBool(rewritten):
      return _emitBoolCond(rewritten, st)
  return ""

def _emitArithExpr(src: str) -> str:
  s: str = src.strip()
  out: str = ""
  i: int = 0
  n: int = len(s)
  while i < n:
    ch: str = s[i]
    if ch == " " or ch == "\t":
      i += 1
      continue
    if ch in "()+-*/":
      out = out + ch
      i += 1
      continue
    # 浮点字面量（``.5`` / ``1.0``）；勿把单独 ``.`` 当属性点
    if ch == "." and i + 1 < n:
      if s[i + 1] >= "0" and s[i + 1] <= "9":
        jF0: int = i + 1
        while jF0 < n:
          cjF0: str = s[jF0]
          if cjF0 >= "0" and cjF0 <= "9":
            jF0 += 1
            continue
          break
        tokF0: str = s[i:jF0]
        if _isFloatLit(tokF0):
          out = out + tokF0
          i = jF0
          continue
        return ""
    if ch >= "0" and ch <= "9":
      jN: int = i + 1
      while jN < n:
        cjN: str = s[jN]
        if cjN >= "0" and cjN <= "9":
          jN += 1
          continue
        if cjN == ".":
          jN += 1
          while jN < n:
            cjN2: str = s[jN]
            if cjN2 >= "0" and cjN2 <= "9":
              jN += 1
              continue
            break
          break
        break
      # 可选指数
      if jN < n:
        if s[jN] == "e" or s[jN] == "E":
          jN2e: int = jN + 1
          if jN2e < n:
            if s[jN2e] == "+" or s[jN2e] == "-":
              jN2e += 1
          while jN2e < n:
            if s[jN2e] >= "0" and s[jN2e] <= "9":
              jN2e += 1
              continue
            break
          jN = jN2e
      tokN: str = s[i:jN]
      if _isIntLit(tokN) or _isFloatLit(tokN):
        out = out + tokN
        i = jN
        continue
      return ""
    if _isIdentStartCh(s[i : i + 1]):
      j: int = i + 1
      while j < n:
        if _isIdentContCh(s[j : j + 1]):
          j += 1
          continue
        break
      # ``a.b`` 属性链
      while j < n:
        if s[j : j + 1] != ".":
          break
        j2: int = j + 1
        if j2 >= n:
          break
        if not _isIdentStartCh(s[j2 : j2 + 1]):
          break
        j = j2 + 1
        while j < n:
          if _isIdentContCh(s[j : j + 1]):
            j += 1
            continue
          break
      tok: str = s[i:j]
      if _isIdent(tok) or _isAttrOrIdent(tok):
        rwA: str = _rewriteTypeDotAttr(tok)
        if rwA != "":
          out = out + rwA
        else:
          out = out + _rewriteSelf(tok)
        i = j
        continue
      return ""
    return ""
  return out

def _emitLenArithIndex(src: str, st: EnumEmitState) -> str:
  s: str = src.strip()
  out: str = ""
  i: int = 0
  n: int = len(s)
  while i < n:
    ch: str = s[i]
    if ch == " " or ch == "\t":
      i += 1
      continue
    if ch in "()+-*/":
      out = out + ch
      i += 1
      continue
    if i + 4 <= n and s[i : i + 4] == "len(":
      depthL: int = 0
      j: int = i + 3
      while j < n:
        cj: str = s[j]
        if cj == "(":
          depthL += 1
        elif cj == ")":
          depthL -= 1
          if depthL == 0:
            break
        j += 1
      if depthL != 0:
        return ""
      inner: str = s[i + 4 : j].strip()
      term: str = _emitSimpleTerm(inner, st)
      if term == "":
        return ""
      out = out + "(" + term + ").__len__()"
      i = j + 1
      continue
    if (ch >= "0" and ch <= "9") or _isIdent(ch):
      j2: int = i + 1
      while j2 < n:
        cj2: str = s[j2]
        if (cj2 >= "0" and cj2 <= "9") or _isIdent(cj2):
          j2 += 1
        else:
          break
      tok: str = s[i:j2]
      if _isIntLit(tok):
        out = out + tok
      elif _isIdent(tok) or _isAttrOrIdent(tok):
        out = out + _rewriteSelf(tok)
      else:
        return ""
      i = j2
      continue
    return ""
  return out

def _emitAdjacentStrLits(term: str) -> str:
  """``'a' 'b'`` / ``\"a\" \"b\"`` 隐式拼接 → ``PyStr(\"a\") + PyStr(\"b\")``。"""
  s: str = term.strip()
  if len(s) < 5:
    return ""
  q0: str = s[:1]
  if q0 != "\"" and q0 != "'":
    return ""
  pieces: list[str] = []
  i: int = 0
  n: int = len(s)
  while i < n:
    while i < n:
      chW: str = s[i : i + 1]
      if chW == " " or chW == "\t" or chW == "\n" or chW == "\r":
        i += 1
        continue
      break
    if i >= n:
      break
    q: str = s[i : i + 1]
    if q != "\"" and q != "'":
      return ""
    j: int = i + 1
    closed: bool = False
    while j < n:
      chJ: str = s[j : j + 1]
      if chJ == "\\" and j + 1 < n:
        j += 2
        continue
      if chJ == q:
        pieces.append(s[i : j + 1])
        i = j + 1
        closed = True
        break
      j += 1
    if closed == False:
      return ""
  if len(pieces) < 2:
    return ""
  outA: str = ""
  piA: int = 0
  while piA < len(pieces):
    litA: str = _emitStrLitRaw(pieces[piA])
    if litA == "":
      return ""
    if outA == "":
      outA = litA
    else:
      outA = outA + " + " + litA
    piA += 1
  return outA

def _emitStrLitRaw(quoted: str) -> str:
  if quoted == "\"\\ufeff\"" or quoted == "'\\ufeff'":
    return "PyStr(PyChar(65279))"
  if quoted == "\"\\n\"" or quoted == "'\\n'":
    return "PyStr(\"\\n\")"
  if quoted == "\"\\t\"" or quoted == "'\\t'":
    return "PyStr(\"\\t\")"
  if quoted == "\"\\r\"" or quoted == "'\\r'":
    return "PyStr(\"\\r\")"
  if quoted == "\"\\\\\"" or quoted == "'\\\\'":
    return "PyStr(\"\\\\\")"
  if quoted == "\"\\r\\n\"" or quoted == "'\\r\\n'":
    return "PyStr(\"\\r\\n\")"
  # Python ``'…'`` → C++ ``PyStr("…")``（多字符单引号非法）
  sqCh: str = "'"
  # 切片须写清终点（勿 ``s[n:]``）
  if len(quoted) >= 2 and quoted[:1] == sqCh and quoted[len(quoted) - 1 : len(quoted)] == sqCh:
    # ``'h'`` / ``'/'`` → ``PyStr``（Path.__truediv__ / writeText / withSegments）。
    # ``s[i] == 'x'`` 仍经 ``_wrapGetitemAsPyStr`` 对齐。
    if len(quoted) == 3:
      ch1: str = quoted[1:2]
      if ch1 == "\"":
        return "PyStr(\"\\\"\")"
      return "PyStr(\"" + ch1 + "\")"
    inner: str = quoted[1 : len(quoted) - 1]
    esc: str = ""
    si: int = 0
    while si < len(inner):
      chS: str = inner[si : si + 1]
      if chS == "\\" and si + 1 < len(inner):
        esc = esc + "\\" + inner[si + 1 : si + 2]
        si += 2
        continue
      if chS == "\"":
        esc = esc + "\\\""
      else:
        esc = esc + chS
      si += 1
    return "PyStr(\"" + esc + "\")"
  return "PyStr(" + quoted + ")"

def _isQuotedStrTerm(t: str) -> bool:
  if len(t) < 2:
    return False
  q: str = t[:1]
  last: str = t[len(t) - 1 : len(t)]
  # Prefer 双引号；单字符单引号在 host Mid 易成 PyChar。
  dq: str = "\""
  sq: str = "'"
  if q == dq and last == dq:
    i: int = 1
    while i < len(t) - 1:
      ch: str = t[i : i + 1]
      if ch == "\\":
        i += 2
        continue
      if ch == dq:
        return False
      i += 1
    return True
  if q == sq and last == sq:
    i2: int = 1
    while i2 < len(t) - 1:
      ch2: str = t[i2 : i2 + 1]
      if ch2 == "\\":
        i2 += 2
        continue
      if ch2 == sq:
        return False
      i2 += 1
    return True
  return False

def _emitMethodChainOn(baseCpp: str, rest: str, st: EnumEmitState) -> str:
  chain: str = baseCpp
  restC: str = rest.strip()
  # Leading / interleaved ``[…]`` getitem before ``.method`` chains.
  while len(restC) > 0 and restC[0] == "[":
    depthGi2: int = 0
    rbGi2: int = -1
    kGi2: int = 0
    while kGi2 < len(restC):
      chGi2: str = str(restC[kGi2])
      if chGi2 == "[":
        depthGi2 = depthGi2 + 1
      elif chGi2 == "]":
        depthGi2 = depthGi2 - 1
        if depthGi2 == 0:
          rbGi2 = kGi2
          break
      kGi2 = kGi2 + 1
    if rbGi2 < 0:
      return ""
    idxGi2: str = restC[1:rbGi2].strip()
    if ":" in idxGi2:
      gotGi2: str = _emitSliceGetitem(chain, idxGi2, st)
      if gotGi2 == "":
        return ""
      chain = gotGi2
    else:
      idxCppGi2: str = _emitIndexExpr(idxGi2, st)
      if idxCppGi2 == "":
        return ""
      subGi2: str = _emitSubscriptOn(chain, idxCppGi2, st)
      if subGi2 == "":
        return ""
      chain = subGi2
    restC = restC[rbGi2 + 1 :].strip()
  while len(restC) >= 2 and restC[0] == ".":
    methPart: str = restC[1:]
    lpM: int = methPart.find("(")
    # ``.members[0].name``：先剥字段，把 ``[…]`` 留给下方下标循环
    lbAttr: int = methPart.find("[")
    if lbAttr > 0 and (lpM < 0 or lbAttr < lpM):
      atrBr: str = methPart[:lbAttr].strip()
      if _isIdent(atrBr):
        # JsonDocument / cursor 链：``.members`` → ``__getattr__``
        if chain.find("__getattr__(PyStr(") >= 0 or chain.find("JsonDocument") >= 0 or chain.find("JsonDocCursor") >= 0:
          chain = "(" + chain + ").__getattr__(PyStr(\"" + atrBr + "\"))"
        elif _isStdlibPropAttr(atrBr) and (not _isRecordFieldName(st, atrBr)):
          if atrBr == "text":
            chain = "(" + chain + ")." + atrBr
          else:
            chain = "(" + chain + ")." + atrBr + "__get()"
        elif _isUserPropName(st, atrBr):
          chain = "(" + chain + ")." + atrBr + "__get()"
        else:
          chain = "(" + chain + ")." + atrBr
        restC = methPart[lbAttr:]
        while len(restC) > 0 and restC[0] == "[":
          depthBr: int = 0
          rbBr: int = -1
          kBr: int = 0
          while kBr < len(restC):
            chBr: str = str(restC[kBr])
            if chBr == "[":
              depthBr = depthBr + 1
            elif chBr == "]":
              depthBr = depthBr - 1
              if depthBr == 0:
                rbBr = kBr
                break
            kBr = kBr + 1
          if rbBr < 0:
            return ""
          idxBr: str = restC[1:rbBr].strip()
          idxCppBr: str = _emitIndexExpr(idxBr, st)
          if idxCppBr == "":
            return ""
          subBr: str = _emitSubscriptOn(chain, idxCppBr, st)
          if subBr == "":
            return ""
          chain = subBr
          restC = restC[rbBr + 1 :].strip()
        continue
    # ``.view.at(0)`` / ``.view.__getitem__(…)``：仅当首段是 property 才先剥；
    # 勿拆 ``assert.equal``（方法名含 ``.``）
    dotBeforeParen: int = methPart.find(".")
    if dotBeforeParen > 0:
      if lpM < 0 or dotBeforeParen < lpM:
        atrPre: str = methPart[:dotBeforeParen].strip()
        peeledPre: bool = False
        if _isIdent(atrPre):
          if _isStdlibPropAttr(atrPre) and (not _isRecordFieldName(st, atrPre)):
            if atrPre == "text":
              chain = "(" + chain + ")." + atrPre
            else:
              chain = "(" + chain + ")." + atrPre + "__get()"
            peeledPre = True
          elif _isUserPropName(st, atrPre):
            chain = "(" + chain + ")." + atrPre + "__get()"
            peeledPre = True
          elif _isXyZwAttr(atrPre) and (
            chain.find("Color") >= 0
            or chain.find("Vector") >= 0
            or chain.find("Quaternion") >= 0
            or chain.find("PyRect") >= 0
            or chain.find("PyRotator") >= 0
          ):
            chain = "(" + chain + ")." + atrPre + "__get()"
            peeledPre = True
        if peeledPre:
          restC = methPart[dotBeforeParen:]
          continue
    if lpM > 0:
      depthM: int = 0
      rpM: int = -1
      km: int = lpM
      inStrM: bool = False
      qM: str = ""
      while km < len(methPart):
        chM: str = methPart[km]
        if inStrM:
          if chM == "\\" and km + 1 < len(methPart):
            km += 2
            continue
          if chM == qM:
            inStrM = False
          km += 1
          continue
        if chM == "\"" or chM == "'":
          inStrM = True
          qM = chM
          km += 1
          continue
        if chM == "(":
          depthM += 1
        elif chM == ")":
          depthM -= 1
          if depthM == 0:
            rpM = km
            break
        km += 1
      if rpM < 0:
        return ""
      methName: str = methPart[:lpM].strip()
      if not _isIdent(methName):
        return ""
      # C++ 关键字：FlowCatalog.register → register_
      if methName == "register":
        methName = "register_"
      argsM: str = methPart[lpM + 1 : rpM].strip()
      callM: str = ""
      sepM: str = "."
      innerPar: str = chain
      if len(chain) >= 2 and chain[0] == "(" and chain[len(chain) - 1] == ")":
        innerPar = chain[1 : len(chain) - 1].strip()
      if _isIdent(innerPar):
        tyPar: str = _localCppTypeOf(st, innerPar)
        if _tyIsPyRefCount(tyPar):
          sepM = "->"
          chain = innerPar
      # Future / RefCount 方法：一律 ``->``（扁平 if，勿多行 or：薄 emit soft-skip）
      futArrow: bool = False
      if methName == "result":
        futArrow = True
      if methName == "cancel":
        futArrow = True
      if methName == "done":
        futArrow = True
      if methName == "exception":
        futArrow = True
      if methName == "cancelled":
        futArrow = True
      if methName == "running":
        futArrow = True
      if futArrow:
        sepM = "->"
        if _isIdent(innerPar):
          chain = innerPar
        elif chain.find("submit(") >= 0:
          if len(chain) >= 2 and chain[0] == "(" and chain[len(chain) - 1] == ")":
            chain = chain[1 : len(chain) - 1].strip()
      if argsM == "":
        callM = "(" + chain + ")" + sepM + methName + "()"
      else:
        if methName == "append":
          arg0: str = argsM.strip()
          if len(arg0) >= 1 and arg0[0] == "*":
            srcM: str = arg0[1:].strip()
            srcMCpp: str = _emitSimpleTerm(srcM, st)
            if srcMCpp != "":
              callM = "(" + chain + ").extend(" + srcMCpp + ")"
              chain = callM
              restC = methPart[rpM + 1 :].strip()
              continue
        apM: list[str] = _splitParams(argsM)
        if len(apM) == 0:
          return ""
        jM: str = ""
        ami: int = 0
        while ami < len(apM):
          if _isDiscardCallKw(apM[ami]):
            ami += 1
            continue
          axm: str = _emitCallArg(apM[ami], st)
          if axm == "":
            return ""
          if axm == "__discard_kw__":
            ami += 1
            continue
          # ``WeakList`` / ``WeakValueDict`` 吃 ``@refcount`` 类，勿 ``PyRefCount<T>`` 实参
          recvTyWa: str = ""
          if _isIdent(chain):
            recvTyWa = _localCppTypeOf(st, chain)
          if (
            recvTyWa.find("WeakList") >= 0
            or recvTyWa.find("WeakValueDict") >= 0
            or chain.find("WeakList") >= 0
            or chain.find("WeakValueDict") >= 0
          ):
            srcWa: str = apM[ami].strip()
            if _isIdent(srcWa):
              tyWa: str = _localCppTypeOf(st, srcWa)
              if _tyIsPyRefCount(tyWa):
                axm = "(*" + _escapeCppIdent(srcWa) + ")"
          if jM == "":
            jM = axm
          else:
            jM = jM + ", " + axm
          ami += 1
        # Path.joinPath / withSegments 吃 ``PyArray<PyStr>``；测试常传多段 str
        if methName == "joinPath" or methName == "withSegments":
          if jM != "":
            segs: list[str] = _splitParams(jM)
            nSeg: int = len(segs)
            fillA: str = "PyArray<PyStr, 0> __jp(" + str(nSeg) + "); "
            siA: int = 0
            while siA < nSeg:
              fillA = (
                fillA
                + "__jp.__setitem__("
                + str(siA)
                + ", "
                + segs[siA].strip()
                + "); "
              )
              siA += 1
            callM = "([&](){ " + fillA + "return (" + chain + ")" + sepM + methName + "(__jp); })()"
          else:
            callM = "(" + chain + ")" + sepM + methName + "()"
        else:
          # Path.rename/replace 单路径；``str.replace(a,b[,n])`` 勿包成 ``PyStr(a, b)``
          if (methName == "rename" or methName == "replace") and len(apM) == 1:
            if jM != "":
              if len(jM) < 6 or jM[:6] != "PyStr(":
                jM = "PyStr(" + jM + ")"
          # ``center/ljust/rjust(width, fill)``：整型 fill → ``PyChar``
          if (
            (methName == "center" or methName == "ljust" or methName == "rjust")
            and len(apM) == 2
          ):
            a0Fill: str = _emitCallArg(apM[0], st)
            a1Raw: str = apM[1].strip()
            a1Fill: str = _emitCallArg(a1Raw, st)
            if a0Fill != "" and a1Fill != "":
              if _isIntLit(a1Raw):
                a1Fill = "PyChar(" + a1Fill + ")"
              jM = a0Fill + ", " + a1Fill
          # ``"{}".format(x)`` → ``PyStr::format("{}", static_cast<PyStr>(x))``
          if methName == "format":
            fmtC: str = ""
            ch0: str = chain.strip()
            if len(ch0) >= 7 and ch0[:6] == "PyStr(" and ch0[len(ch0) - 1] == ")":
              innerF: str = ch0[6 : len(ch0) - 1].strip()
              if _isQuotedStrTerm(innerF) or (
                len(innerF) >= 2 and innerF[0] == "\"" and innerF[len(innerF) - 1] == "\""
              ):
                if len(innerF) >= 2 and innerF[0] == "'" and innerF[len(innerF) - 1] == "'":
                  fmtC = "\"" + innerF[1 : len(innerF) - 1] + "\""
                else:
                  fmtC = innerF
            if fmtC != "":
              if jM == "":
                callM = "PyStr::format(" + fmtC + ")"
              else:
                # 实参须 PyStr；``True``/``False``/``true`` 特判
                partsJm: list[str] = _splitParams(jM)
                jWrap: str = ""
                piJm: int = 0
                while piJm < len(partsJm):
                  rawJm: str = partsJm[piJm].strip()
                  oneJm: str = rawJm
                  if rawJm == "True" or rawJm == "true":
                    oneJm = "PyStr(\"True\")"
                  elif rawJm == "False" or rawJm == "false":
                    oneJm = "PyStr(\"False\")"
                  elif rawJm.find("PyStr") != 0:
                    oneJm = "static_cast<PyStr>(" + rawJm + ")"
                  if jWrap == "":
                    jWrap = oneJm
                  else:
                    jWrap = jWrap + ", " + oneJm
                  piJm += 1
                callM = "PyStr::format(" + fmtC + ", " + jWrap + ")"
              chain = callM
              restC = methPart[rpM + 1 : len(methPart)].strip()
              continue
          # ``d.get(k, default)``：仅 dict；``Grid2D.get(x,y)`` 等勿改三目
          if methName == "get" and len(apM) == 2 and _recvLooksLikeDict(chain, st):
            kGet: str = _emitCallArg(apM[0], st)
            dGet: str = _emitCallArg(apM[1], st)
            if kGet != "" and dGet != "":
              callM = (
                "(("
                + chain
                + ").__contains__("
                + kGet
                + ") ? ("
                + chain
                + ").__getitem__("
                + kGet
                + ") : ("
                + dGet
                + "))"
              )
            else:
              callM = "(" + chain + ")" + sepM + methName + "(" + jM + ")"
          else:
            callM = "(" + chain + ")" + sepM + methName + "(" + jM + ")"
      chain = callM
      restC = methPart[rpM + 1 :].strip()
      continue
    if _isAttrOrIdent(methPart):
      atr: str = methPart
      if len(atr) > 0 and atr[0] == ".":
        atr = atr[1:]
      # JsonDocument cursor：尾属性 ``.name`` → ``__getattr__``
      if _isIdent(atr):
        if chain.find("__getattr__(PyStr(") >= 0 or chain.find("JsonDocument") >= 0 or chain.find("JsonDocCursor") >= 0:
          return "(" + chain + ").__getattr__(PyStr(\"" + atr + "\"))"
      if _isIdent(atr) and _isStdlibPropAttr(atr):
        if not _isRecordFieldName(st, atr):
          # ``.text``：Token/SourceFile 等为字段；勿一律 ``text__get``。
          if atr == "text":
            return "(" + chain + ")." + atr
          return "(" + chain + ")." + atr + "__get()"
      if _isIdent(atr) and _isUserPropName(st, atr):
        return "(" + chain + ")." + atr + "__get()"
      # ``Cell.x`` 字段；``Color``/``Vector`` 链上 ``.r``/``.x`` → ``__get``（chain 常无局部类型）
      if _isIdent(atr) and _isXyZwAttr(atr):
        if chain.find("Color") >= 0 or chain.find("Vector") >= 0 or chain.find("Quaternion") >= 0 or chain.find("PyRect") >= 0 or chain.find("PyRotator") >= 0:
          return "(" + chain + ")." + atr + "__get()"
        if chain.find("__get()") >= 0:
          return "(" + chain + ")." + atr + "__get()"
        return "(" + chain + ")." + atr
      return _rewritePropGets("(" + chain + ")" + restC, st)
    return ""
  # Trailing ``[i]`` after ``.method(...)`` — e.g. ``b"a=b".partition(b"=")[0]``.
  while len(restC) > 0 and restC[0] == "[":
    depthGi3: int = 0
    rbGi3: int = -1
    kGi3: int = 0
    while kGi3 < len(restC):
      chGi3: str = str(restC[kGi3])
      if chGi3 == "[":
        depthGi3 = depthGi3 + 1
      elif chGi3 == "]":
        depthGi3 = depthGi3 - 1
        if depthGi3 == 0:
          rbGi3 = kGi3
          break
      kGi3 = kGi3 + 1
    if rbGi3 < 0:
      return ""
    idxGi3: str = restC[1:rbGi3].strip()
    if ":" in idxGi3:
      gotGi3: str = _emitSliceGetitem(chain, idxGi3, st)
      if gotGi3 == "":
        return ""
      chain = gotGi3
    else:
      idxCppGi3: str = _emitIndexExpr(idxGi3, st)
      if idxCppGi3 == "":
        return ""
      subGi3: str = _emitSubscriptOn(chain, idxCppGi3, st)
      if subGi3 == "":
        return ""
      chain = subGi3
    restC = restC[rbGi3 + 1 :].strip()
  if restC == "":
    return chain
  return ""

def _slicePartCpp(part: str, st: EnumEmitState, fallback: str) -> str:
  p: str = part.strip()
  if p == "":
    return fallback
  t: str = _emitSimpleTerm(p, st)
  if t == "":
    p2: str = p.replace(" // ", " / ").replace("//", "/")
    t = _emitArithExpr(p2)
  if t == "":
    return ""
  return t

def _emitSliceArg(idx1: str, st: EnumEmitState) -> str:
  if ":" not in idx1:
    return ""
  parts: list[str] = idx1.split(":")
  while len(parts) < 3:
    parts.append("")
  # 空 start → SliceStartUnset（``[::-1]`` 须从末尾，勿写死 0）
  aCpp: str = _slicePartCpp(parts[0], st, "-2000000001")
  bCpp: str = _slicePartCpp(parts[1], st, "-2000000002")
  cCpp: str = _slicePartCpp(parts[2], st, "1")
  if aCpp == "":
    return ""
  if bCpp == "":
    return ""
  if cCpp == "":
    return ""
  return "PySlice<PyInt, PyInt>(" + aCpp + ", " + bCpp + ", " + cCpp + ")"

def _tupleArityFromCpp(ty: str) -> int:
  """``PyTuple<A, B, C>`` → 3。"""
  if ty.find("PyTuple<") < 0:
    return 0
  lb: int = ty.find("<")
  rb: int = ty.rfind(">")
  if lb < 0 or rb <= lb:
    return 0
  inner: str = ty[lb + 1 : rb]
  if inner.strip() == "":
    return 0
  parts: list[str] = _splitParams(inner)
  n: int = 0
  pi: int = 0
  while pi < len(parts):
    if parts[pi].strip() != "":
      n += 1
    pi += 1
  return n

def _emitSliceGetitem(baseCpp: str, idx1: str, st: EnumEmitState) -> str:
  # ``vw[0:2, 1:3]`` / ``grid[0:2, 1:3]``
  if "," in idx1:
    parts2d: list[str] = _splitParams(idx1)
    if len(parts2d) == 2:
      if ":" in parts2d[0] and ":" in parts2d[1]:
        slR: str = _emitSliceArg(parts2d[0].strip(), st)
        slC: str = _emitSliceArg(parts2d[1].strip(), st)
        if slR != "" and slC != "":
          ty2d: str = ""
          baseId2: str = baseCpp.strip()
          if len(baseId2) >= 2 and baseId2[0] == "(" and baseId2[len(baseId2) - 1] == ")":
            baseId2 = baseId2[1 : len(baseId2) - 1].strip()
          if _isIdent(baseId2):
            ty2d = _localCppTypeOf(st, baseId2)
          if ty2d.find("PyStackArray2D") >= 0:
            return baseCpp + "._getslice2d(" + slR + ", " + slC + ")"
          return (
            baseCpp
            + ".__getitem__(PyTuple<PySlice<PyInt, PyInt>, PySlice<PyInt, PyInt>>("
            + slR
            + ", "
            + slC
            + "))"
          )
  sl: str = _emitSliceArg(idx1, st)
  if sl == "":
    return ""
  tyB: str = ""
  baseId: str = baseCpp.strip()
  if len(baseId) >= 2 and baseId[0] == "(" and baseId[len(baseId) - 1] == ")":
    baseId = baseId[1 : len(baseId) - 1].strip()
  if _isIdent(baseId):
    tyB = _localCppTypeOf(st, baseId)
  # ``PyStackArray`` 切片 → ``_getslice``（无 ``__getitem__(PySlice)``）
  if _isStackArrayTy(tyB):
    return baseCpp + "._getslice(" + sl + ")"
  # ``PyTuple`` 定长切片 → ``template get_slice<lo, hi>()``
  if tyB.find("PyTuple<") >= 0:
    partsT: list[str] = idx1.split(":")
    while len(partsT) < 2:
      partsT.append("")
    loT: str = partsT[0].strip()
    hiT: str = partsT[1].strip()
    arityT: int = _tupleArityFromCpp(tyB)
    startT: str = "0"
    stopT: str = str(arityT)
    if loT != "":
      if _isIntLit(loT) or (len(loT) >= 2 and loT[0] == "-" and _isIntLit(loT[1:])):
        startT = loT
      else:
        return ""
    if hiT != "":
      if _isIntLit(hiT) or (len(hiT) >= 2 and hiT[0] == "-" and _isIntLit(hiT[1:])):
        stopT = hiT
      else:
        return ""
    return baseCpp + ".template get_slice<" + startT + ", " + stopT + ">()"
  return baseCpp + ".__getitem__(" + sl + ")"

def _findMulOp(s: str) -> int:
  i: int = 0
  n: int = len(s)
  depth: int = 0
  inStr: bool = False
  qCh: str = ""
  while i < n:
    ch: str = s[i]
    if inStr:
      if ch == "\\" and i + 1 < n:
        i += 2
        continue
      if ch == qCh:
        inStr = False
      i += 1
      continue
    if ch == "\"" or ch == "'":
      inStr = True
      qCh = ch
      i += 1
      continue
    if ch == "(" or ch == "[":
      depth += 1
    elif ch == ")" or ch == "]":
      if depth > 0:
        depth -= 1
    elif depth == 0 and ch == "*":
      if i > 0 and i + 1 < n:
        return i
    i += 1
  return -1

def _emitSeqMulExpr(t: str, st: EnumEmitState) -> str:
  s: str = t.strip()
  # 允许 ``2 * (1 + 1j)`` / ``q * Vector3[float64].right``（两侧走 simple）
  mp: int = _findMulOp(s)
  if mp < 0:
    return ""
  left: str = s[:mp].strip()
  right: str = s[mp + 1 :].strip()
  if left == "" or right == "":
    return ""
  if _isIntLit(left):
    if _isIdent(right) or _isAttrOrIdent(right):
      rwR: str = _rewriteTypeDotAttrSt(right, st)
      if rwR == "":
        rwR = _rewriteSelf(right)
      return "(" + rwR + " * " + left + ")"
    # ``3 * b"x"`` / ``2 * "ab"`` / ``2 * (1 + 1j)``
    rightLit: str = _emitSimpleTerm(right, st)
    if rightLit != "":
      return "(" + rightLit + " * " + left + ")"
  if _isIntLit(right):
    if _isIdent(left) or _isAttrOrIdent(left):
      rwL: str = _rewriteTypeDotAttrSt(left, st)
      if rwL == "":
        rwL = _rewriteSelf(left)
      return "(" + rwL + " * " + right + ")"
    # ``b"x" * 57`` / ``"ab" * 2``
    leftLit: str = _emitSimpleTerm(left, st)
    if leftLit != "":
      return "(" + leftLit + " * " + right + ")"
  # ``rot*Vector2.right`` / ``a * b``（两侧均可简单展开）
  leftE: str = _emitSimpleTerm(left, st)
  rightE: str = _emitSimpleTerm(right, st)
  if leftE != "" and rightE != "":
    return "(" + leftE + " * " + rightE + ")"
  # 一侧 simple 失败时仍改写 ``self.``（``this->w * self.h``）
  if leftE == "" and (_isIdent(left) or _isAttrOrIdent(left)):
    leftE = _rewriteSelf(left)
  if rightE == "" and (_isIdent(right) or _isAttrOrIdent(right)):
    rightE = _rewriteSelf(right)
  if leftE != "" and rightE != "":
    return "(" + leftE + " * " + rightE + ")"
  return ""

def _inferBraceCppType(rhs: str, st: EnumEmitState) -> str:
  """``{"a": 1}`` → ``PyDict<PyStr, PyInt>``；``{1, 2}`` → ``PySet<PyInt>``。"""
  if len(rhs) < 2:
    return ""
  if rhs[0] != "{" or rhs[len(rhs) - 1] != "}":
    return ""
  inner: str = rhs[1 : len(rhs) - 1].strip()
  if inner == "":
    return "PyDict<PyStr, PyInt>"
  elems: list[str] = _splitParams(inner)
  if len(elems) == 0:
    return "PyDict<PyStr, PyInt>"
  isDict: bool = False
  di: int = 0
  while di < len(elems):
    if elems[di].find(":") >= 0:
      isDict = True
      break
    di += 1
  if isDict:
    kTy: str = ""
    vTy: str = ""
    ei0: int = 0
    while ei0 < len(elems):
      raw0: str = elems[ei0].strip()
      col0: int = raw0.find(":")
      if col0 <= 0:
        return ""
      k0: str = raw0[:col0].strip()
      v0: str = raw0[col0 + 1 :].strip()
      kt0: str = ""
      if _isQuotedStrTerm(k0):
        kt0 = "PyStr"
      elif _isIntLit(k0):
        kt0 = "PyInt"
      elif _isFloatLit(k0):
        kt0 = "PyFloat"
      else:
        return ""
      vt0: str = ""
      if _isQuotedStrTerm(v0):
        vt0 = "PyStr"
      elif _isIntLit(v0):
        vt0 = "PyInt"
      elif _isFloatLit(v0):
        vt0 = "PyFloat"
      elif v0 == "True" or v0 == "False":
        vt0 = "PyBool"
      else:
        return ""
      if kTy == "":
        kTy = kt0
        vTy = vt0
      else:
        if kTy != kt0 or vTy != vt0:
          return ""
      ei0 += 1
    if kTy == "" or vTy == "":
      return ""
    return "PyDict<" + kTy + ", " + vTy + ">"
  eTy: str = ""
  ej: int = 0
  while ej < len(elems):
    rawE: str = elems[ej].strip()
    et0: str = ""
    if _isQuotedStrTerm(rawE):
      et0 = "PyStr"
    elif _isIntLit(rawE):
      et0 = "PyInt"
    elif _isFloatLit(rawE):
      et0 = "PyFloat"
    else:
      return ""
    if eTy == "":
      eTy = et0
    else:
      if eTy != et0:
        return ""
    ej += 1
  if eTy == "":
    return ""
  return "PySet<" + eTy + ">"

def _emitBraceLiteralInit(ty: str, name: str, rhs: str, st: EnumEmitState) -> str:
  if len(rhs) < 2:
    return ""
  if rhs[0] != "{" or rhs[len(rhs) - 1] != "}":
    return ""
  inner: str = rhs[1 : len(rhs) - 1].strip()
  if inner == "":
    return "  " + ty + " " + name + "{};\n"
  elems: list[str] = _splitParams(inner)
  isDict: bool = False
  di: int = 0
  while di < len(elems):
    if elems[di].find(":") >= 0:
      isDict = True
    di += 1
  # FrozenSet / FrozenDict 不可变：先填临时再 ``initFrom*``
  isFrozen: bool = False
  isFrozenDict: bool = False
  if ty.find("FrozenSet") >= 0:
    isFrozen = True
  if ty.find("FrozenDict") >= 0:
    isFrozenDict = True
  fillName: str = name
  outB: str = "  " + ty + " " + name + "{};\n"
  if isFrozen and isDict == False:
    setTyF: str = ty.replace("PyFrozenSet", "PySet")
    fillName = name + "__s"
    outB = outB + "  " + setTyF + " " + fillName + "{};\n"
  if isFrozenDict and isDict:
    dictTyF: str = ty.replace("PyFrozenDict", "PyDict")
    fillName = name + "__d"
    outB = outB + "  " + dictTyF + " " + fillName + "{};\n"
  ei: int = 0
  while ei < len(elems):
    raw: str = elems[ei].strip()
    if isDict:
      colonD: int = raw.find(":")
      if colonD <= 0:
        return ""
      kRaw: str = raw[:colonD].strip()
      vRaw: str = raw[colonD + 1 :].strip()
      kT: str = _emitSimpleTerm(kRaw, st)
      vT: str = _emitSimpleTerm(vRaw, st)
      if kT == "" or vT == "":
        return ""
      outB = outB + "  (void)(" + fillName + ".__setitem__(" + kT + ", " + vT + "));\n"
    else:
      eT: str = _emitSimpleTerm(raw, st)
      if eT == "":
        return ""
      outB = outB + "  (void)(" + fillName + ".add(" + eT + "));\n"
    ei += 1
  if isFrozen and isDict == False:
    outB = outB + "  " + name + ".initFromSet(" + fillName + ");\n"
  if isFrozenDict and isDict:
    outB = outB + "  " + name + ".initFromDict(" + fillName + ");\n"
  return outB

def _emitBraceArgParts(rhs: str, st: EnumEmitState) -> list[str]:
  """``foo(a, {k: v})`` → ``[prelude, callExpr]``；失败空 list。"""
  src: str = rhs.strip()
  outEmpty: list[str] = []
  if "{" not in src:
    return outEmpty
  if "(" not in src or src[len(src) - 1] != ")":
    return outEmpty
  lp: int = src.find("(")
  if lp <= 0:
    return outEmpty
  callee: str = src[:lp].strip()
  argsInner: str = src[lp + 1 : len(src) - 1]
  parts: list[str] = _splitParams(argsInner)
  if len(parts) == 0:
    return outEmpty
  hasBrace: bool = False
  pi0: int = 0
  while pi0 < len(parts):
    a0: str = parts[pi0].strip()
    if len(a0) >= 2 and a0[0] == "{" and a0[len(a0) - 1] == "}":
      hasBrace = True
      break
    pi0 += 1
  if not hasBrace:
    return outEmpty
  prelude: str = ""
  joined: str = ""
  nPos: int = 0
  ti: int = 0
  pi: int = 0
  while pi < len(parts):
    a: str = parts[pi].strip()
    if _isDiscardCallKw(a):
      pi += 1
      continue
    ax: str = ""
    if len(a) >= 2 and a[0] == "{" and a[len(a) - 1] == "}":
      tmp: str = "__bl" + str(ti)
      ti += 1
      tyB: str = _inferBraceCppType(a, st)
      if tyB == "":
        return outEmpty
      initB: str = _emitBraceLiteralInit(tyB, tmp, a, st)
      if initB == "":
        return outEmpty
      prelude = prelude + initB
      ax = tmp
    else:
      ax = _emitCallArg(a, st)
      if ax == "":
        return outEmpty
      if ax == "__discard_kw__":
        pi += 1
        continue
    if nPos == 0:
      joined = ax
    else:
      joined = joined + ", " + ax
    nPos += 1
    pi += 1
  if nPos == 0:
    return outEmpty
  # 实参已是 C++：勿再走 ``_emitSimpleTerm``（会把 ``PyStr("x")`` 误包成 ``PyPyStr``）
  calCpp: str = callee
  if not _isIdent(callee):
    calCpp = _rewriteSelf(callee)
  if calCpp == "":
    return outEmpty
  callCpp: str = calCpp + "(" + joined + ")"
  outP: list[str] = []
  outP.append(prelude)
  outP.append(callCpp)
  return outP

def _emitBraceArgCallStmt(s: str, st: EnumEmitState) -> str:
  """``d.update({"x": 2})`` → 物化临时 dict/set 再调用。"""
  partsB: list[str] = _emitBraceArgParts(s, st)
  if len(partsB) < 2:
    return ""
  return partsB[0] + "  (void)(" + partsB[1] + ");\n"

def _emitBraceArgCallAssign(emN: str, ty: str, wasKnown: bool, rhs: str, st: EnumEmitState) -> str:
  """``merged: str = mergeQuery("x=1", {"y": "2"})``。"""
  partsB: list[str] = _emitBraceArgParts(rhs, st)
  if len(partsB) < 2:
    return ""
  if wasKnown:
    return partsB[0] + "  " + emN + " = " + partsB[1] + ";\n"
  return partsB[0] + "  " + ty + " " + emN + " = " + partsB[1] + ";\n"

def _compSplitForClauses(clauses: str) -> list[str]:
  parts: list[str] = []
  cur: str = ""
  depth: int = 0
  i: int = 0
  n: int = len(clauses)
  while i < n:
    ch: str = clauses[i]
    if ch == "(" or ch == "[":
      depth += 1
      cur = cur + ch
    elif ch == ")" or ch == "]":
      if depth > 0:
        depth -= 1
      cur = cur + ch
    elif depth == 0 and i + 5 <= n and clauses[i : i + 5] == " for ":
      parts.append(cur.strip())
      cur = ""
      i += 5
      continue
    else:
      cur = cur + ch
    i += 1
  if cur.strip() != "":
    parts.append(cur.strip())
  return parts

def _rangeStepIsNeg(stepSrc: str, stepCpp: str) -> bool:
  """``-1`` / ``(-(1))`` 等负步长 → 用 ``>`` 比较。"""
  s: str = stepSrc.strip()
  if len(s) > 0 and s[0] == "-":
    return True
  if len(stepCpp) > 0 and stepCpp[0] == "-":
    return True
  if len(stepCpp) >= 2 and stepCpp[:2] == "(-":
    return True
  return False

def _rewriteBreaksWithFlag(bodyCpp: str, flag: str) -> str:
  """``break;`` → ``flag = true; break;``（for/while-else）。"""
  linesB: list[str] = bodyCpp.split("\n")
  outB: str = ""
  biB: int = 0
  while biB < len(linesB):
    lnB: str = linesB[biB]
    if "break;" in lnB and lnB.find("done__get()") < 0:
      lnB = lnB.replace("break;", flag + " = true; break;")
    outB = outB + lnB
    if biB + 1 < len(linesB):
      outB = outB + "\n"
    biB += 1
  return outB

def _emitCompRangeLoop(var: str, rangeArg: str, st: EnumEmitState, tag: str) -> str:
  startCpp: str = "0"
  limCpp: str = ""
  stepCpp: str = "1"
  stepSrc: str = "1"
  rParts: list[str] = _splitParams(rangeArg)
  if len(rParts) >= 3:
    startT3: str = _emitSimpleTerm(rParts[0].strip(), st)
    stopT3: str = _emitSimpleTerm(rParts[1].strip(), st)
    stepSrc = rParts[2].strip()
    stepT3: str = _emitSimpleTerm(stepSrc, st)
    if startT3 == "" or stopT3 == "" or stepT3 == "":
      return ""
    startCpp = startT3
    limCpp = stopT3
    stepCpp = stepT3
  elif len(rParts) == 2:
    startT: str = _emitSimpleTerm(rParts[0].strip(), st)
    stopT: str = _emitSimpleTerm(rParts[1].strip(), st)
    if startT == "" or stopT == "":
      return ""
    startCpp = startT
    limCpp = stopT
  else:
    limCpp = _emitSimpleTerm(rangeArg, st)
  if limCpp == "" or not _isIdent(var):
    return ""
  cmpOp: str = " < "
  stepStmt: str = tag + " += " + stepCpp
  if _rangeStepIsNeg(stepSrc, stepCpp):
    cmpOp = " > "
  outR: str = "  for (PyInt " + var + " = " + startCpp + "; "
  outR = outR + var + cmpOp + limCpp + "; " + stepStmt + ") {\n"
  return outR

def _emitRangeCall(inner: str, st: EnumEmitState) -> str:
  """``range(n)`` / ``range(a, b, step)`` → ``PyRange(...)``。"""
  parts: list[str] = _splitParams(inner)
  nP: int = len(parts)
  if nP == 0:
    return ""
  if nP == 1:
    a0: str = _emitSimpleTerm(parts[0].strip(), st)
    if a0 == "":
      return ""
    return "PyRange(" + a0 + ")"
  if nP == 2:
    b0: str = _emitSimpleTerm(parts[0].strip(), st)
    b1: str = _emitSimpleTerm(parts[1].strip(), st)
    if b0 == "" or b1 == "":
      return ""
    return "PyRange(" + b0 + ", " + b1 + ")"
  a2: str = _emitSimpleTerm(parts[0].strip(), st)
  a3: str = _emitSimpleTerm(parts[1].strip(), st)
  a4: str = _emitSimpleTerm(parts[2].strip(), st)
  if a2 == "" or a3 == "" or a4 == "":
    return ""
  return "PyRange(" + a2 + ", " + a3 + ", " + a4 + ")"

def _emitCompForOpen(clause: str, st: EnumEmitState, depth: int) -> str:
  inPos: int = clause.find(" in ")
  if inPos <= 0:
    return ""
  var: str = clause[:inPos].strip()
  iterS: str = clause[inPos + 4 :].strip()
  tag: str = var
  commaV: int = var.find(",")
  if commaV > 0:
    v0: str = var[:commaV].strip()
    v1: str = var[commaV + 1 :].strip()
    if _isIdent(v0) and _isIdent(v1):
      if len(iterS) >= 10 and iterS[:10] == "enumerate(" and iterS[len(iterS) - 1] == ")":
        enInner: str = iterS[10 : len(iterS) - 1].strip()
        enParts: list[str] = _splitParams(enInner)
        if len(enParts) >= 1:
          seqEn: str = enParts[0].strip()
          startEn: str = "0"
          if len(enParts) >= 2:
            stEn: str = _emitSimpleTerm(enParts[1].strip(), st)
            if stEn != "":
              startEn = stEn
          if _isIdent(seqEn) or _isAttrOrIdent(seqEn):
            seqCpp: str = _rewriteSelf(seqEn)
            outE: str = "  for (PyInt __ci" + str(depth) + " = 0; __ci" + str(depth) + " < ("
            outE = outE + seqCpp + ").__len__(); __ci" + str(depth) + " += 1) {\n"
            outE = outE + "  PyInt " + v0 + " = " + startEn + " + __ci" + str(depth) + ";\n"
            outE = outE + "  auto " + v1 + " = (" + seqCpp + ").__getitem__(__ci" + str(depth) + ");\n"
            return outE
    return ""
  if not _isIdent(var):
    return ""
  if len(iterS) >= 6 and iterS[:6] == "range(" and iterS[len(iterS) - 1] == ")":
    innerR: str = iterS[6 : len(iterS) - 1].strip()
    return _emitCompRangeLoop(var, innerR, st, tag)
  if _isIdent(iterS) or _isAttrOrIdent(iterS):
    iterCpp: str = _rewriteSelf(iterS)
    outI: str = "  for (PyInt __ci" + str(depth) + " = 0; __ci" + str(depth) + " < ("
    outI = outI + iterCpp + ").__len__(); __ci" + str(depth) + " += 1) {\n"
    outI = outI + "  auto " + var + " = (" + iterCpp + ").__getitem__(__ci" + str(depth) + ");\n"
    return outI
  return ""

def _isFrozenListTy(ty: str) -> bool:
  return len(ty) >= 12 and ty[:12] == "PyFrozenList"

def _isStackArray2dTy(ty: str) -> bool:
  return ty.find("PyStackArray2D") >= 0

def _isStackArrayTy(ty: str) -> bool:
  if _isStackArray2dTy(ty):
    return False
  return ty.find("PyStackArray") >= 0

def _isCharHeapArrayTy(ty: str) -> bool:
  return ty.find("PyArray<PyChar") >= 0

def _isCharStackArrayTy(ty: str) -> bool:
  return _isStackArrayTy(ty) and ty.find("PyChar") >= 0

def _emitCharArrayFromStrLit(name: str, ty: str, quoted: str, wasKnown: bool, st: EnumEmitState) -> str:
  """``buf: char[:] = \"Hi\"`` / ``fixed: char[:3] = \"abc\"`` → ``toArray`` / 拷入栈数组。"""
  litCpp: str = ""
  if len(quoted) >= 3 and (quoted[:3] == "\"\"\"" or quoted[:3] == "'''"):
    litCpp = _emitTripleQuotedExpr(quoted, st)
  elif _isQuotedStrTerm(quoted):
    litCpp = _emitStrLitRaw(quoted)
  if litCpp == "":
    return ""
  em: str = _escapeCppIdent(name)
  if _isCharHeapArrayTy(ty):
    rhsH: str = "(" + litCpp + ").toArray()"
    if wasKnown:
      return "  " + em + " = " + rhsH + ";\n"
    return "  " + ty + " " + em + " = " + rhsH + ";\n"
  if _isCharStackArrayTy(ty):
    offC: int = 0
    lenC: str = "0"
    lbC: int = ty.find("<")
    rbC: int = ty.rfind(">")
    if lbC > 0 and rbC > lbC:
      partsC: list[str] = _splitParams(ty[lbC + 1 : rbC])
      if len(partsC) >= 2:
        lenC = partsC[1].strip()
      if len(partsC) >= 3:
        offS: str = partsC[2].strip()
        if _isIntLit(offS):
          offC = int(offS)
    tmpC: str = "__ca_" + em
    outC: str = ""
    if wasKnown:
      outC = "  " + em + " = " + ty + "{};\n"
    else:
      outC = "  " + ty + " " + em + "{};\n"
    outC = outC + "  PyArray<PyChar, 0> " + tmpC + " = (" + litCpp + ").toArray();\n"
    outC = (
      outC
      + "  for (PyInt __ci = 0; __ci < "
      + lenC
      + "; __ci += 1) {\n"
      + "  (void)("
      + em
      + ".__setitem__(("
      + str(offC)
      + ") + (__ci), ("
      + tmpC
      + ").__getitem__(__ci)));\n"
      + "  }\n"
    )
    return outC
  return ""

def _frozenElemTy(ty: str) -> str:
  lb: int = ty.find("<")
  rb: int = ty.rfind(">")
  if lb > 0 and rb > lb:
    return ty[lb + 1 : rb].strip()
  return "PyInt"

def _emitStackArrayListInit(name: str, ty: str, elems: list[str], st: EnumEmitState) -> str:
  """``buf: int[:4] = [10,20,…]`` / ``grid: int[:2,:3] = [[…],…]`` → ``__setitem__``。"""
  em: str = _escapeCppIdent(name)
  outS: str = "  " + ty + " " + em + "{};\n"
  if _isStackArray2dTy(ty):
    riS: int = 0
    while riS < len(elems):
      rowRaw: str = elems[riS].strip()
      if len(rowRaw) < 2 or rowRaw[0] != "[" or rowRaw[len(rowRaw) - 1] != "]":
        return ""
      cells: list[str] = _splitParams(rowRaw[1 : len(rowRaw) - 1])
      ciS: int = 0
      while ciS < len(cells):
        cRaw: str = cells[ciS].strip()
        cCpp: str = _emitSimpleTerm(cRaw, st)
        if cCpp == "":
          return ""
        outS = (
          outS
          + "  (void)("
          + em
          + ".__setitem__(PyTuple<PyInt, PyInt>("
          + str(riS)
          + ", "
          + str(ciS)
          + "), "
          + cCpp
          + "));\n"
        )
        ciS += 1
      riS += 1
    return outS
  # ``int[1:3]`` → ``PyStackArray<T,2,1>``：按下标 = offset+i 写入
  offSA: int = 0
  lbSA: int = ty.find("<")
  rbSA: int = ty.rfind(">")
  if lbSA > 0 and rbSA > lbSA:
    partsSA: list[str] = _splitParams(ty[lbSA + 1 : rbSA])
    if len(partsSA) >= 3:
      offRawSA: str = partsSA[2].strip()
      if _isIntLit(offRawSA):
        offSA = int(offRawSA)
  eiS: int = 0
  while eiS < len(elems):
    eRaw: str = elems[eiS].strip()
    eCpp: str = _emitSimpleTerm(eRaw, st)
    if eCpp == "":
      return ""
    outS = (
      outS
      + "  (void)("
      + em
      + ".__setitem__("
      + str(offSA + eiS)
      + ", "
      + eCpp
      + "));\n"
    )
    eiS += 1
  return outS

def _emitListComprehensionAssign(name: str, ty: str, rhs: str, st: EnumEmitState) -> str:
  s: str = rhs.strip()
  if len(s) < 4 or s[0] != "[" or s[len(s) - 1] != "]":
    return ""
  inner: str = s[1 : len(s) - 1].strip()
  fpos: int = inner.find(" for ")
  if fpos < 0:
    return ""
  elem: str = inner[:fpos].strip()
  rest: str = inner[fpos + 5 :].strip()
  cond: str = ""
  ifPos: int = rest.rfind(" if ")
  if ifPos > 0:
    cond = rest[ifPos + 4 :].strip()
    rest = rest[:ifPos].strip()
  clauses: list[str] = _compSplitForClauses(rest)
  if len(clauses) == 0:
    clauses.append(rest)
  elemCpp: str = _emitSimpleTerm(elem, st)
  if elemCpp == "":
    arE: str = _emitArithExpr(elem.replace(" // ", " / ").replace("//", "/"))
    if arE != "":
      elemCpp = arE
  if elemCpp == "":
    return ""
  recvC: str = name
  outC: str = ""
  # Fixed temp name (avoid ``tmpN = \"__flb_\" + name`` soft-skip in thin self-host).
  tmpN: str = "__flb"
  if _isFrozenListTy(ty):
    eTy: str = _frozenElemTy(ty)
    outC = "  PyList<" + eTy + ", 0> " + tmpN + "{};\n"
    outC = outC + "  " + ty + " " + name + "{};\n"
    recvC = tmpN
  else:
    outC = "  " + ty + " " + name + "{};\n"
  ci: int = 0
  while ci < len(clauses):
    op: str = _emitCompForOpen(clauses[ci], st, ci)
    if op == "":
      return ""
    outC = outC + op
    ci += 1
  if cond != "":
    beC: str = _emitBoolCond(cond, st)
    if beC == "":
      return ""
    outC = outC + "  if (" + beC + ") {\n"
    outC = outC + "  (void)(" + recvC + ".append(" + elemCpp + "));\n"
    outC = outC + "  }\n"
  else:
    outC = outC + "  (void)(" + recvC + ".append(" + elemCpp + "));\n"
  ci2: int = len(clauses) - 1
  while ci2 >= 0:
    outC = outC + "  }\n"
    ci2 -= 1
  if _isFrozenListTy(ty):
    outC = outC + "  (void)(" + name + ".initFromList(" + tmpN + "));\n"
  return outC

def _emitDictComprehensionAssign(name: str, ty: str, rhs: str, st: EnumEmitState) -> str:
  """``m: dict[int,int] = {k: k * 10 for k in keys if k != 2}`` / frozendict 同形。"""
  s: str = rhs.strip()
  if len(s) < 4 or s[0] != "{" or s[len(s) - 1] != "}":
    return ""
  if s.find(" for ") < 0:
    return ""
  inner: str = s[1 : len(s) - 1].strip()
  fpos: int = inner.find(" for ")
  if fpos < 0:
    return ""
  head: str = inner[:fpos].strip()
  colonH: int = head.find(":")
  if colonH <= 0:
    return ""
  keyE: str = head[:colonH].strip()
  valE: str = head[colonH + 1 :].strip()
  rest: str = inner[fpos + 5 :].strip()
  cond: str = ""
  ifPos: int = rest.rfind(" if ")
  if ifPos > 0:
    cond = rest[ifPos + 4 :].strip()
    rest = rest[:ifPos].strip()
  keyCpp: str = _emitSimpleTerm(keyE, st)
  valCpp: str = _emitSimpleTerm(valE, st)
  if keyCpp == "":
    keyCpp = _emitArithExpr(keyE.replace(" // ", " / ").replace("//", "/"))
  if valCpp == "":
    valCpp = _emitArithExpr(valE.replace(" // ", " / ").replace("//", "/"))
  if keyCpp == "" or valCpp == "":
    return ""
  isFrozenD: bool = False
  if ty.find("FrozenDict") >= 0:
    isFrozenD = True
  recvD: str = name
  outD: str = "  " + ty + " " + name + "{};\n"
  tmpD: str = "__fdb"
  if isFrozenD:
    dTy: str = ty.replace("PyFrozenDict", "PyDict")
    outD = outD + "  " + dTy + " " + tmpD + "{};\n"
    recvD = tmpD
  clausesD: list[str] = _compSplitForClauses(rest)
  if len(clausesD) == 0:
    clausesD.append(rest)
  ciD: int = 0
  while ciD < len(clausesD):
    opD: str = _emitCompForOpen(clausesD[ciD], st, ciD)
    if opD == "":
      return ""
    outD = outD + opD
    ciD += 1
  bodySet: str = "  (void)(" + recvD + ".__setitem__(" + keyCpp + ", " + valCpp + "));\n"
  if cond != "":
    beD: str = _emitBoolCond(cond, st)
    if beD == "":
      return ""
    outD = outD + "  if (" + beD + ") {\n" + bodySet + "  }\n"
  else:
    outD = outD + bodySet
  ciD2: int = len(clausesD) - 1
  while ciD2 >= 0:
    outD = outD + "  }\n"
    ciD2 -= 1
  if isFrozenD:
    outD = outD + "  " + name + ".initFromDict(" + tmpD + ");\n"
  return outD

def _emitDictUnpackAssign(name: str, ty: str, rhs: str, st: EnumEmitState) -> str:
  """``merged: dict[int,int] = {**base, 3: 30}``。"""
  s: str = rhs.strip()
  if len(s) < 5 or s[0] != "{" or s[len(s) - 1] != "}":
    return ""
  if s.find("**") < 0:
    return ""
  inner: str = s[1 : len(s) - 1].strip()
  parts: list[str] = _splitParams(inner)
  if len(parts) == 0:
    return ""
  outU: str = "  " + ty + " " + name + "{};\n"
  piU: int = 0
  while piU < len(parts):
    pU: str = parts[piU].strip()
    if len(pU) >= 2 and pU[:2] == "**":
      srcU: str = pU[2:].strip()
      srcCppU: str = _emitSimpleTerm(srcU, st)
      if srcCppU == "":
        return ""
      outU = outU + "  (void)(" + name + ".update(" + srcCppU + "));\n"
    else:
      colonU: int = pU.find(":")
      if colonU <= 0:
        return ""
      kU: str = _emitSimpleTerm(pU[:colonU].strip(), st)
      vU: str = _emitSimpleTerm(pU[colonU + 1 :].strip(), st)
      if kU == "" or vU == "":
        return ""
      outU = outU + "  (void)(" + name + ".__setitem__(" + kU + ", " + vU + "));\n"
    piU += 1
  return outU

def _emitSetComprehensionAssign(name: str, ty: str, rhs: str, st: EnumEmitState) -> str:
  """``s: set[int] = {x * 2 for x in src}`` / frozenset 同形。"""
  s: str = rhs.strip()
  if len(s) < 4 or s[0] != "{" or s[len(s) - 1] != "}":
    return ""
  if s.find(":") >= 0 and s.find(" for ") < 0:
    return ""
  # dictcomp ``{k: v for …}`` → ``_emitDictComprehensionAssign``
  if s.find(":") >= 0 and s.find(" for ") >= 0:
    headD: str = s[1 : s.find(" for ")].strip()
    if headD.find(":") >= 0:
      return ""
  inner: str = s[1 : len(s) - 1].strip()
  fpos: int = inner.find(" for ")
  if fpos < 0:
    return ""
  elem: str = inner[:fpos].strip()
  rest: str = inner[fpos + 5 :].strip()
  cond: str = ""
  ifPos: int = rest.rfind(" if ")
  if ifPos > 0:
    cond = rest[ifPos + 4 :].strip()
    rest = rest[:ifPos].strip()
  clauses: list[str] = _compSplitForClauses(rest)
  if len(clauses) == 0:
    clauses.append(rest)
  elemCpp: str = _emitSimpleTerm(elem, st)
  if elemCpp == "":
    arE: str = _emitArithExpr(elem.replace(" // ", " / ").replace("//", "/"))
    if arE != "":
      elemCpp = arE
  if elemCpp == "":
    return ""
  isFrozen: bool = False
  if ty.find("FrozenSet") >= 0:
    isFrozen = True
  recvC: str = name
  outC: str = "  " + ty + " " + name + "{};\n"
  tmpN: str = "__fsb"
  if isFrozen:
    setTy: str = ty.replace("PyFrozenSet", "PySet")
    outC = outC + "  " + setTy + " " + tmpN + "{};\n"
    recvC = tmpN
  ci: int = 0
  while ci < len(clauses):
    op: str = _emitCompForOpen(clauses[ci], st, ci)
    if op == "":
      return ""
    outC = outC + op
    ci += 1
  if cond != "":
    beC: str = _emitBoolCond(cond, st)
    if beC == "":
      return ""
    outC = outC + "  if (" + beC + ") {\n"
    outC = outC + "  (void)(" + recvC + ".add(" + elemCpp + "));\n"
    outC = outC + "  }\n"
  else:
    outC = outC + "  (void)(" + recvC + ".add(" + elemCpp + "));\n"
  ci2: int = len(clauses) - 1
  while ci2 >= 0:
    outC = outC + "  }\n"
    ci2 -= 1
  if isFrozen:
    outC = outC + "  " + name + ".initFromSet(" + tmpN + ");\n"
  return outC

def _wrapAssertBoolArg(expr: str, st: EnumEmitState) -> str:
  """``assertTrue/False`` 实参 → PyBool（比较 / 容器 truthiness / 显式 bool）。"""
  e: str = expr.strip()
  if e == "true" or e == "false":
    return e
  if (
    "==" in e
    or "!=" in e
    or ">=" in e
    or "<=" in e
    or "&&" in e
    or "||" in e
    or (len(e) >= 4 and e[:4] == "not ")
  ):
    return "static_cast<PyBool>(" + e + ")"
  if len(e) > 0 and e[0] == "!" and e != "!":
    return "static_cast<PyBool>(" + e + ")"
  if (
    "__moved__" in e
    or "__contains__" in e
    or ".startsWith(" in e
    or ".endsWith(" in e
  ):
    return "static_cast<PyBool>(" + e + ")"
  if len(e) >= 7 and e[len(e) - 7 :] == "__get()":
    return "static_cast<PyBool>(" + e + ")"
  gt: int = e.find(">")
  lt: int = e.find("<")
  if gt > 0 or lt > 0:
    if ">" in e or "<" in e:
      return "static_cast<PyBool>(" + e + ")"
  if (
    ".isAbsolute(" in e
    or ".isRelative(" in e
    or ".isRelativeTo(" in e
    or ".isFile(" in e
    or ".isDir(" in e
    or ".exists(" in e
    or ".isSymlink(" in e
    or ".match(" in e
    or ".fullMatch(" in e
    or "Match(" in e
  ):
    return "static_cast<PyBool>(" + e + ")"
  if _isIdent(e):
    tyE: str = _localCppTypeOf(st, e)
    if tyE.find("PyTextIO") >= 0 or tyE.find("PyStringIO") >= 0:
      return "static_cast<PyBool>(" + e + ")"
    if tyE == "bool":
      return "static_cast<PyBool>(" + e + ")"
    if tyE.find("PyPath") >= 0 or tyE.find("PyLong") >= 0:
      return "static_cast<PyBool>((" + e + ").__bool__())"
    if tyE.find("complex") >= 0 or tyE.find("Complex") >= 0:
      return "static_cast<PyBool>((" + e + ").__bool__())"
    # Delegate / Callable：``operator bool``，勿 ``__len__``
    if tyE.find("Delegate") >= 0:
      return "static_cast<PyBool>(static_cast<bool>(" + e + "))"
    if tyE.find("PyCallable") >= 0:
      return "static_cast<PyBool>(static_cast<bool>(" + e + "))"
    # 已知容器 truthiness；普通用户对象实例默认真
    if (
      tyE.find("PyList") >= 0
      or tyE.find("PyDict") >= 0
      or tyE.find("PySet") >= 0
      or tyE.find("PyStr") >= 0
      or tyE.find("PyArray") >= 0
      or tyE.find("PyBytes") >= 0
      or tyE.find("PyByteArray") >= 0
      or tyE.find("PyFrozen") >= 0
      or tyE.find("PyDeque") >= 0
      or tyE.find("PyOptional") >= 0
      or tyE.find("PyTuple") >= 0
      or tyE.find("PyQueue") >= 0
    ):
      return "static_cast<PyBool>(((" + e + ").__len__() > 0))"
    # 标准库/算法类型有 ``operator PyBool``；测例辅助类常无转换 → 默认真，
    # 但带 ``__len__`` 语义的序列名仍走长度真值。
    if len(tyE) >= 2 and tyE[:2] == "Py":
      if (
        tyE.find("DSU") >= 0
        or tyE.find("Heap") >= 0
        or tyE.find("Trie") >= 0
        or tyE.find("Graph") >= 0
        or tyE.find("FenTree") >= 0
        or tyE.find("SegTree") >= 0
        or tyE.find("SparseTable") >= 0
        or tyE.find("ChunkDeque") >= 0
        or         tyE.find("ACAuto") >= 0
        or tyE.find("AcAuto") >= 0
        or tyE.find("AhoCorasick") >= 0
        or tyE.find("Navigate") >= 0
        or tyE.find("Automaton") >= 0
      ):
        return "static_cast<PyBool>(" + e + ")"
      if (
        tyE.find("Seq") >= 0
        or tyE.find("Ints") >= 0
        or tyE.find("Chars") >= 0
        or tyE.find("Buffer") >= 0
      ):
        return "static_cast<PyBool>(((" + e + ").__len__() > 0))"
      return "static_cast<PyBool>(true)"
    return "static_cast<PyBool>(((" + e + ").__len__() > 0))"
  # 调用 / 宏 / 已是 bool 形：``inBounds()`` / ``PY2CPP_ISINF`` / ``static_cast`` 链
  if len(e) > 0 and e[len(e) - 1] == ")":
    return "static_cast<PyBool>(" + e + ")"
  if e.find("PY2CPP_") >= 0:
    return "static_cast<PyBool>(" + e + ")"
  return "static_cast<PyBool>(" + e + ")"

def _userClassMemberCsv(st: EnumEmitState, clsName: str) -> str:
  i: int = 0
  while i < len(st.classMethTyNames):
    if st.classMethTyNames[i] == clsName:
      if i < len(st.classMethNameCsv):
        return st.classMethNameCsv[i]
      return ""
    i += 1
  return ""

def _cppTyUserClassName(ty: str) -> str:
  """``PyCountingProxy<PyWidget>`` → ``CountingProxy``；``PyProxy<…>`` → ``Proxy``。"""
  s: str = ty.strip()
  if len(s) >= 2 and s[:2] == "Py":
    s = s[2:]
  lb: int = s.find("<")
  if lb > 0:
    s = s[:lb]
  return s

def _typeLooksProxyStorage(ty: str) -> bool:
  t: str = ty.strip()
  if t.find("PyProxy<") >= 0:
    return True
  if len(t) >= 7 and t[:7] == "PyProxy":
    return True
  return False

def _isProxyHostTy(recvTy: str, st: EnumEmitState) -> bool:
  if _typeLooksProxyStorage(recvTy):
    return True
  unc: str = _cppTyUserClassName(recvTy)
  if unc == "":
    return False
  i: int = 0
  while i < len(st.proxyHostNames):
    if st.proxyHostNames[i] == unc:
      return True
    i += 1
  return False

def _shouldProxyPeelMember(recvTy: str, member: str, st: EnumEmitState) -> bool:
  """``Proxy[T]`` 或子类上未声明的成员 → 剥到 ``_target``。"""
  if member == "" or member == "_target":
    return False
  if not _isProxyHostTy(recvTy, st):
    return False
  unc2: str = _cppTyUserClassName(recvTy)
  if unc2 == "Proxy":
    return True
  csv2: str = _userClassMemberCsv(st, unc2)
  if csv2 == "":
    return True
  partsM: list[str] = csv2.split(",")
  pi: int = 0
  while pi < len(partsM):
    if partsM[pi].strip() == member:
      return False
    pi += 1
  return True

def _emitSuperExpr(term: str, st: EnumEmitState) -> str:
  """``super.m(…)`` / ``super().m(…)`` / ``super()`` → 基类或 ``_target``。"""
  t: str = term.strip()
  baseCpp: str = st.superBaseCpp
  if baseCpp == "":
    return ""
  # 以基类名判断（勿只靠 bool 字段；薄路径上 bool 可能未写回）
  isProxySuper: bool = False
  if st.superIsProxy:
    isProxySuper = True
  if baseCpp.find("PyProxy") >= 0:
    isProxySuper = True
  # ``super()`` → 基类 ``__call__()``
  if t == "super()":
    if isProxySuper:
      return "this->_target.__call__()"
    return baseCpp + "::__call__()"
  # ``super().meth(…)``
  if len(t) >= 8 and t[:8] == "super().":
    restS: str = t[8:].strip()
    lpS: int = restS.find("(")
    if lpS <= 0 or restS[len(restS) - 1] != ")":
      return ""
    methS: str = restS[:lpS].strip()
    argsS: str = restS[lpS + 1 : len(restS) - 1].strip()
    if not _isIdent(methS):
      return ""
    if methS == "__call__":
      return _emitSuperExpr("super()", st)
    jArgs: str = ""
    if argsS != "":
      apS: list[str] = _splitParams(argsS)
      aiS: int = 0
      okS: bool = True
      while aiS < len(apS):
        aE: str = _emitCallArg(apS[aiS], st)
        if aE == "" or aE == "__discard_kw__":
          okS = False
          break
        if jArgs == "":
          jArgs = aE
        else:
          jArgs = jArgs + ", " + aE
        aiS += 1
      if not okS:
        return ""
    if isProxySuper:
      if jArgs == "":
        return "this->_target." + methS + "()"
      return "this->_target." + methS + "(" + jArgs + ")"
    if jArgs == "":
      return baseCpp + "::" + methS + "()"
    return baseCpp + "::" + methS + "(" + jArgs + ")"
  # ``super.meth(…)`` / ``super.attr``
  if len(t) >= 6 and t[:6] == "super.":
    rest2: str = t[6:].strip()
    lp2: int = rest2.find("(")
    if lp2 < 0:
      if _isIdent(rest2):
        if st.superIsProxy:
          return "this->_target." + rest2
        return "static_cast<" + baseCpp + "&>(*this)." + rest2
      return ""
    if rest2[len(rest2) - 1] != ")":
      return ""
    meth2: str = rest2[:lp2].strip()
    args2: str = rest2[lp2 + 1 : len(rest2) - 1].strip()
    if not _isIdent(meth2):
      return ""
    j2: str = ""
    if args2 != "":
      ap2: list[str] = _splitParams(args2)
      ai2: int = 0
      ok2: bool = True
      while ai2 < len(ap2):
        a2e: str = _emitCallArg(ap2[ai2], st)
        if a2e == "" or a2e == "__discard_kw__":
          ok2 = False
          break
        if j2 == "":
          j2 = a2e
        else:
          j2 = j2 + ", " + a2e
        ai2 += 1
      if not ok2:
        return ""
    if isProxySuper:
      if j2 == "":
        return "this->_target." + meth2 + "()"
      return "this->_target." + meth2 + "(" + j2 + ")"
    if j2 == "":
      return baseCpp + "::" + meth2 + "()"
    return baseCpp + "::" + meth2 + "(" + j2 + ")"
  return ""

def _emitSimpleTerm(term: str, st: EnumEmitState) -> str:
  t: str = term.strip()
  # 裸 ``this->field`` 直出；``this->meth(...)`` / 下标须继续派发（嵌套实参装箱）
  if _hasThisArrowPrefix(t):
    if "(" not in t and "[" not in t:
      return t
  if t == "self":
    return "(*this)"
  supE: str = _emitSuperExpr(t, st)
  if supE != "":
    return supE
  # 外层成对括号：``(1 + 1j)`` / ``(a + b)``
  if len(t) >= 2 and t[0] == "(" and t[len(t) - 1] == ")":
    depthP0: int = 0
    okP0: bool = True
    inStrP0: bool = False
    qP0: str = ""
    pi0: int = 0
    while pi0 < len(t):
      chP0: str = t[pi0]
      if inStrP0:
        if chP0 == "\\" and pi0 + 1 < len(t):
          pi0 += 2
          continue
        if chP0 == qP0:
          inStrP0 = False
        pi0 += 1
        continue
      if chP0 == "\"" or chP0 == "'":
        inStrP0 = True
        qP0 = chP0
        pi0 += 1
        continue
      if chP0 == "(":
        depthP0 += 1
      elif chP0 == ")":
        depthP0 -= 1
        if depthP0 == 0 and pi0 != len(t) - 1:
          okP0 = False
          break
      pi0 += 1
    if okP0 and depthP0 == 0:
      innerP0: str = t[1 : len(t) - 1].strip()
      # 勿拆元组 ``(1, 2)`` / ``(a,)``：交由下方元组字面量分支
      hasTopComma: bool = False
      dC0: int = 0
      inSC0: bool = False
      qC0: str = ""
      ci0: int = 0
      while ci0 < len(innerP0):
        chC0: str = innerP0[ci0]
        if inSC0:
          if chC0 == "\\" and ci0 + 1 < len(innerP0):
            ci0 += 2
            continue
          if chC0 == qC0:
            inSC0 = False
          ci0 += 1
          continue
        if chC0 == "\"" or chC0 == "'":
          inSC0 = True
          qC0 = chC0
          ci0 += 1
          continue
        if chC0 == "(" or chC0 == "[" or chC0 == "{":
          dC0 += 1
        elif chC0 == ")" or chC0 == "]" or chC0 == "}":
          if dC0 > 0:
            dC0 -= 1
        elif chC0 == "," and dC0 == 0:
          hasTopComma = True
          break
        ci0 += 1
      if innerP0 != "" and innerP0 != t and hasTopComma == False:
        return _emitSimpleTerm(innerP0, st)
  # ``(300, 28)`` 元组字面量（须在外层括号拆解之后、且未被拆掉时）
  if len(t) >= 5 and t[0:1] == "(" and t[len(t) - 1 : len(t)] == ")" and "," in t:
    tupInner0: str = t[1 : len(t) - 1].strip()
    if tupInner0 != "" and tupInner0.find("=") < 0 and tupInner0.find(" for ") < 0:
      tupParts0: list[str] = _splitParams(tupInner0)
      if len(tupParts0) >= 1:
        # 单元素 ``(x,)`` 也走 makeTuple 友好的 PyTuple
        if len(tupParts0) >= 2 or (
          len(tupParts0) == 1
          and len(tupInner0) > 0
          and tupInner0[len(tupInner0) - 1 : len(tupInner0)] == ","
        ):
          tupOk0: bool = True
          tupJoined0: str = ""
          tupTys0: str = ""
          tiT0: int = 0
          while tiT0 < len(tupParts0):
            teT0: str = _emitSimpleTerm(tupParts0[tiT0].strip(), st)
            if teT0 == "":
              tupOk0 = False
              break
            tyT0: str = "PyInt"
            rawT0: str = tupParts0[tiT0].strip()
            if _isFloatLit(rawT0):
              tyT0 = "PyFloat64"
            if len(rawT0) >= 1 and (rawT0[0:1] == "\"" or rawT0[0:1] == "'"):
              tyT0 = "PyStr"
            if _isIdent(rawT0):
              tyLoc0: str = _localCppTypeOf(st, rawT0)
              if tyLoc0 != "":
                tyT0 = tyLoc0
            if tupJoined0 == "":
              tupJoined0 = teT0
              tupTys0 = tyT0
            else:
              tupJoined0 = tupJoined0 + ", " + teT0
              tupTys0 = tupTys0 + ", " + tyT0
            tiT0 += 1
          if tupOk0 and tupJoined0 != "":
            return "PyTuple<" + tupTys0 + ">(" + tupJoined0 + ")"
  # 三引号须先于相邻字面量：``"""…"""`` 会被拆成 ``""`` + ``"…"`` + ``""``
  if len(t) >= 3:
    if t[:3] == "\"\"\"" or t[:3] == "'''":
      tq0: str = _emitTripleQuotedExpr(t, st)
      if tq0 != "":
        return tq0
  adjLit: str = _emitAdjacentStrLits(t)
  if adjLit != "":
    return adjLit
  if t == "True":
    return "true"
  if t == "False":
    return "false"
  # ``complex.Infj`` / ``complex.NaNj`` → ``complex128::…__get()``
  if len(t) >= 9 and t[:8] == "complex.":
    atrCx: str = t[8:]
    if _isIdent(atrCx):
      if atrCx == "Infj" or atrCx == "NaNj" or atrCx == "Inf" or atrCx == "NaN":
        return "complex128::" + atrCx + "__get()"
      return "complex128::" + atrCx
  if t == "wall_time":
    return "paw::system::time::time"
  if t == "strptime" or t == "strftime" or t == "gmTime" or t == "gmTimeNow" or t == "localTime" or t == "mkTime" or t == "ascTime":
    return "paw::system::time::" + t
  if t == "monotonic" or t == "perfCounter" or t == "processTime" or t == "sleep" or t == "stopwatch" or t == "formatDuration":
    return "paw::system::time::" + t
  if t == "None":
    return "nullptr"
  # ``getattr(obj, "x")`` / ``setattr(obj, "y", v)``（字面量字段名）
  if len(t) >= 8 and t[:8] == "getattr(" and t[len(t) - 1 : len(t)] == ")":
    gInner: str = t[8 : len(t) - 1].strip()
    gParts: list[str] = _splitParams(gInner)
    if len(gParts) == 2:
      gObj: str = _emitSimpleTerm(gParts[0].strip(), st)
      gAttrRaw: str = gParts[1].strip()
      gAttr: str = ""
      if len(gAttrRaw) >= 2 and gAttrRaw[0:1] == "\"" and gAttrRaw[len(gAttrRaw) - 1 : len(gAttrRaw)] == "\"":
        gAttr = gAttrRaw[1 : len(gAttrRaw) - 1]
      if len(gAttrRaw) >= 2 and gAttrRaw[0:1] == "'" and gAttrRaw[len(gAttrRaw) - 1 : len(gAttrRaw)] == "'":
        gAttr = gAttrRaw[1 : len(gAttrRaw) - 1]
      if gObj != "" and gAttr != "" and _isIdent(gAttr):
        _noteGetattrAttr(st, gAttr)
        return "PY2CPP_GETATTR(" + gObj + ", " + gAttr + ")"
  if len(t) >= 8 and t[:8] == "setattr(" and t[len(t) - 1 : len(t)] == ")":
    sInner: str = t[8 : len(t) - 1].strip()
    sParts: list[str] = _splitParams(sInner)
    if len(sParts) == 3:
      sObj: str = _emitSimpleTerm(sParts[0].strip(), st)
      sAttrRaw: str = sParts[1].strip()
      sAttr: str = ""
      if len(sAttrRaw) >= 2 and sAttrRaw[0:1] == "\"" and sAttrRaw[len(sAttrRaw) - 1 : len(sAttrRaw)] == "\"":
        sAttr = sAttrRaw[1 : len(sAttrRaw) - 1]
      if len(sAttrRaw) >= 2 and sAttrRaw[0:1] == "'" and sAttrRaw[len(sAttrRaw) - 1 : len(sAttrRaw)] == "'":
        sAttr = sAttrRaw[1 : len(sAttrRaw) - 1]
      sVal: str = _emitSimpleTerm(sParts[2].strip(), st)
      if sObj != "" and sAttr != "" and _isIdent(sAttr) and sVal != "":
        _noteSetattrAttr(st, sAttr)
        return "PY2CPP_SETATTR(" + sObj + ", " + sAttr + ", " + sVal + ")"
  # ``(300, 28)`` 元组字面量
  if len(t) >= 5 and t[0:1] == "(" and t[len(t) - 1 : len(t)] == ")" and "," in t:
    tupInner: str = t[1 : len(t) - 1].strip()
    if tupInner != "" and tupInner.find("=") < 0 and tupInner.find(" for ") < 0:
      tupParts: list[str] = _splitParams(tupInner)
      if len(tupParts) >= 2:
        tupOk: bool = True
        tupJoined: str = ""
        tupTys: str = ""
        tiT: int = 0
        while tiT < len(tupParts):
          teT: str = _emitSimpleTerm(tupParts[tiT].strip(), st)
          if teT == "":
            tupOk = False
            break
          tyT: str = "PyInt"
          if _isFloatLit(tupParts[tiT].strip()):
            tyT = "PyFloat"
