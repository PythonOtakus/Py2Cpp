        out = out + _softSkipLine(s)
        continue
      out = out + _softSkipLine(s)
      continue
    # ``async with EXPR as NAME:`` → enter/body/exit（薄：同步调用 aenter/aexit）
    if len(s) >= 11 and s[:11] == "async with " and s[len(s) - 1] == ":":
      headAW: str = s[11 : len(s) - 1].strip()
      asPosAW: int = _findOutsideQuotes(headAW, " as ")
      exprAW: str = headAW
      nameAW: str = ""
      if asPosAW > 0:
        exprAW = headAW[:asPosAW].strip()
        nameAW = headAW[asPosAW + 4 :].strip()
      exprCppAW: str = _emitSimpleTerm(exprAW, st)
      i += 1
      withLinesAW: list[str] = []
      if i < len(lines):
        withIndAW: int = _lineIndent(lines[i])
        if withIndAW > ind:
          while i < len(lines) and _lineIndent(lines[i]) >= withIndAW:
            withLinesAW.append(lines[i])
            i += 1
      if exprCppAW != "":
