@native_name("cudaGraphAddNode")
native def pyiCudaGraphAddNode(pGraphNode: Pointer[Pointer[PyiCUgraphNodeSt]], graph: Pointer[PyiCUgraphSt], pDependencies: Pointer[Pointer[PyiCUgraphNodeSt]], dependencyData: Pointer[PyiCudaGraphEdgeDataSt], numDependencies: uint64, nodeParams: Pointer[PyiCudaGraphNodeParams]) -> PyiCudaErrorT:
