"""GPU 点wise：``Add.map`` + ``Field``。"""
from paw import *
from paw.gpu import Field, GpuKernelMixin, gpuSync
from paw.test.unittest import TestCaseMixin, TestSuite, TextTestRunner

record Add(GpuKernelMixin):
  c: float

  def run(self, a: float, b: float) -> float:
    return a + b + self.c

class VectorAddTests(TestCaseMixin):
  override def test(self):
    n: int = 8
    a: Field[float] = new.zeros(n)
    b: Field[float] = new.ones(n)
    out: Field[float] = new.zeros(n)
    hostA: list[float] = []
    for i in range(n):
      hostA.append(1.0)
    a.copyFromHost(hostA)
    with gpuSync():
      op: Add = new(c=1.0)
      op.map(a, b, out)
    host: list[float] = out.toHost()
    self.assertEqual(host[0], 3.0)

def main() -> None:
  suite: TestSuite = new()
  suite.addTest(VectorAddTests())
  runner: TextTestRunner = new()
  return runner.run(suite)
