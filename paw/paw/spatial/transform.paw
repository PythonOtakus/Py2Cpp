"""场景图变换 ``Transform2D`` / ``Transform3D``（对齐 tggame ``space.Transform*`` 子集）。"""
from __future__ import annotations

from ..builtins import *
from ..core.exceptions import ValueError
from ..numeric.protocols import RealType
from ..weak.ref import WeakRef
from .matrix import Matrix3, Matrix4
from .rotator import Quaternion, Rotator
from .vector import Vector2, Vector3

mixin TransformMixin[Vec, Rot, Mat]:
  """``Transform2D`` / ``Transform3D`` 公共场景图 + 世界空间 TRS（维相关类型由 ``Vec``/``Rot``/``Mat`` 形参绑定）。"""

  name: str = "Anonymous"
  _parent: WeakRef[Self] | None = None
  _children: list[Self] = []
  _localPosition: Vec = new.zero
  _localRotation: Rot = new.identity
  _localScale: Vec = new.one

  @immutable
  static def _isDescendantOf(node: Self, ancestor: Self) -> bool:
    cur: Self = node
    while True:
      if cur is ancestor:
        return True
      if cur.parent is None:
        return False
      cur = cur.parent

  @immutable
  property parent:
    def __get__(self) -> Self | None:
      if self._parent is None:
        return None
      wr: WeakRef[Self] = self._parent.value
      if not wr.alive:
        return None
      return wr.value
    def __set__(self, value: Self | None) -> None:
      old: Self | None = self.parent
      if old is not None:
        old.detach(self)
      if value is not None:
        if value is self or Self._isDescendantOf(value, self):
          raise ValueError("transform parent would create a cycle")
        value.attach(self)

  @immutable
  property def root(self) -> Self:
    node: Self = self
    while True:
      p: Self | None = node.parent
      if p is None:
        return node
      node = p

  @immutable
  property def childCount(self) -> int:
    return len(self._children)

  @immutable
  property def children(self) -> list[Self]:
    return self._children.copy()

  def attach(self, child: Self) -> None:
    self._children.append(child)
    child.bindParent(self)

  def detach(self, child: Self) -> None:
    for i in range(len(self._children)):
      if self._children[i] is child:
        self._children.pop(i)
        child.unbindParent()
        return

  def detachAll(self) -> None:
    for i in range(len(self._children)):
      self._children[i].unbindParent()
    self._children.clear()

  def bindParent(self, par: Self) -> None:
    self._parent = new(par)

  def unbindParent(self) -> None:
    self._parent = None

  def find(self, name: str) -> Self | None:
    stack: list[Self] = []
    for i in range(len(self._children)):
      stack.append(self._children[i])
    head: int = 0
    while head < len(stack):
      node: Self = stack[head]
      head += 1
      if node.name == name:
        return node
      subs: list[Self] = node.children
      for j in range(len(subs)):
        stack.append(subs[j])
    return None

  @immutable
  property def localMatrix(self) -> Mat:
    return new.transform(self._localPosition, self._localRotation, self._localScale)

  @immutable
  property def localInvMatrix(self) -> Mat:
    return self.localMatrix.inv

  @immutable
  property def localToWorldMatrix(self) -> Mat:
    m: Mat = self.localMatrix
    par: Self | None = self.parent
    while par is not None:
      m = par.localMatrix @ m
      par = par.parent
    return m

  @immutable
  property def worldToLocalMatrix(self) -> Mat:
    return self.localToWorldMatrix.inv

  @immutable
  def localToWorldPoint(self, point: Vec) -> Vec:
    return self.localToWorldMatrix.applyToPoint(point)

  @immutable
  def localToWorldVector(self, vector: Vec) -> Vec:
    return self.localToWorldMatrix.applyToVector(vector)

  @immutable
  def worldToLocalPoint(self, point: Vec) -> Vec:
    return self.worldToLocalMatrix.applyToPoint(point)

  @immutable
  def worldToLocalVector(self, vector: Vec) -> Vec:
    return self.worldToLocalMatrix.applyToVector(vector)

  @immutable
  property position:
    def __get__(self) -> Vec:
      p: Vec = self.localPosition
      par: Self | None = self.parent
      if par is not None:
        return par.localToWorldPoint(p)
      return p
    def __set__(self, value: Vec) -> None:
      par: Self | None = self.parent
      if par is not None:
        local: Vec = par.worldToLocalPoint(value)
        self.localPosition = local
      else:
        self.localPosition = value

  @immutable
  property rotation:
    def __get__(self) -> Rot:
      rot: Rot = self.localRotation
      par: Self | None = self.parent
      while par is not None:
        rot = par.localRotation @ rot
        par = par.parent
      return rot
    def __set__(self, value: Rot) -> None:
      par: Self | None = self.parent
      if par is not None:
        local: Rot = value @ ~par.rotation
        self.localRotation = local
      else:
        self.localRotation = value

  @immutable
  property def scale(self) -> Vec:
    return self.localToWorldMatrix.scale

  def translate(self, translation: Vec) -> None:
    self.position += translation

ref class Transform2D[Scalar: RealType = float](
  TransformMixin[Vector2[Scalar], Rotator[Scalar], Matrix3[Scalar]],
):
  """2D 变换节点：局部 TRS + 父子层级（父引用 ``WeakRef``，子列表强引用）。"""

  def __repr__(self) -> str:
    return f"<Transform2D {self.name}>"

  @immutable
  property localPosition:
    def __get__(self) -> Vector2[Scalar]:
      return new(self._localPosition.x, self._localPosition.y)
    def __set__(self, value: Vector2[Scalar]) -> None:
      self._localPosition.x = value.x
      self._localPosition.y = value.y

  @immutable
  property localRotation:
    def __get__(self) -> Rotator[Scalar]:
      return new(self._localRotation.w, self._localRotation.z)
    def __set__(self, value: Rotator[Scalar]) -> None:
      self._localRotation.w = value.w
      self._localRotation.z = value.z
  @immutable
  property localAngle:
    def __get__(self) -> Scalar:
      return self._localRotation.toAngle()
    def __set__(self, value: Scalar) -> None:
      r: Rotator[Scalar] = new.fromAngle(value)
      self._localRotation.w = r.w
      self._localRotation.z = r.z

  @immutable
  property localScale:
    def __get__(self) -> Vector2[Scalar]:
      return new(self._localScale.x, self._localScale.y)
    def __set__(self, value: Vector2[Scalar]) -> None:
      self._localScale.x = value.x
      self._localScale.y = value.y

  @immutable
  property angle:
    def __get__(self) -> Scalar:
      rot: Rotator[Scalar] = self.rotation
      return rot.toAngle()
    def __set__(self, value: Scalar) -> None:
      self.rotation = new.fromAngle(value)

  @immutable
  property def right(self) -> Vector2[Scalar]:
    return self.localToWorldVector(Vector2[Scalar].right)

  @immutable
  property def down(self) -> Vector2[Scalar]:
    return self.localToWorldVector(Vector2[Scalar].down)

  def rotate(self, angle: Scalar) -> None:
    delta: Rotator[Scalar] = new.fromAngle(angle)
    self.rotation = delta @ self.rotation

  def rotateAround(self, center: Vector2[Scalar], angle: Scalar) -> None:
    pos: Vector2[Scalar] = self.position
    self.position = pos.rotatedAround(center, angle)
    delta: Rotator[Scalar] = new.fromAngle(angle)
    self.rotation = delta @ self.rotation

  def lookAt(self, target: Vector2[Scalar]) -> None:
    self.rotation = new.lookAt(target - self.position)

ref class Transform3D[Scalar: RealType = float](
  TransformMixin[Vector3[Scalar], Quaternion[Scalar], Matrix4[Scalar]],
):
  """3D 变换节点：局部 TRS + 父子层级（父引用 ``WeakRef``，子列表强引用）。"""

  def __repr__(self) -> str:
    return f"<Transform3D {self.name}>"

  @immutable
  property localPosition:
    def __get__(self) -> Vector3[Scalar]:
      return new(self._localPosition.x, self._localPosition.y, self._localPosition.z)
    def __set__(self, value: Vector3[Scalar]) -> None:
      self._localPosition.x = value.x
      self._localPosition.y = value.y
      self._localPosition.z = value.z

  @immutable
  property localRotation:
    def __get__(self) -> Quaternion[Scalar]:
      return new(
        self._localRotation.w,
        self._localRotation.x,
        self._localRotation.y,
        self._localRotation.z,
      )
    def __set__(self, value: Quaternion[Scalar]) -> None:
      self._localRotation.w = value.w
      self._localRotation.x = value.x
      self._localRotation.y = value.y
      self._localRotation.z = value.z
  @immutable
  property localEulerAngles:
    def __get__(self) -> Vector3[Scalar]:
      return self._localRotation.toEulerAngles()
    def __set__(self, value: Vector3[Scalar]) -> None:
      q: Quaternion[Scalar] = new.fromEulerAngles(value)
      self._localRotation.w = q.w
      self._localRotation.x = q.x
      self._localRotation.y = q.y
      self._localRotation.z = q.z

  @immutable
  property localScale:
    def __get__(self) -> Vector3[Scalar]:
      return new(self._localScale.x, self._localScale.y, self._localScale.z)
    def __set__(self, value: Vector3[Scalar]) -> None:
      self._localScale.x = value.x
      self._localScale.y = value.y
      self._localScale.z = value.z

  @immutable
  property eulerAngles:
    def __get__(self) -> Vector3[Scalar]:
      rot: Quaternion[Scalar] = self.rotation
      return rot.toEulerAngles()
    def __set__(self, value: Vector3[Scalar]) -> None:
      self.rotation = new.fromEulerAngles(value)

  @immutable
  property def right(self) -> Vector3[Scalar]:
    return self.localToWorldVector(Vector3[Scalar].right)

  @immutable
  property def down(self) -> Vector3[Scalar]:
    return self.localToWorldVector(Vector3[Scalar].down)

  @immutable
  property def forward(self) -> Vector3[Scalar]:
    return self.localToWorldVector(Vector3[Scalar].forward)

  def rotate(self, axis: Vector3[Scalar], angle: Scalar) -> None:
    delta: Quaternion[Scalar] = new.fromAxisAngle(axis, angle)
    self.rotation = delta @ self.rotation

  def rotateAround(self, center: Vector3[Scalar], axis: Vector3[Scalar], angle: Scalar) -> None:
    pos: Vector3[Scalar] = self.position
    self.position = pos.rotatedAround(center, axis, angle)
    delta: Quaternion[Scalar] = new.fromAxisAngle(axis, angle)
    self.rotation = delta @ self.rotation

  def lookAt(self, target: Vector3[Scalar]) -> None:
    self.rotation = new.lookAt(target - self.position)
