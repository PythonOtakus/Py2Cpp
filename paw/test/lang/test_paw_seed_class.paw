"""C0 种子回归：class/record 前缀、``@copyable``、类内 const/方法。"""
from py2cpp import *
from py2cpp.test.unittest import TestCaseMixin, TestSuite, TextTestRunner
from compiler.paw.frontend.source import SourceManager
from compiler.paw.frontend.parser import parseSource
from compiler.paw.frontend.syntax_nodes import ItemKindEnum, SyntaxModule

class PawSeedClassTests(TestCaseMixin):
  _testTag = 1

  override def test(self):
    src: str = (
      "frozen ordered record Point:\n"
      "  x: int = 0\n"
      "  y: int = 0\n"
      "final class Seal:\n"
      "  const MAX: int = 3\n"
      "  override def run(self) -> None:\n"
      "    pass\n"
      "@copyable\n"
      "class FileId:\n"
      "  value: int = 0\n"
    )
    sm: SourceManager = new()
    sf = sm.add("c.paw", src, "d2")
    mod: SyntaxModule = parseSource(sf.text, sf.fileId)
    self.assertTrue(len(mod.classes) == 3)
    self.assertTrue(mod.items[0].kind == ItemKindEnum.Class)
    self.assertTrue(mod.classes[0].name == "Point")
    self.assertTrue(mod.classes[0].isRecord)
    self.assertTrue(mod.classes[0].isFrozen)
    self.assertTrue(mod.classes[0].isOrdered)
    self.assertTrue(mod.classes[1].name == "Seal")
    self.assertTrue(mod.classes[1].isFinal)
    self.assertTrue(len(mod.classes[1].constFields) == 1)
    self.assertTrue(mod.classes[1].constFields[0].name == "MAX")
    self.assertTrue(mod.classes[1].constFields[0].valueSource == "3")
    self.assertTrue(len(mod.classes[1].methods) == 1)
    self.assertTrue(mod.classes[1].methods[0].name == "run")
    self.assertTrue(mod.classes[1].methods[0].isOverride)
    self.assertTrue(mod.classes[2].name == "FileId")
    self.assertTrue(mod.classes[2].decoratorsSource[:9] == "@copyable")

def main():
  suite: TestSuite = new()
  for Class in TestCaseMixin.iterSubclasses(sortConst="_testTag"):
    suite.addTest(Class())
  return TextTestRunner().run(suite)
